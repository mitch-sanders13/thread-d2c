    { "type": "header", "content": "Design — Gallery" },
    { "type": "checkbox", "id": "gallery_full_width_m", "label": "Mobile: image full-width edge-to-edge", "default": false },
    { "type": "checkbox", "id": "gallery_full_width_d", "label": "Desktop: image fills container (no neighbor peek)", "default": false },
    { "type": "checkbox", "id": "enable_sticky_gallery", "label": "Desktop: pin gallery while details scroll", "info": "The image column stays fixed while the right column scrolls; once the details run out the whole page scrolls.", "default": true },
    { "type": "range", "id": "sticky_gallery_top", "label": "Pinned gallery top offset (px)", "info": "Distance from the top of the viewport while pinned — raise it to clear the sticky header.", "min": 0, "max": 200, "step": 2, "default": 90 },

    { "type": "header", "content": "Design — Gallery layout" },
    { "type": "paragraph", "content": "Fine-tune the spacing and proportions of the gallery vs the details column. All settings apply to desktop unless noted." },
    { "type": "color", "id": "gallery_image_bg", "label": "Image background", "info": "Nike-style soft grey background behind product images. Leave blank for transparent." },
    { "type": "range", "id": "gallery_image_pad_d", "label": "Image inner padding — desktop (px)", "info": "Whitespace between image and its background.", "min": 0, "max": 96, "step": 2, "default": 0 },
    { "type": "range", "id": "gallery_image_pad_m", "label": "Image inner padding — mobile (px)", "min": 0, "max": 64, "step": 2, "default": 0 },
    { "type": "range", "id": "gallery_col_gap_d", "label": "Gap between gallery and details column — desktop (px)", "info": "Horizontal breathing room between the image area and the right column.", "min": 0, "max": 96, "step": 1, "default": 0 },
    { "type": "range", "id": "gallery_col_gap_m", "label": "Gap between gallery and details — mobile (px)", "info": "Vertical gap below the gallery on mobile (since columns stack).", "min": 0, "max": 64, "step": 1, "default": 0 },
    { "type": "range", "id": "details_pad_d", "label": "Details column extra padding — desktop (px)", "info": "Adds horizontal padding inside the right column for breathing room.", "min": 0, "max": 64, "step": 2, "default": 0 },
    { "type": "range", "id": "details_pad_m", "label": "Details column extra padding — mobile (px)", "min": 0, "max": 64, "step": 2, "default": 0 },
    { "type": "header", "content": "Design — Thumbnail strip (Thumbnail slider only)" },
    { "type": "paragraph", "content": "Controls the vertical thumbnail column on the left when gallery style is set to Thumbnail slider." },
    { "type": "range", "id": "gallery_thumb_width_d", "label": "Thumbnail strip width — desktop (%)", "min": 6, "max": 25, "step": 1, "default": 10 },
    { "type": "range", "id": "gallery_thumb_max_h_d", "label": "Thumbnail strip max height — desktop (px)", "info": "Caps the strip's vertical extent. Scrolls if more thumbs than fit.", "min": 300, "max": 900, "step": 50, "default": 500 },
    { "type": "range", "id": "gallery_thumb_gap", "label": "Gap between thumbs and main image (px)", "min": 0, "max": 48, "step": 2, "default": 8 },

    { "type": "header", "content": "Design — Gallery dots" },
    { "type": "paragraph", "content": "Position indicator dots below the gallery (only shown when product has multiple images). Allbirds-style. Click a dot to jump to that image." },
    {
      "type": "select", "id": "dots_shape", "label": "Shape",
      "options": [
        { "value": "default", "label": "Default (existing pill bars)" },
        { "value": "circle",  "label": "Round dots" },
        { "value": "square",  "label": "Square dots" }
      ],
      "default": "default"
    },
    { "type": "range", "id": "dots_size",          "label": "Dot size (px)",   "min": 4, "max": 16, "step": 1, "default": 6 },
    { "type": "range", "id": "dots_active_size",   "label": "Active dot size (px)", "info": "Bigger than the inactive dots for emphasis. Set equal to dot size for uniform.", "min": 4, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "dots_gap",           "label": "Gap between dots (px)", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "dots_bottom_offset", "label": "Distance from bottom of image (px)", "min": 4, "max": 80, "step": 1, "default": 16 },
    {
      "type": "select", "id": "dots_inactive_style", "label": "Inactive dot style",
      "info": "\"Outlined\" = hollow ring (Allbirds-style). \"Filled\" = solid color with opacity.",
      "options": [
        { "value": "filled",   "label": "Filled" },
        { "value": "outlined", "label": "Outlined ring" }
      ],
      "default": "outlined"
    },
    { "type": "range", "id": "dots_border_width", "label": "Outline thickness (px)", "info": "Only applies when inactive style is Outlined.", "min": 1, "max": 4, "step": 1, "default": 1 },
    { "type": "color", "id": "dots_color",         "label": "Inactive dot color (or border)" },
    { "type": "color", "id": "dots_color_active",  "label": "Active dot color" },
    { "type": "range", "id": "dots_opacity",       "label": "Inactive dot opacity (%)", "info": "Only applies when inactive style is Filled.", "min": 10, "max": 100, "step": 5, "default": 35 },

    { "type": "header", "content": "Design — Icon layout" },
    {
      "type": "select", "id": "icon_layout", "label": "Icon block layout",
      "info": "How multiple Icon blocks stack relative to each other.",
