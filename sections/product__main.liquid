  x-intersect:enter="if (window.__stickyAddTimer) clearTimeout(window.__stickyAddTimer); window.__stickyAddTimer = setTimeout(() => { stickyadd = false; scroll_up_force = true; }, 120);"
  x-intersect:leave="if (window.__stickyAddTimer) clearTimeout(window.__stickyAddTimer); window.__stickyAddTimer = setTimeout(() => { stickyadd = true; scroll_up_force = false; }, 120);">

  {%- capture script_product -%}
    {% render 'script__product', 
      gallery_style : section.settings.media_gallery_style %}
  {%- endcapture -%}
  <div class="flex flex-row flex-wrap md:items-start"

    x-data="{{ script_product }}"
    x-init="
      initProductForm();
    "
    x-ref="formContainer">

    {%- comment -%}media{%- endcomment -%}
    {% if section.settings.media_gallery_style == 'grid' %}
      {% render 'product__gallery-grid' %}
    {% elsif section.settings.media_gallery_style == 'slider' %}
      {% render 'product__gallery-slider' %}
    {% else %}
       {% render 'product__gallery-thumbnail-slider' %} 
    {% endif %}
    
    {%- comment -%}details{%- endcomment -%}
    {% case section.settings.layout_gallery_size %}
      {% when 'w-full md:w-1/3' %}
        {% assign layout_detail_size = 'w-full md:w-2/3' %}
      {% when 'w-full md:w-1/2' %}
        {% assign layout_detail_size = 'w-full md:w-1/2' %}
      {% when 'w-full md:w-2/3' %}
        {% assign layout_detail_size = 'w-full md:w-1/3' %}
      {% when 'w-full md:w-3/4' %}
        {% assign layout_detail_size = 'w-full md:w-1/4' %}
    {% endcase %}

    <div class="pdp-details-col border--t-width md:border-t-0
      {{ section.settings.color_border }}
      {{ layout_detail_size }}">
      <div class="sticky top-0 z-10" 
        x-data="{ 
          button_loading: false 
        }">

        {% form "product", product %}

          {% comment %} Desktop only blocks {% endcomment %}
          <div class="hidden w-full md:block">
            {% for block in section.blocks %}
              {%- case block.type -%}
                
                {%- when 'breadcrumb' -%}
                  {% render 'product__breadcrumb', blocksettings: block.settings %}

                {%- when 'title' -%}
                  {% render 'product__title', blocksettings: block.settings %}

                {%- when 'price' -%}
                  <div class="px-4
                      {{ section.settings.color_border }}
                      {{ block.settings.color_scheme }} 
                      {{ block.settings.style_border }}"
                    style="
                      padding-top:{{ block.settings.spacing_top }}px;
                      padding-bottom:{{ block.settings.spacing_bottom }}px;">
                    <div class="relative flex items-end justify-between">
                      {% render 'product__price', blocksettings: block.settings %}
                    </div>
                  </div>

              {%- endcase -%}
            {% endfor %}
          </div>

          {% for block in section.blocks %}
            {%- case block.type -%}
              {%- when 'icon' -%}
                {%- comment -%}
                  Per-type icon sets: when the block names one or more
                  product types (comma-separated), it only renders on
                  PDPs whose product.type matches one of them. Blank =
                  universal icon, shows everywhere.
                {%- endcomment -%}
                {%- assign _icon_show = true -%}
                {%- if block.settings.icon_product_type != blank -%}
                  {%- assign _icon_show = false -%}
                  {%- assign _icon_pt = product.type | downcase | strip -%}
                  {%- assign _icon_types = block.settings.icon_product_type | downcase | split: ',' -%}
                  {%- for _icon_t in _icon_types -%}
                    {%- assign _icon_tt = _icon_t | strip -%}
                    {%- if _icon_tt == _icon_pt -%}{%- assign _icon_show = true -%}{%- break -%}{%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- if _icon_show -%}
                  {% render 'product__icon', blocksettings: block.settings, block_id: block.id %}
                {%- endif -%}

              {%- when 'custom' -%}
                <div class='px-4 
                  {{ section.settings.color_border }}
                  {{ block.settings.color_scheme }} 
                  {{ block.settings.style_border }}'
                  style="
                    padding-top:{{ block.settings.spacing_top }}px;
                    padding-bottom:{{ block.settings.spacing_bottom }}px;">
                  {% render 'product__custom-field', blocksettings: block.settings %}
                </div>

              {%- when 'text' -%}
                {% if product.tags contains block.settings.text_block_tag %}
                    {% render 'product__text', blocksettings: block.settings %}
                {% endif %}

              {%- when 'description' -%}
                {% render 'product__description', blocksettings: block.settings %}

              {%- when 'accordion' -%}
                {% render 'product__accordion', blocksettings: block.settings %}

              {%- when 'popup' -%}
                {% render 'product__popup', blocksettings: block.settings %}

              {%- when 'inventory' -%}
                {% render 'product__inventory', blocksettings: block.settings %}

              {%- when 'presale' -%}
                {% comment %}
                  Pre-sale ship date + final-sale notice. Used by the
                  product.presale alternate template instead of inventory.
                {% endcomment %}
                {% render 'product__presale', blocksettings: block.settings %}

              {%- when 'pickup' -%}
                {% render 'product__pickup', blocksettings: block.settings %}  

              {%- when 'options' -%}
                <div class="options flex flex-col gap-2
                  {{ section.settings.color_border }}
                  {{ block.settings.color_scheme }}
                  {{ block.settings.style_border }}"
                  style="
                    padding-top:{% if product.selected_or_first_available_selling_plan_allocation or product.has_only_default_variant == false %}{{ block.settings.spacing_top }}px;{% else %}0;{% endif %}
                    padding-bottom:{% if product.selected_or_first_available_selling_plan_allocation or product.has_only_default_variant == false %}{{ block.settings.spacing_bottom }}px;{% else %}0;{% endif %}">
                  {% render 'product__options', 
                    blocksettings: block.settings %}
                </div>

              {%- when 'add' -%}
                <div class=" 
                  {{ section.settings.color_border }}
                  {{ block.settings.color_scheme }}
                  {{ block.settings.style_border }}"
                  style="
                    padding-top:{{ block.settings.spacing_top }}px;
                    padding-bottom:{{ block.settings.spacing_bottom }}px;">
                    
                  {% render 'product__add',
                    blocksettings: block.settings,
                    form: form,
                    enable_express: block.settings.enable_dynamic_checkout %}
                  {% if block.settings.enable_dynamic_checkout %}
                    <style>
                      /* Fallback styling only — the inline script in
                         product__add.liquid copies the ATC's measured
                         height + radius onto the wallet button (inline
                         styles), so no !important here or it would beat
                         that exact match. */
                      #shopify-section-{{ section.id }} .pdp-express .shopify-payment-button__button {
                        border-radius: var(--sizes-border-button-radius);
                        min-height: 48px;
                        width: 100%;
                      }
                      #shopify-section-{{ section.id }} .pdp-express .shopify-payment-button__more-options {
                        display: none !important;
                      }
                    </style>
                  {% endif %}
                  {%- comment -%}
                    No px-4 wrapper around the bundle — the bundle
                    handles its own horizontal padding internally so
                    its top/bottom divider lines (in bundle-builder
                    .css) span the full column width, lining up with
                    the accordion dividers below it on the PDP.
                  {%- endcomment -%}
                  {% render 'bundle__pdp-cta' %}
                  {% render 'market-tote-bundler__pdp-cta' %}
                </div>

              {%- when 'stickyadd' -%}
                {% render 'product__stickyadd', blocksettings: block.settings %}

              {%- when 'related_styles' -%}
                {%- comment -%}
                  rs_total is computed once on the first encountered
                  related_styles block — counts how many such blocks
                  the section contains so the snippet can decide
                  whether the "Select Your Style" title should live
                  on the per-block widget (single block) or be
                  hoisted into the shared tabbed header (multi block).
                {%- endcomment -%}
                {%- if rs_total == nil -%}
                  {%- assign rs_total = 0 -%}
                  {%- for _rs_b in section.blocks -%}
                    {%- if _rs_b.type == 'related_styles' -%}{%- assign rs_total = rs_total | plus: 1 -%}{%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- assign rs_index = rs_index | default: 0 | plus: 1 -%}
                {% render 'product__related-styles', blocksettings: block.settings, block_id: block.id, rs_index: rs_index, rs_total: rs_total %}

              {%- when 'rating' -%}
                {% render 'product__rating', blocksettings: block.settings %}

              {%- when 'countdown' -%}
                {% if product.tags contains block.settings.countdown_tag or block.settings.countdown_tag == "" %}
                    {% render 'product__countdown', blocksettings: block.settings %}
                {% endif %}

              {% when 'liquid' %}
                {% render 'product__liquid', blocksettings: block.settings %}

              {% when '@app' %}
                {% render block %}

              {%- endcase -%}
          {% endfor %}
        {% endform %}

        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when 'upsell' -%}
              {% render 'product__upsell', blocksettings: block.settings %}
          {%- endcase -%}
        {% endfor %}

      </div>
    </div>
  </div>

  {% if section.settings.enable_zoom %}
    {% render 'product__gallery-fullscreen' %}
  {% endif %}

</section>

{% render 'script__recent-view' %}
{% render 'script__swatches' %}

{% comment %} Backup collegiate swatch container - ensure it exists {% endcomment %}
{% if product.tags contains 'collegiate' %}
  <div style="display: none;">
    <div class="js:pdp-collegiate-swatches-backup"></div>
  </div>
{% endif %}

