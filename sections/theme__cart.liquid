<!-- sections/theme__cart.liquid v2 -->
{% comment %}
  Slide out cart and alert cart popup.

  Globals:
    - settings.enable_animations: boolean to enable animations
    - settings.type_seperator: setting to pick the type of seperator between text
    - settings.thumbmails_color_scheme: color scheme of thumbnails
    - settings.thumbnails_ratio: set the aspect ratio of thumbnails
    - setttings.cart_button_behavior: set the behavior of the checkout button

  Possible enhancements:
    - Add option to set cart to slideout, alert or page
{% endcomment %}

{%- comment -%} ===== Font token resolvers (token class vs inline font-family) ===== {%- endcomment -%}
{%- capture header_title_token_class -%}{%- if section.settings.header_title_font contains 'token-' -%}{{ section.settings.header_title_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}
{%- capture item_title_token_class -%}{%- if section.settings.item_title_font contains 'token-' -%}{{ section.settings.item_title_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}
{%- capture item_variant_token_class -%}{%- if section.settings.item_variant_font contains 'token-' -%}{{ section.settings.item_variant_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}
{%- capture item_price_token_class -%}{%- if section.settings.item_price_font contains 'token-' -%}{{ section.settings.item_price_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}
{%- capture subtotal_label_token_class -%}{%- if section.settings.subtotal_label_font contains 'token-' -%}{{ section.settings.subtotal_label_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}
{%- capture subtotal_value_token_class -%}{%- if section.settings.subtotal_value_font contains 'token-' -%}{{ section.settings.subtotal_value_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}
{%- capture tax_label_token_class -%}{%- if section.settings.tax_label_font contains 'token-' -%}{{ section.settings.tax_label_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}
{%- capture empty_message_token_class -%}{%- if section.settings.empty_message_font contains 'token-' -%}{{ section.settings.empty_message_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}
{%- capture simple_message_token_class -%}{%- if section.settings.simple_message_font contains 'token-' -%}{{ section.settings.simple_message_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}
{%- capture trust_label_token_class -%}{%- if section.settings.trust_label_font contains 'token-' -%}{{ section.settings.trust_label_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}
{%- capture tax_value_token_class -%}{%- if section.settings.tax_value_font contains 'token-' -%}{{ section.settings.tax_value_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}
{%- capture item_compare_token_class -%}{%- if section.settings.item_compare_font contains 'token-' -%}{{ section.settings.item_compare_font | replace: 'token-', 'type-' }}{%- endif -%}{%- endcapture -%}

<style>
  {%- assign _sid = section.id -%}

  /* ============ Drawer container ============ */
  {% if section.settings.drawer_max_width != blank %}
  #shopify-section-{{ _sid }} .cart__panel {
    max-width: {{ section.settings.drawer_max_width }}px !important;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ _sid }} .cart__panel {
      max-width: {{ section.settings.drawer_max_width }}px !important;
    }
  }
  {% endif %}

  /* Constrain the drawer to the dynamic viewport height so the footer stays above
     the mobile browser URL bar (iOS Safari/Chrome) and iPhone home indicator. */
  #shopify-section-{{ _sid }} .cart__fixed-wrap {
    bottom: auto !important;
    height: 100dvh;
    max-height: 100dvh;
  }
  @supports not (height: 100dvh) {
    #shopify-section-{{ _sid }} .cart__fixed-wrap {
      height: 100vh;
      max-height: 100vh;
    }
  }
  #shopify-section-{{ _sid }} .cart__panel,
  #shopify-section-{{ _sid }} .cart__panel-inner {
    height: 100%;
    max-height: 100%;
  }
  #shopify-section-{{ _sid }} .cart__footer {
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  /* Lock page scroll while the cart drawer is open; contain overscroll inside the
     drawer's own scroll region so swipes never chain to the page behind. */
  html.drawer-open,
  html.drawer-open body {
    overflow: hidden !important;
    overscroll-behavior: none;
    touch-action: none;
  }
  #shopify-section-{{ _sid }} .cart__panel-inner,
  #shopify-section-{{ _sid }} .cart__panel-inner > section {
    overscroll-behavior: contain;
    touch-action: pan-y;
  }

  /* ============ Header / Top bar ============ */
  {% if section.settings.cart_header_bg != blank %}
  #shopify-section-{{ _sid }} .cart__header {
    background-color: {{ section.settings.cart_header_bg }} !important;
    border-bottom: none !important;
  }
  #shopify-section-{{ _sid }} .cart__header,
  #shopify-section-{{ _sid }} .cart__header * {
    color: {{ section.settings.cart_header_text }} !important;
  }
  #shopify-section-{{ _sid }} .cart__header svg {
    stroke: {{ section.settings.cart_header_text }} !important;
  }
  {% endif %}

  #shopify-section-{{ _sid }} .cart__header {
    min-height: {{ section.settings.header_height | default: 56 }}px !important;
    height: auto !important;
    padding-left: {{ section.settings.header_padding_x | default: 16 }}px !important;
    padding-right: {{ section.settings.header_padding_x | default: 16 }}px !important;
    padding-top: {{ section.settings.header_padding_y | default: 0 }}px !important;
    padding-bottom: {{ section.settings.header_padding_y | default: 0 }}px !important;
  }

  /* Title placement — left / center / right. The right side has the
     absolute-positioned close button at right: 16px, so when the title
     is right-aligned we offset it by the close-icon's width + a 12px gap
     so the text doesn't slide under the X. */
  {% case section.settings.header_title_align %}
    {% when 'left' %}
      #shopify-section-{{ _sid }} .cart__header { justify-content: flex-start !important; }
      #shopify-section-{{ _sid }} .cart__header-title { text-align: left !important; flex: 0 1 auto; }
    {% when 'right' %}
      {%- assign _close_size = section.settings.header_close_icon_size | default: 24 | plus: 12 -%}
      #shopify-section-{{ _sid }} .cart__header { justify-content: flex-end !important; }
      #shopify-section-{{ _sid }} .cart__header-title {
        text-align: right !important;
        padding-right: {{ _close_size }}px;
        flex: 0 1 auto;
      }
    {% else %}
      #shopify-section-{{ _sid }} .cart__header { justify-content: center !important; }
      #shopify-section-{{ _sid }} .cart__header-title { text-align: center !important; }
  {% endcase %}

  /* Header title typography */
  {% unless section.settings.header_title_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__header-title {
      font-size: {{ section.settings.header_title_size | default: 14 }}px !important;
      font-weight: {{ section.settings.header_title_weight | default: 400 }} !important;
      text-transform: {{ section.settings.header_title_transform | default: 'none' }} !important;
      letter-spacing: {{ section.settings.header_title_spacing | default: '0em' }} !important;
      line-height: {{ section.settings.header_title_line_height | default: 1.2 }} !important;
      {% if section.settings.header_title_color != blank %}color: {{ section.settings.header_title_color }} !important;{% endif %}
      {% if section.settings.header_title_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.header_title_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.header_title_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.header_title_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}

  /* ============ Body background ============ */
  {% if section.settings.cart_body_bg != blank %}
  #shopify-section-{{ _sid }} .color__bg-body {
    background-color: {{ section.settings.cart_body_bg }} !important;
  }
  {% endif %}

  /* ============ Borders ============ */
  {% if section.settings.cart_border_color != blank %}
  #shopify-section-{{ _sid }} .border--b-width,
  #shopify-section-{{ _sid }} .border--t-width {
    border-color: {{ section.settings.cart_border_color }} !important;
  }
  {% endif %}

  /* ============ Cart item row ============ */
  #shopify-section-{{ _sid }} .cart__item-row {
    padding: {{ section.settings.item_padding_y | default: 16 }}px {{ section.settings.item_padding_x | default: 16 }}px !important;
    gap: {{ section.settings.item_gap | default: 8 }}px !important;
  }

  /* Item image */
  #shopify-section-{{ _sid }} .cart__item-image-link {
    width: {{ section.settings.item_image_width | default: 20 }}% !important;
  }
  #shopify-section-{{ _sid }} .cart__item-image-box,
  #shopify-section-{{ _sid }} .cart__item-image-box img {
    border-radius: {{ section.settings.item_image_radius | default: 0 }}px !important;
  }
  #shopify-section-{{ _sid }} .cart__item-image-box {
    overflow: hidden;
  }

  /* Product title */
  #shopify-section-{{ _sid }} .cart__item-title {
    {% if section.settings.item_title_color != blank %}color: {{ section.settings.item_title_color }} !important;{% endif %}
  }
  {% unless section.settings.item_title_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__item-title {
      font-size: {{ section.settings.cart_title_size }}px !important;
      font-weight: {{ section.settings.cart_title_weight }} !important;
      text-transform: {{ section.settings.item_title_transform | default: 'capitalize' }} !important;
      letter-spacing: {{ section.settings.item_title_spacing | default: '0em' }} !important;
      line-height: {{ section.settings.item_title_line_height | default: 1.15 }} !important;
      {% if section.settings.item_title_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.item_title_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.item_title_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.item_title_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}

  /* Variant */
  #shopify-section-{{ _sid }} .cart__item-variant {
    opacity: {{ section.settings.item_variant_opacity | default: 0.75 }} !important;
    {% if section.settings.item_variant_color != blank %}color: {{ section.settings.item_variant_color }} !important;{% endif %}
  }
  {% unless section.settings.item_variant_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__item-variant {
      font-size: {{ section.settings.item_variant_size | default: 12 }}px !important;
      font-weight: {{ section.settings.item_variant_weight | default: 400 }} !important;
      text-transform: {{ section.settings.item_variant_transform | default: 'capitalize' }} !important;
      letter-spacing: {{ section.settings.item_variant_spacing | default: '0em' }} !important;
      {% if section.settings.item_variant_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.item_variant_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.item_variant_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.item_variant_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}

  /* Price */
  #shopify-section-{{ _sid }} .cart__item-price {
    {% if section.settings.item_price_color != blank %}color: {{ section.settings.item_price_color }} !important;{% endif %}
  }
  {% unless section.settings.item_price_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__item-price {
      font-size: {{ section.settings.item_price_size | default: 14 }}px !important;
      font-weight: {{ section.settings.item_price_weight | default: 400 }} !important;
      {% if section.settings.item_price_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.item_price_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.item_price_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.item_price_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}

  /* Compare-at price */
  #shopify-section-{{ _sid }} .cart__item-compare {
    {% if section.settings.item_compare_color != blank %}color: {{ section.settings.item_compare_color }} !important;{% endif %}
  }
  {% unless section.settings.item_compare_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__item-compare {
      font-size: {{ section.settings.item_compare_size | default: 14 }}px !important;
      font-weight: {{ section.settings.item_compare_weight | default: 400 }} !important;
      {% if section.settings.item_compare_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.item_compare_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.item_compare_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.item_compare_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}

  /* ============ Quantity stepper ============ */
  #shopify-section-{{ _sid }} .cart__qty-stepper {
    max-width: {{ section.settings.qty_max_width | default: 150 }}px !important;
    border-radius: {{ section.settings.qty_border_radius | default: 0 }}px !important;
  }
  {% if section.settings.qty_border_color != blank %}
  #shopify-section-{{ _sid }} .cart__qty-stepper,
  #shopify-section-{{ _sid }} .cart__qty-stepper .cart__qty-btn {
    border-color: {{ section.settings.qty_border_color }} !important;
  }
  {% endif %}
  #shopify-section-{{ _sid }} .cart__qty-btn {
    min-height: {{ section.settings.qty_button_height | default: 32 }}px !important;
  }
  {% if section.settings.qty_bg_color != blank %}
  #shopify-section-{{ _sid }} .cart__qty-stepper,
  #shopify-section-{{ _sid }} .cart__qty-input {
    background-color: {{ section.settings.qty_bg_color }} !important;
  }
  {% endif %}

  /* ============ Simple progress bar ============ */
  #shopify-section-{{ _sid }} .cart__progress-simple {
    background-color: {{ section.settings.simple_container_bg | default: '#F3F3F3' }};
    padding: {{ section.settings.simple_container_pad_y | default: 16 }}px {{ section.settings.simple_container_pad_x | default: 16 }}px;
  }
  #shopify-section-{{ _sid }} .cart__progress-simple-message {
    display: block;
    text-align: center;
    margin-bottom: {{ section.settings.simple_message_gap | default: 12 }}px;
    {% if section.settings.simple_message_color != blank %}color: {{ section.settings.simple_message_color }} !important;{% endif %}
  }
  {% unless section.settings.simple_message_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__progress-simple-message {
      font-size: {{ section.settings.simple_message_size | default: 15 }}px !important;
      font-weight: {{ section.settings.simple_message_weight | default: 400 }} !important;
      text-transform: {{ section.settings.simple_message_transform | default: 'none' }} !important;
      letter-spacing: {{ section.settings.simple_message_spacing | default: '0em' }} !important;
      line-height: {{ section.settings.simple_message_line_height | default: 1.4 }} !important;
      {% if section.settings.simple_message_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.simple_message_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.simple_message_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.simple_message_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}
  #shopify-section-{{ _sid }} .cart__progress-simple-track {
    width: 100%;
    height: {{ section.settings.simple_bar_height | default: 8 }}px;
    background-color: {{ section.settings.simple_track_color | default: '#ffffff' }};
    border-radius: {{ section.settings.simple_bar_radius | default: 999 }}px;
    overflow: hidden;
  }
  #shopify-section-{{ _sid }} .cart__progress-simple-fill {
    height: 100%;
    {%- comment -%}
      Two-color gradient fill — when the merchant leaves
      simple_fill_color_end blank we fall back to a solid fill so the
      single-color setting still works on its own. The gradient runs
      left → right so the start color shows immediately when the cart
      is below threshold; once unlocked the end color reads at the
      right edge as the "done" state.
    {%- endcomment -%}
    {%- if section.settings.simple_fill_color_end != blank -%}
      background: linear-gradient(
        {{ section.settings.simple_fill_angle | default: 90 }}deg,
        {{ section.settings.simple_fill_color | default: '#4A7599' }} 0%,
        {{ section.settings.simple_fill_color_end }} 100%
      );
    {%- else -%}
      background-color: {{ section.settings.simple_fill_color | default: '#4A7599' }};
    {%- endif -%}
    border-radius: {{ section.settings.simple_bar_radius | default: 999 }}px;
    transition: width 400ms ease;
  }

  /* ============ Trust badges ============ */
  #shopify-section-{{ _sid }} .cart__trust-badges {
    display: flex !important;
    flex-wrap: wrap;
    justify-content: {{ section.settings.trust_alignment | default: 'center' }} !important;
    align-items: center;
    text-align: center;
    gap: {{ section.settings.trust_gap | default: 24 }}px !important;
    padding: {{ section.settings.trust_pad_y | default: 8 }}px {{ section.settings.trust_pad_x | default: 16 }}px {{ section.settings.trust_pad_bottom | default: 16 }}px !important;
    {% if section.settings.trust_bg != blank %}background-color: {{ section.settings.trust_bg }};{% endif %}
  }
  #shopify-section-{{ _sid }} .cart__trust-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.trust_icon_gap | default: 8 }}px;
    {% if section.settings.trust_label_color != blank %}color: {{ section.settings.trust_label_color }} !important;{% endif %}
  }
  #shopify-section-{{ _sid }} .cart__trust-badge svg {
    width: {{ section.settings.trust_icon_size | default: 18 }}px !important;
    height: {{ section.settings.trust_icon_size | default: 18 }}px !important;
    flex-shrink: 0;
    {% if section.settings.trust_icon_color != blank %}stroke: {{ section.settings.trust_icon_color }} !important;{% endif %}
  }
  {% unless section.settings.trust_label_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__trust-badge .cart__trust-label {
      font-size: {{ section.settings.trust_label_size | default: 13 }}px !important;
      font-weight: {{ section.settings.trust_label_weight | default: 500 }} !important;
      text-transform: {{ section.settings.trust_label_transform | default: 'none' }} !important;
      letter-spacing: {{ section.settings.trust_label_spacing | default: '0em' }} !important;
      {% if section.settings.trust_label_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.trust_label_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.trust_label_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.trust_label_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}

  /* ============ Empty state ============ */
  #shopify-section-{{ _sid }} .cart__empty-message {
    {% if section.settings.empty_message_color != blank %}color: {{ section.settings.empty_message_color }} !important;{% endif %}
  }
  {% unless section.settings.empty_message_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__empty-message {
      font-size: {{ section.settings.empty_message_size | default: 16 }}px !important;
      font-weight: {{ section.settings.empty_message_weight | default: 400 }} !important;
      text-transform: {{ section.settings.empty_message_transform | default: 'none' }} !important;
      letter-spacing: {{ section.settings.empty_message_spacing | default: '0em' }} !important;
      {% if section.settings.empty_message_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.empty_message_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.empty_message_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.empty_message_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}

  /* ============ Footer / Subtotal ============ */
  {% if section.settings.cart_footer_bg != blank %}
  #shopify-section-{{ _sid }} aside {
    background-color: {{ section.settings.cart_footer_bg }} !important;
  }
  {% endif %}

  #shopify-section-{{ _sid }} .cart__subtotal-wrap {
    padding: {{ section.settings.subtotal_padding_y | default: 16 }}px {{ section.settings.subtotal_padding_x | default: 16 }}px !important;
    border-bottom-width: {% if section.settings.show_subtotal_divider %}1{% else %}0{% endif %}px !important;
  }
  #shopify-section-{{ _sid }} .cart__checkout-form {
    padding-top: {{ section.settings.footer_padding_top | default: 16 }}px !important;
    padding-bottom: {{ section.settings.footer_padding_bottom | default: 16 }}px !important;
    padding-left: {{ section.settings.footer_padding_x | default: 16 }}px !important;
    padding-right: {{ section.settings.footer_padding_x | default: 16 }}px !important;
  }

  {%- assign _ru = section.blocks | where: 'type', 'roundup_donation' | first -%}
  {% if _ru and _ru.settings.enable %}
  /* ============ Round-up donation ============ */
  #shopify-section-{{ _sid }} .cart__roundup {
    padding: {{ _ru.settings.pad_y | default: 10 }}px {{ _ru.settings.pad_x | default: 16 }}px !important;
    border-top-width: 1px;
  }
  #shopify-section-{{ _sid }} .cart__roundup-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #shopify-section-{{ _sid }} .cart__roundup-icon {
    flex: 0 0 auto;
    width: 28px; height: 28px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px;
    background: rgba(0,0,0,0.06);
    font-size: 14px; line-height: 1;
  }
  /* Main row text — applies to wrapper and cascades to span/strong inside */
  #shopify-section-{{ _sid }} .cart__roundup-text,
  #shopify-section-{{ _sid }} .cart__roundup-text > div,
  #shopify-section-{{ _sid }} .cart__roundup-text span,
  #shopify-section-{{ _sid }} .cart__roundup-text strong {
    font-size: {{ _ru.settings.main_font_size | default: 13 }}px !important;
    font-weight: {{ _ru.settings.main_font_weight | default: '400' }} !important;
    letter-spacing: {{ _ru.settings.main_letter_spacing | default: '0em' }} !important;
    text-transform: {{ _ru.settings.main_transform | default: 'none' }} !important;
    {% if _ru.settings.main_color != blank %}color: {{ _ru.settings.main_color }} !important;{% endif %}
  }
  #shopify-section-{{ _sid }} .cart__roundup-text {
    flex: 1 1 auto;
    line-height: 1.35;
    min-width: 0;
  }
  /* Learn more + Remove links — typography setting block */
  #shopify-section-{{ _sid }} .cart__roundup-learn,
  #shopify-section-{{ _sid }} .cart__roundup-remove {
    display: inline-block;
    margin-top: 2px;
    font-size: {{ _ru.settings.link_font_size | default: 12 }}px !important;
    font-weight: {{ _ru.settings.link_font_weight | default: '400' }} !important;
    letter-spacing: {{ _ru.settings.link_letter_spacing | default: '0em' }} !important;
    text-transform: {{ _ru.settings.link_transform | default: 'none' }} !important;
    {% if _ru.settings.link_color != blank %}color: {{ _ru.settings.link_color }} !important;{% else %}color: inherit;{% endif %}
    text-decoration: underline;
    cursor: pointer;
    background: none; border: 0; padding: 0;
    line-height: 1.2;
  }
  #shopify-section-{{ _sid }} .cart__roundup-remove {
    margin-top: 0; margin-left: 8px;
  }
  /* Toggle */
  #shopify-section-{{ _sid }} .cart__roundup-toggle {
    flex: 0 0 auto;
    position: relative;
    width: 40px; height: 22px;
    background: #cfcfcf;
    border-radius: 999px;
    border: 0; padding: 0; cursor: pointer;
    transition: background 200ms;
  }
  #shopify-section-{{ _sid }} .cart__roundup-toggle::before {
    content: ''; position: absolute;
    top: 2px; left: 2px;
    width: 18px; height: 18px;
    background: #fff;
    border-radius: 999px;
    transition: transform 200ms;
    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }
  #shopify-section-{{ _sid }} .cart__roundup-toggle.is-on {
    background: {{ _ru.settings.accent_color | default: '#000000' }} !important;
  }
  #shopify-section-{{ _sid }} .cart__roundup-toggle.is-on::before {
    transform: translateX(18px);
  }
  #shopify-section-{{ _sid }} .cart__roundup-toggle:disabled {
    opacity: 0.6; cursor: progress;
  }
  /* Inline collapse panel (Learn more) */
  #shopify-section-{{ _sid }} .cart__roundup-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 200ms ease, margin-top 200ms ease;
    margin-top: 0;
  }
  #shopify-section-{{ _sid }} .cart__roundup-panel.is-open {
    grid-template-rows: 1fr;
    margin-top: 10px;
  }
  #shopify-section-{{ _sid }} .cart__roundup-panel > div { overflow: hidden; }
  #shopify-section-{{ _sid }} .cart__roundup-panel-inner {
    padding: 12px;
    background: rgba(0,0,0,0.04);
    border-radius: 8px;
    display: flex; flex-direction: column; gap: 6px;
  }
  #shopify-section-{{ _sid }} .cart__roundup-panel-inner img {
    max-height: 28px; width: auto; object-fit: contain;
    align-self: flex-start;
  }
  /* Credibility badge */
  #shopify-section-{{ _sid }} .cart__roundup-credibility {
    font-size: {{ _ru.settings.credibility_font_size | default: 11 }}px !important;
    font-weight: {{ _ru.settings.credibility_font_weight | default: '400' }} !important;
    letter-spacing: {{ _ru.settings.credibility_letter_spacing | default: '0.05em' }} !important;
    text-transform: {{ _ru.settings.credibility_transform | default: 'uppercase' }} !important;
    {% if _ru.settings.credibility_color != blank %}color: {{ _ru.settings.credibility_color }} !important;{% else %}opacity: 0.7;{% endif %}
  }
  /* Mission */
  #shopify-section-{{ _sid }} .cart__roundup-mission {
    font-size: {{ _ru.settings.mission_font_size | default: 13 }}px !important;
    font-weight: {{ _ru.settings.mission_font_weight | default: '400' }} !important;
    line-height: {{ _ru.settings.mission_line_height | default: 1.4 }} !important;
    {% if _ru.settings.mission_color != blank %}color: {{ _ru.settings.mission_color }} !important;{% endif %}
  }
  /* Money-flow disclosure */
  #shopify-section-{{ _sid }} .cart__roundup-money {
    font-size: {{ _ru.settings.money_flow_font_size | default: 12 }}px !important;
    font-weight: {{ _ru.settings.money_flow_font_weight | default: '400' }} !important;
    {% if _ru.settings.money_flow_color != blank %}color: {{ _ru.settings.money_flow_color }} !important;{% else %}opacity: 0.75;{% endif %}
  }
  /* Website link */
  #shopify-section-{{ _sid }} .cart__roundup-link {
    font-size: {{ _ru.settings.url_font_size | default: 12 }}px !important;
    font-weight: {{ _ru.settings.url_font_weight | default: '400' }} !important;
    {% if _ru.settings.url_color != blank %}color: {{ _ru.settings.url_color }} !important;{% else %}color: inherit;{% endif %}
    text-decoration: underline;
  }
  {% endif %}

  /* Subtotal label */
  #shopify-section-{{ _sid }} .cart__subtotal-label,
  #shopify-section-{{ _sid }} .cart__tax-label {
    font-weight: {{ section.settings.cart_label_weight }} !important;
    text-transform: {{ section.settings.cart_label_transform }} !important;
    font-size: {{ section.settings.cart_label_size }}px !important;
  }
  #shopify-section-{{ _sid }} .cart__subtotal-label {
    {% if section.settings.subtotal_label_color != blank %}color: {{ section.settings.subtotal_label_color }} !important;{% endif %}
  }
  {% unless section.settings.subtotal_label_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__subtotal-label {
      {% if section.settings.subtotal_label_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.subtotal_label_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.subtotal_label_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.subtotal_label_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}
  #shopify-section-{{ _sid }} .cart__tax-label {
    {% if section.settings.tax_label_color != blank %}color: {{ section.settings.tax_label_color }} !important;{% endif %}
  }
  {% unless section.settings.tax_label_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__tax-label {
      {% if section.settings.tax_label_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.tax_label_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.tax_label_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.tax_label_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}

  /* Subtotal value */
  #shopify-section-{{ _sid }} .cart__subtotal-value {
    {% if section.settings.subtotal_value_color != blank %}color: {{ section.settings.subtotal_value_color }} !important;{% endif %}
  }
  {% unless section.settings.subtotal_value_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__subtotal-value {
      font-size: {{ section.settings.subtotal_value_size | default: 14 }}px !important;
      font-weight: {{ section.settings.subtotal_value_weight | default: 400 }} !important;
      {% if section.settings.subtotal_value_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.subtotal_value_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.subtotal_value_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.subtotal_value_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}

  /* Tax value ("Calculated at checkout") */
  #shopify-section-{{ _sid }} .cart__tax-value {
    {% if section.settings.tax_value_color != blank %}color: {{ section.settings.tax_value_color }} !important;{% endif %}
  }
  {% unless section.settings.tax_value_font contains 'token-' %}
    #shopify-section-{{ _sid }} .cart__tax-value {
      font-size: {{ section.settings.tax_value_size | default: 13 }}px !important;
      font-weight: {{ section.settings.tax_value_weight | default: 400 }} !important;
      text-transform: {{ section.settings.tax_value_transform | default: 'none' }} !important;
      letter-spacing: {{ section.settings.tax_value_spacing | default: '0em' }} !important;
      {% if section.settings.tax_value_font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if section.settings.tax_value_font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if section.settings.tax_value_font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if section.settings.tax_value_font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
  {% endunless %}

  /* ============ Checkout button ============
     Each property only emits when the merchant has explicitly set it,
     so the global theme-token defaults (button radius, font, weight, etc.)
     keep working when the per-section overrides are left blank / 0. */
  {% if section.settings.cart_checkout_bg != blank %}
    #shopify-section-{{ _sid }} button[name="checkout"],
    #shopify-section-{{ _sid }} form[action*="cart"] .btn:not(.cart__continue-btn):not(.cart__empty-button) {
      background-color: {{ section.settings.cart_checkout_bg }} !important;
      border-color: {{ section.settings.cart_checkout_bg }} !important;
      {% if section.settings.cart_checkout_text != blank %}color: {{ section.settings.cart_checkout_text }} !important;{% endif %}
    }
    {% if section.settings.cart_checkout_text != blank %}
      #shopify-section-{{ _sid }} button[name="checkout"] *,
      #shopify-section-{{ _sid }} form[action*="cart"] .btn:not(.cart__continue-btn):not(.cart__empty-button) * {
        color: {{ section.settings.cart_checkout_text }} !important;
      }
    {% endif %}
  {% endif %}
  #shopify-section-{{ _sid }} button[name="checkout"],
  #shopify-section-{{ _sid }} form[action*="cart"] .btn:not(.cart__continue-btn):not(.cart__empty-button) {
    {% if section.settings.cart_checkout_radius and section.settings.cart_checkout_radius > 0 %}border-radius: {{ section.settings.cart_checkout_radius }}px !important;{% endif %}
    {% if section.settings.cart_checkout_font_size and section.settings.cart_checkout_font_size > 0 %}font-size: {{ section.settings.cart_checkout_font_size }}px !important;{% endif %}
    {% if section.settings.cart_checkout_weight != blank %}font-weight: {{ section.settings.cart_checkout_weight }} !important;{% endif %}
    {% if section.settings.cart_checkout_transform != blank %}text-transform: {{ section.settings.cart_checkout_transform }} !important;{% endif %}
    {% if section.settings.cart_checkout_spacing != blank %}letter-spacing: {{ section.settings.cart_checkout_spacing }} !important;{% endif %}
    {% if section.settings.cart_checkout_pad_v and section.settings.cart_checkout_pad_v > 0 %}padding-top: {{ section.settings.cart_checkout_pad_v }}px !important; padding-bottom: {{ section.settings.cart_checkout_pad_v }}px !important;{% endif %}
  }
  /* Also target descendants because the button label sits inside .btn__content,
     and the global .btn--primary * rule sets font properties on descendants
     with !important — overriding our top-level rule unless we match the same
     specificity. */
  #shopify-section-{{ _sid }} button[name="checkout"] *,
  #shopify-section-{{ _sid }} form[action*="cart"] .btn:not(.cart__continue-btn):not(.cart__empty-button) * {
    {% if section.settings.cart_checkout_font_size and section.settings.cart_checkout_font_size > 0 %}font-size: {{ section.settings.cart_checkout_font_size }}px !important;{% endif %}
    {% if section.settings.cart_checkout_weight != blank %}font-weight: {{ section.settings.cart_checkout_weight }} !important;{% endif %}
    {% if section.settings.cart_checkout_transform != blank %}text-transform: {{ section.settings.cart_checkout_transform }} !important;{% endif %}
    {% if section.settings.cart_checkout_spacing != blank %}letter-spacing: {{ section.settings.cart_checkout_spacing }} !important;{% endif %}
  }

  /* ============ Continue shopping button ============ */
  {% if section.settings.continue_shopping_bg != blank %}
    #shopify-section-{{ _sid }} .cart__continue-btn {
      background-color: {{ section.settings.continue_shopping_bg }} !important;
      border-color: {{ section.settings.continue_shopping_bg }} !important;
      {% if section.settings.continue_shopping_text != blank %}color: {{ section.settings.continue_shopping_text }} !important;{% endif %}
    }
    {% if section.settings.continue_shopping_text != blank %}
      #shopify-section-{{ _sid }} .cart__continue-btn * { color: {{ section.settings.continue_shopping_text }} !important; }
    {% endif %}
  {% endif %}
  #shopify-section-{{ _sid }} .cart__continue-btn {
    {% if section.settings.continue_shopping_radius and section.settings.continue_shopping_radius > 0 %}border-radius: {{ section.settings.continue_shopping_radius }}px !important;{% endif %}
    {% if section.settings.continue_shopping_font_size and section.settings.continue_shopping_font_size > 0 %}font-size: {{ section.settings.continue_shopping_font_size }}px !important;{% endif %}
    {% if section.settings.continue_shopping_weight != blank %}font-weight: {{ section.settings.continue_shopping_weight }} !important;{% endif %}
    {% if section.settings.continue_shopping_transform != blank %}text-transform: {{ section.settings.continue_shopping_transform }} !important;{% endif %}
    {% if section.settings.continue_shopping_spacing != blank %}letter-spacing: {{ section.settings.continue_shopping_spacing }} !important;{% endif %}
    {% if section.settings.continue_shopping_pad_v and section.settings.continue_shopping_pad_v > 0 %}padding-top: {{ section.settings.continue_shopping_pad_v }}px !important; padding-bottom: {{ section.settings.continue_shopping_pad_v }}px !important;{% endif %}
  }
  /* Descendants — same reasoning as the checkout button rule above. */
  #shopify-section-{{ _sid }} .cart__continue-btn * {
    {% if section.settings.continue_shopping_font_size and section.settings.continue_shopping_font_size > 0 %}font-size: {{ section.settings.continue_shopping_font_size }}px !important;{% endif %}
    {% if section.settings.continue_shopping_weight != blank %}font-weight: {{ section.settings.continue_shopping_weight }} !important;{% endif %}
    {% if section.settings.continue_shopping_transform != blank %}text-transform: {{ section.settings.continue_shopping_transform }} !important;{% endif %}
    {% if section.settings.continue_shopping_spacing != blank %}letter-spacing: {{ section.settings.continue_shopping_spacing }} !important;{% endif %}
  }

  /* ============ Trifecta bundle (cart widget) — sync with PDP ============
   * Mirrors snippets/bundle__pdp-cta.liquid's per-element style block.
   * Each trifecta_* setting that drives a PDP class is re-emitted here
   * against the equivalent .cart__bundle-* class so the cart widget
   * reads identical to the PDP preview: slot label, product title,
   * product type line, price, Change hint, card outline, filter pills,
   * dropdown swatch name. Hardcoded font sizes / borders in
   * assets/bundle-builder.css are overridden by these rules because
   * this style block loads later. */
  /* Card outline */
  #shopify-section-{{ _sid }} .cart__bundle-item-button {
    border-width: {{ settings.trifecta_card_border_w | default: 1 }}px;
    {%- if settings.trifecta_card_border_color != blank %}border-color: {{ settings.trifecta_card_border_color }};{%- endif %}
    padding: 0 0 {{ settings.trifecta_card_pad | default: 8 }}px;
  }
  #shopify-section-{{ _sid }} .cart__bundle-item.is-active-dropdown .cart__bundle-item-button {
    {%- assign _cart_tri_active_w = settings.trifecta_card_border_w | default: 1 | plus: 1 -%}
    border-width: {{ _cart_tri_active_w }}px;
  }
  #shopify-section-{{ _sid }} .cart__bundle-item-img-wrap {
    margin-bottom: {{ settings.trifecta_card_gap | default: 6 }}px;
  }
  /* Slot label */
  #shopify-section-{{ _sid }} .cart__bundle-item-slot {
    margin-top: {{ settings.trifecta_slot_mt | default: 4 }}px;
    font-size: {{ settings.trifecta_slot_size_d | default: 11 }}px;
    font-weight: {{ settings.trifecta_slot_weight | default: '700' }};
    text-transform: {{ settings.trifecta_slot_transform | default: 'uppercase' }};
    letter-spacing: {{ settings.trifecta_slot_ls | default: '0.08em' }};
    opacity: 0.55;
    {%- case settings.trifecta_slot_font -%}
      {%- when 'body'        -%}font-family: var(--type-font-body-family);
      {%- when 'heading'     -%}font-family: var(--type-font-header-family);
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
    {%- endcase -%}
    {%- if settings.trifecta_slot_color != blank %}color: {{ settings.trifecta_slot_color }};{%- endif %}
  }
  @media (max-width: 749px) {
    #shopify-section-{{ _sid }} .cart__bundle-item-slot {
      font-size: {{ settings.trifecta_slot_size_m | default: 11 }}px;
    }
  }
  /* Product title (color name when shortName is on) */
  #shopify-section-{{ _sid }} .cart__bundle-item-title {
    margin-top: {{ settings.trifecta_itemtitle_mt | default: 2 }}px;
    font-size: {{ settings.trifecta_itemtitle_size_d | default: 12 }}px;
    font-weight: {{ settings.trifecta_itemtitle_weight | default: '500' }};
    text-transform: {{ settings.trifecta_itemtitle_transform | default: 'none' }};
    letter-spacing: {{ settings.trifecta_itemtitle_ls | default: '0em' }};
    {%- case settings.trifecta_itemtitle_font -%}
      {%- when 'body'        -%}font-family: var(--type-font-body-family);
      {%- when 'heading'     -%}font-family: var(--type-font-header-family);
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
    {%- endcase -%}
    {%- if settings.trifecta_itemtitle_color != blank %}color: {{ settings.trifecta_itemtitle_color }};{%- endif %}
  }
  @media (max-width: 749px) {
    #shopify-section-{{ _sid }} .cart__bundle-item-title {
      font-size: {{ settings.trifecta_itemtitle_size_m | default: 12 }}px;
    }
  }
  /* Product type line — same styling controls as PDP */
  #shopify-section-{{ _sid }} .cart__bundle-item-type {
    margin: {{ settings.trifecta_itemtype_mt | default: 1 }}px 0 0;
    padding-left: 6px;
    padding-right: 6px;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    opacity: 0.65;
    font-size: {{ settings.trifecta_itemtype_size_d | default: 11 }}px;
    font-weight: {{ settings.trifecta_itemtype_weight | default: '400' }};
    text-transform: {{ settings.trifecta_itemtype_transform | default: 'none' }};
    letter-spacing: {{ settings.trifecta_itemtype_ls | default: '0em' }};
    {%- case settings.trifecta_itemtype_font -%}
      {%- when 'body'        -%}font-family: var(--type-font-body-family);
      {%- when 'heading'     -%}font-family: var(--type-font-header-family);
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
    {%- endcase -%}
    {%- if settings.trifecta_itemtype_color != blank %}color: {{ settings.trifecta_itemtype_color }}; opacity: 1;{%- endif %}
  }
  @media (max-width: 749px) {
    #shopify-section-{{ _sid }} .cart__bundle-item-type {
      font-size: {{ settings.trifecta_itemtype_size_m | default: 11 }}px;
    }
  }
  /* Price */
  #shopify-section-{{ _sid }} .cart__bundle-item-price {
    margin-top: {{ settings.trifecta_itemprice_mt | default: 2 }}px;
    font-size: {{ settings.trifecta_itemprice_size_d | default: 12 }}px;
    font-weight: {{ settings.trifecta_itemprice_weight | default: '400' }};
    text-transform: {{ settings.trifecta_itemprice_transform | default: 'none' }};
    letter-spacing: {{ settings.trifecta_itemprice_ls | default: '0em' }};
    {%- case settings.trifecta_itemprice_font -%}
      {%- when 'body'        -%}font-family: var(--type-font-body-family);
      {%- when 'heading'     -%}font-family: var(--type-font-header-family);
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
    {%- endcase -%}
    {%- if settings.trifecta_itemprice_color != blank %}color: {{ settings.trifecta_itemprice_color }};{%- endif %}
  }
  @media (max-width: 749px) {
    #shopify-section-{{ _sid }} .cart__bundle-item-price {
      font-size: {{ settings.trifecta_itemprice_size_m | default: 12 }}px;
    }
  }
  /* Change hint (and its caret) — !important matches the PDP pattern
     because the static .cart__bundle-item-caret has a hardcoded font
     size that needs to scale with the merchant's hint size. */
  #shopify-section-{{ _sid }} .cart__bundle-item-change,
  #shopify-section-{{ _sid }} .cart__bundle-item-change * {
    margin-top: {{ settings.trifecta_hint_mt | default: 3 }}px;
    font-size: {{ settings.trifecta_hint_size_d | default: 11 }}px !important;
    font-weight: {{ settings.trifecta_hint_weight | default: '600' }} !important;
    {%- case settings.trifecta_hint_font -%}
      {%- when 'body'        -%}font-family: var(--type-font-body-family) !important;
      {%- when 'heading'     -%}font-family: var(--type-font-header-family) !important;
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family) !important;
    {%- endcase -%}
  }
  #shopify-section-{{ _sid }} .cart__bundle-item-change {
    text-transform: {{ settings.trifecta_hint_transform | default: 'uppercase' }};
    letter-spacing: {{ settings.trifecta_hint_ls | default: '0.05em' }};
    {%- if settings.trifecta_hint_color != blank %}color: {{ settings.trifecta_hint_color }};{%- endif %}
  }
  @media (max-width: 749px) {
    #shopify-section-{{ _sid }} .cart__bundle-item-change,
    #shopify-section-{{ _sid }} .cart__bundle-item-change * {
      font-size: {{ settings.trifecta_hint_size_m | default: 11 }}px !important;
    }
  }
  /* Filter pills */
  #shopify-section-{{ _sid }} .cart__bundle-type-tabs {
    gap: {{ settings.trifecta_dt_gap | default: 12 }}px !important;
  }
  #shopify-section-{{ _sid }} .cart__bundle-type-tab,
  #shopify-section-{{ _sid }} .cart__bundle-type-tab > * {
    font-size: {{ settings.trifecta_dt_size_d | default: 12 }}px !important;
    font-weight: {{ settings.trifecta_dt_weight | default: '700' }} !important;
    text-transform: {{ settings.trifecta_dt_transform | default: 'none' }} !important;
    letter-spacing: {{ settings.trifecta_dt_ls | default: '0em' }} !important;
    {%- case settings.trifecta_dt_font -%}
      {%- when 'body'        -%}font-family: var(--type-font-body-family) !important;
      {%- when 'heading'     -%}font-family: var(--type-font-header-family) !important;
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family) !important;
    {%- endcase -%}
    {%- if settings.trifecta_dt_color != blank %}color: {{ settings.trifecta_dt_color }} !important;{%- endif %}
  }
  #shopify-section-{{ _sid }} .cart__bundle-type-tab {
    padding: {{ settings.trifecta_dt_pad_v | default: 8 }}px {{ settings.trifecta_dt_pad_h | default: 12 }}px !important;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ _sid }} .cart__bundle-type-tab,
    #shopify-section-{{ _sid }} .cart__bundle-type-tab > * {
      font-size: {{ settings.trifecta_dt_size_m | default: 12 }}px !important;
    }
  }
  #shopify-section-{{ _sid }} .cart__bundle-type-tab.is-active,
  #shopify-section-{{ _sid }} .cart__bundle-type-tab.is-active > * {
    {%- if settings.trifecta_dt_active_bg    != blank %}background: {{ settings.trifecta_dt_active_bg }} !important; border-color: {{ settings.trifecta_dt_active_bg }} !important;{%- endif %}
    {%- if settings.trifecta_dt_active_color != blank %}color: {{ settings.trifecta_dt_active_color }} !important;{%- endif %}
  }
  /* Dropdown swatch color name */
  #shopify-section-{{ _sid }} .cart__bundle-swatch-name {
    font-size: 12px;
    font-weight: {{ settings.trifecta_dn_weight | default: '400' }};
    text-transform: {{ settings.trifecta_dn_transform | default: 'none' }};
    letter-spacing: 0.05em;
    {%- case settings.trifecta_dn_font -%}
      {%- when 'body'        -%}font-family: var(--type-font-body-family);
      {%- when 'heading'     -%}font-family: var(--type-font-header-family);
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
    {%- endcase -%}
    {%- if settings.trifecta_dn_color != blank %}color: {{ settings.trifecta_dn_color }};{%- endif %}
  }
  /* Slot label override: match the same .is-this neutralization the
     PDP card uses so the "current" slot's label doesn't read darker
     than the other two. */
  #shopify-section-{{ _sid }} .cart__bundle-item.is-this .cart__bundle-item-slot {
    opacity: 0.55;
    color: inherit;
  }

  /* ============ Cart upsells ============
   * Wrapper class `.cart__upsells` set in the markup just above the
   * upsell loop. All rules scoped via #shopify-section-X so they
   * don't bleed into other cart UI. Stack vs carousel toggled via
   * `--stack` / `--carousel` modifier classes on the list element.
   */
  #shopify-section-{{ _sid }} .cart__upsells {
    padding: {{ section.settings.cart_upsell_pad_v | default: 0 }}px {{ section.settings.cart_upsell_pad_h | default: 0 }}px;
    {%- if section.settings.cart_upsell_bg != blank %}background: {{ section.settings.cart_upsell_bg }};{%- endif %}
  }
  /* Pin to bottom: sticks the upsells block to the bottom edge of
   * the cart drawer's scrolling content area, just above whatever
   * follows it (notes / share / subtotal). z-index keeps it above
   * line items as the customer scrolls. */
  #shopify-section-{{ _sid }} .cart__upsells--pinned {
    position: sticky;
    bottom: 0;
    z-index: 5;
    {%- if section.settings.cart_upsell_bg != blank -%}
    background: {{ section.settings.cart_upsell_bg }};
    {%- else -%}
    background: var(--color-body-background-light, #ffffff);
    {%- endif -%}
  }

  /* Header row — heading + collapse chevron on the same line.
   * The whole row is a button so tapping anywhere collapses /
   * expands the upsells list. */
  #shopify-section-{{ _sid }} .cart__upsells-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: transparent;
    border: 0;
    padding: 0 16px;
    margin: 0 0 {{ section.settings.cart_upsell_heading_mb | default: 8 }}px;
    cursor: pointer;
    text-align: {{ section.settings.cart_upsell_heading_align | default: 'left' }};
    color: inherit;
  }
  #shopify-section-{{ _sid }} .cart__upsells-heading {
    display: inline-block;
    line-height: 1.3;
    font-size: {{ section.settings.cart_upsell_heading_size | default: 14 }}px;
    font-weight: {{ section.settings.cart_upsell_heading_weight | default: '600' }};
    text-transform: {{ section.settings.cart_upsell_heading_transform | default: 'uppercase' }};
    letter-spacing: {{ section.settings.cart_upsell_heading_ls | default: '0.05em' }};
    text-align: {{ section.settings.cart_upsell_heading_align | default: 'left' }};
    {%- case section.settings.cart_upsell_heading_font -%}
      {%- when 'body'        -%}font-family: var(--type-font-body-family);
      {%- when 'heading'     -%}font-family: var(--type-font-header-family);
      {%- when 'nav'         -%}font-family: var(--type-font-nav-family);
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
    {%- endcase -%}
    {%- if section.settings.cart_upsell_heading_color != blank %}color: {{ section.settings.cart_upsell_heading_color }};{%- endif %}
  }
  #shopify-section-{{ _sid }} .cart__upsells-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    opacity: 0.65;
    transition: transform 0.2s ease, opacity 0.15s ease;
  }
  #shopify-section-{{ _sid }} .cart__upsells-header:hover .cart__upsells-chevron { opacity: 1; }
  #shopify-section-{{ _sid }} .cart__upsells-chevron.is-open {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* Stack layout — default, one card per row */
  #shopify-section-{{ _sid }} .cart__upsells-list--stack {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.cart_upsell_item_gap | default: 0 }}px;
  }

  /* Carousel layout — horizontal scroll, column-flow grid mirroring
   * the Related Styles pattern. The merchant sets visible columns
   * (cols) and creep (% of next column that should peek past the
   * right edge). The card width is computed so cols + creep/100
   * cards fit the visible viewport minus the inter-card gap. */
  {%- assign _up_cols_d  = section.settings.cart_upsell_cols_d  | default: 1 -%}
  {%- assign _up_cols_m  = section.settings.cart_upsell_cols_m  | default: 1 -%}
  {%- assign _up_creep_d = section.settings.cart_upsell_creep_d | default: 20 -%}
  {%- assign _up_creep_m = section.settings.cart_upsell_creep_m | default: 20 -%}
  {%- assign _up_gap     = section.settings.cart_upsell_item_gap | default: 8 -%}
  #shopify-section-{{ _sid }} .cart__upsells-list--carousel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - ({{ _up_cols_m | minus: 1 }} * {{ _up_gap }}px)) / ({{ _up_cols_m }} + {{ _up_creep_m }} / 100));
    gap: {{ _up_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    padding: 0 16px;
  }
  #shopify-section-{{ _sid }} .cart__upsells-list--carousel::-webkit-scrollbar {
    display: none;
  }
  #shopify-section-{{ _sid }} .cart__upsells-list--carousel .cart__upsells-item {
    scroll-snap-align: start;
    min-width: 0;
  }
  @media (min-width: 750px) {
    #shopify-section-{{ _sid }} .cart__upsells-list--carousel {
      grid-auto-columns: calc((100% - ({{ _up_cols_d | minus: 1 }} * {{ _up_gap }}px)) / ({{ _up_cols_d }} + {{ _up_creep_d }} / 100));
    }
  }
  /* Card visual — corner radius + clip the children to it. In
   * carousel mode the bottom border is hidden since each card is
   * its own visual unit; in stack mode it stays. */
  #shopify-section-{{ _sid }} .cart__upsells-card {
    border-radius: {{ section.settings.cart_upsell_card_radius | default: 0 }}px;
    overflow: hidden;
  }
  #shopify-section-{{ _sid }} .cart__upsells-list--carousel .cart__upsells-card {
    border-bottom-width: 0 !important;
  }

  /* Image column width — overrides the component's hardcoded w-[20%]
   * tailwind utility. The image inside stretches to fill. */
  #shopify-section-{{ _sid }} .cart__upsells-card > div:first-child {
    width: {{ section.settings.cart_upsell_image_width | default: 20 }}% !important;
    flex-shrink: 0;
  }

  /* Image-to-content horizontal padding — overrides the
   * component's hardcoded `pl-6` (24px) Tailwind utility on the
   * content column. Setting this controls the gap between the
   * image column on the left and the title/price/button on the
   * right. Same selector also sets padding-right, which is what
   * pushes the Add button in from the card's right edge. */
  #shopify-section-{{ _sid }} .cart__upsells-card > div:nth-child(2) {
    padding-left: {{ section.settings.cart_upsell_title_pad_h | default: 24 }}px !important;
    padding-right: {{ section.settings.cart_upsell_button_pad_h | default: 16 }}px !important;
  }

  /* Product title typography — targets the first <p> in each card,
   * scoped tightly so we only style upsell-item titles. !important
   * beats the theme's generic `type__nav *` cascading rules. */
  #shopify-section-{{ _sid }} .cart__upsells-card .grow > p:first-child,
  #shopify-section-{{ _sid }} .cart__upsells-card .grow > p:first-child * {
    font-size: {{ section.settings.cart_upsell_title_size | default: 14 }}px !important;
    font-weight: {{ section.settings.cart_upsell_title_weight | default: '500' }} !important;
    text-transform: {{ section.settings.cart_upsell_title_transform | default: 'none' }} !important;
    letter-spacing: {{ section.settings.cart_upsell_title_ls | default: '0em' }} !important;
    {%- case section.settings.cart_upsell_title_font -%}
      {%- when 'body'        -%}font-family: var(--type-font-body-family) !important;
      {%- when 'heading'     -%}font-family: var(--type-font-header-family) !important;
      {%- when 'nav'         -%}font-family: var(--type-font-nav-family) !important;
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family) !important;
    {%- endcase -%}
    {%- if section.settings.cart_upsell_title_color != blank %}color: {{ section.settings.cart_upsell_title_color }} !important;{%- endif %}
  }

  /* Title→Price vertical gap — applied as margin-top on the price
   * block so the spacing sits below the title (or below the
   * tagline if one is rendered between). */
  #shopify-section-{{ _sid }} .cart__upsells-card .grow > p:nth-of-type(2) {
    margin-top: {{ section.settings.cart_upsell_title_to_price_gap | default: 0 }}px !important;
  }

  /* Price block — current price and the line-through compare-at
   * BOTH inherit the merchant's cart_upsell_price_weight so they
   * read as a matched pair. Compare-at can still have its own size
   * + color via cart_upsell_compare_size / cart_upsell_compare_color. */
  #shopify-section-{{ _sid }} .cart__upsells-card .grow > p:nth-of-type(2),
  #shopify-section-{{ _sid }} .cart__upsells-card .grow > p:nth-of-type(2) span {
    font-size: {{ section.settings.cart_upsell_price_size | default: 12 }}px !important;
    font-weight: {{ section.settings.cart_upsell_price_weight | default: '500' }} !important;
  }
  #shopify-section-{{ _sid }} .cart__upsells-card .grow > p:nth-of-type(2) > span:not(.line-through) {
    {%- if section.settings.cart_upsell_price_color != blank %}color: {{ section.settings.cart_upsell_price_color }} !important;{%- endif %}
  }
  #shopify-section-{{ _sid }} .cart__upsells-card .grow > p:nth-of-type(2) > span.line-through {
    font-size: {{ section.settings.cart_upsell_compare_size | default: 12 }}px !important;
    /* compare-at weight intentionally matches the current price's
     * weight per merchant request — no separate setting. */
    {%- if section.settings.cart_upsell_compare_color != blank %}color: {{ section.settings.cart_upsell_compare_color }} !important;{%- endif %}
  }

  /* Add button — kill the legacy hover shadow + scale on press so
   * the button behaves like the rest of the current theme buttons.
   * The merchant's chosen variant (.btn--primary / .btn--secondary
   * / etc.) provides the bg + text color from the theme tokens. */
  #shopify-section-{{ _sid }} .cart__upsells-card .btn,
  #shopify-section-{{ _sid }} .cart__upsells-card .btn:hover,
  #shopify-section-{{ _sid }} .cart__upsells-card .btn:focus,
  #shopify-section-{{ _sid }} .cart__upsells-card .btn:active,
  #shopify-section-{{ _sid }} .cart__upsells-card .btn--load,
  #shopify-section-{{ _sid }} .cart__upsells-card .btn--load:hover,
  #shopify-section-{{ _sid }} .cart__upsells-card .btn--load:active {
    box-shadow: none !important;
    transform: none !important;
    text-decoration: none !important;
  }

  /* Optional merchant typography overrides on the Add button. Each
   * field falls back to the variant's theme defaults when blank/0. */
  #shopify-section-{{ _sid }} .cart__upsells-card .btn,
  #shopify-section-{{ _sid }} .cart__upsells-card .btn .btn__content,
  #shopify-section-{{ _sid }} .cart__upsells-card .btn * {
    {% if section.settings.cart_upsell_button_size and section.settings.cart_upsell_button_size > 0 %}font-size: {{ section.settings.cart_upsell_button_size }}px !important;{% endif %}
    {% if section.settings.cart_upsell_button_weight != blank %}font-weight: {{ section.settings.cart_upsell_button_weight }} !important;{% endif %}
    {% if section.settings.cart_upsell_button_transform != blank %}text-transform: {{ section.settings.cart_upsell_button_transform }} !important;{% endif %}
    {% if section.settings.cart_upsell_button_ls != blank %}letter-spacing: {{ section.settings.cart_upsell_button_ls }} !important;{% endif %}
    {% if section.settings.cart_upsell_button_color != blank %}color: {{ section.settings.cart_upsell_button_color }} !important;{% endif %}
  }

  /* ============ Trifecta bundle promo banner ============ */
  #shopify-section-{{ _sid }} .cart__trifecta-promo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    margin: 8px 12px;
    border: 1px dashed currentColor;
    border-radius: 8px;
    background: var(--color-bg-overlay-1, rgba(0, 0, 0, 0.04));
  }
  #shopify-section-{{ _sid }} .cart__trifecta-promo-text > * {
    margin: 0;
    font-size: 0.95em;
    line-height: 1.4;
  }
  #shopify-section-{{ _sid }} .cart__trifecta-promo-cta {
    align-self: flex-start;
  }

</style>

{% comment %} Cart alert {% endcomment %}
{% capture alert_content %}
  {% comment %} Title {% endcomment %}
  <div class="flex flex-wrap justify-between items-center mb-4">
    <p class="flex items-center mb-0">
      {% render 'component__icon', icon: 'check', size: '24', class: 'mr-1' %} {{ 'cart.general.updated' | t }} (<span x-text="cart.item_count"></span>)
    </p>
    <div class="flex">
      <button class="btn--close-dark btn--smaller !pr-0"
        title="{{ 'general.navigation.close' | t }}"
        @click="cart_alert = false">
        {% render 'component__icon', icon: 'x', size: '24', class: '' %}
      </button>
    </div>
  </div>

  {% comment %} Cart button {% endcomment %}
  <button class="btn btn--small btn--plain !w-full mb-2"
    @click="
      cart_drawer = true;
      cart_alert = false;
    ">
    {{ 'cart.general.view_cart' | t }}
  </button>

  {% comment %} Checkout button {% endcomment %}
  <button 
    class="btn btn--small btn--primary !w-full mb-2" 
    @click="
      checkout_button_loading = true; 
      setTimeout(function(){ 
        checkout_button_loading = false
      }, 5000); 
      window.location.href = '/checkout';
    ">
    {{ 'cart.general.checkout' | t }} {% if settings.type_seperator == 'dot' %}·{% else %}|{% endif %} <span class="ml-1 type__nav" x-text="Shopify.formatMoney(cart.total_price, '{{ cart.currency.symbol }}')"></span>
  </button>
{% endcapture %}

{% comment %} Cart drawer {% endcomment %}
<section
  class="overflow-hidden fixed inset-0 z-50"
  x-show="cart_drawer"
  x-cloak
>
  <div class="overflow-hidden absolute inset-0">
    <div
      class="absolute inset-0 bg-black bg-opacity-50"
      aria-hidden="true"
      x-show="cart_drawer"
      {% if settings.enable_animations %}
        x-transition:enter="animation-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="animation-300"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
      {% endif %}
      x-cloak
    >
      <div
        class="cart__fixed-wrap flex fixed inset-y-0 right-0 max-w-full"
        x-trap="cart_drawer"
        x-show="cart_drawer"
        x-init="
          cart.shipping_gap_tier1 = Math.max(0, {{ section.settings.progress_bar_tier1 | times: 100 }} - cart.total_price);
        "
        {% if settings.enable_animations %}
          x-transition:enter="animation-300 opacity-0"
          x-transition:enter-start="translate-x-8 opacity-0"
          x-transition:enter-end="translate-x-0 opacity-100"
          x-transition:leave="animation-300 opacity-100"
          x-transition:leave-start="translate-x-0 opacity-100"
          x-transition:leave-end="translate-x-8 opacity-0"
        {% endif %}
        @click.outside="cart_drawer = false;"
        x-cloak
      >
        <div class="cart__panel w-screen max-w-full md:max-w-md">
          <div
            class="cart__panel-inner flex flex-col h-full shadow-xl color__bg-body"
            action="{{ routes.cart_url }}"
            method="post"
          >
            {%- comment -%} Top bar {%- endcomment -%}
            <section
              class="
                cart__header border--b-width color__border-selected-2 flex flex-wrap items-center justify-center px-4 sticky top-0 h-[56px]
                {{ section.settings.top_color_scheme }}
                {{ section.settings.top_color_border }}
              "
            >
              <div class="cart__header-title text-center normal-case type__nav{% if header_title_token_class != '' %} {{ header_title_token_class }}{% endif %}">
                {%- if section.settings.header_title_text != blank -%}
                  {{ section.settings.header_title_text }}
                {%- else -%}
                  {{ 'cart.general.title' | t }}
                {%- endif -%}
                <span x-show="cart.item_count > 0" x-cloak> (<span x-text="cart.item_count"></span>) </span>
              </div>
              {%- assign _close_icon_size = section.settings.header_close_icon_size | default: 24 -%}
              <div class="cart__close-wrap absolute right-4">
                <button
                  class="cart__close-btn btn--smaller color__light !pr-0 !bg-transparent !border-0"
                  title="{{ 'general.navigation.close' | t }}"
                  @click="cart_drawer = false;"
                >
                  {% render 'component__icon', icon: 'x', size: _close_icon_size, class: '' %}
                </button>
              </div>
            </section>

            {%- comment -%} Cart {%- endcomment -%}
            <section
              class="flex overflow-y-auto overflow-x-hidden flex-col flex-grow"
              x-data="
                {
                  scroll: false,
                  animate_index: 0,
                  animate_delay: 0,
                  shipping_protection: false,

                  /* True once snippets/bundle__eligibility-data.liquid has
                   * finished fetching the full handle-to-slot map. Auto-
                   * combine bails until this flips so a stale eligibility
                   * snapshot doesn't pre-emptively bundle the cart. */
                  bundleEligibilityReady: false,

                  /* Bundle grouping + edit/remove handlers.
                   * Takes the raw cart.items array and returns a display
                   * array where items sharing a _bundle_id property are
                   * collapsed into a single 'lead' row carrying its
                   * siblings under __bundleGroup. __bundleType comes from
                   * _bundle_type (market_tote) or defaults to trifecta for
                   * legacy Trifecta lines that only set _bundle_id. */
                  bundleGroups(items) {
                    var seen = {};
                    var out = [];
                    (items || []).forEach(function(it) {
                      var bid = it.properties && it.properties._bundle_id;
                      if (!bid) { out.push(Object.assign({}, it, { __bundleLead: false })); return; }
                      if (seen[bid]) return;
                      seen[bid] = true;
                      var group = items.filter(function(x){ return x.properties &amp;&amp; x.properties._bundle_id === bid; });
                      var lineKeys = group.map(function(g){ return g.key; }).join('|');
                      var bundleType = (group[0].properties &amp;&amp; group[0].properties._bundle_type) || 'trifecta';
                      out.push(Object.assign({}, group[0], {
                        __bundleLead: true,
                        __bundleGroup: group,
                        __bundleType: bundleType,
                        __bundleKey: 'bundle:' + bid + ':' + lineKeys
                      }));
                    });
                    return out;
                  },

                  formatBundleTotal(group) {
                    var sum = (group || []).reduce(function(acc, i){ return acc + (i.line_price || 0); }, 0);
                    if (window.Shopify &amp;&amp; window.Shopify.formatMoney) {
                      return window.Shopify.formatMoney(sum, '{{ cart.currency.symbol }}');
                    }
                    return '$' + (sum / 100).toFixed(2);
                  },

                  /* editBundle() was removed when bundle__cart-group.liquid
                   * moved to inline-edit (per-row dropdown + swatch picker).
                   * The widget now handles swaps via the bundleCartEdit
                   * factory in bundle__cart-edit-data.liquid. */

                  removeBundle(group) {
                    var rootScope = (window.Alpine &amp;&amp; document.body) ? window.Alpine.$data(document.body) : null;
                    if (!rootScope || typeof rootScope.changeCartItemQuantity !== 'function') return;
                    var keys = (group || []).map(function(it){ return it.key; });
                    keys.reduce(function(chain, key) {
                      return chain.then(function() {
                        return rootScope.changeCartItemQuantity(key, 0, false, false);
                      });
                    }, Promise.resolve()).then(function() {
                      if (typeof rootScope.updateCart === 'function') rootScope.updateCart(false);
                    });
                  },

                  /* Trifecta cart upsell: detect partial AND complete
                   * bundles in cart.
                   *
                   * Uses window.__trifectaEligibility (built async by
                   * snippets/bundle__eligibility-data.liquid from the live
                   * /collections/<handle>/products.json data) so the lookup
                   * isn't capped at Shopify Liquid's 50-product limit.
                   * Falls back to the original Liquid product-id list
                   * before the fetch resolves. */
                  get bundleEligibilityMap() {
                    return window.__trifectaEligibility || null;
                  },

                  get cartBundleStatus() {
                    var defaultStatus = { filled: [], missing: [], eligibleItems: [], complete: false };
                    var map = this.bundleEligibilityMap;
                    if (!map) return defaultStatus;
                    var slots = ['Wallet', 'Lanyard', 'Chapstick'];
                    var filled = {};
                    var eligibleItems = [];
                    (cart.items || []).forEach(function(it) {
                      // Already-bundled items shouldn't trigger the upsell.
                      if (it.properties &amp;&amp; it.properties._bundle_id) return;
                      var slot = null;
                      for (var i = 0; i < slots.length; i++) {
                        var s = slots[i];
                        var bucket = map[s] || {};
                        if (bucket.byHandle &amp;&amp; bucket.byHandle[it.handle]) { slot = s; break; }
                        if (bucket.byProductId &amp;&amp; bucket.byProductId[it.product_id]) { slot = s; break; }
                      }
                      if (!slot || filled[slot]) return;
                      filled[slot] = true;
                      eligibleItems.push({
                        slotLabel: slot,
                        handle: it.handle,
                        key: it.key,
                        variantId: it.variant_id
                      });
                    });
                    var filledList = slots.filter(function(s){ return filled[s]; });
                    return {
                      filled: filledList,
                      missing: slots.filter(function(s){ return !filled[s]; }),
                      eligibleItems: eligibleItems,
                      complete: filledList.length === 3
                    };
                  },

                  /* Reactive auto-combine trigger. Wired via x-effect on
                   * the cart section element. Re-fires whenever cart.items
                   * or bundleEligibilityReady changes. The window-scoped
                   * guard is intentionally non-reactive so flipping it
                   * doesn't re-trigger this effect. */
                  maybeAutoCombineTrifecta() {
                    if (!this.bundleEligibilityReady) return;
                    if (this.cart_loading) return;
                    if (window.__trifectaCombining) return;
                    if (!this.cartBundleStatus.complete) return;
                    window.__trifectaCombining = true;
                    this.combineCartIntoBundle();
                  },

                  /* All 3 trifecta types in cart as individual lines →
                   * convert them to a Trifecta Bundle (adds _bundle_id +
                   * Bundle Slot properties), apply discount code. */
                  combineCartIntoBundle() {
                    var status = this.cartBundleStatus;
                    if (!status.complete) return;
                    if (this.cart_loading) return;
                    this.cart_loading = true;
                    var eligible = status.eligibleItems.slice(0, 3);
                    var bundleId = 'tri_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
                    var self = this;
                    var discountCode = (window.__trifectaEligibility &amp;&amp; window.__trifectaEligibility.discountCode) || '';

                    // Order: ADD bundled lines first, THEN remove the
                    // original unbundled lines. If the add fails partway,
                    // the original cart is intact. Matches the safe order
                    // used by removeSlot.
                    var addItems = eligible.map(function(eli){
                      return {
                        id: eli.variantId,
                        quantity: 1,
                        properties: {
                          'Bundle Slot': eli.slotLabel,
                          '_bundle_id': bundleId
                        }
                      };
                    });
                    fetch(window.Shopify.routes.root + 'cart/add.js', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                      body: JSON.stringify({ items: addItems })
                    })
                    .then(function(r){
                      if (!r.ok) throw new Error('cart/add.js failed: ' + r.status);
                      return r.json();
                    })
                    .then(function(){
                      return eligible.reduce(function(chain, eli){
                        return chain.then(function(){
                          return fetch(window.Shopify.routes.root + 'cart/change.js', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id: eli.key, quantity: 0 })
                          });
                        });
                      }, Promise.resolve());
                    })
                    .then(function(){
                      /* Fire-and-forget discount attach so it doesn't
                       * block the cart refresh below. /discount/<code>
                       * only sets a session cookie — the cart drawer
                       * display is identical whether the code is
                       * attached or not (the discount applies at
                       * checkout), so the customer doesn't see any
                       * stale state by not awaiting it. */
                      if (discountCode) {
                        fetch('/discount/' + encodeURIComponent(discountCode), {
                          method: 'GET',
                          credentials: 'same-origin'
                        }).catch(function(){});
                      }
                      window.__trifectaCombining = false;
                      self.updateCart(false);
                    })
                    .catch(function(err){
                      console.error('[trifecta-combine]', err);
                      window.__trifectaCombining = false;
                      self.cart_loading = false;
                      self.updateCart(false);
                    });
                  },

                  startBundleUpsell(eligibleItems) {
                    if (!eligibleItems || !eligibleItems.length) return;
                    /* Navigate to the trifecta page with the customer's
                     * existing cart picks encoded as URL params, plus
                     * the line item keys to remove on successful add.
                     * The trifecta page's wizard reads these on init().
                     *
                     * Drawer-based prefill was attempted first but
                     * unreliable when the section-render fetch can't
                     * carry preview_theme_id forward. Navigation also
                     * preserves any preview/locale params on the URL. */
                    var rootScope = (window.Alpine &amp;&amp; document.body) ? window.Alpine.$data(document.body) : null;
                    if (rootScope) rootScope.cart_drawer = false;
                    try {
                      var u = new URL('/pages/build-your-trifecta', window.location.origin);
                      var current = new URLSearchParams(window.location.search);
                      current.forEach(function(v, k) { u.searchParams.set(k, v); });
                      eligibleItems.forEach(function(it) {
                        if (it &amp;&amp; it.slotLabel &amp;&amp; it.handle) {
                          u.searchParams.set('slot_' + it.slotLabel.toLowerCase(), it.handle);
                        }
                      });
                      var keys = eligibleItems.map(function(it){ return it.key; }).filter(Boolean);
                      if (keys.length) u.searchParams.set('replace_keys', keys.join(','));
                      window.location.href = u.toString();
                    } catch (e) {
                      console.error('[trifecta-upsell]', e);
                      window.location.href = '/pages/build-your-trifecta';
                    }
                  }
                }
              "
              x-init="
                if (window.__trifectaEligibility &amp;&amp; window.__trifectaEligibility.ready) bundleEligibilityReady = true;
                window.addEventListener('trifecta-eligibility-ready', () => { bundleEligibilityReady = true; });
              "
              x-effect="$nextTick(() => maybeAutoCombineTrifecta())"
              @scroll.throttle="scroll = true"
