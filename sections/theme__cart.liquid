                Wrapped in `.cart__upsells` so the scoped CSS block
                higher up in this file can style the heading, item
                title, price, and Add button with merchant settings
                without touching the shared component snippet.

                Collapsible: a chevron next to the heading toggles
                an Alpine `upsellsOpen` state. Default open/closed
                is merchant-controlled via cart_upsell_default_open.

                Pin to bottom: when cart_upsell_pin_bottom is on,
                the outer wrapper gets `cart__upsells--pinned` which
                applies `position: sticky; bottom: 0` so the section
                sticks to the bottom of the cart drawer's scroll
                area, just above the subtotal / CTA region.
              {% endcomment %}
              <div class="flex flex-wrap">
                {%- if section.settings.cart_upsell_products != blank -%}
                  {%- if collections[section.settings.cart_upsell_products].products.size > 0 -%}
                    {%- assign _upsell_layout = section.settings.cart_upsell_layout | default: 'stack' -%}
                    {%- assign _upsell_btn_variant = section.settings.cart_upsell_button_variant | default: 'secondary' -%}
                    {%- assign _upsell_btn_class = 'btn--' | append: _upsell_btn_variant -%}
                    {%- assign _upsell_default_open = true -%}
                    {%- if section.settings.cart_upsell_default_open == false -%}{%- assign _upsell_default_open = false -%}{%- endif -%}
                    <div
                      class="cart__upsells w-full{% if section.settings.cart_upsell_pin_bottom %} cart__upsells--pinned{% endif %}"
                      data-cart-upsells
                      x-data="{ upsellsOpen: {{ _upsell_default_open }} }">
                      {%- if section.settings.cart_upsell_heading != blank -%}
                        <button
                          type="button"
                          class="cart__upsells-header"
                          :aria-expanded="upsellsOpen ? 'true' : 'false'"
                          @click="upsellsOpen = !upsellsOpen">
                          <span class="cart__upsells-heading">{{ section.settings.cart_upsell_heading }}</span>
                          <span class="cart__upsells-chevron" :class="{ 'is-open': upsellsOpen }" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                              <path d="M3 5.5L7 9.5L11 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                        </button>
                      {%- endif -%}
                      <div class="cart__upsells-list cart__upsells-list--{{ _upsell_layout }}"
                        data-cart-upsells-list
                        x-show="upsellsOpen"
                        x-cloak>
                        {% for product in collections[section.settings.cart_upsell_products].products limit: 5 %}
                          <div class="cart__upsells-item">
                            {% render 'component__upsell-cart-item',
                              product: product,
                              inner_class: 'cart__upsells-card border--b-width color__bg-overlay-1 color__border-divider-1',
                              content_class: '',
                              button_class: _upsell_btn_class,
                              index: forloop.index0
                            %}
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                    <script>
                      /* Hide any upsell tile whose product is already in the
                         cart (e.g. a mystery product the customer just added)
                         and restore it when the product is removed.

                         The bundled updateCart() resets ALL .js:cartUpsell
                         tiles to display:flex on every cart change, then
                         hides only zero-price matches (the free-gift logic).
                         It dispatches cart:updated BEFORE that reset, so this
                         pass defers via setTimeout(0) to land last. Restore-
                         on-remove is free: the reset un-hides everything and
                         this pass simply doesn't re-hide tiles that no longer
                         match. The .cart__upsells-item wrapper is hidden
                         along with the tile so carousel mode doesn't keep an
                         empty grid cell; only this pass ever touches the
                         wrapper. */
                      (function () {
                        if (window.__csUpsellVisibilityInstalled) return;
                        window.__csUpsellVisibilityInstalled = true;

                        function applyVisibility(items) {
                          if (!Array.isArray(items)) return;
                          var pids = {}, vids = {};
                          items.forEach(function (it) {
                            if (!it) return;
                            if (it.product_id != null) pids[String(it.product_id)] = true;
                            if (it.variant_id != null) vids[String(it.variant_id)] = true;
                          });
                          var tiles = document.querySelectorAll('.js\\:cartUpsell');
                          tiles.forEach(function (tile) {
                            var pidEl = tile.querySelector('[data-product-id]');
                            var pid = pidEl ? String(pidEl.getAttribute('data-product-id')) : '';
                            var vid = (tile.id || '').indexOf('upsell_') === 0 ? tile.id.slice(7) : '';
                            var inCart = (pid && pids[pid]) || (vid && vids[vid]);
                            var wrap = tile.closest('.cart__upsells-item');
                            if (inCart) {
                              tile.style.display = 'none';
                              if (wrap) wrap.style.display = 'none';
                            } else if (wrap) {
                              /* Only restore the wrapper here — the tile's own
                                 display is managed by updateCart (flex reset +
                                 free-gift hiding), which already ran. */
                              wrap.style.display = '';
                            }
                          });
                        }

                        window.addEventListener('cart:updated', function (e) {
                          var items = e && e.detail && e.detail.cart && e.detail.cart.items;
                          setTimeout(function () { applyVisibility(items); }, 0);
                        });

                        /* Initial best-effort pass from the server-seeded cart
                           (variant-id matches only — product ids arrive with
                           the first updateCart, fired on page init). */
                        var seed = function () {
                          var d = window.__initialData && window.__initialData.cart;
                          if (d && d.items) applyVisibility(d.items);
                        };
                        if (document.readyState === 'loading') {
                          document.addEventListener('DOMContentLoaded', seed);
                        } else {
                          seed();
                        }
                      })();
                    </script>
                  {%- endif -%}
                {%- endif -%}
              </div>

              {%- comment -%} Notes {%- endcomment -%}
              {% if section.settings.main_enable_cart_note %}
                <div
                  class="
                    border--b-width w-full p-4
                    {{ section.settings.main_color_scheme_second }}
                    {{ section.settings.main_color_border }}
                  "
                  x-data="{ reveal: cart.note != '', currentNote: cart.note }"
                  x-show="cart.items.length > 0"
                  x-cloak
                >
                  <label class="flex items-center">
                    <label for="notes" class="sr-only">
                      {{- 'cart.notes.title' | t -}}
                    </label>
                    <input
                      id="notes"
                      type="checkbox"
                      :checked="reveal"
                      class="form-checkbox"
                      @click="reveal = ! reveal"
                    >

                    <p class="cart__notes-label mb-0 ml-2 text--small">
                      {{ 'cart.notes.add' | t }}
                    </p>
                  </label>

                  <textarea
                    rows="4"
                    class="mt-2 w-full form-textarea border--radius"
                    placeholder="{{ 'cart.notes.placeholder' | t }}"
                    name="note"
                    x-show="reveal"
                    x-model="currentNote"
                    @keydown.debounce="updateCartNote(currentNote)"
                    x-cloak
                  ></textarea>
                </div>
              {% endif %}

              {%- comment -%} Share {%- endcomment -%}
              {% if section.settings.main_enable_cart_share %}
                <div
                  class="
                    border--b-width w-full p-4
                    {{ section.settings.main_color_scheme_second }}
                    {{ section.settings.main_color_border }}
                  "
                  x-show="cart.items.length > 0"
                  x-cloak
                >
                  <p class="cart__share-label mb-2 type--small">{{ 'cart.share.title' | t }}</p>
                  <div
                    class="flex mb-2 w-full"
                    x-data="
                      {
                        copy: '{{ 'cart.share.copy_url' | t }}'
                      }
                    "
                  >
                    <label for="copy-cart" class="sr-only">
                      {{- 'cart.share.copy_url' | t -}}
                    </label>
                    <input
                      id="copy-cart"
                      class="flex-grow -mr-6 form-input"
                      type="text"
                      placeholder="cart/?="
                      autocorrect="off"
                      autocapitalize="off"
                      :value="generateUrl()"
                    >
                    <button
                      type="submit"
                      class="whitespace-nowrap btn btn--secondary btn--smaller shrink-0"
                      @click="
                        copyToClipboard('copy-cart');
                        copy = '{{ 'cart.share.copied' | t }}';
                      "
                    >
                      <span class="btn__content" x-text="copy">
                        {{- 'cart.share.copy_url' | t -}}
                      </span>
                    </button>
                  </div>

                  <p class="mb-0 opacity-75 type--smaller">
                    {{ 'cart.share.description' | t }}
                  </p>
                </div>
              {% endif %}

              {%- comment -%} Scroll cue removed per merchant — the cut-off
                  next line item is its own scroll affordance. x-show false
                  keeps the Alpine `scroll` var wiring intact. {%- endcomment -%}
              <div
                class="sticky bottom-4 text-center"
                @click="scroll = true;"
                x-show="false"
                {% if settings.enable_animations %}
                  x-transition:enter="animation-300"
                  x-transition:enter-start="opacity-0 translate-y-8"
                  x-transition:enter-end="opacity-100"
                  x-transition:leave="animation-300"
                  x-transition:leave-start="opacity-100"
                  x-transition:leave-end="opacity-0 translate-y-8"
                {% endif %}
                x-cloak
              >
                <button
                  class="shadow-sm btn btn--plain btn--small"
                  title="{{ 'general.scroll.scroll_down' | t }}"
                >
                  {% render 'component__icon', icon: 'arrow-down', size: '20', class: '' %}
                </button>
              </div>
            </section>

            {%- comment -%} Footer {%- endcomment -%}
            <aside
              class="
                cart__footer border--t-width mt-auto
                {{ section.settings.bottom_color_scheme }}
                {{ section.settings.bottom_color_border }}
              "
              x-show="cart.items.length > 0"
              x-cloak
            >
              <!-- Subtotal -->
              <div
                class="
                  cart__subtotal-wrap w-full p-4
                  {{ section.settings.main_color_scheme_second }}
                  {{ section.settings.main_color_border }}
                "
                x-show="cart.total_price > 0"
                x-cloak
              >
                <div class="cart__subtotal-row flex justify-between items-center mb-1 w-full normal-case">
                  <span class="cart__subtotal-label{% if subtotal_label_token_class != '' %} {{ subtotal_label_token_class }}{% endif %}">{{ 'cart.general.subtotal' | t }}</span>
                  <span
                    class="cart__subtotal-value{% if subtotal_value_token_class != '' %} {{ subtotal_value_token_class }}{% endif %}"
                    x-text="Shopify.formatMoney(cart.total_price, '{{ cart.currency.symbol }}')"
                  ></span>
                </div>

                <!--
                  div class="flex justify-between items-center mb-1 w-full normal-case" x-show="cart.total_discount > 0" x-cloak>
                      <span>{{ 'cart.general.discount' | t }}</span>
                      <span x-text="'-' + Shopify.formatMoney(cart.total_discount, '{{ cart.currency.symbol }}')"></span>
                  </div
                -->

                <div class="cart__tax-row flex justify-between items-center w-full normal-case">
                  <span class="cart__tax-label{% if tax_label_token_class != '' %} {{ tax_label_token_class }}{% endif %}">{{ 'customer.order.taxes' | t }}</span>
                  <span class="cart__tax-value{% if tax_value_token_class != '' %} {{ tax_value_token_class }}{% endif %}">
                    {{- 'cart.general.calculated' | t -}}
                  </span>
                </div>

                {%- comment -%}
                  <div class="flex justify-between items-center w-full">
                      <span class="flex items-center w-full">
                      <strong>{{ 'cart.general.total' | t }}</strong>
                      {% if cart.taxes_included %}
                          {%- capture taxes_included -%}
                          {{ 'customer.order.taxes_included' | t }}
                          {%- endcapture -%}
                          <div class="ml-1">
                          {% render 'component__badge',
                              color: 'overlay-2',
                              icon: '',
                              content: taxes_included %}
                          </div>
                      {% endif %}
                      </span>
                      <strong x-text="Shopify.formatMoney(cart.total_price, '{{ cart.currency.symbol }}')"></strong>
                  </div>
                {%- endcomment -%}
              </div>

              {%- assign roundup_block = section.blocks | where: 'type', 'roundup_donation' | first -%}
              {%- if roundup_block and roundup_block.settings.enable and roundup_block.settings.variant_id != blank -%}
                <!-- Round-up donation -->
                <div
                  class="cart__roundup {{ section.settings.bottom_color_border }}"
                  {{ roundup_block.shopify_attributes }}
                  x-data="{
                    donationKey: null,
                    donationLockedAmount: 0,
                    donationExpanded: false,
                    donationBusy: false,
                    donationVariantId: '{{ roundup_block.settings.variant_id | escape }}',
                    _rootCart() {
                      var rs = (window.Alpine &amp;&amp; document.body) ? window.Alpine.$data(document.body) : null;
                      return (rs &amp;&amp; rs.cart) ? rs.cart : null;
                    },
                    get donationLineRoundup() {
                      var c = this._rootCart();
                      if (!c) return 0;
                      var base = (c.total_price || 0) - (this.donationKey ? this.donationLockedAmount : 0);
                      if (base <= 0) return 0;
                      return (Math.ceil(base / 100) * 100) - base;
                    },
                    get donationVisible() {
                      var c = this._rootCart();
                      if (!c || !c.items || c.items.length === 0) return false;
                      if (this.donationKey) return true;
                      return this.donationLineRoundup > 0;
                    },
                    get donationDisplayAmount() {
                      return this.donationKey ? this.donationLockedAmount : this.donationLineRoundup;
                    },
                    get donationRoundedTotal() {
                      var c = this._rootCart();
                      var subtotal = (c &amp;&amp; c.total_price) || 0;
                      if (this.donationKey) return subtotal;
                      return subtotal + this.donationLineRoundup;
                    },
                    formatMoneyCents(c) {
                      return (window.Shopify &amp;&amp; window.Shopify.formatMoney)
                        ? window.Shopify.formatMoney(c, '{{ cart.currency.symbol }}')
                        : '$' + (c / 100).toFixed(2);
                    },
                    syncFromCart() {
                      var c = this._rootCart();
                      if (!c || !c.items) { this.donationKey = null; this.donationLockedAmount = 0; return; }
                      var found = null;
                      for (var i = 0; i < c.items.length; i++) {
                        var it = c.items[i];
                        var props = it.properties || {};
                        if (props &amp;&amp; props._donation === 'Carry On') { found = it; break; }
                      }
                      if (found) {
                        this.donationKey = found.key;
                        this.donationLockedAmount = found.original_line_price != null ? found.original_line_price : (found.line_price || 0);
                      } else {
                        this.donationKey = null;
                        this.donationLockedAmount = 0;
                      }
                    },
                    toggleDonation() {
                      if (this.donationBusy) return;
                      if (this.donationKey) { this.removeDonation(); } else { this.addDonation(); }
                    },
                    addDonation() {
                      var cents = this.donationLineRoundup;
                      var vid = parseInt(this.donationVariantId, 10);
                      var rootScope = (window.Alpine &amp;&amp; document.body) ? window.Alpine.$data(document.body) : null;
                      if (!vid) {
                        if (rootScope) { rootScope.error_title = 'Donation variant missing'; rootScope.error_message = 'The donation variant ID on the Round-up donation block is empty or not numeric.'; rootScope.show_alert = true; }
                        return;
                      }
                      if (!cents) return;
                      this.donationBusy = true;
                      var self = this;
                      fetch(window.Shopify.routes.root + 'cart/add.js', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({
                          items: [{
                            id: vid,
                            quantity: cents,
                            properties: {
                              '_donation': 'Carry On',
                              '_donation_amount': self.formatMoneyCents(cents),
                              '_donation_kind': 'roundup'
                            }
                          }]
                        })
                      })
                      .then(function(r){ return r.json().then(function(body){ if (!r.ok) throw body; return body; }); })
                      .then(function(){
                        if (rootScope &amp;&amp; typeof rootScope.updateCart === 'function') rootScope.updateCart(false);
                      })
                      .catch(function(err){
                        console.warn('[roundup] add failed', err);
                        if (rootScope) {
                          rootScope.error_title = (err &amp;&amp; err.message) ? err.message : 'Could not add donation';
                          rootScope.error_message = (err &amp;&amp; err.description) ? err.description : 'The donation variant could not be added. Double-check the variant ID, that the donation product is set to Active (not Draft), and that the variant is available.';
                          rootScope.show_alert = true;
                        }
                      })
                      .then(function(){ self.donationBusy = false; });
                    },
                    removeDonation() {
                      if (!this.donationKey) return;
                      this.donationBusy = true;
                      var self = this;
                      var key = this.donationKey;
                      var rootScope = (window.Alpine &amp;&amp; document.body) ? window.Alpine.$data(document.body) : null;
                      if (!rootScope || typeof rootScope.changeCartItemQuantity !== 'function') {
                        this.donationBusy = false; return;
                      }
                      Promise.resolve(rootScope.changeCartItemQuantity(key, 0, false, false))
                        .then(function(){
                          if (typeof rootScope.updateCart === 'function') rootScope.updateCart(false);
                        })
                        .catch(function(err){
                          console.warn('[roundup] remove failed', err);
                          if (rootScope) {
                            rootScope.error_title = 'Could not remove donation';
                            rootScope.error_message = (err &amp;&amp; err.message) || 'Please try refreshing the cart.';
                            rootScope.show_alert = true;
                          }
                        })
                        .then(function(){ self.donationBusy = false; });
                    }
                  }"
                  x-init="syncFromCart()"
                  @cart:updated.window="syncFromCart()"
                  x-show="donationVisible"
                  x-cloak>
                  <div class="cart__roundup-row">
                    <span class="cart__roundup-icon" aria-hidden="true">{{ roundup_block.settings.icon_glyph | default: '♥' }}</span>
                    <div class="cart__roundup-text">
                      <template x-if="!donationKey">
                        <div>
                          <strong>Round up to</strong>
                          <span x-text="formatMoneyCents(donationRoundedTotal)"></span>
                          <span>— donate</span>
                          <strong x-text="formatMoneyCents(donationDisplayAmount)"></strong>
                          <span>to {{ roundup_block.settings.org_name | default: 'Carry On Foundation' }}</span>
                          <br>
                          <button type="button" class="cart__roundup-learn" @click="donationExpanded = !donationExpanded" :aria-expanded="donationExpanded ? 'true' : 'false'">
                            Learn more <span x-text="donationExpanded ? '▴' : '▾'"></span>
                          </button>
                        </div>
                      </template>
                      <template x-if="donationKey">
                        <div>
                          <strong>Donating</strong>
                          <span x-text="formatMoneyCents(donationDisplayAmount)"></span>
                          <span>to {{ roundup_block.settings.org_name | default: 'Carry On Foundation' }}</span>
                          <button type="button" class="cart__roundup-remove" :disabled="donationBusy" @click="removeDonation()">Remove</button>
                        </div>
                      </template>
                    </div>
                    <button
                      type="button"
                      class="cart__roundup-toggle"
                      :class="{ 'is-on': donationKey }"
                      :disabled="donationBusy"
                      :aria-pressed="donationKey ? 'true' : 'false'"
                      aria-label="Round up to the nearest dollar and donate to {{ roundup_block.settings.org_name | default: 'Carry On Foundation' | escape }}"
                      @click="toggleDonation()"></button>
                  </div>
                  <div class="cart__roundup-panel" :class="{ 'is-open': donationExpanded }">
                    <div>
                      <div class="cart__roundup-panel-inner">
                        {%- if roundup_block.settings.org_logo != blank -%}
                          <img src="{{ roundup_block.settings.org_logo | image_url: width: 400 }}" alt="{{ roundup_block.settings.org_name | default: 'Carry On Foundation' | escape }}" loading="lazy">
                        {%- endif -%}
                        {%- if roundup_block.settings.credibility_text != blank -%}
                          <div class="cart__roundup-credibility">{{ roundup_block.settings.credibility_text }}</div>
                        {%- endif -%}
                        {%- if roundup_block.settings.mission_text != blank -%}
                          <div class="cart__roundup-mission">{{ roundup_block.settings.mission_text }}</div>
                        {%- endif -%}
                        {%- if roundup_block.settings.money_flow_text != blank -%}
                          <div class="cart__roundup-money">{{ roundup_block.settings.money_flow_text }}</div>
                        {%- endif -%}
                        {%- if roundup_block.settings.org_url != blank -%}
                          <a class="cart__roundup-link" href="{{ roundup_block.settings.org_url }}" target="_blank" rel="noopener noreferrer">{{ roundup_block.settings.org_url | split: '//' | last | split: '/' | first }} ›</a>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}

              <!-- Checkout -->
              <form
                class="cart__checkout-form px-4 py-4 w-full"
                action="{{ routes.cart_url }}"
                method="post"
                x-data="{checkout_button_loading:false}"
                @submit.prevent="
                    checkout_button_loading = true;
                    {% if settings.enable_audio %}
                      const click_audio = new Audio(window.__initialData.click_audio);
                      click_audio.play();
                    {% endif %}
                    setTimeout(function(){ checkout_button_loading = false}, 5000); window.location.href = '/checkout'
                  ;
                "
              >
                <div class="mb-0">
                  {% if section.settings.cart_button_behavior == 'checkout' %}
                    <button
                      type="submit"
                      name="checkout"
                      class="!w-full btn btn--load {{ section.settings.bottom_color_button }}"
                      :class="{ 'btn--loading' : checkout_button_loading }"
                      :disabled="checkout_button_loading"
                    >
                      <div class="btn__spinner">
                        {% render 'component__icon', icon: 'spinner', size: '24', class: '' %}
                      </div>
                      <div class="btn__content">
                        {{ 'cart.general.checkout' | t }}
                      </div>
                    </button>
                  {% else %}
                    <a
                      href="{{ routes.cart_url }}"
                      class="!w-full btn btn--load block {{ section.settings.bottom_color_button }}"
                      :class="{ 'btn--loading' : checkout_button_loading }"
                    >
                      {{ 'cart.general.title' | t }}
                      {% if settings.type_seperator == 'dot' -%}
                        ·
                      {%- else -%}
                        |
                      {%- endif %}
                    </a>
                  {% endif %}
                  {% if section.settings.show_continue_shopping_button %}
                    <a
                      href="{{ routes.cart_url }}"
                      @click.prevent="cart_drawer = false;"
                      class="cart__continue-btn !w-full mt-2 btn btn--load block {{ section.settings.continue_shopping_color_button | default: 'btn--secondary' }}"
                    >
                      {{ section.settings.continue_shopping_label | default: 'Continue shopping' }}
                    </a>
                  {% endif %}
                </div>

              </form>

              {%- comment -%} Trust badges {%- endcomment -%}
              {% assign trust_blocks = section.blocks | where: 'type', 'trust_badge' %}
              {% if trust_blocks.size > 0 %}
                {%- assign _trust_icon_size = section.settings.trust_icon_size | default: 18 -%}
                <div class="cart__trust-badges">
                  {% for block in trust_blocks %}
                    <div class="cart__trust-badge" {{ block.shopify_attributes }}>
                      {% render 'component__icon', icon: block.settings.icon, size: _trust_icon_size, class: '' %}
                      <span class="cart__trust-label{% if trust_label_token_class != '' %} {{ trust_label_token_class }}{% endif %}">
                        {{ block.settings.label }}
                      </span>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </aside>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%}
  Cart's bundle-editor drawer was removed when the cart-group widget
  moved to inline-edit (per-row dropdown). bundle__cart-group.liquid
  now handles swaps via bundleCartEdit() in bundle__cart-edit-data.liquid,
  no drawer / no navigation needed.
{%- endcomment -%}

{% render 'component__alert', alert_id: 'cart_alert', cart_bar: true, content: alert_content %}

<script>
  document.addEventListener('cart:updated', function(event) {
    if (window.Alpine) {
      const cart = event.detail.cart;
      cart.shipping_gap_tier1 = Math.max(0, {{ section.settings.progress_bar_tier1 | times: 100 }} - cart.total_price);
    }
  });

  /* Refresh per-row Alpine scope's `item` after any cart mutation.
   *
   * The cart line item row (theme__cart.liquid) wraps each non-bundle
   * line in its own x-data that destructures the outer x-for `item`
   * once at mount. When updateCart() replaces cart.items, Alpine's
   * outer x-for reuses the row's DOM at the matching :key — so the
   * inner scope's `item` stays pinned to the original shallow copy
   * and the qty input + line price freeze at the pre-add values
   * while the cart-level total updates correctly.
   *
   * Inline @cart:updated handlers on the inner scope didn't reliably
   * trigger reactivity here, so we do it imperatively from a global
   * listener: walk every [data-cart-line-item-key] node, look the
   * fresh line item up in the event payload by key, and reassign
   * Alpine.$data(el).item. The assignment is detected by Alpine's
   * reactivity proxy and the bound bindings (x-model, x-text) update. */
  (function () {
    function refreshLineItems(detail) {
      if (!window.Alpine || !detail || !detail.cart) return;
      var items = detail.cart.items || [];
      var rows = document.querySelectorAll('[data-cart-line-item-key]');
      rows.forEach(function (row) {
        var key = row.getAttribute('data-cart-line-item-key');
        var fresh = items.find(function (i) { return String(i.key) === String(key); });
        if (!fresh) return;
        try {
          var scope = window.Alpine.$data(row);
          if (scope && 'item' in scope) {
            scope.item = fresh;
          }
        } catch (e) { /* row not yet hydrated */ }
      });
    }
    window.addEventListener('cart:updated', function (e) { refreshLineItems(e.detail); });
    document.addEventListener('cart:updated', function (e) { refreshLineItems(e.detail); });
  })();
</script>

{%- if request.design_mode and section.settings.cart_open_in_editor -%}
<script>
  /* Customizer-only "always open" override for the cart drawer.
   *
   * The previous x-init approach only fired once on the initial
   * Alpine mount. Every customizer setting change reloads this
   * section's HTML (Shopify dispatches shopify:section:load with
   * fresh markup), which re-mounts the cart drawer — but the new
   * x-init's reactive change couldn't compete with the closing
   * animation Alpine was already mid-running, so the drawer
   * appeared to slam shut on every merchant edit.
   *
   * This script runs on initial load AND on every section reload
   * (because it's inside the section's reloaded HTML), pushing
   * cart_drawer = true onto the root Alpine scope as soon as it
   * exists. The listeners are registered exactly once via a
   * window flag so reloads don't stack duplicate handlers. Only
   * emitted inside request.design_mode — the live storefront has
   * zero overhead from this. */
  (function(){
    function openDrawer() {
      var tries = 0;
      var attempt = function() {
        var root = (window.Alpine && document.body) ? window.Alpine.$data(document.body) : null;
        if (root && typeof root === 'object') {
          root.cart_drawer = true;
        } else if (++tries < 25) {
          setTimeout(attempt, 80);
        }
      };
      attempt();
    }
    /* Open immediately on script execution. Covers initial page
     * load AND every section reload (this script is inside the
     * reloaded HTML so it runs again on each editor edit). */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', openDrawer);
    } else {
      openDrawer();
    }
    /* Register editor-event listeners exactly once. The window
     * flag prevents stacking duplicates when this section's HTML
     * is reloaded by the customizer. */
    if (!window.__cartDrawerEditorAlwaysOpen) {
      window.__cartDrawerEditorAlwaysOpen = true;
      var maybeOpen = function(e) {
        if (e && e.detail && e.detail.sectionId === '{{ section.id }}') {
          openDrawer();
        }
      };
      document.addEventListener('shopify:section:load',   maybeOpen);
      document.addEventListener('shopify:section:select', maybeOpen);
      document.addEventListener('shopify:block:select',   maybeOpen);
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.theme_cart.name",
  "settings": [
    { "type": "header", "content": "Theme editor preview" },
    { "type": "checkbox", "id": "cart_open_in_editor", "label": "Always open the cart drawer in the theme editor", "default": true, "info": "Customizer-only override so you can style the drawer without manually opening it. No effect on the live storefront." },
    { "type": "header", "content": "Cart design" },
    { "type": "paragraph", "content": "Custom colors override the color scheme dropdowns below. Leave blank to use color schemes." },
    { "type": "color", "id": "cart_header_bg", "label": "Header background" },
    { "type": "color", "id": "cart_header_text", "label": "Header text color", "default": "#ffffff" },
    { "type": "color", "id": "cart_body_bg", "label": "Body background" },
    { "type": "color", "id": "cart_border_color", "label": "Border color" },
    { "type": "color", "id": "cart_footer_bg", "label": "Footer background" },

    { "type": "header", "content": "Product title" },
    { "type": "range", "id": "cart_title_size", "label": "Title font size (px)", "min": 10, "max": 20, "step": 1, "default": 14 },
    {
      "type": "select", "id": "cart_title_weight", "label": "Title font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },

    { "type": "header", "content": "Checkout button" },
    { "type": "paragraph", "content": "Leave fields blank / 0 to inherit the global theme button tokens (Theme settings → Buttons → Primary). Set a value to override just for the cart drawer." },
