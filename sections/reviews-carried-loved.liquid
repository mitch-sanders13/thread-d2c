<!-- sections/reviews-carried-loved.liquid -->
{% comment %}
  Reviews — "Carried & Loved". Three (or more) review cards: stars,
  quote, verified badge + name, linked product tag. Each card is a
  schema block the team fills with real Okendo review text — the
  preset ships with obviously-placeholder copy so nothing fabricated
  can read as a real customer review.
{% endcomment %}

{%- assign rv_id = section.id -%}

<section id="rv-{{ rv_id }}" class="rv-section{% if section.settings.visibility != blank %} {{ section.settings.visibility }}{% endif %}">
  <div class="rv-head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="rv-eyebrow rv-reveal" style="--rv-d: 0s;">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="rv-heading rv-reveal" style="--rv-d: 0.07s;">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="rv-grid">
    {%- for block in section.blocks -%}
      {%- assign rv_stars = block.settings.stars | default: 5 -%}
      <article class="rv-card rv-reveal" style="--rv-d: {{ forloop.index0 | times: 0.07 }}s;" {{ block.shopify_attributes }}>
        <div class="rv-stars" role="img" aria-label="{{ rv_stars }} out of 5 stars">
          {%- for i in (1..5) -%}
            <span class="rv-star{% if i > rv_stars %} rv-star--empty{% endif %}" aria-hidden="true">★</span>
          {%- endfor -%}
        </div>
        {%- if block.settings.quote != blank -%}
          <blockquote class="rv-quote">{{ block.settings.quote }}</blockquote>
        {%- endif -%}
        <footer class="rv-foot">
          <span class="rv-verified">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/>
              <polyline points="8.5 12.5 11 15 15.5 9.5"/>
            </svg>
            <span>{{ block.settings.reviewer | default: 'Verified Buyer' }}</span>
            {%- if block.settings.reviewer != blank -%}
              <span class="rv-verified__label">Verified Buyer</span>
            {%- endif -%}
          </span>
          {%- if block.settings.product != blank -%}
            <a class="rv-product" href="{{ block.settings.product.url }}">
              {{ block.settings.product_label | default: block.settings.product.title }}
            </a>
          {%- endif -%}
        </footer>
      </article>
    {%- endfor -%}
  </div>
</section>

<style>
  #rv-{{ rv_id }} {
    background: {{ section.settings.bg_color | default: 'var(--thread-bone)' }};
    padding: {{ section.settings.padding_top | default: 56 }}px 16px {{ section.settings.padding_bottom | default: 64 }}px;
  }
  #rv-{{ rv_id }} .rv-head {
    text-align: center;
    margin-bottom: 28px;
  }
  #rv-{{ rv_id }} .rv-eyebrow {
    margin: 0 0 8px;
    font-family: var(--type-font-body-family);
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: var(--thread-ls-eyebrow);
    color: {{ section.settings.eyebrow_color | default: 'var(--thread-blue)' }};
  }
  #rv-{{ rv_id }} .rv-heading {
    margin: 0;
    font-family: var(--type-font-header-family);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.94;
    font-size: clamp(36px, 6vw, 76px);
    color: #1c1c1c;
  }
  #rv-{{ rv_id }} .rv-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    max-width: 1180px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    #rv-{{ rv_id }} .rv-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }
  #rv-{{ rv_id }} .rv-card {
    background: #ffffff;
    border: 1px solid var(--thread-hairline);
    border-radius: 16px;
    padding: 22px 22px 18px;
    display: flex;
    flex-direction: column;
  }
  #rv-{{ rv_id }} .rv-stars {
    color: {{ section.settings.star_color | default: 'var(--thread-bronze)' }};
    font-size: 15px;
    letter-spacing: 2px;
    line-height: 1;
    margin-bottom: 12px;
  }
  #rv-{{ rv_id }} .rv-star--empty { color: var(--thread-hairline); }
  #rv-{{ rv_id }} .rv-quote {
    margin: 0 0 16px;
    font-family: var(--type-font-body-family);
    font-size: 15px;
    line-height: 1.5;
    letter-spacing: var(--thread-ls-body);
    color: #1c1c1c;
    flex: 1;
  }
  #rv-{{ rv_id }} .rv-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    border-top: 1px solid var(--thread-hairline);
    padding-top: 12px;
  }
  #rv-{{ rv_id }} .rv-verified {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--type-font-body-family);
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: var(--thread-ls-label);
    color: #1c1c1c;
  }
  #rv-{{ rv_id }} .rv-verified svg { color: {{ section.settings.eyebrow_color | default: 'var(--thread-blue)' }}; flex: none; }
  #rv-{{ rv_id }} .rv-verified__label {
    color: var(--thread-grey);
    font-weight: 400;
    letter-spacing: 0.05em;
  }
  #rv-{{ rv_id }} .rv-product {
    font-family: var(--type-font-body-family);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--thread-ls-label);
    color: #1c1c1c;
    text-decoration: none;
    border: 1px solid var(--thread-hairline);
    border-radius: var(--thread-radius-pill);
    padding: 5px 12px;
    white-space: nowrap;
  }
  #rv-{{ rv_id }} .rv-product:hover { border-color: #1c1c1c; }

  @media (prefers-reduced-motion: no-preference) {
    #rv-{{ rv_id }} .rv-card {
      transition: transform 0.3s cubic-bezier(0,0,.3,1), box-shadow 0.3s cubic-bezier(0,0,.3,1);
    }
    #rv-{{ rv_id }} .rv-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 30px rgba(28,28,28,0.08);
    }
    #rv-{{ rv_id }}.rv-armed .rv-reveal {
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.55s cubic-bezier(0,0,.3,1), transform 0.55s cubic-bezier(0,0,.3,1);
      transition-delay: var(--rv-d, 0s);
    }
    #rv-{{ rv_id }}.rv-armed.rv-in .rv-reveal {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('rv-{{ rv_id }}');
    if (!section) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;
    section.classList.add('rv-armed');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          section.classList.add('rv-in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    io.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Reviews — Carried & Loved",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "4.8 stars · 16,000+ reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Carried & Loved" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f4f1ea" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow / badge color", "default": "#1e7db3" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#c08951" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 64 },
    {
      "type": "select", "id": "visibility", "label": "Show on",
      "options": [
        { "value": "", "label": "All devices" },
        { "value": "md:hidden", "label": "Mobile only" },
        { "value": "hidden md:block", "label": "Desktop only" }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "info": "Paste a real review from Okendo — don't invent reviews." },
        { "type": "text", "id": "reviewer", "label": "Reviewer name" },
        { "type": "product", "id": "product", "label": "Reviewed product" },
        { "type": "text", "id": "product_label", "label": "Product tag label (optional)", "info": "Overrides the product title on the tag." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Reviews — Carried & Loved",
      "blocks": [
        { "type": "review", "settings": { "quote": "[Placeholder — paste a real Okendo review]", "reviewer": "Reviewer name" } },
        { "type": "review", "settings": { "quote": "[Placeholder — paste a real Okendo review]", "reviewer": "Reviewer name" } },
        { "type": "review", "settings": { "quote": "[Placeholder — paste a real Okendo review]", "reviewer": "Reviewer name" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["custom.overlay"] }
}
{% endschema %}
