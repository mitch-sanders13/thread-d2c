<!-- sections/attentive-warranty-bar.liquid -->
{% comment %} 
  Call to action for attentive - warranty registration
{% endcomment %}

<section class="
  {{ section.settings.visibility }}
  {{ section.settings.color_scheme }} 
  {{ section.settings.color_border }}
  {{ section.settings.style_border }}">
  <div class="{{ section.settings.layout_horizontal }}"
    style="
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;">
      
    <div class="flex flex-row flex-wrap items-end text-center justify-center
      {% unless request.design_mode %}
        {% if settings.enable_animations %}
          opacity-0 js:animation animation-300 
        {% endif %}
      {% endunless %}"
      {% if settings.enable_animations %}
        data-delay="100" 
        data-replace="{ 
          'opacity-0' : 'opacity-100'
        }"
      {% endif %}>

      <div class="max-w-prose md:w-auto w-full text-left">
        {%- unless section.settings.heading == blank -%}
          <h2 class="text-left" aria-level="2">{{ section.settings.heading }}</h2>
        {%- endunless -%}
        {%- unless section.settings.content == blank -%}
          <div class="text-left">
            {{ section.settings.content }}
          </div>
        {%- endunless -%}
        {%- unless section.settings.button_label == blank -%}
          <button
            class="mt-2 {{ section.settings.color_button }}"
            @click="
              if (window.innerWidth >= 760) {
                window.__attentive.trigger(null, null, null, {{ section.settings.desktop_id }});
              } else {
                window.__attentive.trigger(null, null, null, {{ section.settings.mobile_id }});
              }
            ">
            {{ section.settings.button_label }}
          </button>
        {%- endunless -%}
      </div>

    </div>
    
  </div>
</section>
  
{% schema %}
{
  "name":"Attentive warranty bar",
  "settings":[
    {
      "type": "paragraph",
      "content": "This section will only work if the Attentive script is installed - inject using GTM or custom liquid snippet."
    },
    {
      "type": "paragraph",
      "content": "<script>!function(w){w.attn_d0x0b_evt=[];var n=w.attentive={analytics:{}},a=['enable','disable','track','pageView','productView','addToCart','purchase'];function e(n){return function(){w.attn_d0x0b_evt.push({func:n,args:arguments})}}for(var i=0,c=a.length;i<c;i++)n.analytics[a[i]]=e(a[i])}(window)</script><script src='https://cdn.attn.tv/threadwallets/dtag.js'></script>"
    },
    {
      "type":"header",
      "content":"t:sections.all.headers.header__4.content"
    },
    {
      "type":"text",
      "id":"desktop_id",
      "label":"Attentive desktop ID"
    },
    {
