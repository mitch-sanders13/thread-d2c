<!-- sections/collection__main.liquid -->
{% comment %}
  Main contents of the collection template

  Globals:
    - settings.layout_horizontal: horizontaly margin

  Possible enhancements:
    - Add support for global setting to control grid gap.
    - Add setting so blocks can be set to width of two blocks.
    - Add new block to support SMS opt-in.

  Pro tips:
    - Use blocks to showcase promotional content.
{% endcomment %}

{%- assign _grid_cg_m = section.settings.grid_col_gap_mobile  | default: 8 -%}
{%- assign _grid_rg_m = section.settings.grid_row_gap_mobile  | default: 12 -%}
{%- assign _grid_cg_d = section.settings.grid_col_gap_desktop | default: 8 -%}
{%- assign _grid_rg_d = section.settings.grid_row_gap_desktop | default: 12 -%}

<style>
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} > *,
  #shopify-section-{{ section.id }} section,
  #shopify-section-{{ section.id }} div {
    padding-left: 0 !important;
    padding-right: 0 !important;
    max-width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
  #js\:results {
    padding-left: 8px !important;
    padding-right: 8px !important;
    column-gap: {{ _grid_cg_m }}px !important;
    row-gap: {{ _grid_rg_m }}px !important;
    grid-auto-flow: dense;
  }
  @media (min-width: 768px) {
    #js\:results {
      column-gap: {{ _grid_cg_d }}px !important;
      row-gap: {{ _grid_rg_d }}px !important;
    }
  }

  /* Product + lifestyle pair — every Nth product is wrapped in a
     .cs-pair that spans 2 outer-grid columns, with the product card
     on the left and a card-sized lifestyle tile (the product's own
     3rd image) on the right. Guarantees same-row pairing on mobile
     and desktop. grid-auto-flow: dense on the outer grid backfills
     any gap from boundary-case wrapping on wider viewports. */
  #shopify-section-{{ section.id }} .cs-pair {
    grid-column: span 2;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: {{ _grid_cg_m }}px;
    row-gap: {{ _grid_rg_m }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .cs-pair {
      column-gap: {{ _grid_cg_d }}px;
      row-gap: {{ _grid_rg_d }}px;
    }
  }
  #shopify-section-{{ section.id }} .cs-pair__lifestyle {
    position: relative;
    display: block;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
    width: 100%;
  }
  #shopify-section-{{ section.id }} .cs-pair__lifestyle-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

</style>
<section id="js:top" class="{{ section.settings.color_scheme }}">
  <div>
    {% render 'collection__sublinks' %}
    {% render 'collection__subtags' %}
    <div
      x-ref="destop_filter"
      x-data="
        {
          sort_by : ['{{ sort_by }}'],
          height: 0
        }
      "
      {% if settings.header_position == 'sticky' %}
        x-init="
          height = $refs.header.offsetHeight;
          $refs.destop_filter.style.top = height + 'px';
        "
      {% endif %}
    >
      {% render 'component__collection-filter' %}
    </div>

    {% paginate collection.products by section.settings.products_per_page %}
      {%- unless collection.title == blank %}
        {% comment %} <h1 class="text-center mt-12 mb-0 type--big">{{ collection.title }}</h1> {% endcomment %}
      {%- endunless -%}
      <section
        id="js:results"
        class="
          grid animation-500 py-4
          {{ section.settings.row_size_desktop }}
          {{ section.settings.row_size_mobile }}
        "
        :class="
          {
          'opacity-25' : pagination_loading }
        "
        style="
          padding-left: 8px !important; padding-right: 8px !important; max-width: 100% !important; margin: 0 !important;
        "
      >
        {% for product in collection.products %}
          {% assign gridIndex = forloop.index %}
          {% if paginate.current_page == 1 %}
            {% for block in section.blocks %}
              {%- case block.type -%}
                {%- when 'newsletter' -%}
                  {% if block.settings.index == gridIndex %}
                    {% render 'component__newsletter-item',
                      title: block.settings.heading,
                      content: block.settings.content,
                      button_label: block.settings.button_label,
                      disclaimer: block.settings.disclaimer,
                      success: block.settings.success,
                      size_desktop: block.settings.column_size,
                      background_image: block.settings.image_background,
                      background_color: block.settings.background_color_scheme,
                      index: gridIndex
                    %}
                  {% endif %}

                {%- when 'content' -%}
                  {% if block.settings.index == gridIndex %}
                    {% render 'component__content-item',
                      url: block.settings.url,
                      title: block.settings.heading,
                      content: block.settings.content,
                      button_label: block.settings.button_label,
                      size_desktop: block.settings.column_size,
                      background_image: block.settings.image_background,
                      background_color: block.settings.background_color_scheme,
                      video: block.settings.video,
                      autoplay: block.settings.enable_autoplay,
                      mute: block.settings.enable_mute_toggle,
                      loop: block.settings.enable_loop,
                      index: gridIndex
                    %}
                  {% endif %}
              {%- endcase -%}
            {% endfor %}
          {% endif %}

          {%- comment -%}
            Product + lifestyle pair — wraps every Nth product in a
            span-2 grid item with the product card on the left and a
            card-sized lifestyle tile (the product's own 3rd image)
            on the right. Skipped when the product has fewer than 3
            images, when display_mode is 'variants', or when the
            feature is toggled off.
          {%- endcomment -%}
          {%- assign _cs_show_pair = false -%}
          {%- if section.settings.show_lifestyle_tiles and section.settings.display_mode != 'variants' and product.images.size >= 3 -%}
            {%- assign _cs_pair_interval = section.settings.lifestyle_tile_interval | default: 6 -%}
            {%- assign _cs_pair_mod = forloop.index | modulo: _cs_pair_interval -%}
            {%- if _cs_pair_mod == 0 -%}
              {%- assign _cs_show_pair = true -%}
              {%- assign _cs_lifestyle = product.images[2] -%}
            {%- endif -%}
          {%- endif -%}

          {%- if _cs_show_pair -%}
            <div class="cs-pair">
              <div class="cs-pair__product">
                {% render 'component__product-item', product: product, source: 'col_main' %}
              </div>
              <a class="cs-pair__lifestyle {{ settings.thumbnails_ratio }}"
                 href="{{ product.url }}"
                 aria-label="{{ product.title | escape }}">
                <img class="cs-pair__lifestyle-img"
                     src="{{ _cs_lifestyle | image_url: width: 800 }}"
                     srcset="{{ _cs_lifestyle | image_url: width: 400 }} 400w, {{ _cs_lifestyle | image_url: width: 600 }} 600w, {{ _cs_lifestyle | image_url: width: 900 }} 900w"
                     sizes="(min-width: 768px) 25vw, 50vw"
                     alt="{{ _cs_lifestyle.alt | default: product.title | escape }}"
                     loading="lazy"
                     width="{{ _cs_lifestyle.width }}"
                     height="{{ _cs_lifestyle.height }}">
              </a>
            </div>
          {%- elsif section.settings.display_mode == 'variants' and product.has_only_default_variant == false -%}
            {%- for variant in product.variants -%}
              {% render 'component__variant-item', product: product, variant: variant, source: 'col_main' %}
            {%- endfor -%}
          {%- else -%}
            {% render 'component__product-item', product: product, source: 'col_main' %}
          {%- endif -%}
        {% endfor %}
      </section>

      {% if collection.all_products_count == 0 %}
        <section class="py-4 text-center">
          <span>{{ 'collections.general.no_matches' | t }}</span>
        </section>
      {% else %}
        {% render 'component__pagination', paginate: paginate %}
      {% endif %}

      {% render 'script__swatches' %}
    {% endpaginate %}
  </div>
</section>

