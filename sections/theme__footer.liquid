      ],
      "default": "700"
    },
    {
      "type": "select", "id": "title_case", "label": "Case",
      "options": [
        { "value": "none", "label": "Normal" }, { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "lowercase", "label": "lowercase" }, { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "select", "id": "title_ls", "label": "Letter spacing",
      "options": [
