<!-- sections/theme__footer.liquid -->
{% comment %} 
  Site wide footer.

  Globals:
    - settings.layout_horizontal: horizontaly margin
    - settings.enable_animations: boolean to enable animations
    - settings.enable_region: boolean to enable/disable the region selector
    - settings.enable_language: boolean to enable/disable the language selector
    - settings.type_seperator: setting to pick the type of seperator between text
    - settings.social_tiktok_link: link to tiktok
    - settings.social_instagram_link: link to instagram
    - settings.social_twitter_link: link to twitter
    - settings.social_facebook_link: link to facebook
    - settings.social_pinterest_link: link to pinterest
    - settings.social_snapchat_link: link to snapchat
    - settings.social_tumblr_link: link to tumblr
    - settings.social_discord_link: link to discord
    - settings.social_linkedin_link: link to linkedin
    - settings.social_twitch_link: link to twitch
    - settings.social_youtube_link: link to youtube
    - settings.social_vimeo_link: link to vimeo
{% endcomment %}

{%- assign has_content = false -%}
{% for block in section.blocks %}
  {%- case block.type -%}
    {%- when 'newsletter' -%}
      {%- assign has_content = true -%}
    {%- when 'content' -%}
      {%- assign has_content = true -%}
  {%- endcase -%}
{% endfor %}

{%- comment -%}
  ============================================================
  Footer typography + spacing — scoped to this section. Each
  text layer (title, link, heading, body) resolves a font family
  from a select; sizes/weights/etc. are driven by individual
  settings. Mobile/desktop variants use a media query fence.
  ============================================================
{%- endcomment -%}
{%- assign _ft_title_fam   = section.settings.title_font   | default: 'nav' -%}
{%- assign _ft_link_fam    = section.settings.link_font    | default: 'body' -%}
{%- assign _ft_heading_fam = section.settings.heading_font | default: 'heading' -%}
{%- assign _ft_body_fam    = section.settings.body_font    | default: 'body' -%}
{%- capture _ft_title_fam_var   -%}var(--type-font-{% if _ft_title_fam == 'heading' %}header{% else %}{{ _ft_title_fam }}{% endif %}-family){%- endcapture -%}
{%- capture _ft_link_fam_var    -%}var(--type-font-{% if _ft_link_fam == 'heading' %}header{% else %}{{ _ft_link_fam }}{% endif %}-family){%- endcapture -%}
{%- capture _ft_heading_fam_var -%}var(--type-font-{% if _ft_heading_fam == 'heading' %}header{% else %}{{ _ft_heading_fam }}{% endif %}-family){%- endcapture -%}
{%- capture _ft_body_fam_var    -%}var(--type-font-{% if _ft_body_fam == 'heading' %}header{% else %}{{ _ft_body_fam }}{% endif %}-family){%- endcapture -%}

<style>
  /* ---- Block title (desktop column header + mobile accordion label) ---- */
  #shopify-section-{{ section.id }} .ft-title,
  #shopify-section-{{ section.id }} .ft-title * {
    font-family: {{ _ft_title_fam_var }} !important;
    font-size: {{ section.settings.title_size_m | default: 14 }}px !important;
    font-weight: {{ section.settings.title_weight | default: '700' }} !important;
    text-transform: {{ section.settings.title_case | default: 'uppercase' }} !important;
    letter-spacing: {{ section.settings.title_ls | default: '0.08em' }} !important;
    line-height: {{ section.settings.title_lh | default: 1.3 }} !important;
    {% if section.settings.title_color != blank %}color: {{ section.settings.title_color }} !important;{% endif %}
  }
  /* ---- Menu link (desktop + mobile accordion items) ---- */
  #shopify-section-{{ section.id }} .ft-link,
  #shopify-section-{{ section.id }} .ft-link * {
    font-family: {{ _ft_link_fam_var }} !important;
    font-size: {{ section.settings.link_size_m | default: 14 }}px !important;
    font-weight: {{ section.settings.link_weight | default: '400' }} !important;
    text-transform: {{ section.settings.link_case | default: 'none' }} !important;
    letter-spacing: {{ section.settings.link_ls | default: '0em' }} !important;
    line-height: {{ section.settings.link_lh | default: 1.5 }} !important;
    opacity: {{ section.settings.link_opacity | default: 100 | divided_by: 100.0 }} !important;
    {% if section.settings.link_color != blank %}color: {{ section.settings.link_color }} !important;{% endif %}
  }
  /* ---- Heading (newsletter, content block heading) ---- */
  #shopify-section-{{ section.id }} .ft-heading,
  #shopify-section-{{ section.id }} .ft-heading * {
    font-family: {{ _ft_heading_fam_var }} !important;
    font-size: {{ section.settings.heading_size_m | default: 18 }}px !important;
    font-weight: {{ section.settings.heading_weight | default: '700' }} !important;
    text-transform: {{ section.settings.heading_case | default: 'none' }} !important;
    letter-spacing: {{ section.settings.heading_ls | default: '0em' }} !important;
    line-height: {{ section.settings.heading_lh | default: 1.2 }} !important;
    {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }} !important;{% endif %}
  }
  /* ---- Body text (location text, newsletter/content body, disclaimer, sub-footer) ---- */
  #shopify-section-{{ section.id }} .ft-body,
  #shopify-section-{{ section.id }} .ft-body * {
    font-family: {{ _ft_body_fam_var }} !important;
    font-size: {{ section.settings.body_size_m | default: 14 }}px !important;
    font-weight: {{ section.settings.body_weight | default: '400' }} !important;
    letter-spacing: {{ section.settings.body_ls | default: '0em' }} !important;
    line-height: {{ section.settings.body_lh | default: 1.5 }} !important;
    {% if section.settings.body_color != blank %}color: {{ section.settings.body_color }} !important;{% endif %}
  }

  /* ---- Sub-footer copyright text — independent size + opacity ----
     Uses `.ft-body.ft-sub-text` so the selector specificity is higher
     than the generic `.ft-body` rule above; otherwise the .ft-body
     desktop override (emitted later) would beat this even with
     !important. */
  #shopify-section-{{ section.id }} .ft-body.ft-sub-text,
  #shopify-section-{{ section.id }} .ft-body.ft-sub-text * {
    font-size: {{ section.settings.sub_text_size_m | default: 12 }}px !important;
    opacity: {{ section.settings.sub_text_opacity | default: 75 | divided_by: 100.0 }};
    {% if section.settings.sub_text_color != blank %}color: {{ section.settings.sub_text_color }} !important;{% endif %}
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .ft-body.ft-sub-text,
    #shopify-section-{{ section.id }} .ft-body.ft-sub-text * {
      font-size: {{ section.settings.sub_text_size_d | default: 12 }}px !important;
    }
  }

  /* ---- Desktop typography sizes + spacing ---- */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .ft-title,
    #shopify-section-{{ section.id }} .ft-title * { font-size: {{ section.settings.title_size_d | default: 14 }}px !important; }
    #shopify-section-{{ section.id }} .ft-link,
    #shopify-section-{{ section.id }} .ft-link * { font-size: {{ section.settings.link_size_d | default: 14 }}px !important; }
    #shopify-section-{{ section.id }} .ft-heading,
    #shopify-section-{{ section.id }} .ft-heading * { font-size: {{ section.settings.heading_size_d | default: 20 }}px !important; }
    #shopify-section-{{ section.id }} .ft-body,
    #shopify-section-{{ section.id }} .ft-body * { font-size: {{ section.settings.body_size_d | default: 14 }}px !important; }

    #shopify-section-{{ section.id }} .ft-main-d {
      padding-top: {{ section.settings.main_pt_d | default: 48 }}px !important;
      padding-bottom: {{ section.settings.main_pb_d | default: 48 }}px !important;
      padding-left: {{ section.settings.main_pl_d | default: 0 }}px !important;
      padding-right: {{ section.settings.main_pr_d | default: 0 }}px !important;
    }
    #shopify-section-{{ section.id }} .ft-cols-d { gap: {{ section.settings.col_gap_d | default: 80 }}px !important; }
    {% if section.settings.cols_divider_d %}
      /* Vertical divider between menu columns (left) and newsletter (right). */
      #shopify-section-{{ section.id }} .ft-right-d {
        border-left: {{ section.settings.cols_divider_width_d | default: 1 }}px solid {{ section.settings.cols_divider_color_d | default: 'rgba(0,0,0,0.12)' }} !important;
        padding-left: {{ section.settings.cols_divider_pad_d | default: 40 }}px !important;
      }
    {% endif %}
    #shopify-section-{{ section.id }} .ft-menu-d {
      gap: {{ section.settings.menu_gap_d | default: 48 }}px !important;
      {% case section.settings.menu_layout_d %}
        {% when 'tight_left'   %}justify-content: flex-start  !important;
        {% when 'tight_center' %}justify-content: center      !important;
        {% when 'tight_right'  %}justify-content: flex-end    !important;
      {% endcase %}
    }
    {% if section.settings.menu_layout_d != blank and section.settings.menu_layout_d != 'spread' %}
    /* Tight mode: let columns shrink to their content so `gap` actually
       controls the space between them. Overrides Tailwind's w-1/4. */
    #shopify-section-{{ section.id }} .ft-menu-d > div { width: auto !important; }
    {% endif %}
    #shopify-section-{{ section.id }} .ft-title-mb-d { margin-bottom: {{ section.settings.title_mb_d | default: 16 }}px !important; }
    #shopify-section-{{ section.id }} .ft-link-row-d  { margin-top: 0 !important; margin-bottom: {{ section.settings.link_gap_d | default: 12 }}px !important; }
    #shopify-section-{{ section.id }} .ft-sub-d {
      padding-top: {{ section.settings.sub_pt_d | default: 16 }}px !important;
      padding-bottom: {{ section.settings.sub_pb_d | default: 16 }}px !important;
      padding-left: {{ section.settings.sub_pl_d | default: 0 }}px !important;
      padding-right: {{ section.settings.sub_pr_d | default: 0 }}px !important;
    }
    {% unless section.settings.sub_border_top_d %}
      #shopify-section-{{ section.id }} .ft-sub-d { border-top: 0 !important; }
    {% endunless %}

    {%- comment -%} ----- Desktop background overrides ----- {%- endcomment -%}
    {% if section.settings.desktop_bg_color != blank %}
      #shopify-section-{{ section.id }} .ft-nav-d,
      #shopify-section-{{ section.id }} .ft-sub-d {
        background: {{ section.settings.desktop_bg_color }} !important;
      }
    {% endif %}
    {% if section.settings.desktop_text_color != blank %}
      #shopify-section-{{ section.id }} .ft-nav-d,
      #shopify-section-{{ section.id }} .ft-nav-d a,
      #shopify-section-{{ section.id }} .ft-sub-d,
      #shopify-section-{{ section.id }} .ft-sub-d a {
        color: {{ section.settings.desktop_text_color }} !important;
      }
    {% endif %}
    {% if section.settings.desktop_newsletter_bg_color != blank %}
      /* Newsletter-specific desktop background (inside the right column) */
      #shopify-section-{{ section.id }} .ft-nav-d [data-nl-container] {
        background: {{ section.settings.desktop_newsletter_bg_color }} !important;
        {% if section.settings.desktop_newsletter_pad and section.settings.desktop_newsletter_pad > 0 %}
          padding: {{ section.settings.desktop_newsletter_pad }}px;
        {% endif %}
        {% if section.settings.desktop_newsletter_radius and section.settings.desktop_newsletter_radius > 0 %}
          border-radius: {{ section.settings.desktop_newsletter_radius }}px;
        {% endif %}
      }
    {% endif %}
  }

  /* ============================================================
     Force-remove any stray horizontal line at the very top of the
     footer — covers three possible sources:
       1. Borders on the footer's own outer wrappers / first child.
       2. A border-bottom on the last element of <main> (the section
          directly above the footer group).
       3. The ::before pseudo we draw on the first accordion.
     ============================================================ */
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} > footer,
  #shopify-section-{{ section.id }} > footer > *:first-child,
  #shopify-section-{{ section.id }} .ft-nav-d,
  #shopify-section-{{ section.id }} .ft-mobile-block:first-of-type,
  #shopify-section-{{ section.id }} .ft-acc-m:first-of-type {
    border-top: 0 !important;
    box-shadow: none !important;
    margin-top: 0 !important;
  }
  #shopify-section-{{ section.id }} .ft-acc-m:first-of-type::before,
  #shopify-section-{{ section.id }} .ft-acc-m:first-of-type::after + .ft-acc-m::before {
    display: none !important;
  }
  /* The section directly above the footer group can't cleanly be
     targeted from inside the footer (different DOM subtree), but a
     last-child selector on <main> works at the document level. */
  main > *:last-child,
  main > *:last-child > *:last-child {
    border-bottom: 0 !important;
    margin-bottom: 0 !important;
    box-shadow: none !important;
  }
  /* The Footer Group wrapper <section> and any wrapping div Shopify
     injects around this section — zero any top-edge styling. */
  section[aria-label="Footer Group"],
  section[aria-label="Footer Group"] > *:first-child {
    border-top: 0 !important;
    margin-top: 0 !important;
    box-shadow: none !important;
  }

  /* ---- Mobile spacing ---- */
  @media (max-width: 767.98px) {
    #shopify-section-{{ section.id }} .ft-accordion-btn {
      /* Horizontal padding ties to the divider inset so title + `+` icon
         line up with the divider line no matter what value is chosen. */
      padding-top:    {{ section.settings.acc_btn_pad_v_m | default: 16 }}px !important;
      padding-bottom: {{ section.settings.acc_btn_pad_v_m | default: 16 }}px !important;
      padding-left:   {{ section.settings.acc_divider_inset_m | default: 16 }}px !important;
      padding-right:  {{ section.settings.acc_divider_inset_m | default: 16 }}px !important;
    }
    #shopify-section-{{ section.id }} .ft-accordion-item {
      padding-top:    {{ section.settings.acc_item_pad_v_m | default: 16 }}px !important;
      padding-bottom: {{ section.settings.acc_item_pad_v_m | default: 16 }}px !important;
      padding-left:   {{ section.settings.acc_divider_inset_m | default: 16 }}px !important;
      padding-right:  {{ section.settings.acc_divider_inset_m | default: 16 }}px !important;
    }
    {% unless section.settings.sub_border_top_m %}
      #shopify-section-{{ section.id }} .ft-sub-m { border-top: 0 !important; }
    {% endunless %}
    {% unless section.settings.block_border_top_m %}
      /* Removes the line that sits above the mobile newsletter / content
         block (hard-coded `border--t-width` in the markup). */
      #shopify-section-{{ section.id }} .ft-mobile-block { border-top: 0 !important; }
    {% endunless %}
    #shopify-section-{{ section.id }} .ft-mobile-block {
      padding-top: {{ section.settings.mob_block_pt_m | default: 32 }}px !important;
      padding-bottom: {{ section.settings.mob_block_pb_m | default: 32 }}px !important;
    }
    #shopify-section-{{ section.id }} .ft-social-m {
      padding-top: {{ section.settings.social_pt_m | default: 32 }}px !important;
      padding-bottom: {{ section.settings.social_pb_m | default: 32 }}px !important;
      padding-left: {{ section.settings.social_pad_h_m | default: 16 }}px !important;
      padding-right: {{ section.settings.social_pad_h_m | default: 16 }}px !important;
      {% if section.settings.social_border_top_m %}border-top: {{ section.settings.social_border_top_width_m | default: 1 }}px solid {{ section.settings.social_border_top_color_m | default: 'rgba(255,255,255,0.15)' }};{% endif %}
    }
    #shopify-section-{{ section.id }} .ft-social-heading-m {
      margin-bottom: {{ section.settings.social_heading_mb_m | default: 16 }}px !important;
      font-size: {{ section.settings.social_heading_size_m | default: 14 }}px !important;
      letter-spacing: {{ section.settings.social_heading_ls_m | default: '0.08em' }} !important;
      text-transform: {{ section.settings.social_heading_case_m | default: 'uppercase' }} !important;
      {% if section.settings.social_heading_color_m != blank %}color: {{ section.settings.social_heading_color_m }} !important;{% endif %}
    }
    #shopify-section-{{ section.id }} .ft-social-row-m {
      gap: {{ section.settings.social_gap_m | default: 16 }}px !important;
    }
    #shopify-section-{{ section.id }} .ft-social-icon-m {
      width: {{ section.settings.social_icon_hit_m | default: 40 }}px !important;
      height: {{ section.settings.social_icon_hit_m | default: 40 }}px !important;
      opacity: {{ section.settings.social_opacity_m | default: 85 | divided_by: 100.0 }} !important;
      {% if section.settings.social_icon_color_m != blank %}color: {{ section.settings.social_icon_color_m }} !important;{% endif %}
      {% if section.settings.social_icon_style_m == 'circle_outline' %}
        border: {{ section.settings.social_border_width_m | default: 1 }}px solid {{ section.settings.social_border_color_m | default: 'currentColor' }};
        border-radius: 50%;
      {% elsif section.settings.social_icon_style_m == 'circle_fill' %}
        background: {{ section.settings.social_border_color_m | default: '#ffffff' }};
        color: {{ section.settings.social_icon_color_m | default: '#000000' }} !important;
        border-radius: 50%;
      {% endif %}
    }
    #shopify-section-{{ section.id }} .ft-social-icon-m svg {
      width: {{ section.settings.social_icon_size_m | default: 18 }}px !important;
      height: {{ section.settings.social_icon_size_m | default: 18 }}px !important;
    }
    #shopify-section-{{ section.id }} .ft-sub-m {
      padding-top: {{ section.settings.sub_pt_m | default: 16 }}px !important;
      padding-bottom: {{ section.settings.sub_pb_m | default: 16 }}px !important;
    }

    {%- comment -%} ----- Mobile background overrides ----- {%- endcomment -%}
    {% if section.settings.mobile_bg_color != blank %}
      #shopify-section-{{ section.id }} .ft-acc-m,
      #shopify-section-{{ section.id }} .ft-acc-m > button,
      #shopify-section-{{ section.id }} .ft-acc-m .accordion-content,
      #shopify-section-{{ section.id }} .ft-acc-m nav,
      #shopify-section-{{ section.id }} .ft-mobile-block,
      #shopify-section-{{ section.id }} .ft-social-m,
      #shopify-section-{{ section.id }} .ft-sub-m {
        background: {{ section.settings.mobile_bg_color }} !important;
      }
    {% endif %}
    {% if section.settings.mobile_text_color != blank %}
      #shopify-section-{{ section.id }} .ft-acc-m,
      #shopify-section-{{ section.id }} .ft-acc-m button,
      #shopify-section-{{ section.id }} .ft-acc-m a,
      #shopify-section-{{ section.id }} .ft-mobile-block,
      #shopify-section-{{ section.id }} .ft-mobile-block a,
      #shopify-section-{{ section.id }} .ft-social-m,
      #shopify-section-{{ section.id }} .ft-sub-m {
        color: {{ section.settings.mobile_text_color }} !important;
      }
    {% endif %}
    {% if section.settings.mobile_newsletter_bg_color != blank %}
      /* Newsletter block gets its own mobile bg, overriding the footer-wide color. */
      #shopify-section-{{ section.id }} .ft-mobile-block:has([data-nl-container]) {
        background: {{ section.settings.mobile_newsletter_bg_color }} !important;
      }
    {% endif %}

    {%- comment -%} ----- Accordion dividers (inset from edges) ----- {%- endcomment -%}
    #shopify-section-{{ section.id }} .ft-acc-m {
      position: relative;
      border-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} .ft-acc-m::after {
      content: "";
      position: absolute;
      left:   {{ section.settings.acc_divider_inset_m | default: 0 }}px;
      right:  {{ section.settings.acc_divider_inset_m | default: 0 }}px;
      bottom: 0;
      height: {{ section.settings.acc_divider_width_m | default: 1 }}px;
      background: {{ section.settings.acc_divider_color_m | default: 'rgba(255,255,255,0.15)' }};
      pointer-events: none;
    }
    {% if section.settings.acc_divider_show_top_m %}
      #shopify-section-{{ section.id }} .ft-acc-m:first-of-type::before {
        content: "";
        position: absolute;
        left:   {{ section.settings.acc_divider_inset_m | default: 0 }}px;
        right:  {{ section.settings.acc_divider_inset_m | default: 0 }}px;
        top: 0;
        height: {{ section.settings.acc_divider_width_m | default: 1 }}px;
        background: {{ section.settings.acc_divider_color_m | default: 'rgba(255,255,255,0.15)' }};
        pointer-events: none;
      }
    {% endif %}
  }
</style>

<footer class="{{ section.settings.visibility }} relative z-30"
  x-intersect:enter="scroll_up_force = true;"
  x-intersect:leave="scroll_up_force = false;"
  x-data="{ accordion: null }">

  {% comment %} mobile menu {% endcomment %}
  {% for block in section.blocks %}
    {%- case block.type -%}
      {%- when 'menu' -%}
        {% capture menu_content %}
          <!-- mobile menu -->
          <nav class="color__bg-secondary color__light">
              {%- for link in block.settings.menu.links -%}
                {% if link.levels >= 1 %}
                    {% capture accordion_content %}
                    {% for child_link in link.links %}
                        <a href="{{ child_link.url }}"
                        class="ft-link ft-accordion-item type__body border--t-width flex items-center justify-between w-full px-4 py-4 pl-8 no-underline
                            {{ section.settings.main_color_border }}">
                        {{ child_link.title }}
                        </a>
                        {% for grandchild_link in child_link.links %}
                        <a href="{{ grandchild_link.url }}"
                            class="ft-link ft-accordion-item type__body border--t-width flex items-center justify-between w-full px-4 py-4 pl-12 no-underline
                            {{ section.settings.main_color_border }}">
                            {{ grandchild_link.title }}
                        </a>
                        {% endfor %}
                    {% endfor %}
                    {% endcapture %}
                    {% capture accordion_container_class %}
                        border--t-width {{ section.settings.main_color_border }} no-js--hide
                    {% endcapture %}
                    {% capture accordion_inner_class %}{% endcapture %}

                    {% render 'component__accordion', 
                    button_label: link.title, 
                    button_class: "px-4",
                    container_class: accordion_container_class,
                    inner_class: accordion_inner_class
                    content: accordion_content %}

                    <noscript>
                        <a class="border--t-width {{ section.settings.main_color_border }} block w-full p-4 no-underline" href="{{ link.url }}">{{ link.title }}</a>
                        {% for child_link in link.links %}
                            <a class="border--t-width {{ section.settings.main_color_border }} block w-full p-4 !pl-8 no-underline" href="{{ child_link.url }}">{{ child_link.title }}</a>
                            {% for grandchild_link in child_link.links %}
                            <a class="border--t-width {{ section.settings.main_color_border }} block w-full p-4 !pl-12 no-underline" href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>
                            {% endfor %}
                        {% endfor %}
                    </noscript>
                {% else %}
                    
                  {%- if link.url contains 'https://' -%}
                    <a href="{{ link.url }}" target="_blank"
                    class="ft-link ft-accordion-item border--t-width block p-4 no-underline
                    {{ section.settings.main_color_border }}">
                        {{ link.title }}
                    </a>
                  {%- else -%}
                      <a href="{{ link.url }}"
                      class="ft-link ft-accordion-item border--t-width block p-4 no-underline
                      {{ section.settings.main_color_border }}">
                          {{ link.title }}
                      </a>
                  {%- endif -%}

                {% endif %}
                
              {%- endfor -%}
          </nav>
          {% capture menu_title %}{{ block.settings.block_title }}{% endcapture %} 
        {% endcapture %}

        {% render 'component__accordion',
          open: false,
          index:forloop.index,
          container_class: "ft-acc-m md:hidden",
          icon_class: "color__light",
          inner_class: "color__bg-overlay-1",
          button_class: "ft-title ft-accordion-btn px-4 color__bg-secondary color__light focus:outline-0",
          button_label: menu_title,
          content: menu_content
        %}

      {%- when 'location' -%}
        {% capture location_content %}
          <!-- mobile location -->
          <div class="md:hidden color__bg-secondary color__light w-full">
              <p href="{{ link.url }}" class="ft-body ft-accordion-item block no-underline type__body normal-case !mb-0 p-4">
                  {{ block.settings.block_text }}
              </p>
          </div>
          {% capture location_title %}{{ block.settings.block_title }}{% endcapture %}
        {% endcapture %}
        {% render 'component__accordion',
          open: false,
          index:forloop.index,
          button_label: location_title,
          button_class: "ft-title ft-accordion-btn px-4 color__bg-secondary color__light focus:outline-0",
          container_class: "ft-acc-m md:hidden",
          icon_class: "color__light",
          inner_class: "color__bg-overlay-1",
          content: location_content
        %}

      {%- when 'newsletter' -%}
        <!-- mobile newsletter (Attentive) -->
        <section class="ft-mobile-block py-8 md:hidden
          {{ section.settings.main_color_scheme }}
          {{ section.settings.main_color_border }}">
          <div class="{{ settings.layout_horizontal }} ft-nl-{{ block.id }}" data-nl-container>
            <div data-nl-body>
              {%- unless block.settings.heading == blank -%}
                <h3 class="ft-heading type__heading type__heading--bold-5" style="margin:0 0 {{ block.settings.heading_mb | default: 8 }}px 0;">
                  {{ block.settings.heading }}
                </h3>
              {%- endunless -%}

              {%- unless block.settings.content == blank -%}
                <div class="ft-body m-0--clear" style="margin:0 0 {{ block.settings.content_mb | default: 8 }}px 0;">
                  {{ block.settings.content }}
                </div>
              {%- endunless -%}

              {% render 'footer__newsletter-form', block: block, breakpoint: 'mobile' %}

              {%- unless block.settings.disclaimer == blank -%}
                <div class="ft-body m-0--clear type--smaller opacity-75" style="margin:{{ block.settings.disclaimer_mt | default: 8 }}px 0 0;">
                  {{ block.settings.disclaimer }}
                </div>
              {%- endunless -%}
            </div>
            {% render 'footer__newsletter-success', block: block %}
          </div>
        </section>
        {% render 'footer__newsletter-script', block: block %}

      {%- when 'content' -%}
        <!-- mobile content -->
        <div class="ft-mobile-block py-8 md:hidden
          {{ section.settings.main_color_scheme }}
          {{ section.settings.main_color_border }}">
          <div class="{{ settings.layout_horizontal }}">
          <h3 class="ft-heading type__heading type__heading--bold-5 mb-2">
              {{ block.settings.heading }}
          </h3>
          <div class="ft-body m-0--clear">
              {{ block.settings.content }}
          </div>

          {%- unless block.settings.button_url == blank -%}
              <a href="{{ block.settings.button_url }}" class="btn btn--smaller mt-2 !w-full {{ section.settings.main_color_button }}">
              {{ block.settings.button_label }}
              </a>
          {%- endunless -%}

          </div>
        </div>

    {%- endcase -%}
  {% endfor %}

  {% comment %} mobile social icons (Allbirds-style: heading + icons in a row) {% endcomment %}
  {%- assign _social_platforms = 'tiktok,instagram,twitter,facebook,pinterest,snapchat,tumblr,discord,linkedin,twitch,youtube,vimeo' | split: ',' -%}
  {%- assign _social_titles = 'TikTok,Instagram,Twitter,Facebook,Pinterest,Snapchat,Tumblr,Discord,LinkedIn,Twitch,YouTube,Vimeo' | split: ',' -%}
  <section class="ft-social-m md:hidden flex flex-col items-center color__bg-secondary color__light w-full">
    {%- if section.settings.social_heading_m != blank -%}
      <div class="ft-social-heading-m ft-title">{{ section.settings.social_heading_m }}</div>
    {%- endif -%}
    <div class="ft-social-row-m flex flex-wrap items-center justify-center">
      {%- for _p in _social_platforms -%}
        {%- assign _link_key = 'social_' | append: _p | append: '_link' -%}
        {%- assign _link = settings[_link_key] -%}
        {%- unless _link == blank -%}
          <a href="{{ _link }}" target="_blank" rel="noopener" title="{{ _social_titles[forloop.index0] }}" class="ft-social-icon-m inline-flex items-center justify-center no-underline hover:no-underline">
            {% render 'component__icon', icon: _p, size: '20', class: '' %}
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>


  {% comment %} desktop nav {% endcomment %}
  <nav aria-label="Footer Navigation" class="ft-nav-d hidden md:block
    {{ section.settings.main_color_scheme }}">
    <div class="window--wide">
      <div class="ft-cols-d ft-main-d flex justify-between gap-20 py-12 overflow-hidden relative">

        {% comment %} menu and locations {% endcomment %}
        <div class="ft-menu-d grow flex justify-between gap-12
          {% if has_content %}w-3/4 {% else %}w-full {% endif %}">
          {% for block in section.blocks %}
          {%- case block.type -%}

            {%- when 'menu' -%}
              <div class="w-1/4">
                <strong class="ft-title ft-title-mb-d block type__nav">{{ block.settings.block_title }}</strong>
                {%- for link in block.settings.menu.links -%}

                        {%- if link.url contains 'https://' -%}
                            <a href="{{ link.url }}" target='_blank' class="ft-link ft-link-row-d block mb-4 no-underline type__body type--small normal-case
                                {% if forloop.index > 1 %}mt-4{% else %}mt-6{% endif %}">
                                {{ link.title }}
                            </a>
                        {%- else -%}
                            <a href="{{ link.url }}" class="ft-link ft-link-row-d block mb-4 no-underline type__body type--small normal-case
                                {% if forloop.index > 1 %}mt-4{% else %}mt-6{% endif %}">
                                {{ link.title }}
                            </a>
                        {%- endif -%}

                    {% for child_link in link.links %}
                        <a href="{{ child_link.url }}" class="ft-link block mb-2 no-underline">
                        {{ child_link.title }}
                        </a>
                        {% for grandchild_link in child_link.links %}
                            <a href="{{ grandchild_link.url }}" class="ft-link block mb-2 no-underline">
                                {{ grandchild_link.title }}
                            </a>
                        {% endfor %}
                    {% endfor %}
                {%- endfor -%}
              </div>

            {%- when 'location' -%}
              <div class="w-1/4">
                <strong class="ft-title ft-title-mb-d block type__nav">{{ block.settings.block_title }}</strong>
                <p href="{{ link.url }}" class="ft-body block mb-4 no-underline type__body type--small mt-6 normal-case">
                    {{ block.settings.block_text }}
                </p>
              </div>

          {%- endcase -%}
          {% endfor %}
        </div>

        {% comment %} extra stuff {% endcomment %}
        {% if has_content %}
          {%- capture _ft_social_d -%}
            <div class="md:w-auto flex w-full gap-2">
              {% unless settings.social_tiktok_link == blank %}
                <a href="{{ settings.social_tiktok_link }}" target="_blank" title="TikTok" class="hover:no-underline inline-flex no-underline opacity-75 pr-2">
                  {% render 'component__icon', icon: 'tiktok', size: '20', class: '' %}
                </a>
              {% endunless %}
              {% unless settings.social_instagram_link == blank %}
                <a href="{{ settings.social_instagram_link }}" target="_blank" title="Instagram" class="hover:no-underline inline-flex no-underline opacity-75 px-2">
                  {% render 'component__icon', icon: 'instagram', size: '20', class: '' %}
                </a>
              {% endunless %}
              {% unless settings.social_twitter_link == blank %}
                <a href="{{ settings.social_twitter_link }}" target="_blank" title="Twitter" class="hover:no-underline inline-flex no-underline opacity-75">
                  {% render 'component__icon', icon: 'twitter', size: '20', class: '' %}
                </a>
              {% endunless %}
              {% unless settings.social_facebook_link == blank %}
                <a href="{{ settings.social_facebook_link }}" target="_blank" title="Facebook" class="hover:no-underline inline-flex no-underline opacity-75 px-2">
                  {% render 'component__icon', icon: 'facebook', size: '20', class: '' %}
                </a>
              {% endunless %}
              {% unless settings.social_pinterest_link == blank %}
                <a href="{{ settings.social_pinterest_link }}" target="_blank" title="Pinterest" class="hover:no-underline inline-flex no-underline opacity-75">
                  {% render 'component__icon', icon: 'pinterest', size: '20', class: '' %}
                </a>
              {% endunless %}
              {% unless settings.social_snapchat_link == blank %}
                <a href="{{ settings.social_snapchat_link }}" target="_blank" title="Snapchat" class="hover:no-underline inline-flex no-underline opacity-75">
                  {% render 'component__icon', icon: 'snapchat', size: '20', class: '' %}
                </a>
              {% endunless %}
              {% unless settings.social_tumblr_link == blank %}
                <a href="{{ settings.social_tumblr_link }}" target="_blank" title="Tumblr" class="hover:no-underline inline-flex no-underline opacity-75">
                  {% render 'component__icon', icon: 'tumblr', size: '20', class: '' %}
                </a>
              {% endunless %}
              {% unless settings.social_discord_link == blank %}
                <a href="{{ settings.social_discord_link }}" target="_blank" title="Discord" class="hover:no-underline inline-flex no-underline opacity-75">
                  {% render 'component__icon', icon: 'discord', size: '20', class: '' %}
                </a>
              {% endunless %}
              {% unless settings.social_linkedin_link == blank %}
                <a href="{{ settings.social_linkedin_link }}" target="_blank" title="LinkedIn" class="hover:no-underline inline-flex no-underline opacity-75">
                  {% render 'component__icon', icon: 'linkedin', size: '20', class: '' %}
                </a>
              {% endunless %}
              {% unless settings.social_twitch_link == blank %}
                <a href="{{ settings.social_twitch_link }}" target="_blank" title="Twitch" class="hover:no-underline inline-flex no-underline opacity-75">
                  {% render 'component__icon', icon: 'twitch', size: '20', class: '' %}
                </a>
              {% endunless %}
              {% unless settings.social_youtube_link == blank %}
                <a href="{{ settings.social_youtube_link }}" target="_blank" title="YouTube" class="hover:no-underline inline-flex no-underline opacity-75 pl-2">
                  {% render 'component__icon', icon: 'youtube', size: '20', class: '' %}
                </a>
              {% endunless %}
              {% unless settings.social_vimeo_link == blank %}
                <a href="{{ settings.social_vimeo_link }}" target="_blank" title="Vimeo" class="hover:no-underline inline-flex no-underline opacity-75">
                  {% render 'component__icon', icon: 'vimeo', size: '20', class: '' %}
                </a>
              {% endunless %}
            </div>
          {%- endcapture -%}

          <div class="ft-right-d flex flex-col items-end w-1/4 gap-12">

            {% if section.settings.social_position_d != 'below' %}
              <!-- social icons (above) -->
              {{ _ft_social_d }}
            {% endif %}

            {% comment %} newsletter, content {% endcomment %}
            {% for block in section.blocks %}
            {%- case block.type -%}

              {%- when 'newsletter' -%}
                <!-- desktop newsletter (Attentive) -->
                <div data-nl-container class="ft-nl-{{ block.id }}">
                  <div data-nl-body>
                    {%- unless block.settings.heading == blank -%}
                      <h3 class="ft-heading type__heading type--base" style="margin:0 0 {{ block.settings.heading_mb | default: 8 }}px 0;">
                        {{ block.settings.heading }}
                      </h3>
                    {%- endunless -%}

                    {%- unless block.settings.content == blank -%}
                      <div class="ft-body m-0--clear" style="margin:0 0 {{ block.settings.content_mb | default: 8 }}px 0;">
                        {{ block.settings.content }}
                      </div>
                    {%- endunless -%}

                    {% render 'footer__newsletter-form', block: block, breakpoint: 'desktop' %}

                    {%- unless block.settings.disclaimer == blank -%}
                      <div class="ft-body m-0--clear type--smaller opacity-75" style="margin:{{ block.settings.disclaimer_mt | default: 8 }}px 0 0;">
                        {{ block.settings.disclaimer }}
                      </div>
                    {%- endunless -%}
                  </div>
                  {% render 'footer__newsletter-success', block: block %}
                </div>

              {%- when 'content' -%}
                <div>
                  <h3 class="ft-heading type__heading type--base mb-2">
                      {{ block.settings.heading }}
                  </h3>
                  <div class="ft-body m-0--clear">
                      {{ block.settings.content }}
                  </div>
                  {%- unless block.settings.button_url == blank -%}
                      <a href="{{ block.settings.button_url }}" class="btn btn--small mt-2
                      {{ section.settings.main_color_button }}">
                      {{ block.settings.button_label }}
                      </a>
                  {%- endunless -%}
                </div>

            {%- endcase -%}
            {% endfor %}

            {% if section.settings.social_position_d == 'below' %}
              <!-- social icons (below) -->
              {{ _ft_social_d }}
            {% endif %}

          </div>
        {% endif %}

      </div>
      
    </div>
  </nav>

  {%- comment -%} sub footer {%- endcomment -%}
  <section class="ft-sub-d ft-sub-m py-4 border--t-width flex flex-wrap gap-4 md:bg-transparent color__bg-secondary color__light">
    <div class="flex flex-wrap w-full items-center justify-between gap-4 window--wide">

    {% if settings.enable_region or settings.enable_language or settings.enable_audio %}
      <div class="md:w-auto flex flex-wrap w-full gap-2">
        {% if settings.enable_audio %}
          <button  
            class="btn btn--smaller {{ section.settings.sub_color_button }}"
            @click="audio_popup = true;">
            <span x-show="enable_audio == false">{{ 'general.media.audio_off' | t }}</span> 
            <span x-show="enable_audio == true">{{ 'general.media.audio_on' | t }}</span> 
          </button>
      {% endif %}
          {% if settings.enable_region or settings.enable_language %}
            <button class="btn btn--smaller {{ section.settings.sub_color_button }}" @click="localization_popup = true;">
              <span class="fi type--smaller" style="background-image: url(https://flagicons.lipis.dev/flags/4x3/{{ localization.country.iso_code | downcase }}.svg)"></span>
              <span class="type--smaller ml-1">{{ localization.country.currency.symbol }} {{ localization.country.currency.iso_code }}
              {% if settings.type_seperator == 'dot' %}·{% else %}|{% endif %}
              {{ localization.language.iso_code | upcase }}</span> 
              {% render 'component__icon', icon: 'chevron-down', size: '16' %}
            </button>
          {% endif %}
      </div>
    {% endif %}

    <div class="text-center md:w-auto md:text-left flex flex-wrap flex-1 w-full gap-1">
      {% if section.settings.sub_enable_payment_icons %}
        <ul class="flex flex-wrap w-full gap-2 p-0 list-none" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            </li>
          {%- endfor -%}
        </ul>
      {% endif %}
      <div class="ft-body ft-sub-text m-0--clear type--smaller w-full md:text-black">
        {{ shop.name }}
        {% capture current_year %}{{ "now" | date: "%Y" }}{% endcapture %}
        {{ 'general.footer.copyright' | t: y: current_year }}
      </div>
    </div>

    </div>
  </section>
  
</footer>

