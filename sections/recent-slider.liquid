    {
      "type": "select",
      "id": "layout_horizontal",
      "label": "t:settings_schema.layout.settings.layout_horizontal.label",
      "options": [
        {
          "value": "window--narrow",
          "label": "t:settings_schema.layout.settings.layout_horizontal.options__1.label"
        },
        {
          "value": "window",
          "label": "t:settings_schema.layout.settings.layout_horizontal.options__2.label"
        },
        {
          "value": "window--wide",
          "label": "t:settings_schema.layout.settings.layout_horizontal.options__3.label"
        },
        {
          "value": "window--full",
          "label": "t:settings_schema.layout.settings.layout_horizontal.options__4.label"
        }
