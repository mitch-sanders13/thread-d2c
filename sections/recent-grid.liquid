<!-- sections/recent-grid.liquid -->
{% comment %}
  Slider of recently viewed products.

  Globals:
    - settings.layout_horizontal: horizontaly margin
    - settings.thumbnails_border_style: border style of thumbnails
    - settings.thumbnails_color_border: border color
    - settings.thumbmails_color_scheme: color scheme of thumbnails
    - settings.thumbnails_ratio: set the aspect ratio of thumbnails
    - settings.thumbnails_object: set the image object sizing
    - settings.enable_quick_desktop: boolean to enable quick add
    - settings.enable_quick_mobile: boolean to enable quick add
    - settings.type_seperator: setting to pick the type of seperator between text text
    - settings.enable_thumbnails_product_type: boolean to enable product type
    - settings.enable_thumbnails_vendor: boolean to enable vendor
    - settings.enable_thumbnails_variant_count: boolean to enable variant count

  Possible enhancements:
    - Break this up into re-useable snippets.

  Pro tips:
    - {% render 'script__recent-view' %} is used to tag products as viewed.
{% endcomment %}

{%- comment -%}
  Recently Viewed is hidden on collection pages — it caused perceived
  duplicates when a recently-visited product also appeared in the grid
  above. Other templates (PDP, homepage, etc.) still render it.
{%- endcomment -%}
{%- unless template.name == 'collection' -%}
<section
  class="
    {{ section.settings.visibility }}
    {{ section.settings.color_scheme }}
    {{ section.settings.color_border }}
    {{ section.settings.style_border }}
  "
  data-recent-grid-section
  style="display: none;"
>
  <div
    class="
      !px-0
      {{ section.settings.layout_horizontal }}
    "
    style="
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;
    "
  >
    {%- comment -%}header{%- endcomment -%}
    <div class="flex flex-row flex-wrap items-end justify-center gap-2 py-15 px-4 pb-4">
      <div class="max-w-prose">
        {%- unless section.settings.heading == blank -%}
          <h3 aria-level="2">{{ section.settings.heading }}</h3>
        {%- endunless -%}
        {%- unless section.settings.content == blank -%}
          <div class="m-0--clear">
            {{ section.settings.content }}
          </div>
        {%- endunless -%}
      </div>
    </div>

    {%- comment -%}skeleton loader — replaced by the real cards once fetched{%- endcomment -%}
    <div data-recent-grid-skeleton>
      <div
        class="grid flex-wrap justify-start w-full grid-cols-2 px-4 whitespace-nowrap md:grid-cols-4"
        style="
          column-gap: {{ settings.layout_gap_size }}px;
          row-gap: {{ settings.layout_gap_size | times: 1.5 }}px;
        "
      >
        <div class="flex justify-center snap-center">
          {% render 'component__skeleton-grid-item' %}
        </div>
        <div class="flex justify-center snap-center">
          {% render 'component__skeleton-grid-item' %}
        </div>
      </div>
    </div>

    {%- comment -%}
      Results grid. Cards are fetched server-rendered via the Section
      Rendering API (/products/<handle>?section_id=recent-card) so each
      one goes through component__product-item — identical markup and
      theme settings to the collection grid cards. The old client-side
      Alpine template (template__product-item) drew its own simplified
      card that drifted out of sync with the Product card settings.
    {%- endcomment -%}
    <div
      class="grid flex-wrap justify-between w-full grid-cols-2 px-4 md:grid-cols-4"
      style="
        column-gap: {{ settings.layout_gap_size }}px;
        row-gap: {{ settings.layout_gap_size | times: 1.5 }}px;
        display: none;
      "
      data-recent-grid
    ></div>
  </div>
</section>

<script>
  (function () {
    function init() {
      var sectionEl = document.querySelector('[data-recent-grid-section]');
      var grid = document.querySelector('[data-recent-grid]');
      var skeleton = document.querySelector('[data-recent-grid-skeleton]');
      if (!sectionEl || !grid) return;

      var items = [];
      try {
        items = JSON.parse(localStorage.getItem('recentlyViewedProducts') || '[]');
      } catch (e) { items = []; }

      {% if template.name == 'product' %}
      var currentHandle = {{ product.handle | json }};
      items = items.filter(function (p) { return p && p.handle !== currentHandle; });
      {% endif %}

      items = items.filter(function (p) {
        if (!p || !p.handle || !p.url) return false;
        if (p.available === false) return false;
        var tags = p.tags || [];
        if (typeof tags === 'string') tags = tags.split(',');
        return !tags.some(function (t) {
          return String(t).trim().toLowerCase() === 'hiderecommendation';
        });
      }).slice(0, 4);

      if (!items.length) return; // section stays hidden

      sectionEl.style.display = '';

      Promise.all(items.map(function (p) {
        return fetch('/products/' + encodeURIComponent(p.handle) + '?section_id=recent-card')
          .then(function (r) { return r.ok ? r.text() : ''; })
          .catch(function () { return ''; });
      })).then(function (htmls) {
        var added = 0;
        htmls.forEach(function (html) {
          if (!html) return;
          var tpl = document.createElement('template');
          tpl.innerHTML = html;
          var card = tpl.content.querySelector('[data-recent-card]');
          /* component__product-item renders nothing for hidden products
           * (hideproduct tag, collegiate outside its collection) — skip
           * empty cards so we don't leave blank grid cells. */
          if (!card || card.children.length === 0) return;
          grid.appendChild(card);
          added++;
        });
        if (!added) { sectionEl.style.display = 'none'; return; }
        if (skeleton) skeleton.style.display = 'none';
        grid.style.display = '';
        if (window.okeWidgetApi && typeof window.okeWidgetApi.initAllWidgets === 'function') {
          setTimeout(function () { window.okeWidgetApi.initAllWidgets(); }, 100);
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{% render 'component__collection-description' %}
{%- endunless -%}

