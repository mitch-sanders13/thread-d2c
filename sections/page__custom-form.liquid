<!-- sections/page__custom-form.liquid -->
{% comment %} 
  Custom Form for requesting a price quote.
{% endcomment %}

<section class="tmp-{{ template.name | handle }}">
  <div class="px-0 max-w-full my-0 mx-auto">
    <div class="flex flex-col md:flex-row">

      <div class="flex flex-col color__bg-secondary h-full w-full md:w-1/2">
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: height: 5760 | image_tag: class: 'w-full h-full z-10'}}
        {%- endif -%}

        <div class="px-4 py-24 w-full my-0 mx-auto">
          <div class="flex justify-center flex-wrap">
            <div class="w-full md:w-4/5 lg:w-2/3 text-white">
              {{ section.settings.description }}
            </div>
          </div>
        </div>
        
      </div>

      <div class="w-full md:w-1/2 py-24">
        <div class="px-4 w-full my-0 mx-auto">
          <div class="flex justify-center flex-wrap">
            <div class="w-full md:w-4/5 lg:w-2/3">

                <h1 class="type--big mb-8">
                  {{ section.settings.title }}
                </h1>

                <!-- CUSTOMER FIELDS -->
                {% form 'contact' %}

                  {% if form.posted_successfully? %}
                    <p>
                      {{ 'contact.form.success' | t }}
                    </p>
                  {% endif %}
          
                  {% if form.errors %}
                    <div class="color__bg-overlay-1 type--small border--radius p-2 mb-4">
                      {{ form.errors | default_errors }}
                    </div>
                  {% endif %}

                  <div class="grid grid-cols-2 mb-4"
                    style="gap: {{ settings.layout_gap_size }}px;">
                    
                    <div>
                      <label class="type--base" for="ContactFormFirstName">{{ 'customer.account.first_name' | t }}:</label>
                      <input
                        type="text"
                        class="form-input"
                        name="contact[name]"
                        id="ContactFormFirstName"
                        placeholder="{{ 'customer.account.your' | t }}"
                        value="{% if form.first_name %}{{ form.first_name }}{% elsif customer %}{{ customer.first_name }}{% endif %}">
                    </div>
                    <div>
                      <label class="type--base" for="ContactFormLastName">{{ 'customer.account.last_name' | t }}:</label>
                      <input
                        type="text"
                        class="form-input"
                        name="contact[name]"
                        id="ContactFormLastName"
                        placeholder="{{ 'customer.account.name' | t }}"
                        value="{% if form.last_name %}{{ form.last_name }}{% elsif customer %}{{ customer.last_name }}{% endif %}">
                    </div>
                    
                  </div>
                    

                  <div class="mb-4">
                    <label class="type--base" for="CustomFormEmail">{{ 'contact.form.email' | t }}:</label>
                    <input
                      type="email"
                      class="form-input"
                      name="contact[email]"
                      id="CustomFormEmail"
                      placeholder="{{ 'contact.form.email_placeholder' | t }}"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      spellcheck="false"
                      autocomplete="off"
                      autocapitalize="off">
                  </div>

                  <div class="mb-4">
                    <label class="type--base" for="CustomFormCompany">{{ 'customer.addresses.company' | t }}:</label>
                    <input
                      type="text"
                      class="form-input"
                      name="contact[company]"
                      id="CustomFormCompany"
                      placeholder="{{ 'customer.addresses.company' | t }}"
                      value="{% if form.company %}{{ form.company }}{% elsif customer.current_company %}{{ customer.current_company }}{% endif %}"
                      spellcheck="false"
                      autocomplete="off"
                      autocapitalize="off">
                  </div>

                  <div class="mb-4">
                    <label class="type--base" for="CustomFormMessage">{{ 'contact.form.project' | t }}:</label>
                    <textarea
                      rows="10"
                      class="border--radius"
                      name="contact[body]"
                      id="CustomFormMessage"
                      placeholder="{{ 'contact.form.dots' | t }}">
                      {% if form.body %}
                        {{ form.body }}{% endif %}
                    </textarea>
                  </div>

                  <div class="mb-4">
                    <button class="btn btn--secondary h-full !w-full" type="submit">Submit</button>
                  </div>

                {% endform %}
                <!-- CUSTOMER FIELDS -->

            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
    "name": "[custom] Custom form",
    "settings": [
    {
        "type": "image_picker",
        "id": "image",
        "label": "Featured image"
    },
    {
        "type": "text",
        "id": "image_alt",
        "label": "Image alt tag"
    },
    {
        "type": "richtext",
        "id": "description",
        "label": "Description",
        "default": "<p>Default</p>"
    },
    {
        "type": "text",
        "id": "title",
        "label": "Title"
    }
    ],
    "presets": [
        {
            "name":"[custom] Custom form"
        }
    ]
}
{% endschema %}
