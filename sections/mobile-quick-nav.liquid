<!-- sections/mobile-quick-nav.liquid -->
{% comment %}
  Compact mobile-only quick-nav bar that sits under the header. 1-4 items
  spread evenly across the row — no horizontal scroll. Hides when the
  user scrolls down, slides back out from under the header on scroll-up.

  Positioning:
    - position: sticky; top: {header offset} — stays pinned just below
      the header as the page scrolls.
    - A scroll direction listener toggles `data-qn-hidden="true"` which
      applies `transform: translateY(-110%)` (plus a touch of headroom)
      to slide the bar up behind the header.

  Only renderable on the homepage (see `enabled_on.templates`).
{% endcomment %}

{%- assign _blocks_shown = 0 -%}
{%- for _b in section.blocks -%}
  {%- if _b.settings.label != blank -%}{%- assign _blocks_shown = _blocks_shown | plus: 1 -%}{%- endif -%}
{%- endfor -%}

{%- if _blocks_shown == 0 -%}{% comment %} nothing to render {% endcomment %}{%- else -%}

{%- capture _qn_id -%}qn-{{ section.id }}{%- endcapture -%}

{%- assign _fam = section.settings.item_font | default: 'nav' -%}
{%- capture _fam_var -%}var(--type-font-{% if _fam == 'heading' %}header{% else %}{{ _fam }}{% endif %}-family){%- endcapture -%}

<aside class="qn-wrap md:hidden{% if section.settings.visibility != blank %} {{ section.settings.visibility }}{% endif %}"
  id="{{ _qn_id }}"
  data-qn
  data-qn-hide-on-scroll="{{ section.settings.hide_on_scroll_down }}"
  style="position:sticky;top:0;z-index:20;transition:transform {{ section.settings.transition_ms | default: 250 }}ms ease;background:{{ section.settings.bg_color | default: '#ffffff' }};{% if section.settings.border_width > 0 %}{% if section.settings.border_side == 'top' or section.settings.border_side == 'both' %}border-top:{{ section.settings.border_width }}px solid {{ section.settings.border_color | default: '#e5e5e5' }};{% endif %}{% if section.settings.border_side == 'bottom' or section.settings.border_side == 'both' %}border-bottom:{{ section.settings.border_width }}px solid {{ section.settings.border_color | default: '#e5e5e5' }};{% endif %}{% endif %}"
  {{ section.shopify_attributes }}>

  <nav class="qn-row flex items-stretch"
    style="padding:{{ section.settings.row_pad_v | default: 12 }}px {{ section.settings.row_pad_h | default: 12 }}px;gap:{{ section.settings.item_gap | default: 0 }}px;">
    {% for block in section.blocks %}
      {% if block.settings.label != blank %}
        <a href="{{ block.settings.url | default: '#' }}"
          class="qn-item flex-1 text-center no-underline block"
          style="padding:{{ section.settings.item_pad_v | default: 4 }}px {{ section.settings.item_pad_h | default: 4 }}px;font-family:{{ _fam_var }};font-size:{{ section.settings.item_size | default: 14 }}px;font-weight:{{ section.settings.item_weight | default: '500' }};text-transform:{{ section.settings.item_case | default: 'none' }};letter-spacing:{{ section.settings.item_ls | default: '0em' }};line-height:{{ section.settings.item_lh | default: 1.3 }};color:{{ section.settings.item_color | default: '#1a1a1a' }};"
          {{ block.shopify_attributes }}>
          {{ block.settings.label }}
        </a>
      {% endif %}
    {% endfor %}
  </nav>
</aside>

<style>
  #{{ _qn_id }}[data-qn-hidden="true"] { transform: translateY(-110%); }
  #{{ _qn_id }} .qn-item:active,
  #{{ _qn_id }} .qn-item:focus,
  #{{ _qn_id }} .qn-item:hover { opacity: 1 !important; }
</style>

<script>
(function () {
  var el = document.getElementById('{{ _qn_id }}');
  if (!el || el.__qnWired) return;
  el.__qnWired = true;

  var THRESHOLD_PX  = {{ section.settings.scroll_threshold | default: 8 }};   // min |dy| to react
  var PIN_UNDER_PX  = {{ section.settings.pin_under_scroll | default: 80 }};  // below this scroll, always show
  var HIDE_ENABLED  = el.getAttribute('data-qn-hide-on-scroll') === 'true';

  var lastY = window.pageYOffset || 0;
  var hidden = false;

  function updateTop() {
    var header = document.querySelector('header');
    if (header) { el.style.top = header.offsetHeight + 'px'; }
  }

  function setHidden(next) {
    if (next === hidden) return;
    hidden = next;
    if (hidden) el.setAttribute('data-qn-hidden', 'true');
    else        el.removeAttribute('data-qn-hidden');
  }

  function onScroll() {
    var y = window.pageYOffset || 0;
    var dy = y - lastY;
    if (!HIDE_ENABLED) { lastY = y; return; }
    if (Math.abs(dy) < THRESHOLD_PX) return;
    if (y < PIN_UNDER_PX)  setHidden(false);
    else if (dy > 0)       setHidden(true);   // scrolling down
    else                   setHidden(false);  // scrolling up
    lastY = y;
  }

  updateTop();
  requestAnimationFrame(updateTop);
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', updateTop, { passive: true });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Mobile quick nav",
  "tag": "section",
  "class": "mobile-quick-nav-section",
  "settings": [
    { "type": "paragraph", "content": "Shows under the header on mobile only. Add up to 4 quick links. Hides on scroll down, slides back in on scroll up." },

    { "type": "header", "content": "Behavior" },
    { "type": "checkbox", "id": "hide_on_scroll_down", "label": "Hide on scroll down (show on scroll up)", "default": true },
    { "type": "range", "id": "pin_under_scroll", "label": "Always show when within this distance from top (px)", "min": 0, "max": 400, "step": 10, "default": 80 },
    { "type": "range", "id": "scroll_threshold", "label": "Scroll delta before reacting (px)", "info": "Lower = twitchier; higher = calmer.", "min": 1, "max": 40, "step": 1, "default": 8 },
    { "type": "range", "id": "transition_ms", "label": "Show/hide transition (ms)", "min": 0, "max": 600, "step": 10, "default": 250 },

    { "type": "header", "content": "Typography" },
    {
      "type": "select", "id": "item_font", "label": "Font",
      "options": [
        { "value": "body",        "label": "Body (Forma)" },
        { "value": "heading",     "label": "Heading (PP Right Grotesk)" },
        { "value": "nav",         "label": "Nav" },
        { "value": "handwritten", "label": "Handwritten" }
      ],
      "default": "nav"
    },
    { "type": "range", "id": "item_size", "label": "Font size (px)", "min": 10, "max": 22, "step": 1, "default": 14 },
    {
      "type": "select", "id": "item_weight", "label": "Weight",
      "options": [
        { "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" }
      ],
      "default": "500"
    },
    {
      "type": "select", "id": "item_case", "label": "Case",
      "options": [
        { "value": "none", "label": "Normal" }, { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "lowercase", "label": "lowercase" }, { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "select", "id": "item_ls", "label": "Letter spacing",
      "options": [
        { "value": "0em", "label": "None" }, { "value": "0.02em", "label": "Tight" },
        { "value": "0.05em", "label": "Normal" }, { "value": "0.08em", "label": "Wide" },
        { "value": "0.12em", "label": "Wider" }
      ],
      "default": "0em"
    },
    { "type": "range", "id": "item_lh",    "label": "Line height",  "min": 1.0, "max": 2.0, "step": 0.1, "default": 1.3 },
    { "type": "color", "id": "item_color", "label": "Text color",   "default": "#1a1a1a" },

    { "type": "header", "content": "Layout & spacing" },
    { "type": "range", "id": "row_pad_v",  "label": "Row vertical padding (px)",   "min": 0, "max": 32, "step": 1, "default": 12 },
    { "type": "range", "id": "row_pad_h",  "label": "Row horizontal padding (px)", "min": 0, "max": 40, "step": 1, "default": 12 },
    { "type": "range", "id": "item_pad_v", "label": "Item vertical padding (px)",  "min": 0, "max": 24, "step": 1, "default": 4 },
    { "type": "range", "id": "item_pad_h", "label": "Item horizontal padding (px)","min": 0, "max": 24, "step": 1, "default": 4 },
    { "type": "range", "id": "item_gap",   "label": "Gap between items (px)",      "min": 0, "max": 24, "step": 1, "default": 0 },

    { "type": "header", "content": "Background & border" },
    { "type": "color", "id": "bg_color",     "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Border color",     "default": "#e5e5e5" },
    { "type": "range", "id": "border_width", "label": "Border width (px)", "min": 0, "max": 4, "step": 1, "default": 1 },
    {
      "type": "select", "id": "border_side", "label": "Border side",
      "options": [
        { "value": "bottom", "label": "Bottom" },
        { "value": "top",    "label": "Top" },
        { "value": "both",   "label": "Top & bottom" },
        { "value": "none",   "label": "None" }
      ],
      "default": "bottom"
    },

    { "type": "header", "content": "Visibility" },
    {
      "type": "select", "id": "visibility", "label": "Show on",
      "options": [
        { "value": "", "label": "Mobile only" },
        { "value": "hidden", "label": "Hidden (preview off)" }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Quick link",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Wallets" },
        { "type": "url",  "id": "url",   "label": "Link URL", "info": "Link to any product, collection, or page." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile quick nav",
      "blocks": [
        { "type": "item", "settings": { "label": "Wallets" } },
        { "type": "item", "settings": { "label": "Bags" } },
        { "type": "item", "settings": { "label": "Accessories" } },
        { "type": "item", "settings": { "label": "Sale" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
