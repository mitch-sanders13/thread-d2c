<!-- sections/testimonial-slider.liquid -->
{% comment %} 
  Slider to highlight multiple testimonails.

  Globals:
    - settings.layout_horizontal: horizontaly margin
    - settings.enable_animations: boolean to enable animations
    - settings.thumbnails_color_border: border color
    - settings.thumbnails_color_scheme: color scheme of thumbnails

  Possible enhancements:
    - 
{% endcomment %}

<section class="
  {{ section.settings.visibility }}
  {{ section.settings.color_border }}
  {{ section.settings.style_border }}"
  x-intersect.half="
    body_background_color = '{{ section.settings.color_background }}';
    body_text_color = '{{ section.settings.color_text }}';
  ">
  <div class="{{ settings.layout_horizontal }}"
    style="
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;"
    x-data="{
      index: 0,
      index_size: {{ section.blocks.size | minus: 1 }},

      scrollNext() {
        if(this.index >= this.index_size){
          this.index = 0
        } else {
          this.index++
        }
      },
      
      scrollBack() {
        if(this.index <= 0){
          this.index = this.index_size;
        } else {
          this.index--
        }
      },

      autoScroll() {
        setInterval(() => this.scrollNext(), {{ section.settings.announcement_delay }}000);
      }
    }"
    {% if section.settings.announcement_delay > 0 %}
      x-init="autoScroll()"
    {% endif %}>

    {% for block in section.blocks %}
      <div class="flex flex-row -mx-4
        {{ section.settings.layout_y_alignment }}
        {{ section.settings.layout_x_alignment }}"
        x-show="index == {{ forloop.index0 }}"
        {% if settings.enable_animations %}
          x-transition:enter="animation-300"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="hidden animation-300"
          x-transition:leave-start="hidden opacity-0"
          x-transition:leave-end="hidden opacity-0"
        {% endif %}
        {% unless forloop.index0 == 0%}
          x-cloak
        {% endunless %}>
        
        {% comment %} Testimonial {% endcomment %}
        <div class="p-4
          {{ block.settings.layout_gallery_size }}
          {{ block.settings.layout_x_alignment }}">

          <div class="inline-flex h-16 mb-8 opacity-50">
            {%- unless block.settings.logo == blank -%}
              {% render 'component__image',
                image: block.settings.logo,
                aspect_ratio: '',
                background: 'transparent',
                crop: '',
                max_width: 600,
                container_class: 'h-full',
                image_class: 'w-auto h-full',
                enable_lazy_load: true,
                include_2x: true
              %}
            {%- endunless -%}
          </div>

          <h3 class="type__heading-1 mb-0">
            {{ block.settings.content }}
          </h3>

          <div class="flex items-center mt-8 
            {{ block.settings.layout_x_alignment }}">
            {% if block.settings.avatar %}
              <div class="w-10 h-10 mr-2">
                <div class="border__button--radius overflow-hidden object-cover aspect-[1/1]
                  {{ settings.thumbnails_color_scheme }}">
                  {{ block.settings.avatar 
                    | image_url: width: 80 
                    | image_tag: style: 'object-fit:cover', 
                      class: 'h-full w-full object-cover aspect-[1/1]', 
                      loading: 'lazy', 
                      alt: block.settings.avatar.alt }}
                </div>
              </div>
            {% endif %}
            <div class="m-0--clear type--small opacity-75">
              <p>
                {{ block.settings.author_name }}
              </p>
              {{ block.settings.author_title }}
            </div>
          </div>

          {% if section.blocks.size >= 2 %}
            <div class="flex gap-4 mt-12
              {{ block.settings.layout_x_alignment }}">
              <button class="btn btn--plain btn--small shadow-sm"
                @click="scrollBack();">
                {% render 'component__icon', icon: 'arrow-left', size: '20', class: '' %}
              </button>
              <button class="btn btn--plain btn--small shadow-sm"
                @click="scrollNext();">
                {% render 'component__icon', icon: 'arrow-right', size: '20', class: '' %}
              </button>
            </div>
          {% endif %}

        </div>

        {% comment %} Media {% endcomment %}
        {% case block.settings.layout_gallery_size %}
          {% when 'w-full md:w-1/3' %}
            {% assign media_size = 'w-full md:w-2/3' %}
          {% when 'w-full md:w-1/2' %}
            {% assign media_size = 'w-full md:w-1/2' %}
          {% when 'w-full md:w-2/3' %}
            {% assign media_size = 'w-full md:w-1/3' %}
          {% when 'w-full md:w-3/4' %}
            {% assign media_size = 'w-full md:w-1/4' %}
        {% endcase %}
        {% unless block.settings.image_featured == blank %}
          <div class="p-4
            {{ media_size }}">
            <div class="border--radius relative w-full overflow-hidden">
              {% render 'component__image',
                image: block.settings.image_featured,
                aspect_ratio: '',
                background: 'transparent',
                crop: '',
                max_width: 2000,
                container_class: '',
                image_class: '',
                enable_lazy_load: true,
                include_2x: true
              %}
            </div>
          </div>
        {% endunless %}

      </div>
    {% endfor %}
    
  </div>
</section>

