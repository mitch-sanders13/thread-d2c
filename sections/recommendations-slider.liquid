<!-- sections/recommendations-slider.liquid -->
{% comment %} 
  Slider of recommended products. 

  Globals:
    - settings.layout_horizontal: horizontaly margin
    - settings.thumbnails_border_style: border style of thumbnails
    - settings.thumbnails_color_border: border color
    - settings.thumbmails_color_scheme: color scheme of thumbnails
    - settings.thumbnails_ratio: set the aspect ratio of thumbnails
    - settings.thumbnails_object: set the image object sizing
    - settings.enable_quick_desktop: boolean to enable quick add
    - settings.enable_quick_mobile: boolean to enable quick add
    - settings.type_seperator: setting to pick the type of seperator between text
    - settings.enable_thumbnails_product_type: boolean to enable product type
    - settings.enable_thumbnails_vendor: boolean to enable vendor
    - settings.enable_thumbnails_variant_count: boolean to enable variant count

  Possible enhancements:
    - Break this up into re-useable snippets.

  Pro tips:
    - Recomendations can be updated using Search and Discovery app.
    - Can be set to either complimentary or related products.
    - This section will only work on product templates.
{% endcomment %}

<section class="
  {{ section.settings.visibility }}
  {{ section.settings.color_scheme }} 
  {{ section.settings.color_border }}
  {{ section.settings.style_border }}">
  <div class="!px-0
      {{ section.settings.layout_horizontal }}"
    style="
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;" 
    x-data="{
      initialLoad: true,
      loadingRecomendations : false,
      recomended_products: [],
      getRecomendations(){
        fetch(window.Shopify.routes.root + 'recommendations/products.json?product_id={{ product.id }}&limit={{ section.settings.products_count }}&intent={{ section.settings.intent }}')
        .then(response => response.json())
        .then(({ products }) => {
          const filtered = (products || []).filter(function(p){
            var tags = (p && p.tags) ? p.tags : [];
            return p && p.available && p.url && tags.indexOf('hiderecommendation') === -1 && tags.indexOf('collegiate') === -1;
          });
          if (filtered.length > 0) {
            this.recomended_products = filtered.slice(0, {{ section.settings.products_count }});
            this.loadingRecomendations = true;
          } else {
            this.recomended_products = [];
            this.loadingRecomendations = false;
          }
          this.initialLoad = false;
        }
      );
    }
  }"
  x-show="recomended_products.length > 0 || initialLoad == true"
  x-init="getRecomendations();">
    
    {%- comment -%}header{%- endcomment -%}
    <div class="flex flex-row flex-wrap items-end justify-center px-4 pb-4">
      <div class="max-w-prose">
        {%- unless section.settings.heading == blank -%}
          <h3>{{ section.settings.heading }}</h3>
        {%- endunless -%}
        {%- unless section.settings.content == blank -%}
          <div class="m-0--clear">
            {{ section.settings.content }}
          </div>
        {%- endunless -%}
      </div>
    </div>

    {%- comment -%}skeleton loader{%- endcomment -%}
    <div x-show="!loadingRecomendations">
      <div class="inline-flex w-full px-4 overflow-x-auto overflow-y-hidden whitespace-nowrap md:snap-x scroll-smooth hidescrollbar"
        style="
          column-gap: {{ settings.layout_gap_size }}px;
          row-gap: {{ settings.layout_gap_size | times: 1.5 }}px;">
        <div class="snap-center md:w-[26%] flex justify-center flex-none w-8/12">
          {% render 'component__skeleton-grid-item' %}
        </div>
        <div class="snap-center md:w-[26%] flex justify-center flex-none w-8/12">
          {% render 'component__skeleton-grid-item' %}
        </div>
      </div>
      <div class="justify-end hidden gap-4 pt-4 md:flex">
        <div>
          <button class="btn btn--plain btn--small shadow-sm"
            title="{{ 'general.media.previous_slide' | t }}"
            {% if settings.enable_animations %}
              x-transition:enter="animation-300"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="animation-300"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
            {% endif %}
            >
            {% render 'component__icon', icon: 'arrow-left', size: '20', class: '' %}
          </button>
        </div>
        <div>
          <button class="btn btn--plain btn--small shadow-sm"
            title="{{ 'general.media.next_slide' | t }}"
            {% if settings.enable_animations %}
              x-transition:enter="animation-300"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="animation-300"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
            {% endif %}
            >
            {% render 'component__icon', icon: 'arrow-right', size: '20', class: '' %}
          </button>
        </div>
      </div>
    </div>

    {%- comment -%}results{%- endcomment -%}
    <div 
      class="relative w-full"
      x-show="recomended_products.length > 0 && loadingRecomendations"
      x-cloak
      x-data="{
        index_slide: 0,
        index_size: {{ section.settings.products_count | minus: 1 }},
        show_arrows: false,
        isOverflown(element) {
          return element.scrollWidth > element.clientWidth;
        },
        scrollNext() {
          let slider = this.$refs.slider;
          if(this.index_slide >= this.index_size){
            slider.scrollLeft = 0;
          } else {
            this.index_slide ++;
            slider.scrollLeft += slider.offsetWidth-300;
          }

        },
        scrollBack() {
          let slider = this.$refs.slider;
          if(this.index_slide < 0){
            slider.scrollLeft = 999999;
          } else {
            this.index_slide --;
            slider.scrollLeft -= slider.offsetWidth-300;
          }
        }
      }">
      
      {%- comment -%}slides{%- endcomment -%}
      <div class="inline-flex w-full px-4 overflow-x-auto overflow-y-hidden whitespace-nowrap md:snap-x scroll-smooth hidescrollbar" 
        style="
          column-gap: {{ settings.layout_gap_size }}px;
          row-gap: {{ settings.layout_gap_size | times: 1.5 }}px;"
        x-ref="slider"
        x-init="
          setTimeout(function() {
            window.okeWidgetApi.initAllWidgets();
          }, 100);
        ">
        <template x-for="(item, index) in recomended_products">
          <div class="snap-center md:w-[26%] flex justify-center flex-none w-8/12"
            x-intersect:enter.full="index_slide = index;"
            x-bind:data-slide="index_slide">
            {% render 'template__product-item' %}
          </div>
        </template>
      </div>

      {% comment %} arrows {% endcomment %}
      <div 
        class="justify-end hidden gap-4 px-4 pt-4 md:flex"
        x-show="recomended_products.length > 4">
        <div>
          <button class="btn btn--plain btn--small shadow-sm"
            title="{{ 'general.media.previous_slide' | t }}"
            {% if settings.enable_animations %}
              x-transition:enter="animation-300"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="animation-300"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
            {% endif %}
            @click="scrollBack();">
            {% render 'component__icon', icon: 'arrow-left', size: '20', class: '' %}
          </button>
        </div>
        <div>
          <button class="btn btn--plain btn--small shadow-sm"
            title="{{ 'general.media.next_slide' | t }}"
            {% if settings.enable_animations %}
              x-transition:enter="animation-300"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="animation-300"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
            {% endif %}
            @click="scrollNext();">
            {% render 'component__icon', icon: 'arrow-right', size: '20', class: '' %}
          </button>
        </div>
      </div>
      
    </div>
    
  </div>
</section>

