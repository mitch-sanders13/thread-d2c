<!-- sections/about-slider.liquid -->
{% comment %} 
  Slider for about page.
{% endcomment %}

<section class="{{ section.settings.visibility }} {{ section.settings.color_scheme }} content-slider" 
style="padding-top:{{ section.settings.spacing_top }}px; padding-bottom:{{ section.settings.spacing_bottom }}px;">

	<div class="flex flex-col items-center">
		<div class="flex justify-start items-start w-full md:justify-center px-8 pb-8 md:px-20 md:pb-4 2xl:w-[70vw] translate-y-12 md:translate-y-0">
			<span>
				<div class="subtext">{{ section.settings.subtext }}</div>
				<div class="heading md:mt-4 md:mb-8">{{ section.settings.heading }}</div>
			</span>
			<span class="body-2 pt-0 px-8 pb-8 hidden md:block 2xl:w-[50vw]">
				{{ section.settings.body }}
				<a href="{{ section.settings.link_url }}" class="md:!text-base border-b-2 border-blue-700 md:pb-1">{{ section.settings.link_title }} ></a>
			</span>
		</div>
	</div>
	<div class="!relative !px-0 pt-12 pb-8 md:pt-0 md:pb-0">
		{% assign slider_size = section.blocks.size | minus: 1 %}
		{%- capture slides -%}
			{% for block in section.blocks %}
			{%- unless block.settings.image_background == blank -%}

					<div :key="index" :class="{ active: centerSlide === index}" class="slide py-4 px-2 snap-center flex flex-col justify-center items-start flex-none hover:opacity-40 transition-opacity
						{% if block.settings.layout_desktop_width == 12 %}md:w-full{% else %}md:w-{{ block.settings.layout_desktop_width }}/12{% endif %}
						{% if block.settings.layout_mobile_width == 12 %}w-full{% else %}w-{{ block.settings.layout_mobile_width }}/12{% endif %}"
						x-bind:data-slide="{{ forloop.index0 }}">

						<a href="{{ block.settings.name_url }}">
							<div
								class="animation-300 shadow-none flex flex-row flex-wrap w-full rounded-none overflow-hidden border no-underline hover:no-underline whitespace-normal
								{{ block.settings.color_scheme }} 
								{{ block.settings.color_text }}
								{% unless block.settings.image_featured == blank %}
								!content-between
								{% endunless %}">

								{{ block.settings.image_background | image_url: width: 1400 | image_tag: class: 'w-full top-0 h-full absolute object-cover', loading: 'lazy' }}
							</div>
						</a>

						<div class="sub-slide flex flex-col justify-center items-start 
						{% if forloop.first %} pl-2 {% endif %}">
							<div class="slide_name text-center">{{ block.settings.slide_name }}</div>
							<a href="{{ block.settings.name_url }}" class="border-b-2 border-blue-700">SEE MORE ></a>
						</div>

					</div>

				{%- endunless -%}
			{% endfor %}
		{%- endcapture -%}

		{% render 'component__slider',
		outer_class: 'alpine-slider',
		container_class: 'px-4',
		slider_size: slider_size,
		slides: slides %} 
	</div>
</section>


{% schema %}
{
"name":"[about] Slider",
"settings":[
	{
	"type":"header",
	"content":"Content"
	},
	{
		"type":"richtext",
		"id":"subtext",
		"label":"Subtext"
	},
	{
		"type":"richtext",
		"id":"heading",
		"label":"Heading"
	},
	{
		"type":"richtext",
		"id":"body",
		"label":"Body"
	},
	{
		"type":"text",
		"id":"link_title",
		"label":"Link Title",
		"default": "SEE MORE"
	},
	{
		"type":"text",
		"id":"link_url",
		"label":"Link URL"
	},
	{
	"type":"header",
	"content":"Spacing"
	},
	{
	"type":"range",
	"id":"spacing_top",
	"min":0,
	"max":300,
	"step":20,
	"unit":"px",
	"label":"Top padding",
	"default":100
	},
	{
	"type":"range",
	"id":"spacing_bottom",
	"min":0,
	"max":300,
	"step":20,
	"unit":"px",
	"label":"Bottom padding",
	"default":100
	},
	{
	"type":"header",
	"content":"Display"
	},
	{
	"type":"select",
	"id":"visibility",
	"label":"Visibility",
	"options":[
		{
		"value":"",
		"label":"Show on all devices"
		},
		{
		"value":"md:hidden",
		"label":"Show on mobile only"
		},
		{
		"value":"hidden md:block",
		"label":"Show on desktop only"
		}
	],
	"default":""
	}
],
"blocks":[
	{
	"type":"content",
	"name":"Slider Card",
	"limit":20,
	"settings":[
		{
		"type":"header",
		"content":"Content"
		},
		{
		"type":"image_picker",
		"id":"image_background",
		"label":"Background image"
		},
		{
		"type":"text",
		"id":"slide_name",
		"label":"Name",
		"default":"NAME HERE"
		},
		{
		"type":"text",
		"id":"name_url",
		"label":"Name URL"
		},
		{
		"type":"header",
		"content":"Spacing"
		},
		{
		"type":"range",
		"id":"spacing_top",
		"min":0,
		"max":300,
		"step":20,
		"unit":"px",
		"label":"Top padding",
		"default":0
		},
		{
		"type":"range",
		"id":"spacing_bottom",
		"min":0,
		"max":300,
		"step":20,
		"unit":"px",
		"label":"Bottom padding",
		"default":0
		},
		{
		"type":"header",
		"content":"Layout"
		},
		{
		"type":"range",
		"id":"layout_desktop_width",
		"min":1,
		"max":12,
		"step":1,
		"unit":"/12",
		"label":"Desktop width",
		"default":3
		},
		{
		"type":"range",
		"id":"layout_mobile_width",
		"min":1,
		"max":12,
		"step":1,
		"unit":"/12",
		"label":"Mobile width",
		"default":8
		}
	]
	}
],
"presets":[
	{
	"name":"[about] Slider",
	"settings":{
		"spacing_top": 100,
		"spacing_bottom": 100
	},
	"blocks": [
		{
		"type": "content",
		"settings": {
			"spacing_top": 0,
			"spacing_bottom": 0,
			"layout_desktop_width": 3,
			"layout_mobile_width": 8
		}
		},
		{
		"type": "content",
		"settings": {
			"spacing_top": 0,
			"spacing_bottom": 0,
			"layout_desktop_width": 3,
			"layout_mobile_width": 8
		}
		},
		{
		"type": "content",
		"settings": {
			"spacing_top": 0,
			"spacing_bottom": 0,
			"layout_desktop_width": 3,
			"layout_mobile_width": 8
		}
		}
	]
	}
],
"disabled_on": {
	"groups": ["custom.overlay"]
}
}
{% endschema %}