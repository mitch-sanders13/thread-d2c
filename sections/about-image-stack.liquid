<!-- sections/about-image-stack.liquid -->
{% comment %} 
  For custom about page
{% endcomment %}

<section
	data-section-id="{{ section.id }}"
	class="
		sec-{{ section.id }}
		pt-{{ section.settings.padding_top }}
		pb-{{ section.settings.padding_bottom }}
		image-text-alt
		h-fit
		w-screen">

	<div class="flex flex-col items-center">
		<div class="flex flex-col justify-start items-start md:justify-center px-8 pb-8 md:hidden">
				<div class="subtext">{{ section.settings.subtext }}</div>
				<div class="heading">{{ section.settings.heading }}</div>
				<div class="body-1 hidden md:block">{{ section.settings.body }}</div>
		</div>
		<div class="">
			<div class="">
				{% if section.settings.image != blank %}
					<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" decoding="async" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" class="w-screen">
				{% else %}
					<div class="placeholder-wrapper">{{ 'collection-1' | placeholder_svg_tag: 'placeholder dark' }}</div>
				{% endif %}
			</div>
		</div>
		<div class="flex md:p-5 2xl:w-[70vw]">
			<span class="">
				<div class="subtext hidden md:block">{{ section.settings.subtext }}</div>
				<div class="heading hidden md:block mt-4 mb-8">{{ section.settings.heading }}</div>
			</span>
			<span class="body-2 p-8 2xl:w-[50vw]">
				{{ section.settings.body }}
			</span>
		</div>
	</div>
</section>


{% schema %}
{
	"name": "[about] Image stack",
	"settings": [
	{
		"type": "image_picker",
		"id": "image",
		"label": "Image"
	},
	{
		"type":"richtext",
		"id":"subtext",
		"label":"Subtext"
	},
	{
		"type":"richtext",
		"id":"heading",
		"label":"Heading"
	},
	{
		"type":"richtext",
		"id":"body",
		"label":"Body"
	},
	{
	"type": "range",
	"id": "padding_top",
	"min": 0,
	"max": 6,
	"step": 1,
	"label": "Top Padding",
	"default": 0
	},
	{
	"type": "range",
	"id": "padding_bottom",
	"min": 0,
	"max": 6,
	"step": 1,
	"label": "Bottom padding",
	"default": 0
	}
	],
	"presets":[
		{
			"name":"[about] Image stack"
		}
	]
}
{% endschema %}
