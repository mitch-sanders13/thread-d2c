{% comment %}
  Trifecta bundler — Market Tote–style picker (page section).

  Markup + Alpine live in snippets/bundle-builder__instance.liquid so
  the PDP drawer can preload the same UI without fetching a page.

  Slots: Wallet, Lanyard, Chapstick Holder (cart property key remains
  "Chapstick" for compatibility with cart grouping / edit / upsell).
{% endcomment %}

{% render 'bundle-builder__instance',
  instance_id: section.id,
  heading: section.settings.heading,
  savings_label: section.settings.savings_label,
  add_bundle_label: section.settings.add_to_bundle_text,
  cart_label: section.settings.cta_text,
  discount_type: section.settings.discount_type,
  discount_value: section.settings.discount_value,
  discount_code: section.settings.discount_code,
  wallet_collection: section.settings.wallet_collection,
  lanyard_collection: section.settings.lanyard_collection,
  chapstick_collection: section.settings.chapstick_collection,
  spacing_top: section.settings.spacing_top,
  spacing_bottom: section.settings.spacing_bottom,
  layout_horizontal: section.settings.layout_horizontal,
  color_scheme: section.settings.color_scheme,
  color_border: section.settings.color_border,
  style_border: section.settings.style_border,
  visibility: section.settings.visibility
%}

{% schema %}
{
  "name": "Trifecta bundler",
  "tag": "section",
  "class": "section-bundle-builder",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Trifecta"
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Savings line (under heading)",
      "default": "Save 20% when you bundle a wallet, lanyard, and chapstick holder",
      "info": "Shown under the heading in Thread copper/gold. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "add_to_bundle_text",
      "label": "Add to Bundle button text",
      "default": "Add to Bundle"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Add to Cart button text",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "header",
      "content": "Products",
      "info": "Leave blank to use Theme settings → Trifecta bundle collections."
    },
    {
      "type": "collection",
      "id": "wallet_collection",
      "label": "Wallet collection"
    },
    {
      "type": "collection",
      "id": "lanyard_collection",
      "label": "Lanyard collection"
    },
    {
      "type": "collection",
      "id": "chapstick_collection",
      "label": "Chapstick Holder collection"
    },
    {
      "type": "header",
      "content": "Bundle discount",
      "info": "discount_type / discount_value control only the savings LABEL. Prefer an Automatic 20% discount in Shopify admin on the eligibility collections (min qty 3). Leave discount code blank unless you intentionally use a silent code attach."
    },
    {
      "type": "select",
      "id": "discount_type",
      "label": "Discount type (display label)",
      "options": [
        { "value": "percent", "label": "Percent off" },
        { "value": "fixed_off", "label": "Fixed amount off" },
        { "value": "none", "label": "No discount" }
      ],
      "default": "percent"
    },
    {
      "type": "number",
      "id": "discount_value",
      "label": "Discount value (percent OR dollar amount, label only)",
      "default": 20
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code (optional override)",
      "info": "Leave blank for automatic discounts. If set, overrides Theme settings → Everyday Carry Set → discount code and silently attaches via /discount/CODE."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "min": 0,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "select",
      "id": "layout_horizontal",
      "label": "Width",
      "options": [
        { "value": "window--narrow", "label": "Narrow" },
        { "value": "window", "label": "Default" },
        { "value": "window--wide", "label": "Wide" },
        { "value": "window--full", "label": "Full" }
      ],
      "default": "window"
    },
    {
      "type": "header",
      "content": "Colors & borders"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color__bg-body color__text", "label": "Body" },
        { "value": "color__bg-neutral color__text", "label": "Neutral" },
        { "value": "color__bg-overlay-1 color__text", "label": "Overlay 1" },
        { "value": "color__bg-overlay-2 color__text", "label": "Overlay 2" },
        { "value": "color__bg-overlay-3 color__text", "label": "Overlay 3" }
      ],
      "default": "color__bg-body color__text"
    },
    {
      "type": "select",
      "id": "color_border",
      "label": "Border color",
      "options": [
        { "value": "color__border-divider-1", "label": "Divider" },
        { "value": "color__border-selected-1", "label": "Selected" }
      ],
      "default": "color__border-divider-1"
    },
    {
      "type": "select",
      "id": "style_border",
      "label": "Border style",
      "options": [
        { "value": "", "label": "None" },
        { "value": "border--t-width", "label": "Top" },
        { "value": "border--b-width", "label": "Bottom" },
        { "value": "border--b-width border--t-width", "label": "Top and bottom" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        { "value": "", "label": "Show on all devices" },
        { "value": "md:hidden", "label": "Show on mobile only" },
        { "value": "hidden md:block", "label": "Show on desktop only" }
      ],
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "Trifecta bundler"
    }
  ]
}
{% endschema %}
