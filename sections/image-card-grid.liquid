<!-- sections/image-card-grid.liquid -->
{% comment %}
  Image Card Grid section — same shell as Best Sellers (title + filter tabs + CTA + grid/carousel)
  but the grid is populated with image cards (user-uploaded images that link to a product, collection,
  page, or any URL) instead of products from a collection.

  Blocks:
    - filter_tab: title + label for each tab. Tab label is used as the key that image cards filter on.
    - image_card: image, link URL, optional title & subtitle, and a `tab_filter` that matches one of
      the filter_tab labels (blank = show on every tab).
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .border__button--radius span {
    font-size: 10px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .border__button--radius {
    padding: 2px 6px;
    border-width: 0 !important;
  }
  {% if section.settings.grid_mode == 'carousel' %}
    /* In carousel mode, strip the section's horizontal padding so the carousel
       can bleed off the right and scroll fully to the left edge. */
    #shopify-section-{{ section.id }} > section.spacing-global,
    #shopify-section-{{ section.id }} > section.spacing-sides {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    {% if section.settings.use_global_spacing == 'global' or section.settings.use_global_spacing == 'global-sides' %}
      /* Match the theme's global side padding as the carousel's left inset (mobile) */
      #shopify-section-{{ section.id }} [data-icg-slider] {
        padding-left: {{ settings.token_padding_sides_mobile }}px !important;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ section.id }} [data-icg-slider] {
          padding-left: {{ settings.token_padding_sides_desktop }}px !important;
        }
      }
    {% endif %}
  {% endif %}
  /* CTA full-width on mobile (opt-in per section) */
  @media (max-width: 767px) {
    .icg-cta-full-mobile-{{ section.id }} {
      display: block !important;
      width: 100%;
      white-space: normal !important;
    }
  }

  /* Filter button styling — scoped so theme CSS can't override */
  .icg-filter-btn-{{ section.id }} {
    flex-shrink: 0;
    padding: 12px {{ section.settings.tab_spacing }}px !important;
    border: none !important;
    background: transparent !important;
    cursor: pointer;
    font-family: var(--type-font-nav-family) !important;
    font-size: {{ section.settings.filter_size }}px !important;
    font-weight: {{ section.settings.filter_weight }} !important;
    text-transform: {{ section.settings.filter_case }} !important;
    letter-spacing: {{ section.settings.filter_ls }} !important;
    transition: color 0.15s;
  }
  .icg-filter-btn-{{ section.id }} .icg-tab-text {
    display: inline-block;
    padding-bottom: {{ section.settings.underline_offset | default: 3 }}px;
    border-bottom: {{ section.settings.underline_width }}px solid transparent;
    transition: border-color 0.15s;
    font-family: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    letter-spacing: inherit !important;
    text-transform: inherit !important;
  }
</style>
<section class="{{ section.settings.visibility }} {{ section.settings.color_scheme }}{% if section.settings.use_global_spacing == 'global' %} spacing-global{% elsif section.settings.use_global_spacing == 'global-sides' %} spacing-sides{% endif %}"
  style="{% if section.settings.use_global_spacing == 'custom' %}padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;{% elsif section.settings.use_global_spacing == 'global-sides' %}padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;{% endif %}">

  {%- comment -%} Resolve default CTA (may be overridden per-tab) {%- endcomment -%}
  {%- assign cta_href = section.settings.cta_url -%}
  {%- assign cta_text = section.settings.cta_label -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'filter_tab' and forloop.first -%}
      {%- if block.settings.cta_url != blank -%}{%- assign cta_href = block.settings.cta_url -%}{%- endif -%}
      {%- if block.settings.cta_label != blank -%}{%- assign cta_text = block.settings.cta_label -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} Resolve title font token vs manual {%- endcomment -%}
  {% assign icg_title_use_token = false %}
  {% assign icg_title_token_class = '' %}
  {% assign icg_title_font_style = '' %}
  {% if section.settings.title_font contains 'token-' %}
    {% assign icg_title_use_token = true %}
    {% assign icg_title_token_class = section.settings.title_font | replace: 'token-', 'type-' %}
  {% elsif section.settings.title_font == 'body' %}
    {% assign icg_title_font_style = 'font-family:var(--type-font-body-family);' %}
  {% elsif section.settings.title_font == 'heading' %}
    {% assign icg_title_font_style = 'font-family:var(--type-font-header-family);' %}
  {% elsif section.settings.title_font == 'nav' %}
    {% assign icg_title_font_style = 'font-family:var(--type-font-nav-family);' %}
  {% elsif section.settings.title_font == 'handwritten' %}
    {% assign icg_title_font_style = 'font-family:var(--type-font-handwritten-family);' %}
  {% endif %}

  {%- comment -%} Section title + inline CTA {%- endcomment -%}
  {% if section.settings.show_title or section.settings.cta_show and section.settings.cta_position == 'above' %}
    {% assign has_inline_cta = false %}
    {% if section.settings.cta_show and section.settings.cta_position == 'above' %}
      {% assign has_inline_cta = true %}
    {% endif %}
    <div style="padding:{{ section.settings.title_padding_top }}px {{ section.settings.grid_padding | default: 16 }}px {{ section.settings.title_padding_bottom }}px;display:flex;{% if has_inline_cta %}justify-content:space-between;{% else %}justify-content:{{ section.settings.title_align }};{% endif %}align-items:center;flex-wrap:wrap;gap:8px;">
      {% if section.settings.show_title %}
        <h2 id="js:icgTitle-{{ section.id }}" class="{% if icg_title_use_token %}{{ icg_title_token_class }}{% endif %}" style="margin:0;{% unless icg_title_use_token %}{{ icg_title_font_style }}font-size:{{ section.settings.title_size }}px;font-weight:{{ section.settings.title_weight }};text-transform:{{ section.settings.title_case }};letter-spacing:{{ section.settings.title_ls }};{% endunless %}color:{{ section.settings.title_color }};line-height:1;">
          {{ section.settings.title_text }}
        </h2>
      {% endif %}
      {% if has_inline_cta %}
        <a id="js:icgCta-{{ section.id }}"
          href="{{ cta_href }}"
          style="display:inline-block;font-family:var(--type-font-nav-family);font-size:{{ section.settings.cta_size }}px;font-weight:{{ section.settings.cta_weight }};text-transform:{{ section.settings.cta_case }};letter-spacing:{{ section.settings.cta_ls }};color:{{ section.settings.cta_text_color }};background:{{ section.settings.cta_bg_color }};border:{{ section.settings.cta_border_width }}px solid {{ section.settings.cta_border_color }};border-radius:{{ section.settings.cta_radius }}px;padding:{{ section.settings.cta_pad_v }}px {{ section.settings.cta_pad_h }}px;text-decoration:none;white-space:nowrap;">
          {{ cta_text }}
        </a>
      {% endif %}
    </div>
  {% endif %}

  {%- comment -%} CTA — centered between title and filter {%- endcomment -%}
  {% if section.settings.cta_show and section.settings.cta_position == 'between' %}
    <div style="display:flex;justify-content:center;padding:{{ section.settings.cta_between_spacing_top }}px {{ section.settings.grid_padding | default: 16 }}px {{ section.settings.cta_between_spacing_bottom }}px;">
      <a id="js:icgCta-{{ section.id }}"
        href="{{ cta_href }}"
        class="icg-cta{% if section.settings.cta_full_width_mobile %} icg-cta-full-mobile-{{ section.id }}{% endif %}"
        style="display:inline-block;text-align:center;font-family:var(--type-font-nav-family);font-size:{{ section.settings.cta_size }}px;font-weight:{{ section.settings.cta_weight }};text-transform:{{ section.settings.cta_case }};letter-spacing:{{ section.settings.cta_ls }};color:{{ section.settings.cta_text_color }};background:{{ section.settings.cta_bg_color }};border:{{ section.settings.cta_border_width }}px solid {{ section.settings.cta_border_color }};border-radius:{{ section.settings.cta_radius }}px;padding:{{ section.settings.cta_pad_v }}px {{ section.settings.cta_pad_h }}px;text-decoration:none;white-space:nowrap;">
        {{ cta_text }}
      </a>
    </div>
  {% endif %}

  {%- comment -%} Filter bar {%- endcomment -%}
  {% if section.settings.show_filter %}
    {% assign _cta_in_filter_row = false %}
    {% if section.settings.cta_show and section.settings.cta_position == 'right_of_filter' %}
      {% assign _cta_in_filter_row = true %}
    {% endif %}
    {% assign _arrows_in_filter = false %}
    {% if section.settings.grid_mode == 'carousel' and section.settings.carousel_show_arrows %}
      {% assign _arrows_in_filter = true %}
    {% endif %}
    {% assign _filter_row_flex = false %}
    {% if _cta_in_filter_row or _arrows_in_filter %}{% assign _filter_row_flex = true %}{% endif %}
    <div style="background:{{ section.settings.filter_bg }};border-bottom:1px solid {{ section.settings.filter_border }};{% unless _arrows_in_filter %}padding-left:{{ section.settings.grid_padding | default: 16 }}px;{% endunless %}padding-right:{% if _arrows_in_filter %}0{% else %}{{ section.settings.grid_padding | default: 16 }}px{% endif %};{% if _filter_row_flex %}display:flex;align-items:stretch;{% endif %}">
      {% if _arrows_in_filter %}
        <button type="button" onclick="icgScrollArrow('{{ section.id }}','prev')" class="icg-arrow-edge-{{ section.id }} icg-arrow-edge-left btn btn--plain btn--small shadow-sm" aria-label="Previous">
          {% render 'component__icon', icon: 'arrow-left', size: '20', class: '' %}
        </button>
      {% endif %}
      {%- comment -%}
        Horizontal overflow only so filter chips can swipe on narrow screens.
        Avoid overscroll-behavior-y: none — it traps vertical wheel scroll
        when the cursor is over this row (same bug as Best Sellers tabs).
      {%- endcomment -%}
      <div style="{% if _filter_row_flex %}flex:1 1 auto;min-width:0;{% endif %}overflow-x:auto;overflow-y:hidden;white-space:nowrap;scrollbar-width:none;{% if _arrows_in_filter %}padding-left:{{ section.settings.grid_padding | default: 16 }}px;{% endif %}">
        <div id="js:icgFilterBar-{{ section.id }}" style="display:flex;justify-content:{{ section.settings.filter_align }};min-width:100%;">
          {% for block in section.blocks %}
            {% if block.type == 'filter_tab' %}
              {% assign is_first = forloop.first %}
              {% assign tab_key = block.settings.tab_label | handle %}
              <button
                class="js:icgFilterBtn-{{ section.id }} icg-filter-btn-{{ section.id }}"
                data-tab="{{ tab_key }}"
                data-cta-label="{{ block.settings.cta_label | default: section.settings.cta_label }}"
                data-cta-url="{{ block.settings.cta_url | default: section.settings.cta_url }}"
                onclick="icgFilter('{{ section.id }}', '{{ tab_key }}', this)"
                style="color:{% if is_first %}{{ section.settings.active_color }}{% else %}{{ section.settings.inactive_color }}{% endif %};"
                {{ block.shopify_attributes }}>
                <span class="icg-tab-text" style="border-bottom-color:{% if is_first %}{{ section.settings.active_color }}{% else %}transparent{% endif %};">
                  {{ block.settings.tab_label }}
                </span>
              </button>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      {% if _arrows_in_filter %}
        <button type="button" onclick="icgScrollArrow('{{ section.id }}','next')" class="icg-arrow-edge-{{ section.id }} icg-arrow-edge-right btn btn--plain btn--small shadow-sm" aria-label="Next">
          {% render 'component__icon', icon: 'arrow-right', size: '20', class: '' %}
        </button>
      {% endif %}
      {% if _cta_in_filter_row %}
        <a id="js:icgCta-{{ section.id }}"
          href="{{ cta_href }}"
          class="icg-cta-desktop-{{ section.id }}"
          style="flex-shrink:0;align-self:center;font-family:var(--type-font-nav-family);font-size:{{ section.settings.cta_size }}px;font-weight:{{ section.settings.cta_weight }};text-transform:{{ section.settings.cta_case }};letter-spacing:{{ section.settings.cta_ls }};color:{{ section.settings.cta_text_color }};background:{{ section.settings.cta_bg_color }};border:{{ section.settings.cta_border_width }}px solid {{ section.settings.cta_border_color }};border-radius:{{ section.settings.cta_radius }}px;padding:{{ section.settings.cta_pad_v }}px {{ section.settings.cta_pad_h }}px;text-decoration:none;white-space:nowrap;margin-left:16px;{% if _arrows_in_filter %}margin-right:{{ section.settings.grid_padding | default: 16 }}px;{% endif %}">
          {{ cta_text }}
        </a>
        <style>
          .icg-cta-desktop-{{ section.id }} { display: none; }
          @media (min-width: 768px) {
            .icg-cta-desktop-{{ section.id }} { display: inline-block; }
          }
        </style>
      {% endif %}
    </div>
  {% endif %}

  {% assign col_mob = section.settings.columns_mobile | plus: 0 %}
  {% assign col_desk = section.settings.columns_desktop | plus: 0 %}
  {% assign col_desk_minus = col_desk | minus: 1 %}
  {% assign col_mob_minus = col_mob | minus: 1 %}

  {%- comment -%} Count how many filter_tab blocks there are; if zero, render a single untabbed grid {%- endcomment -%}
  {% assign tab_count = 0 %}
  {% for block in section.blocks %}
    {% if block.type == 'filter_tab' %}{% assign tab_count = tab_count | plus: 1 %}{% endif %}
  {% endfor %}

  {%- capture icg_image_card_template -%}
    {%- comment -%} Reusable image-card render — expects a local `card` variable {%- endcomment -%}
  {%- endcapture -%}

  {%- comment -%} CTA — below filter, above grid {%- endcomment -%}
  {% if section.settings.cta_show and section.settings.cta_position == 'below_filter' %}
    <div style="display:flex;justify-content:center;padding:{{ section.settings.cta_between_spacing_top }}px {{ section.settings.grid_padding | default: 16 }}px {{ section.settings.cta_between_spacing_bottom }}px;">
      <a id="js:icgCta-{{ section.id }}"
        href="{{ cta_href }}"
        class="icg-cta{% if section.settings.cta_full_width_mobile %} icg-cta-full-mobile-{{ section.id }}{% endif %}"
        style="display:inline-block;text-align:center;font-family:var(--type-font-nav-family);font-size:{{ section.settings.cta_size }}px;font-weight:{{ section.settings.cta_weight }};text-transform:{{ section.settings.cta_case }};letter-spacing:{{ section.settings.cta_ls }};color:{{ section.settings.cta_text_color }};background:{{ section.settings.cta_bg_color }};border:{{ section.settings.cta_border_width }}px solid {{ section.settings.cta_border_color }};border-radius:{{ section.settings.cta_radius }}px;padding:{{ section.settings.cta_pad_v }}px {{ section.settings.cta_pad_h }}px;text-decoration:none;white-space:nowrap;">
        {{ cta_text }}
      </a>
    </div>
  {% endif %}

  <div id="js:icgGrid-{{ section.id }}" class="icg-grid-wrap-{{ section.id }}"
    style="padding: 16px {% if section.settings.grid_mode == 'carousel' %}0{% else %}{{ section.settings.grid_padding | default: 16 }}px{% endif %} 0;">

    {% if tab_count > 0 %}
      {%- comment -%} One grid/carousel per tab — only the active tab is visible {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'filter_tab' %}
          {% assign current_tab_key = block.settings.tab_label | handle %}

          {%- capture tab_cards -%}
            {% for inner in section.blocks %}
              {% if inner.type == 'image_card' %}
                {%- assign card_filter_key = inner.settings.tab_filter | handle -%}
                {% assign show_card = false %}
                {% if inner.settings.tab_filter == blank %}
                  {% assign show_card = true %}
                {% elsif card_filter_key == current_tab_key %}
                  {% assign show_card = true %}
                {% endif %}
                {% if show_card and inner.settings.image != blank %}
                  {%- assign card_vis_class = '' -%}
                  {%- if inner.settings.visibility == 'mobile' -%}{%- assign card_vis_class = ' icg-card-item--mobile-only' -%}
                  {%- elsif inner.settings.visibility == 'desktop' -%}{%- assign card_vis_class = ' icg-card-item--desktop-only' -%}
                  {%- endif -%}
                  <div class="icg-card-item{{ card_vis_class }}">
                    <a href="{{ inner.settings.link }}" style="text-decoration:none;color:inherit;display:block;" {{ inner.shopify_attributes }}>
                      <div class="icg-card-image-wrap-{{ section.id }}" style="position:relative;overflow:hidden;background:#f5f5f5;border-radius:{{ section.settings.image_radius }}px;aspect-ratio:{{ section.settings.image_aspect | default: inner.settings.image.aspect_ratio }};">
                        <img
                          src="{{ inner.settings.image | image_url: width: 1000 }}"
                          alt="{{ inner.settings.title | default: inner.settings.image.alt | escape }}"
                          loading="lazy"
                          style="position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover;">
                      </div>
                      {% if inner.settings.title != blank or inner.settings.subtitle != blank %}
                        <div style="padding:{{ section.settings.card_text_pad_top }}px {{ section.settings.card_text_pad_x }}px 0;text-align:{{ section.settings.card_text_align }};">
                          {% if inner.settings.title != blank %}
                            <h3 style="margin:0 0 {{ section.settings.card_title_mb }}px 0;font-family:var(--type-font-{% if section.settings.card_title_font == 'heading' %}header{% else %}{{ section.settings.card_title_font }}{% endif %}-family);font-size:{{ section.settings.card_title_size }}px;font-weight:{{ section.settings.card_title_weight }};text-transform:{{ section.settings.card_title_case }};letter-spacing:{{ section.settings.card_title_ls }};line-height:1.2;color:{{ section.settings.card_title_color }};">
                              {{ inner.settings.title }}
                            </h3>
                          {% endif %}
                          {% if section.settings.show_card_sub and inner.settings.subtitle != blank %}
                            <div style="font-family:var(--type-font-{% if section.settings.card_sub_font == 'heading' %}header{% else %}{{ section.settings.card_sub_font }}{% endif %}-family);font-size:{{ section.settings.card_sub_size }}px;font-weight:{{ section.settings.card_sub_weight }};line-height:{{ section.settings.card_sub_line_height | default: 1.4 }};letter-spacing:{{ section.settings.card_sub_ls | default: '0em' }};text-transform:{{ section.settings.card_sub_transform | default: 'none' }};opacity:{{ section.settings.card_sub_opacity }};color:{{ section.settings.card_sub_color }};">
                              {{ inner.settings.subtitle }}
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                    </a>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          {%- endcapture -%}

          <div class="icg-tab-content-{{ section.id }}"
            data-tab="{{ current_tab_key }}"
            style="{% unless forloop.first %}display:none;{% endunless %}">

            {% if section.settings.grid_mode == 'carousel' %}
              <div style="position:relative;">
                <div data-icg-slider
                  class="icg-slider-{{ section.id }}"
                  style="overflow-x:auto;scroll-snap-type:x proximity;scroll-padding-left:{{ section.settings.grid_padding | default: 16 }}px;-webkit-overflow-scrolling:touch;scrollbar-width:none;display:flex;gap:{{ section.settings.col_gap }}px;padding-left:{{ section.settings.grid_padding | default: 16 }}px;padding-right:0;">
                  {{ tab_cards }}
                </div>
              </div>
            {% else %}
              <div class="icg-grid-{{ section.id }}" style="display:grid;grid-template-columns:repeat({{ col_mob }},1fr);gap:{{ section.settings.row_gap }}px {{ section.settings.col_gap }}px;">
                {{ tab_cards }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      {%- comment -%} No filter tabs — render all image cards as one grid/carousel {%- endcomment -%}
      {%- capture all_cards -%}
        {% for inner in section.blocks %}
          {% if inner.type == 'image_card' and inner.settings.image != blank %}
            {%- assign card_vis_class = '' -%}
            {%- if inner.settings.visibility == 'mobile' -%}{%- assign card_vis_class = ' icg-card-item--mobile-only' -%}
            {%- elsif inner.settings.visibility == 'desktop' -%}{%- assign card_vis_class = ' icg-card-item--desktop-only' -%}
            {%- endif -%}
            <div class="icg-card-item{{ card_vis_class }}">
              <a href="{{ inner.settings.link }}" style="text-decoration:none;color:inherit;display:block;" {{ inner.shopify_attributes }}>
                <div style="position:relative;overflow:hidden;background:#f5f5f5;border-radius:{{ section.settings.image_radius }}px;">
                  <img
                    src="{{ inner.settings.image | image_url: width: 1000 }}"
                    alt="{{ inner.settings.title | default: inner.settings.image.alt | escape }}"
                    loading="lazy"
                    style="width:100%;display:block;aspect-ratio:{{ section.settings.image_aspect | default: inner.settings.image.aspect_ratio }};object-fit:cover;">
                </div>
                {% if inner.settings.title != blank or inner.settings.subtitle != blank %}
                  <div style="padding:{{ section.settings.card_text_pad_top }}px {{ section.settings.card_text_pad_x }}px 0;text-align:{{ section.settings.card_text_align }};">
                    {% if inner.settings.title != blank %}
                      <h3 style="margin:0 0 {{ section.settings.card_title_mb }}px 0;font-family:var(--type-font-{% if section.settings.card_title_font == 'heading' %}header{% else %}{{ section.settings.card_title_font }}{% endif %}-family);font-size:{{ section.settings.card_title_size }}px;font-weight:{{ section.settings.card_title_weight }};text-transform:{{ section.settings.card_title_case }};letter-spacing:{{ section.settings.card_title_ls }};line-height:1.2;color:{{ section.settings.card_title_color }};">
                        {{ inner.settings.title }}
                      </h3>
                    {% endif %}
                    {% if section.settings.show_card_sub and inner.settings.subtitle != blank %}
                      <div style="font-family:var(--type-font-{% if section.settings.card_sub_font == 'heading' %}header{% else %}{{ section.settings.card_sub_font }}{% endif %}-family);font-size:{{ section.settings.card_sub_size }}px;font-weight:{{ section.settings.card_sub_weight }};line-height:{{ section.settings.card_sub_line_height | default: 1.4 }};letter-spacing:{{ section.settings.card_sub_ls | default: '0em' }};text-transform:{{ section.settings.card_sub_transform | default: 'none' }};opacity:{{ section.settings.card_sub_opacity }};color:{{ section.settings.card_sub_color }};">
                        {{ inner.settings.subtitle }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </a>
            </div>
          {% endif %}
        {% endfor %}
      {%- endcapture -%}
      {% if section.settings.grid_mode == 'carousel' %}
        <div style="position:relative;">
          <div data-icg-slider class="icg-slider-{{ section.id }}" style="overflow-x:auto;scroll-snap-type:x proximity;scroll-padding-left:{{ section.settings.grid_padding | default: 16 }}px;-webkit-overflow-scrolling:touch;scrollbar-width:none;display:flex;gap:{{ section.settings.col_gap }}px;padding-left:{{ section.settings.grid_padding | default: 16 }}px;padding-right:0;">
            {{ all_cards }}
          </div>
        </div>
      {% else %}
        <div class="icg-grid-{{ section.id }}" style="display:grid;grid-template-columns:repeat({{ col_mob }},1fr);gap:{{ section.settings.row_gap }}px {{ section.settings.col_gap }}px;">
          {{ all_cards }}
        </div>
      {% endif %}
    {% endif %}

    <style>
      .icg-slider-{{ section.id }}::-webkit-scrollbar { display: none; }
      /* Per-card visibility (mobile/desktop/both). Breakpoint matches section: 768px. */
      @media (max-width: 767.98px) {
        .icg-grid-wrap-{{ section.id }} .icg-card-item--desktop-only { display: none !important; }
      }
      @media (min-width: 768px) {
        .icg-grid-wrap-{{ section.id }} .icg-card-item--mobile-only { display: none !important; }
      }
      .icg-grid-wrap-{{ section.id }} .icg-card-item {
        flex: 0 0 calc((100% - {{ section.settings.col_gap | times: col_mob_minus }}px) / {{ col_mob }} - {{ section.settings.carousel_peek | default: 20 }}px);
        scroll-snap-align: start;
        min-width: calc((100% - {{ section.settings.col_gap | times: col_mob_minus }}px) / {{ col_mob }} - {{ section.settings.carousel_peek | default: 20 }}px);
        box-sizing: border-box;
      }
      /* Custom image height overrides (mobile/desktop). 0 = use aspect ratio. */
      {% if section.settings.image_height_mobile > 0 %}
        .icg-card-image-wrap-{{ section.id }} {
          height: {{ section.settings.image_height_mobile }}px !important;
          aspect-ratio: auto !important;
        }
      {% endif %}
      @media (min-width: 768px) {
        {% if section.settings.image_height_desktop > 0 %}
          .icg-card-image-wrap-{{ section.id }} {
            height: {{ section.settings.image_height_desktop }}px !important;
            aspect-ratio: auto !important;
          }
        {% elsif section.settings.image_height_mobile > 0 %}
          /* Mobile-only fixed height — desktop reverts to aspect ratio */
          .icg-card-image-wrap-{{ section.id }} {
            height: auto !important;
            aspect-ratio: {{ section.settings.image_aspect | default: '1 / 1' }} !important;
          }
        {% endif %}
      }
      /* Edge arrows in the filter row — hidden on mobile. Visual styling
         (size, bg, border, shadow) comes from the shared .btn .btn--plain
         .btn--small .shadow-sm classes so they match every other carousel
         arrow in the theme. */
      .icg-arrow-edge-{{ section.id }} { display: none; }
      @media (min-width: 768px) {
        .icg-grid-wrap-{{ section.id }} .icg-card-item {
          flex: 0 0 calc((100% - {{ section.settings.col_gap | times: col_desk_minus }}px) / {{ col_desk }} - {{ section.settings.carousel_peek_desktop | default: 40 }}px);
          min-width: calc((100% - {{ section.settings.col_gap | times: col_desk_minus }}px) / {{ col_desk }} - {{ section.settings.carousel_peek_desktop | default: 40 }}px);
        }
        .icg-grid-wrap-{{ section.id }} .icg-grid-{{ section.id }} {
          grid-template-columns: repeat({{ col_desk }}, 1fr) !important;
        }
        .icg-arrow-edge-{{ section.id }} {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
          align-self: center;
          margin: 0 {{ section.settings.grid_padding | default: 16 }}px;
        }
        .icg-arrow-edge-{{ section.id }}.is-disabled {
          opacity: 0.4;
          cursor: default;
          pointer-events: none;
        }
      }
    </style>
  </div>

  {%- comment -%} CTA — below grid {%- endcomment -%}
  {% if section.settings.cta_show and section.settings.cta_position == 'below' %}
    <div style="padding:{{ section.settings.cta_pad_v | times: 2 }}px {{ section.settings.grid_padding | default: 16 }}px {{ section.settings.cta_pad_v }}px;display:flex;justify-content:center;">
      <a id="js:icgCta-{{ section.id }}"
        href="{{ cta_href }}"
        class="icg-cta{% if section.settings.cta_full_width_mobile %} icg-cta-full-mobile-{{ section.id }}{% endif %}"
        style="display:inline-block;text-align:center;font-family:var(--type-font-nav-family);font-size:{{ section.settings.cta_size }}px;font-weight:{{ section.settings.cta_weight }};text-transform:{{ section.settings.cta_case }};letter-spacing:{{ section.settings.cta_ls }};color:{{ section.settings.cta_text_color }};background:{{ section.settings.cta_bg_color }};border:{{ section.settings.cta_border_width }}px solid {{ section.settings.cta_border_color }};border-radius:{{ section.settings.cta_radius }}px;padding:{{ section.settings.cta_pad_v }}px {{ section.settings.cta_pad_h }}px;text-decoration:none;white-space:nowrap;">
        {{ cta_text }}
      </a>
    </div>
  {% endif %}

</section>

<script>
function icgGetActiveSlider(sid) {
  var container = document.getElementById('js:icgGrid-' + sid);
  if (!container) return null;
  var tabs = container.querySelectorAll('.icg-tab-content-' + sid);
  for (var i = 0; i < tabs.length; i++) {
    if (tabs[i].offsetParent !== null) {
      var s = tabs[i].querySelector('[data-icg-slider]');
      if (s) return s;
    }
  }
  return container.querySelector('[data-icg-slider]');
}

function icgScrollArrow(sid, direction) {
  var slider = icgGetActiveSlider(sid);
  if (!slider) return;
  var amount = slider.offsetWidth;
  slider.scrollBy({ left: direction === 'prev' ? -amount : amount, behavior: 'smooth' });
}

function icgUpdateArrows(sid) {
  var slider = icgGetActiveSlider(sid);
  if (!slider) return;
  var atStart = slider.scrollLeft <= 2;
  var atEnd = Math.ceil(slider.scrollLeft + slider.clientWidth) >= slider.scrollWidth - 2;
  var section = document.getElementById('shopify-section-' + sid);
  if (!section) return;
  var left = section.querySelector('.icg-arrow-edge-left');
  var right = section.querySelector('.icg-arrow-edge-right');
  if (left) left.classList.toggle('is-disabled', atStart);
  if (right) right.classList.toggle('is-disabled', atEnd);
}

document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('[data-icg-slider]').forEach(function(slider) {
    if (slider.dataset.icgBound === '1') return;
    slider.dataset.icgBound = '1';
    var section = slider.closest('[id^="shopify-section-"]');
    if (!section) return;
    var sid = section.id.replace('shopify-section-', '');
    var update = function() { icgUpdateArrows(sid); };
    slider.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
});

function icgFilter(sid, tabKey, clickedBtn) {
  document.querySelectorAll('.js\\:icgFilterBtn-' + sid).forEach(function(b) {
    b.style.color = '{{ section.settings.inactive_color }}';
    var span = b.querySelector('.icg-tab-text');
    if (span) span.style.borderBottomColor = 'transparent';
  });
  clickedBtn.style.color = '{{ section.settings.active_color }}';
  var clickedSpan = clickedBtn.querySelector('.icg-tab-text');
  if (clickedSpan) clickedSpan.style.borderBottomColor = '{{ section.settings.active_color }}';

  document.querySelectorAll('.icg-tab-content-' + sid).forEach(function(tab) {
    if (tab.getAttribute('data-tab') === tabKey) {
      tab.style.display = '';
      var slider = tab.querySelector('[x-ref="icgSlider"]');
      if (slider) slider.scrollLeft = 0;
    } else {
      tab.style.display = 'none';
    }
  });

  var ctaEl = document.getElementById('js:icgCta-' + sid);
  if (ctaEl) {
    var ctaLabel = clickedBtn.getAttribute('data-cta-label');
    var ctaUrl = clickedBtn.getAttribute('data-cta-url');
    if (ctaLabel) ctaEl.textContent = ctaLabel;
    if (ctaUrl) ctaEl.setAttribute('href', ctaUrl);
  }
  icgUpdateArrows(sid);
}
</script>

