{% comment %}
  Market Tote bundler — PDP-style picker.

  Large hero of the previewed tote + thumbnail swatches to change the
  preview. "Add to Bundle" adds the previewed tote to a list of up to 3
  (duplicates allowed). Progress dots + a mini strip by the CTA show
  what's in the bundle (with remove). When 3 are picked, the CTA becomes
  "Add Bundle to Cart" only.

  Discount display is section settings; checkout discount via discount code.
{% endcomment %}

{%- liquid
  assign section_id = 'market-tote-bundler-' | append: section.id
  assign js_id = section.id | replace: '-', '_'
  assign discount_type = section.settings.discount_type
  assign discount_value = section.settings.discount_value | default: 25
  assign required_count = 3
  assign add_bundle_label = section.settings.add_to_bundle_text | default: 'Add to Bundle'
  assign cart_label = section.settings.cta_text | default: 'Add Bundle to Cart'

  assign tote_coll = section.settings.source_collection
  if tote_coll == blank
    if settings.market_tote_collection != blank
      assign tote_coll = settings.market_tote_collection
    else
      assign tote_coll = collections['reusable-market-tote-bags']
    endif
  endif
-%}

<section
  id="{{ section_id }}"
  class="
    {{ section.settings.visibility }}
    {{ section.settings.color_scheme }}
    {{ section.settings.color_border }}
    {{ section.settings.style_border }}
  ">
  <div
    class="market-tote-bundler {{ section.settings.layout_horizontal }}"
    style="
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;
    "
    x-data="marketToteBundler_{{ js_id }}">

    {%- unless section.settings.heading == blank and section.settings.savings_label == blank -%}
      <div class="flex flex-col items-center px-4 pb-4 text-center">
        <div class="max-w-prose">
          {%- unless section.settings.heading == blank -%}
            <h2>{{ section.settings.heading }}</h2>
          {%- endunless -%}
          {%- unless section.settings.savings_label == blank -%}
            <p class="mtb-pdp__savings">{{ section.settings.savings_label }}</p>
          {%- endunless -%}
        </div>
      </div>
    {%- endunless -%}

    {% render 'market-tote-bundler__pdp-layout',
        add_bundle_label: add_bundle_label,
        cart_label: cart_label,
        discount_type: discount_type,
        discount_value: discount_value %}

    <p
      class="type--small px-4 pb-4 text-center"
      x-show="incompleteReason"
      x-text="incompleteReason"
      x-cloak></p>

  </div>
</section>

<script type="application/json" id="{{ section_id }}-data">
{
  "discountCode": {{ section.settings.discount_code | default: settings.market_tote_discount_code | default: '' | strip | json }},
  "requiredCount": {{ required_count | json }},
  "products": [
    {%- if tote_coll != blank -%}
      {%- paginate tote_coll.products by 50 -%}
        {%- for product in tote_coll.products limit: 50 -%}
          {%- assign first_variant = product.selected_or_first_available_variant -%}
          {
            "handle": {{ product.handle | json }},
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "price": {{ first_variant.price | json }},
            "compareAtPrice": {{ first_variant.compare_at_price | default: 0 | json }},
            "available": {{ first_variant.available | json }},
            "variantId": {{ first_variant.id | json }},
            "swatchImage": {{ product.featured_image | image_url: width: 200 | json }},
            "images": [
              {%- for image in product.images limit: 8 -%}
                {
                  "thumb": {{ image | image_url: width: 160 | json }},
                  "hero": {{ image | image_url: width: 1200 | json }},
                  "hero600": {{ image | image_url: width: 600 | json }},
                  "hero900": {{ image | image_url: width: 900 | json }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- endpaginate -%}
    {%- endif -%}
  ]
}
</script>

<script>
(function() {
  function marketToteBundlerFactory_{{ js_id }}() {
    return {
      products: [],
      // Ordered picks (handles). Length ≤ requiredCount. Duplicates allowed.
      picks: [],
      previewHandle: null,
      galleryIndex: 0,
      // Stable hero <img> state — avoid x-if remount flash on SKU switch.
      heroSrc: '',
      heroSrcset: '',
      heroAlt: '',
      heroReady: false,
      _pendingHero: '',
      _prefetchCache: {},
      // handle|galleryIndex → { src, srcset } after first successful load
      _heroCache: {},
      requiredCount: {{ required_count }},
      cartLoading: false,
      incompleteReason: '',
      discountCode: '',

      init() {
        var dataEl = document.getElementById('{{ section_id }}-data');
        if (!dataEl) return;
        var data;
        try { data = JSON.parse(dataEl.textContent); }
        catch (e) { console.error('[market-tote-bundler] bad JSON data', e); return; }

        this.discountCode = (data.discountCode || '').trim();
        this.requiredCount = data.requiredCount || {{ required_count }};
        this.products = data.products || [];
        this.picks = [];
        this.galleryIndex = 0;
        this._prefetchCache = {};
        this._heroCache = {};
        var first = this.products.find(function(p){ return p.available; }) || this.products[0] || null;
        this.previewHandle = first ? first.handle : null;
        this.applyHero(true);
      },

      lockSlot(slotLabel, productHandle) {
        return this.preselect(productHandle);
      },

      // PDP drawer: preview this tote and seed it as pick #1 if empty.
      preselect(productHandle) {
        if (!productHandle) return false;
        var match = this.products.find(function(p){ return p.handle === productHandle; });
        if (!match) {
          console.warn('[market-tote-bundler] product not in catalog', productHandle);
          return false;
        }
        this.previewHandle = productHandle;
        this.galleryIndex = 0;
        this.applyHero(true);
        if (this.picks.length === 0 && match.available) {
          this.picks = [productHandle];
        }
        return true;
      },

      previewProduct() {
        return this.productByHandle(this.previewHandle) || this.products[0] || null;
      },

      previewImages() {
        var p = this.previewProduct();
        return (p && p.images && p.images.length) ? p.images : [];
      },

      currentHero() {
        var images = this.previewImages();
        if (!images.length) {
          var p = this.previewProduct();
          if (!p) return null;
          return {
            thumb: p.swatchImage,
            hero: p.swatchImage,
            hero600: p.swatchImage,
            hero900: p.swatchImage
          };
        }
        var idx = this.galleryIndex;
        if (idx < 0 || idx >= images.length) idx = 0;
        return images[idx];
      },

      heroSrcsetFor(image) {
        if (!image) return '';
        return (image.hero600 || '') + ' 600w, ' + (image.hero900 || '') + ' 900w, ' + (image.hero || '') + ' 1200w';
      },

      _heroCacheKey() {
        return (this.previewHandle || '') + '|' + this.galleryIndex;
      },

      // Show a tiny already-cached image immediately, then swap in the
      // large hero once it finishes loading (no <img> remount).
      applyHero(useSwatchPlaceholder) {
        var p = this.previewProduct();
        var image = this.currentHero();
        if (!p || !image) return;

        this.heroAlt = p.title || '';
        var cacheKey = this._heroCacheKey();
        var cached = this._heroCache[cacheKey];
        // Instant swap when this SKU/gallery frame was already loaded
        if (cached) {
          if (this.heroSrc === cached.src && this.heroReady) return;
          this._pendingHero = cached.src;
          this.heroSrc = cached.src;
          this.heroSrcset = cached.srcset || '';
          this.heroReady = true;
          return;
        }

        var placeholder = useSwatchPlaceholder
          ? (p.swatchImage || image.thumb || image.hero600 || image.hero)
          : (image.thumb || p.swatchImage || image.hero600 || image.hero);

        var target = image.hero || image.hero900 || placeholder;
        var targetSrcset = this.heroSrcsetFor(image);

        // Already showing this large hero — nothing to do
        if (this.heroSrc === target && this.heroReady) return;

        this.heroSrc = placeholder;
        this.heroSrcset = '';
        this.heroReady = false;
        this._loadHero(target, targetSrcset, cacheKey);
      },

      _loadHero(src, srcset, cacheKey) {
        if (!src) return;
        this._pendingHero = src;
        var self = this;
        var img = new Image();
        img.onload = function() {
          if (self._pendingHero !== src) return;
          self.heroSrc = src;
          self.heroSrcset = srcset || '';
          self.heroReady = true;
          if (cacheKey) {
            self._heroCache[cacheKey] = { src: src, srcset: srcset || '' };
          }
        };
        img.onerror = function() {
          if (self._pendingHero !== src) return;
          self.heroReady = true;
        };
        if (srcset) {
          img.sizes = '(min-width: 990px) 45vw, 100vw';
          img.srcset = srcset;
        }
        img.src = src;
      },

      // Warm the primary hero for a tote on swatch hover/focus only —
      // not a bulk preload of the whole collection (egress-safe).
      prefetchProduct(handle) {
        var p = this.productByHandle(handle);
        if (!p) return;
        var image = (p.images && p.images[0]) || null;
        var url = image
          ? (image.hero900 || image.hero || p.swatchImage)
          : p.swatchImage;
        this.prefetchUrl(url);
      },

      prefetchUrl(url) {
        if (!url || this._prefetchCache[url]) return;
        this._prefetchCache[url] = true;
        var img = new Image();
        img.src = url;
      },

      selectGallery(index) {
        var images = this.previewImages();
        if (index < 0 || index >= images.length) return;
        this.galleryIndex = index;
        this.applyHero(false);
      },

      productByHandle(handle) {
        return this.products.find(function(p){ return p.handle === handle; }) || null;
      },

      shortName(title) {
        if (!title) return '';
        var idx = title.indexOf(' - ');
        return idx > 0 ? title.slice(0, idx) : title;
      },

      selectPreview(handle) {
        var p = this.productByHandle(handle);
        if (!p) return;
        this.previewHandle = handle;
        this.galleryIndex = 0;
        this.applyHero(true);
      },

      isPreview(handle) {
        return this.previewHandle === handle;
      },

      totalSelected() {
        return this.picks.length;
      },

      remainingCount() {
        return Math.max(0, this.requiredCount - this.picks.length);
      },

      dotIndexes() {
        var out = [];
        for (var i = 1; i <= this.requiredCount; i++) out.push(i);
        return out;
      },

      isComplete() {
        return this.picks.length === this.requiredCount;
      },

      canAddToBundle() {
        if (this.isComplete()) return false;
        var p = this.previewProduct();
        return !!(p && p.available);
      },

      addToBundle() {
        if (!this.canAddToBundle()) return;
        this.picks = this.picks.concat([this.previewHandle]);
      },

      removePick(index) {
        if (index < 0 || index >= this.picks.length) return;
        this.picks = this.picks.filter(function(_, i){ return i !== index; });
      },

      pickProduct(index) {
        return this.productByHandle(this.picks[index]);
      },

      subtotalCents() {
        var sum = 0;
        var self = this;
        this.picks.forEach(function(handle) {
          var p = self.productByHandle(handle);
          if (p) sum += p.price;
        });
        return sum;
      },

      discountCents() {
        var sub = this.subtotalCents();
        if (!this.canAddToCart()) return 0;
        {% case discount_type %}
          {% when 'percent' %}
            return Math.round(sub * ({{ discount_value | default: 0 }} / 100));
          {% when 'fixed_off' %}
            return Math.min(sub, {{ discount_value | default: 0 | times: 100 }});
          {% else %}
            return 0;
        {% endcase %}
      },

      totalCents() {
        if (!this.canAddToCart()) return this.subtotalCents();
        return Math.max(0, this.subtotalCents() - this.discountCents());
      },

      formatMoney(cents) {
        if (typeof cents !== 'number') return '';
        if (window.Shopify && window.Shopify.formatMoney) {
          return window.Shopify.formatMoney(cents, '{{ cart.currency.symbol }}');
        }
        return '$' + (cents / 100).toFixed(2);
      },

      canAddToCart() {
        if (this.picks.length !== this.requiredCount) return false;
        for (var i = 0; i < this.picks.length; i++) {
          var p = this.productByHandle(this.picks[i]);
          if (!p || !p.available) return false;
        }
        return true;
      },

      primaryAction() {
        if (this.isComplete()) {
          this.finalizeBundle();
        } else {
          this.addToBundle();
        }
      },

      finalizeBundle() {
        if (!this.canAddToCart() || this.cartLoading) return Promise.resolve();
        this.cartLoading = true;
        this.incompleteReason = '';

        var bundleId = 'tote_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
        var items = [];
        for (var i = 0; i < this.picks.length; i++) {
          var p = this.productByHandle(this.picks[i]);
          if (!p) continue;
          items.push({
            id: p.variantId,
            quantity: 1,
            properties: {
              'Bundle Slot': 'Tote ' + (i + 1),
              '_bundle_id': bundleId,
              '_bundle_type': 'market_tote'
            }
          });
        }

        var self = this;
        var rootScope = (window.Alpine && document.body) ? window.Alpine.$data(document.body) : null;

        return fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: items })
        })
        .then(function(r){
          return r.json().then(function(body){
            if (!r.ok) throw Object.assign(new Error('Add to cart failed'), { body: body });
            return body;
          });
        })
        .then(function() {
          if (self.discountCode) {
            fetch('/discount/' + encodeURIComponent(self.discountCode), {
              method: 'GET',
              credentials: 'same-origin'
            }).catch(function(){});
          }
          if (rootScope && typeof rootScope.updateCart === 'function') {
            rootScope.updateCart(true);
          }
          window.dispatchEvent(new CustomEvent('market-tote-drawer:close'));
        })
        .catch(function(err){
          var msg = (err && err.body && err.body.description) || 'Could not add bundle to cart. Please try again.';
          self.incompleteReason = msg;
          if (rootScope) {
            rootScope.error_title = (err && err.body && err.body.message) || 'Something went wrong';
            rootScope.error_message = msg;
            rootScope.show_alert = true;
          }
          console.error('[market-tote-bundler]', err);
        })
        .finally(function(){
          self.cartLoading = false;
        });
      }
    };
  }

  window.marketToteBundler_{{ js_id }} = marketToteBundlerFactory_{{ js_id }};

  function registerMarketToteBundler_{{ js_id }}() {
    if (!window.Alpine || typeof window.Alpine.data !== 'function') return false;
    window.Alpine.data('marketToteBundler_{{ js_id }}', marketToteBundlerFactory_{{ js_id }});
    return true;
  }
  if (!registerMarketToteBundler_{{ js_id }}()) {
    document.addEventListener('alpine:init', registerMarketToteBundler_{{ js_id }});
  }
})();
</script>

{% schema %}
{
  "name": "Market Tote bundler",
  "tag": "section",
  "class": "section-market-tote-bundler",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Tote Bundle"
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Savings line (under heading)",
      "default": "Save 25% when you buy 3 Market Totes",
      "info": "Shown under the heading in Thread copper/gold. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "add_to_bundle_text",
      "label": "Add to Bundle button text",
      "default": "Add to Bundle"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Add to Cart button text",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "source_collection",
      "label": "Market Tote collection",
      "info": "Products shown in the swatch grid. Defaults to reusable-market-tote-bags when blank."
    },
    {
      "type": "header",
      "content": "Bundle discount",
      "info": "discount_type / discount_value control only the savings LABEL. Create a matching discount in Shopify admin and enter its code below so checkout gets the real 25% off."
    },
    {
      "type": "select",
      "id": "discount_type",
      "label": "Discount type (display label)",
      "options": [
        { "value": "percent", "label": "Percent off" },
        { "value": "fixed_off", "label": "Fixed amount off" },
        { "value": "none", "label": "No discount" }
      ],
      "default": "percent"
    },
    {
      "type": "number",
      "id": "discount_value",
      "label": "Discount value (percent OR dollar amount, label only)",
      "default": 25
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code (overrides theme setting)",
      "info": "Leave blank to use Theme settings → Market Tote bundle → Discount code."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "min": 0,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "select",
      "id": "layout_horizontal",
      "label": "Width",
      "options": [
        { "value": "window--narrow", "label": "Narrow" },
        { "value": "window", "label": "Default" },
        { "value": "window--wide", "label": "Wide" },
        { "value": "window--full", "label": "Full" }
      ],
      "default": "window"
    },
    {
      "type": "header",
      "content": "Colors & borders"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color__bg-body color__text", "label": "Body" },
        { "value": "color__bg-neutral color__text", "label": "Neutral" },
        { "value": "color__bg-overlay-1 color__text", "label": "Overlay 1" },
        { "value": "color__bg-overlay-2 color__text", "label": "Overlay 2" },
        { "value": "color__bg-overlay-3 color__text", "label": "Overlay 3" }
      ],
      "default": "color__bg-body color__text"
    },
    {
      "type": "select",
      "id": "color_border",
      "label": "Border color",
      "options": [
        { "value": "color__border-divider-1", "label": "Divider" },
        { "value": "color__border-selected-1", "label": "Selected" }
      ],
      "default": "color__border-divider-1"
    },
    {
      "type": "select",
      "id": "style_border",
      "label": "Border style",
      "options": [
        { "value": "", "label": "None" },
        { "value": "border--t-width", "label": "Top" },
        { "value": "border--b-width", "label": "Bottom" },
        { "value": "border--b-width border--t-width", "label": "Top and bottom" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        { "value": "", "label": "Show on all devices" },
        { "value": "md:hidden", "label": "Show on mobile only" },
        { "value": "hidden md:block", "label": "Show on desktop only" }
      ],
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "Market Tote bundler"
    }
  ]
}
{% endschema %}
