{% comment %}
  Market Tote bundler — pick 3 totes from one grid with per-product qty.

  Each tote has a +/- quantity control. Total quantity across all totes
  must equal 3. Same tote can be added more than once. Bottom CTA is
  Add to Cart only. Status copy: "Select three/two/one more".

  Discount display is section settings; real checkout discount applies via
  Shopify discount code (silent /discount/CODE after add-to-cart).

  Used on: standalone page, collection sections, PDP drawer (preselects
  qty 1 of the current product when opened from a Market Tote PDP).
{% endcomment %}

{%- liquid
  assign section_id = 'market-tote-bundler-' | append: section.id
  assign js_id = section.id | replace: '-', '_'
  assign discount_type = section.settings.discount_type
  assign discount_value = section.settings.discount_value | default: 25
  assign required_count = 3
  assign savings_label = section.settings.savings_label | default: 'Save 25% when you buy 3 Market Totes'
  assign button_label = section.settings.cta_text | default: 'Add Bundle to Cart'

  assign tote_coll = section.settings.source_collection
  if tote_coll == blank
    if settings.market_tote_collection != blank
      assign tote_coll = settings.market_tote_collection
    else
      assign tote_coll = collections['reusable-market-tote-bags']
    endif
  endif
-%}

<section
  id="{{ section_id }}"
  class="
    {{ section.settings.visibility }}
    {{ section.settings.color_scheme }}
    {{ section.settings.color_border }}
    {{ section.settings.style_border }}
  ">
  <div
    class="bundle-wizard market-tote-bundler {{ section.settings.layout_horizontal }}"
    style="
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;
    "
    x-data="marketToteBundler_{{ js_id }}">

    {%- unless section.settings.heading == blank and section.settings.subheading == blank -%}
      <div class="flex flex-col items-center px-4 pb-4 text-center">
        <div class="max-w-prose">
          {%- unless section.settings.heading == blank -%}
            <h2>{{ section.settings.heading }}</h2>
          {%- endunless -%}
          {%- unless section.settings.subheading == blank -%}
            <div class="m-0--clear pt-2">
              {{ section.settings.subheading }}
            </div>
          {%- endunless -%}
        </div>
      </div>
    {%- endunless -%}

    <div class="bundle-wizard__savings-strip">{{ savings_label }}</div>

    <p
      class="market-tote-bundler__remaining"
      x-text="remainingLabel()"
      x-show="remainingCount() > 0"
      aria-live="polite"></p>
    <p
      class="market-tote-bundler__remaining is-complete"
      x-show="remainingCount() === 0"
      x-cloak
      aria-live="polite">
      Bundle ready — add to cart
    </p>

    {% render 'market-tote-bundler__grid' %}

    <div class="px-4 pt-4" x-show="totalSelected() > 0" x-cloak>
      {% render 'bundle__price-summary',
          discount_type: discount_type,
          discount_value: discount_value %}
    </div>

    <div class="bundle-wizard__footer market-tote-bundler__footer">
      <p
        class="bundle-wizard__footer-price"
        x-text="formatMoney(totalCents())"
        aria-label="Bundle total"></p>
      <button
        type="button"
        class="btn btn--primary"
        :disabled="!canAddToCart() || cartLoading"
        :class="{ 'opacity-50 cursor-not-allowed': !canAddToCart() || cartLoading }"
        @click="finalizeBundle()">
        <span x-show="!cartLoading">{{ button_label }}</span>
        <span x-show="cartLoading" x-cloak>Adding…</span>
      </button>
    </div>

    <p
      class="type--small px-4 pb-4 text-center"
      x-show="incompleteReason"
      x-text="incompleteReason"
      x-cloak></p>

  </div>
</section>

<script type="application/json" id="{{ section_id }}-data">
{
  "discountCode": {{ section.settings.discount_code | default: settings.market_tote_discount_code | default: '' | strip | json }},
  "requiredCount": {{ required_count | json }},
  "products": [
    {%- if tote_coll != blank -%}
      {%- paginate tote_coll.products by 50 -%}
        {%- for product in tote_coll.products limit: 50 -%}
          {%- assign first_variant = product.selected_or_first_available_variant -%}
          {
            "handle": {{ product.handle | json }},
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "price": {{ first_variant.price | json }},
            "compareAtPrice": {{ first_variant.compare_at_price | default: 0 | json }},
            "available": {{ first_variant.available | json }},
            "variantId": {{ first_variant.id | json }},
            "swatchImage": {{ product.featured_image | image_url: width: 400 | json }},
            "swatchImage400": {{ product.featured_image | image_url: width: 400 | json }},
            "swatchImage600": {{ product.featured_image | image_url: width: 600 | json }},
            "swatchImage900": {{ product.featured_image | image_url: width: 900 | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- endpaginate -%}
    {%- endif -%}
  ]
}
</script>

<script>
(function() {
  function marketToteBundlerFactory_{{ js_id }}() {
    return {
      products: [],
      // handle → quantity (0 omitted). Total across handles ≤ requiredCount.
      quantities: {},
      requiredCount: {{ required_count }},
      cartLoading: false,
      incompleteReason: '',
      discountCode: '',
      pageSize: 12,
      pagesShown: 1,

      init() {
        var dataEl = document.getElementById('{{ section_id }}-data');
        if (!dataEl) return;
        var data;
        try { data = JSON.parse(dataEl.textContent); }
        catch (e) { console.error('[market-tote-bundler] bad JSON data', e); return; }

        this.discountCode = (data.discountCode || '').trim();
        this.requiredCount = data.requiredCount || {{ required_count }};
        this.products = data.products || [];
        this.pagesShown = 1;
        this.quantities = {};
      },

      // PDP drawer entry: seed qty 1 of the current product.
      lockSlot(slotLabel, productHandle) {
        return this.preselect(productHandle);
      },

      preselect(productHandle) {
        if (!productHandle) return false;
        var match = this.products.find(function(p){ return p.handle === productHandle; });
        if (!match) {
          console.warn('[market-tote-bundler] product not in catalog', productHandle);
          return false;
        }
        if (this.qtyOf(productHandle) > 0) return true;
        if (this.totalSelected() >= this.requiredCount) return false;
        this.quantities = Object.assign({}, this.quantities, { [productHandle]: 1 });
        return true;
      },

      qtyOf(handle) {
        return this.quantities[handle] || 0;
      },

      isSelected(handle) {
        return this.qtyOf(handle) > 0;
      },

      totalSelected() {
        var total = 0;
        var q = this.quantities;
        Object.keys(q).forEach(function(handle) {
          total += q[handle] || 0;
        });
        return total;
      },

      canIncrease(handle) {
        var product = this.productByHandle(handle);
        if (!product || !product.available) return false;
        return this.totalSelected() < this.requiredCount;
      },

      increaseQty(handle) {
        if (!this.canIncrease(handle)) return;
        var next = this.qtyOf(handle) + 1;
        this.quantities = Object.assign({}, this.quantities, { [handle]: next });
      },

      decreaseQty(handle) {
        var current = this.qtyOf(handle);
        if (current <= 0) return;
        var next = current - 1;
        var copy = Object.assign({}, this.quantities);
        if (next <= 0) {
          delete copy[handle];
        } else {
          copy[handle] = next;
        }
        this.quantities = copy;
      },

      // Tile image click: +1 if room, otherwise no-op. Qty 0→1 via + or image.
      addOrIgnore(handle) {
        this.increaseQty(handle);
      },

      remainingCount() {
        return Math.max(0, this.requiredCount - this.totalSelected());
      },

      remainingLabel() {
        var n = this.remainingCount();
        if (n <= 0) return '';
        if (n === 1) return 'Select one more';
        if (n === 2) return 'Select two more';
        return 'Select three more';
      },

      productByHandle(handle) {
        return this.products.find(function(p){ return p.handle === handle; }) || null;
      },

      subtotalCents() {
        var sum = 0;
        var self = this;
        Object.keys(this.quantities).forEach(function(handle) {
          var p = self.productByHandle(handle);
          var qty = self.quantities[handle] || 0;
          if (p && qty) sum += p.price * qty;
        });
        return sum;
      },

      discountCents() {
        var sub = this.subtotalCents();
        if (!this.canAddToCart()) return 0;
        {% case discount_type %}
          {% when 'percent' %}
            return Math.round(sub * ({{ discount_value | default: 0 }} / 100));
          {% when 'fixed_off' %}
            return Math.min(sub, {{ discount_value | default: 0 | times: 100 }});
          {% else %}
            return 0;
        {% endcase %}
      },

      totalCents() {
        if (!this.canAddToCart()) return this.subtotalCents();
        return Math.max(0, this.subtotalCents() - this.discountCents());
      },

      formatMoney(cents) {
        if (typeof cents !== 'number') return '';
        if (window.Shopify && window.Shopify.formatMoney) {
          return window.Shopify.formatMoney(cents, '{{ cart.currency.symbol }}');
        }
        return '$' + (cents / 100).toFixed(2);
      },

      canAddToCart() {
        if (this.totalSelected() !== this.requiredCount) return false;
        var self = this;
        return Object.keys(this.quantities).every(function(handle) {
          var p = self.productByHandle(handle);
          return p && p.available && self.quantities[handle] > 0;
        });
      },

      visibleProducts() {
        return this.products.slice(0, this.pageSize * this.pagesShown);
      },

      hasMore() {
        return this.products.length > this.pageSize * this.pagesShown;
      },

      showMore() {
        this.pagesShown += 1;
      },

      finalizeBundle() {
        if (!this.canAddToCart() || this.cartLoading) return Promise.resolve();
        this.cartLoading = true;
        this.incompleteReason = '';

        var bundleId = 'tote_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
        var items = [];
        var slot = 1;
        var self = this;
        Object.keys(this.quantities).forEach(function(handle) {
          var p = self.productByHandle(handle);
          var qty = self.quantities[handle] || 0;
          if (!p || qty < 1) return;
          // One cart line per unit so Bundle Slot labels stay unique when
          // the same tote is chosen more than once.
          for (var i = 0; i < qty; i++) {
            items.push({
              id: p.variantId,
              quantity: 1,
              properties: {
                'Bundle Slot': 'Tote ' + slot,
                '_bundle_id': bundleId,
                '_bundle_type': 'market_tote'
              }
            });
            slot += 1;
          }
        });

        var rootScope = (window.Alpine && document.body) ? window.Alpine.$data(document.body) : null;

        return fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: items })
        })
        .then(function(r){
          return r.json().then(function(body){
            if (!r.ok) throw Object.assign(new Error('Add to cart failed'), { body: body });
            return body;
          });
        })
        .then(function() {
          if (self.discountCode) {
            fetch('/discount/' + encodeURIComponent(self.discountCode), {
              method: 'GET',
              credentials: 'same-origin'
            }).catch(function(){});
          }
          if (rootScope && typeof rootScope.updateCart === 'function') {
            rootScope.updateCart(true);
          }
          window.dispatchEvent(new CustomEvent('market-tote-drawer:close'));
        })
        .catch(function(err){
          var msg = (err && err.body && err.body.description) || 'Could not add bundle to cart. Please try again.';
          self.incompleteReason = msg;
          if (rootScope) {
            rootScope.error_title = (err && err.body && err.body.message) || 'Something went wrong';
            rootScope.error_message = msg;
            rootScope.show_alert = true;
          }
          console.error('[market-tote-bundler]', err);
        })
        .finally(function(){
          self.cartLoading = false;
        });
      }
    };
  }

  window.marketToteBundler_{{ js_id }} = marketToteBundlerFactory_{{ js_id }};

  function registerMarketToteBundler_{{ js_id }}() {
    if (!window.Alpine || typeof window.Alpine.data !== 'function') return false;
    window.Alpine.data('marketToteBundler_{{ js_id }}', marketToteBundlerFactory_{{ js_id }});
    return true;
  }
  if (!registerMarketToteBundler_{{ js_id }}()) {
    document.addEventListener('alpine:init', registerMarketToteBundler_{{ js_id }});
  }
})();
</script>

{% schema %}
{
  "name": "Market Tote bundler",
  "tag": "section",
  "class": "section-market-tote-bundler",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Tote Bundle"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Pick 3 Market Totes and save 25%</p>"
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Savings strip text",
      "default": "Save 25% when you buy 3 Market Totes"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Add-to-cart button text",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "source_collection",
      "label": "Market Tote collection",
      "info": "Products shown in the grid. Defaults to reusable-market-tote-bags when blank."
    },
    {
      "type": "header",
      "content": "Bundle discount",
      "info": "discount_type / discount_value control only the savings LABEL. Create a matching discount in Shopify admin and enter its code below so checkout gets the real 25% off."
    },
    {
      "type": "select",
      "id": "discount_type",
      "label": "Discount type (display label)",
      "options": [
        { "value": "percent", "label": "Percent off" },
        { "value": "fixed_off", "label": "Fixed amount off" },
        { "value": "none", "label": "No discount" }
      ],
      "default": "percent"
    },
    {
      "type": "number",
      "id": "discount_value",
      "label": "Discount value (percent OR dollar amount, label only)",
      "default": 25
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code (overrides theme setting)",
      "info": "Leave blank to use Theme settings → Market Tote bundle → Discount code."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "min": 0,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "select",
      "id": "layout_horizontal",
      "label": "Width",
      "options": [
        { "value": "window--narrow", "label": "Narrow" },
        { "value": "window", "label": "Default" },
        { "value": "window--wide", "label": "Wide" },
        { "value": "window--full", "label": "Full" }
      ],
      "default": "window"
    },
    {
      "type": "header",
      "content": "Colors & borders"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color__bg-body color__text", "label": "Body" },
        { "value": "color__bg-neutral color__text", "label": "Neutral" },
        { "value": "color__bg-overlay-1 color__text", "label": "Overlay 1" },
        { "value": "color__bg-overlay-2 color__text", "label": "Overlay 2" },
        { "value": "color__bg-overlay-3 color__text", "label": "Overlay 3" }
      ],
      "default": "color__bg-body color__text"
    },
    {
      "type": "select",
      "id": "color_border",
      "label": "Border color",
      "options": [
        { "value": "color__border-divider-1", "label": "Divider" },
        { "value": "color__border-selected-1", "label": "Selected" }
      ],
      "default": "color__border-divider-1"
    },
    {
      "type": "select",
      "id": "style_border",
      "label": "Border style",
      "options": [
        { "value": "", "label": "None" },
        { "value": "border--t-width", "label": "Top" },
        { "value": "border--b-width", "label": "Bottom" },
        { "value": "border--b-width border--t-width", "label": "Top and bottom" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        { "value": "", "label": "Show on all devices" },
        { "value": "md:hidden", "label": "Show on mobile only" },
        { "value": "hidden md:block", "label": "Show on desktop only" }
      ],
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "Market Tote bundler"
    }
  ]
}
{% endschema %}
