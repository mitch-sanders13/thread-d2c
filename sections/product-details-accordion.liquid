{% comment %}
  sections/product__details-accordion.liquid

  PDP product-details / education accordion.

  A full-width product-page section built on Shopify theme blocks:
    - accordion_row   : a collapsible dropdown. Nestable — an accordion_row
                        may contain more accordion_rows for sub-dropdowns.
    - accordion_text  : sub-heading + rich-text body.
    - accordion_media : image or video (Shopify-hosted upload or YouTube /
                        Vimeo URL).

  Every text / image / video setting can be connected to a product
  metafield via the editor's dynamic-source picker (the section is
  product-template scoped, so `product.metafields.*` is in range).

  Open / close is CSS-driven: one Alpine boolean toggles `.pdp-acc--open`
  on each row's root, and CSS handles the icon swap + height animation.
  Because every row owns its own Alpine scope, nested accordions keep
  independent open state.

  Structural CSS for the whole feature (section + all three block types)
  lives here in one place — the section is always present whenever the
  blocks are, and global class names let the rules reach blocks at any
  nesting depth.
{% endcomment %}
{%- comment -%} build: pdp-accordion v2 {%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

<section
  class="pdp-da {{ s.color_scheme }} {{ s.style_border }} {{ s.visibility }}"
  style="padding: {{ s.spacing_top }}px {{ s.spacing_right }}px {{ s.spacing_bottom }}px {{ s.spacing_left }}px;">
  {%- comment -%} width is locked to md:window so it always lines up with the product__main section {%- endcomment -%}
  <div class="pdp-da__inner md:window">
    {%- if s.heading != blank or s.intro != blank -%}
      <div class="pdp-da__head">
        {%- if s.heading != blank -%}
          <h2 class="pdp-da__heading">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.intro != blank -%}
          <div class="pdp-da__intro rte">{{ s.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="pdp-da__rows"
      {%- if s.content_max_width > 0 %} style="max-width: {{ s.content_max_width }}px;"{% endif -%}>
      {% content_for "blocks" %}
    </div>
  </div>
</section>

{% style %}
  /* ================================================================
     Product details accordion — structural CSS (rendered once).
     Global class names so the rules reach nested blocks at any depth.
     ================================================================ */
  .pdp-da__inner { width: 100%; }
  .pdp-da__head { margin-bottom: 24px; padding-inline: 1rem; }
  .pdp-da__heading { margin: 0 0 8px; }
  .pdp-da__heading:last-child { margin-bottom: 0; }
  .pdp-da__intro { margin: 0; }
  .pdp-da__rows {
    display: flex;
    flex-direction: column;
    gap: {{ s.row_gap }}px;
    margin-inline: auto;
    padding-inline: 1rem;
    width: 100%;
  }

  /* ---- accordion row ---- */
  .pdp-acc { width: 100%; }
  .pdp-acc__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    margin: 0;
    padding: 18px 0;
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }
  .pdp-acc__title { display: block; }
  .pdp-acc__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }
  .pdp-acc__icon-plus  { display: inline-flex; }
  .pdp-acc__icon-minus { display: none; }
  .pdp-acc--open > .pdp-acc__header .pdp-acc__icon-plus  { display: none; }
  .pdp-acc--open > .pdp-acc__header .pdp-acc__icon-minus { display: inline-flex; }

  /* collapse animation via grid-template-rows 0fr -> 1fr */
  .pdp-acc__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .32s ease;
  }
  .pdp-acc--open > .pdp-acc__panel { grid-template-rows: 1fr; }
  .pdp-acc__panel-inner { overflow: hidden; min-height: 0; }

  /* two-column flexible content grid (text + media) */
  .pdp-acc__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-auto-flow: dense;
    align-items: start;
    column-gap: 40px;
    row-gap: 32px;
    padding-bottom: 32px;
  }
  /* min-width:0 lets a wide embed (e.g. the Okendo reviews widget)
     reflow to the column width instead of overflowing the screen */
  .pdp-acc__grid > * { min-width: 0; max-width: 100%; }
  .pdp-acc__col--left  { grid-column: 1; }
  .pdp-acc__col--right { grid-column: 2; }
  .pdp-acc__col--full  { grid-column: 1 / -1; }

  /* header vertical padding is set per row via the accordion_row block
     setting (hdr_pad_v); the 18px above is just the fallback */

  /* ---- text block ---- */
  /* header / sub-heading / body spacing is set per block via the Text
     block's four-way padding controls; no structural margin here */
  .pdp-acc__heading,
  .pdp-acc__subheading { margin: 0; }
  .pdp-acc__body > :first-child { margin-top: 0; }
  .pdp-acc__body > :last-child  { margin-bottom: 0; }

  /* ---- media block ---- */
  .pdp-acc__media-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: rgba(0,0,0,0.04);
  }
  .pdp-acc__media-frame img,
  .pdp-acc__media-frame video,
  .pdp-acc__media-frame iframe {
    display: block;
    width: 100%;
    border: 0;
  }
  .pdp-acc__media-frame--ratio img,
  .pdp-acc__media-frame--ratio video,
  .pdp-acc__media-frame--ratio iframe {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
  }
  .pdp-acc__media-frame--natural img,
  .pdp-acc__media-frame--natural video { height: auto; }
  .pdp-acc__caption { margin: 8px 0 0; }

  /* reviews block — force the Okendo widget to fill the full row width;
     it otherwise renders its narrow layout and leaves the row half-empty */
  .pdp-acc__reviews {
    grid-column: 1 / -1 !important;
    min-width: 0;
    width: 100% !important;
    max-width: 100% !important;
  }
  .pdp-acc__reviews > *,
  .pdp-acc__reviews [data-oke-widget],
  .pdp-acc__reviews [data-oke-reviews-widget],
  .pdp-acc__reviews .oke-w {
    width: 100% !important;
    max-width: 100% !important;
  }

  @media (max-width: 749px) {
    .pdp-acc__grid {
      grid-template-columns: minmax(0, 1fr);
      column-gap: 0;
      row-gap: 20px;
    }
    .pdp-acc__col--left,
    .pdp-acc__col--right,
    .pdp-acc__col--full { grid-column: 1 / -1; }
  }

  /* ================================================================
     Section instance — heading typography (settings-driven)
     ================================================================ */
  #shopify-section-{{ section.id }} .pdp-da__heading {
    {%- case s.heading_font -%}
      {%- when 'body' -%}font-family: var(--type-font-body-family);
      {%- when 'heading' -%}font-family: var(--type-font-header-family);
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
    {%- endcase -%}
    {%- if s.heading_size_d > 0 %} font-size: {{ s.heading_size_d }}px;{% endif -%}
    {%- if s.heading_weight != blank %} font-weight: {{ s.heading_weight }};{% endif -%}
    {%- if s.heading_case != blank %} text-transform: {{ s.heading_case }};{% endif -%}
    {%- if s.heading_ls > 0 %} letter-spacing: {{ s.heading_ls | divided_by: 100.0 }}em;{% endif -%}
    {%- if s.heading_color != blank %} color: {{ s.heading_color }};{% endif -%}
    text-align: {{ s.heading_align }};
  }
  #shopify-section-{{ section.id }} .pdp-da__intro { text-align: {{ s.heading_align }}; }
  {%- if s.heading_size_m > 0 -%}
    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} .pdp-da__heading { font-size: {{ s.heading_size_m }}px; }
    }
  {%- endif -%}
{% endstyle %}

{% schema %}
{
  "name": "Product details",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "info": "Optional. Use the dynamic-source icon to connect a product metafield."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },

    { "type": "header", "content": "Heading typography" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Font",
      "options": [
        { "value": "", "label": "Theme default" },
        { "value": "body", "label": "Body (Forma DJR)" },
        { "value": "heading", "label": "Heading (PP Right Grotesk)" },
        { "value": "handwritten", "label": "Handwritten" }
      ],
      "default": "heading"
    },
    { "type": "range", "id": "heading_size_d", "label": "Size — desktop (px)", "info": "0 = theme default.", "min": 0, "max": 64, "step": 1, "default": 28 },
    { "type": "range", "id": "heading_size_m", "label": "Size — mobile (px)", "info": "0 = theme default.", "min": 0, "max": 48, "step": 1, "default": 22 },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Weight",
      "options": [
        { "value": "", "label": "Theme default" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "Case",
      "options": [
        { "value": "", "label": "Theme default" },
        { "value": "none", "label": "Normal" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": ""
    },
    { "type": "range", "id": "heading_ls", "label": "Letter spacing", "info": "In hundredths of an em — 5 = 0.05em, 40 = 0.40em.", "min": 0, "max": 60, "step": 1, "default": 0 },
    { "type": "color", "id": "heading_color", "label": "Color" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_max_width", "label": "Max content width (px)", "info": "Caps the accordion column. 0 = fill the container.", "min": 0, "max": 1400, "step": 20, "default": 0 },
    { "type": "range", "id": "row_gap", "label": "Gap between accordions (px)", "min": 0, "max": 48, "step": 2, "default": 0 },

    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "spacing_top", "label": "Top (px)", "min": 0, "max": 200, "step": 4, "default": 48 },
    { "type": "range", "id": "spacing_right", "label": "Right (px)", "info": "Padding in from the section edge.", "min": 0, "max": 200, "step": 4, "default": 0 },
    { "type": "range", "id": "spacing_bottom", "label": "Bottom (px)", "min": 0, "max": 200, "step": 4, "default": 48 },
    { "type": "range", "id": "spacing_left", "label": "Left (px)", "info": "Padding in from the section edge.", "min": 0, "max": 200, "step": 4, "default": 0 },

    { "type": "header", "content": "Colors and borders" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color__bg-body color__text", "label": "Body" },
        { "value": "color__bg-neutral color__text", "label": "Neutral" },
        { "value": "color__bg-overlay-1 color__text", "label": "Overlay 1" },
        { "value": "color__bg-overlay-2 color__text", "label": "Overlay 2" },
        { "value": "color__bg-overlay-3 color__text", "label": "Overlay 3" }
      ],
      "default": "color__bg-body color__text"
    },
    {
      "type": "select",
      "id": "style_border",
      "label": "Section border",
      "options": [
        { "value": "", "label": "None" },
        { "value": "border--t-width", "label": "Top" },
        { "value": "border--b-width", "label": "Bottom" },
        { "value": "border--t-width border--b-width", "label": "Top & bottom" }
      ],
      "default": ""
    },

    { "type": "header", "content": "Visibility" },
    {
      "type": "select",
      "id": "visibility",
      "label": "Show on",
      "options": [
        { "value": "", "label": "All devices" },
        { "value": "md:hidden", "label": "Mobile only" },
        { "value": "hidden md:block", "label": "Desktop only" }
      ],
      "default": ""
    }
  ],
  "blocks": [{ "type": "accordion_row" }],
  "presets": [{ "name": "Product details" }]
}
{% endschema %}
