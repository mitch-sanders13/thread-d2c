<!-- sections/featured-collections-grid.liquid -->
{% comment %}
  Featured collections grid with large and small cards.
  Layout: 2 tall cards on left, 2x2 smaller cards on right (desktop).
  Each card has a background image with a label overlay at bottom-left.
{% endcomment %}

<section class="{{ section.settings.visibility }}{% if section.settings.use_global_spacing == 'global' %} spacing-global{% elsif section.settings.use_global_spacing == 'global-sides' %} spacing-sides{% endif %}"
  style="
    {% if section.settings.use_global_spacing == 'custom' %}
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;
      padding-left:{{ section.settings.spacing_sides }}px;
      padding-right:{{ section.settings.spacing_sides }}px;
    {% elsif section.settings.use_global_spacing == 'global-sides' %}
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;
    {% endif %}
    {% if section.settings.background_color != blank %}
      background-color:{{ section.settings.background_color }};
    {% endif %}">

  {%- comment -%} Resolve heading font token vs manual {%- endcomment -%}
  {% assign fcg_heading_use_token = false %}
  {% assign fcg_heading_token_class = '' %}
  {% assign fcg_heading_font_style = '' %}
  {% if section.settings.heading_font contains 'token-' %}
    {% assign fcg_heading_use_token = true %}
    {% assign fcg_heading_token_class = section.settings.heading_font | replace: 'token-', 'type-' %}
  {% elsif section.settings.heading_font == 'body' %}
    {% assign fcg_heading_font_style = 'font-family:var(--type-font-body-family);' %}
  {% elsif section.settings.heading_font == 'heading' %}
    {% assign fcg_heading_font_style = 'font-family:var(--type-font-header-family);' %}
  {% elsif section.settings.heading_font == 'nav' %}
    {% assign fcg_heading_font_style = 'font-family:var(--type-font-nav-family);' %}
  {% elsif section.settings.heading_font == 'handwritten' %}
    {% assign fcg_heading_font_style = 'font-family:var(--type-font-handwritten-family);' %}
  {% endif %}

  {%- comment -%} Resolve label font token vs manual {%- endcomment -%}
  {% assign fcg_label_use_token = false %}
  {% assign fcg_label_token_class = '' %}
  {% assign fcg_label_font_style = '' %}
  {% if section.settings.label_font contains 'token-' %}
    {% assign fcg_label_use_token = true %}
    {% assign fcg_label_token_class = section.settings.label_font | replace: 'token-', 'type-' %}
  {% elsif section.settings.label_font == 'body' %}
    {% assign fcg_label_font_style = 'font-family:var(--type-font-body-family);' %}
  {% elsif section.settings.label_font == 'heading' %}
    {% assign fcg_label_font_style = 'font-family:var(--type-font-header-family);' %}
  {% elsif section.settings.label_font == 'nav' %}
    {% assign fcg_label_font_style = 'font-family:var(--type-font-nav-family);' %}
  {% elsif section.settings.label_font == 'handwritten' %}
    {% assign fcg_label_font_style = 'font-family:var(--type-font-handwritten-family);' %}
  {% endif %}

  {%- comment -%} Heading {%- endcomment -%}
  {%- unless section.settings.heading == blank -%}
    <div style="text-align:{{ section.settings.heading_align }};margin-bottom:{{ section.settings.heading_bottom_spacing }}px;">
      <{{ section.settings.heading_tag }} style="
        {% if section.settings.heading_color != blank %}
          color:{{ section.settings.heading_color }};
        {% endif %}
        {% unless fcg_heading_use_token %}
          font-size:{{ section.settings.heading_size_mobile }}px;
          font-weight:{{ section.settings.heading_weight }};
          line-height:{{ section.settings.heading_line_height }};
          letter-spacing:{{ section.settings.heading_letter_spacing }}em;
          text-transform:{{ section.settings.heading_transform }};
          {{ fcg_heading_font_style }}
        {% endunless %}
        margin:0;"
        class="{% if fcg_heading_use_token %}{{ fcg_heading_token_class }}{% endif %}">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    </div>
  {%- endunless -%}

  {%- comment -%} Grid {%- endcomment -%}
  <style>
    .fcg-grid-{{ section.id }} {
      display: grid;
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.grid_gap }}px;
    }
    .fcg-grid-{{ section.id }} .fcg-card--large {
      grid-row: span 1;
    }
    @media (min-width: 768px) {
      .fcg-grid-{{ section.id }} {
        grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
        grid-template-rows: 1fr 1fr;
      }
      .fcg-grid-{{ section.id }} .fcg-card--large {
        grid-row: span 2;
      }
    }
    .fcg-card-{{ section.id }} {
      position: relative;
      overflow: hidden;
      border-radius: {{ section.settings.card_border_radius }}px;
      display: block;
      text-decoration: none;
      color: #fff;
      aspect-ratio: {{ section.settings.aspect_ratio_mobile }};
    }
    @media (min-width: 768px) {
      .fcg-card-{{ section.id }} {
        aspect-ratio: {{ section.settings.aspect_ratio_desktop }};
      }
      .fcg-card--large .fcg-card-{{ section.id }} {
        height: 100%;
        aspect-ratio: auto;
      }
    }
    /* Per-block visibility */
    .fcg-grid-{{ section.id }} .fcg-hide-mobile {
      display: none;
    }
    .fcg-grid-{{ section.id }} .fcg-hide-desktop {
      display: block;
    }
    @media (min-width: 768px) {
      .fcg-grid-{{ section.id }} .fcg-hide-mobile {
        display: block;
      }
      .fcg-grid-{{ section.id }} .fcg-hide-desktop {
        display: none;
      }
    }
    .fcg-card-{{ section.id }} img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.9s var(--thread-ease);
    }
    @media (prefers-reduced-motion: no-preference) {
      .fcg-card-{{ section.id }}:hover img {
        transform: scale(1.03);
      }
    }
    .fcg-card-{{ section.id }}::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: {{ section.settings.overlay_height }}%;
      background: linear-gradient(to top, rgba(0,0,0,{{ section.settings.overlay_opacity }}), transparent);
      pointer-events: none;
    }
    .fcg-label-{{ section.id }} {
      position: absolute;
      bottom: {{ section.settings.label_bottom }}px;
      left: {{ section.settings.label_left }}px;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: {{ section.settings.label_icon_gap }}px;
    }
  </style>

  <div class="fcg-grid-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="{% if block.settings.card_size == 'large' %}fcg-card--large{% endif %}{% if block.settings.card_visibility == 'desktop_only' %} fcg-hide-mobile{% elsif block.settings.card_visibility == 'mobile_only' %} fcg-hide-desktop{% endif %}"
        {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link_url }}"
          class="fcg-card-{{ section.id }}">

          {%- unless block.settings.image == blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag:
              loading: 'lazy',
              alt: block.settings.label }}
          {%- else -%}
            <div style="position:absolute;top:0;left:0;width:100%;height:100%;background:#ddd;"></div>
          {%- endunless -%}

          {%- unless block.settings.label == blank -%}
            <div class="fcg-label-{{ section.id }}">
              {%- if section.settings.show_arrow_icon -%}
                <span style="
                  display:inline-flex;
                  align-items:center;
                  justify-content:center;
                  width:{{ section.settings.icon_size }}px;
                  height:{{ section.settings.icon_size }}px;
                  border-radius:50%;
                  border:{{ section.settings.icon_border_width }}px solid {{ section.settings.label_text_color | default: '#ffffff' }};
                  flex-shrink:0;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="{{ section.settings.icon_size | times: 0.5 }}" height="{{ section.settings.icon_size | times: 0.5 }}" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.label_text_color | default: '#ffffff' }}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              {%- endif -%}
              <span style="
                {% unless fcg_label_use_token %}
                  font-size:{{ section.settings.label_size }}px;
                  font-weight:{{ section.settings.label_weight }};
                  text-transform:{{ section.settings.label_transform }};
                  letter-spacing:{{ section.settings.label_letter_spacing }}em;
                  {{ fcg_label_font_style }}
                {% endunless %}
                color:{{ section.settings.label_text_color | default: '#ffffff' }};
                text-shadow:0 1px 3px rgba(0,0,0,0.3);"
                {% if fcg_label_use_token %}class="{{ fcg_label_token_class }}"{% endif %}>
                {{ block.settings.label }}
              </span>
            </div>
          {%- endunless -%}
        </a>
      </div>
    {% endfor %}
  </div>

</section>

{% schema %}
{
  "name": "Collections grid",
  "class": "section",
  "settings": [

    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED COLLECTIONS"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#3B5BDB"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading font size (px)",
      "min": 16,
      "max": 72,
      "step": 1,
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "900"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "token-display", "label": "↳ Use theme token (Display)" },
        { "value": "token-h1", "label": "↳ Use theme token (H1)" },
        { "value": "token-h2", "label": "↳ Use theme token (H2)" },
        { "value": "token-h3", "label": "↳ Use theme token (H3)" },
        { "value": "token-body", "label": "↳ Use theme token (Body)" },
        { "value": "token-small", "label": "↳ Use theme token (Small)" },
        { "value": "token-label", "label": "↳ Use theme token (Label)" },
        { "value": "inherit", "label": "Theme default" },
        { "value": "body", "label": "Forma DJR" },
        { "value": "heading", "label": "PP Right Grotesk" },
        { "value": "handwritten", "label": "Thread Handwritten" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Heading text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading line height",
      "min": 0.8,
      "max": 2.0,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing (em)",
      "min": -0.1,
      "max": 0.3,
      "step": 0.1,
      "default": 0.0
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Heading bottom spacing (px)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 16
    },

    {
      "type": "header",
      "content": "Card label"
    },
    {
      "type": "select",
      "id": "label_font",
      "label": "Label font",
      "options": [
        { "value": "token-display", "label": "↳ Use theme token (Display)" },
        { "value": "token-h1", "label": "↳ Use theme token (H1)" },
        { "value": "token-h2", "label": "↳ Use theme token (H2)" },
        { "value": "token-h3", "label": "↳ Use theme token (H3)" },
        { "value": "token-body", "label": "↳ Use theme token (Body)" },
        { "value": "token-small", "label": "↳ Use theme token (Small)" },
        { "value": "token-label", "label": "↳ Use theme token (Label)" },
        { "value": "inherit", "label": "Theme default" },
        { "value": "body", "label": "Forma DJR" },
        { "value": "heading", "label": "PP Right Grotesk" },
        { "value": "handwritten", "label": "Thread Handwritten" }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label font size (px)",
      "min": 10,
      "max": 36,
      "step": 1,
      "default": 18
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label font weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "800"
    },
    {
      "type": "select",
      "id": "label_transform",
      "label": "Label text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "label_letter_spacing",
      "label": "Label letter spacing (em)",
      "min": -0.1,
      "max": 0.3,
      "step": 0.1,
      "default": 0.0
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Label text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "label_bottom",
      "label": "Label distance from bottom (px)",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "label_left",
      "label": "Label distance from left (px)",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 20
    },

    {
      "type": "header",
      "content": "Arrow icon"
    },
    {
      "type": "checkbox",
      "id": "show_arrow_icon",
      "label": "Show arrow icon",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon circle size (px)",
      "min": 16,
      "max": 48,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "icon_border_width",
      "label": "Icon border width (px)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "label_icon_gap",
      "label": "Gap between icon and label (px)",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },

    {
      "type": "header",
      "content": "Card styling"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius (px)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "aspect_ratio_mobile",
      "label": "Card aspect ratio — mobile",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "16/9", "label": "Wide (16:9)" },
        { "value": "9/16", "label": "Tall (9:16)" },
        { "value": "3/2", "label": "Photo (3:2)" },
        { "value": "2/3", "label": "Tall photo (2:3)" },
        { "value": "auto", "label": "Auto" }
      ],
      "default": "3/4"
    },
    {
      "type": "select",
      "id": "aspect_ratio_desktop",
      "label": "Card aspect ratio — desktop (small cards)",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "16/9", "label": "Wide (16:9)" },
        { "value": "9/16", "label": "Tall (9:16)" },
        { "value": "3/2", "label": "Photo (3:2)" },
        { "value": "2/3", "label": "Tall photo (2:3)" },
        { "value": "auto", "label": "Auto" }
      ],
      "default": "4/3",
      "info": "Large cards ignore this and stretch to full height"
    },

    {
      "type": "header",
      "content": "Image overlay"
    },
    {
      "type": "range",
      "id": "overlay_height",
      "label": "Overlay gradient height (%)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0.0,
      "max": 1.0,
      "step": 0.1,
      "default": 0.4
    },

    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between cards (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "select",
      "id": "use_global_spacing",
      "label": "Spacing mode",
      "options": [
        { "value": "global", "label": "↳ Use global spacing" },
        { "value": "global-sides", "label": "↳ Use global sides only" },
        { "value": "custom", "label": "Custom (use settings below)" }
      ],
      "default": "custom",
      "info": "Global spacing is set in Theme Settings > Typography tokens"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Section padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Section padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing_sides",
      "label": "Section side padding (px)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 16
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        { "value": "", "label": "All devices" },
        { "value": "hidden md:block", "label": "Desktop only" },
        { "value": "md:hidden", "label": "Mobile only" }
      ],
      "default": ""
    }
  ],

  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Collection"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "select",
          "id": "card_size",
          "label": "Card size",
          "options": [
            { "value": "large", "label": "Large (spans 2 rows)" },
            { "value": "small", "label": "Small (single row)" }
          ],
          "default": "small",
          "info": "Large cards span both rows on desktop"
        },
        {
          "type": "select",
          "id": "card_visibility",
          "label": "Visibility",
          "options": [
            { "value": "all", "label": "All devices" },
            { "value": "desktop_only", "label": "Desktop only" },
            { "value": "mobile_only", "label": "Mobile only" }
          ],
          "default": "all",
          "info": "Show this card on specific devices only"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Collections grid",
      "blocks": [
        { "type": "collection_card", "settings": { "label": "Jeans", "card_size": "large" } },
        { "type": "collection_card", "settings": { "label": "Chinos", "card_size": "large" } },
        { "type": "collection_card", "settings": { "label": "Shorts", "card_size": "small" } },
        { "type": "collection_card", "settings": { "label": "Knit Denim", "card_size": "small" } },
        { "type": "collection_card", "settings": { "label": "Spring", "card_size": "small" } },
        { "type": "collection_card", "settings": { "label": "New", "card_size": "small" } }
      ]
    }
  ]
}
{% endschema %}
