{% comment %}
  Thread Wallets - "Do What Connects You" Campaign Section
  Section: thread-campaign.liquid
  Place in: sections/thread-campaign.liquid
  Add to a page template via Shopify Editor
{% endcomment %}

{{ 'thread-campaign.css' | asset_url | stylesheet_tag }}

<section class="thread-campaign" id="thread-campaign">

  {%- if section.settings.show_hero -%}
  <div class="tc-hero">
    <div class="tc-hero__bg">
      {%- if section.settings.hero_video != blank -%}
        <video autoplay muted loop playsinline class="tc-hero__video">
          <source src="{{ section.settings.hero_video }}" type="video/mp4">
        </video>
      {%- elsif section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | img_url: '1600x' }}" alt="Campaign hero" class="tc-hero__img" loading="eager">
      {%- else -%}
        <div class="tc-hero__placeholder"></div>
      {%- endif -%}
      <div class="tc-hero__overlay"></div>
    </div>
    <div class="tc-hero__content tc-window">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tc-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="tc-hero__title">{{ section.settings.hero_title | default: 'Do What Connects You' }}</h1>
      {%- if section.settings.hero_subtitle != blank -%}
        <p class="tc-hero__subtitle">{{ section.settings.hero_subtitle }}</p>
      {%- endif -%}
      <a href="#tc-submit" class="tc-btn tc-btn--primary">{{ section.settings.hero_cta | default: 'Submit Your Video' }}</a>
    </div>
    <div class="tc-hero__scroll-hint">
      <span></span>
    </div>
  </div>
  {%- endif -%}

  {%- if section.settings.show_intro -%}
  <div class="tc-intro tc-section">
    <div class="tc-window tc-window tc-window--narrow">
      <h2 class="tc-section-title">{{ section.settings.intro_title | default: 'We Need You' }}</h2>
      <div class="tc-richtext">{{ section.settings.intro_body | default: "We're collecting short, real videos that show how you connect. Thread products exist to carry the essentials that move with people through these moments. How do you connect with friends, family, community, co-workers — and the environments around you?" }}</div>
      {%- if section.settings.intro_deadline != blank -%}
        <p class="tc-deadline-text">
          <span class="tc-deadline__label">Submission Deadline</span>
          <span class="tc-deadline__date">{{ section.settings.intro_deadline }}</span>
        </p>
      {%- endif -%}
      <div class="tc-intro-cta">
        <a href="{{ section.settings.dropbox_url | default: 'https://www.dropbox.com/request/KVlCuV1loy6gHRAP3uCS' }}" target="_blank" rel="noopener" class="tc-btn tc-btn--primary tc-btn--upload">
          <span>{{ section.settings.dropbox_btn_text | default: 'Submit Your Video' }}</span>
        </a>
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- assign vibe_blocks = section.blocks | where: 'type', 'vibe_item' -%}
  {%- if vibe_blocks.size > 0 -%}
  <div class="tc-vibe tc-section tc-section--alt">
    <div class="tc-window">
      <h2 class="tc-section-title">{{ section.settings.vibe_title | default: 'The Vibe' }}</h2>
{%- if section.settings.vibe_subtitle != blank -%}
  <p class="tc-section-sub">{{ section.settings.vibe_subtitle }}</p>
{%- endif -%}
      <div class="tc-vibe__grid">
        {%- for block in vibe_blocks -%}
          <div class="tc-vibe__item" {{ block.shopify_attributes }}>
            <span class="tc-vibe__icon">{{ block.settings.icon | default: '' }}</span>
            <div>
              <strong>{{ block.settings.label }}</strong>
              {%- if block.settings.description != blank -%}
                <p>{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- assign prompt_blocks = section.blocks | where: 'type', 'prompt' -%}
  {%- if prompt_blocks.size > 0 -%}
  <div class="tc-prompts tc-section">
    <div class="tc-window">
      <h2 class="tc-section-title">{{ section.settings.prompts_title | default: 'Creative Prompts' }}</h2>
      <p class="tc-section-sub">{{ section.settings.prompts_subtitle | default: 'Pick one — or make it your own.' }}</p>
      <div class="tc-prompts__grid">
        {%- for block in prompt_blocks -%}
          <div class="tc-prompt-card" {{ block.shopify_attributes }}>
            <div class="tc-prompt-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
            <h3 class="tc-prompt-card__title">{{ block.settings.prompt_title }}</h3>
            <p class="tc-prompt-card__desc">{{ block.settings.prompt_description }}</p>
            {%- if block.settings.hook_examples != blank -%}
              <div class="tc-prompt-card__hooks">
                <span class="tc-prompt-card__hooks-label">Easy hooks:</span>
                <div class="tc-prompt-card__hooks-list">{{ block.settings.hook_examples }}</div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- assign rule_blocks = section.blocks | where: 'type', 'rule' -%}
  {%- if rule_blocks.size > 0 -%}
  <div class="tc-rules tc-section tc-section--alt">
    <div class="tc-window">
      <h2 class="tc-section-title">{{ section.settings.rules_title | default: 'Quick Rules' }}</h2>
      {%- if section.settings.rules_subtitle != blank -%}
  <p class="tc-section-sub">{{ section.settings.rules_subtitle }}</p>
{%- endif -%}
      <div class="tc-rules__grid">
        {%- for block in rule_blocks -%}
          <div class="tc-rule-item" {{ block.shopify_attributes }}>
            <span class="tc-rule-item__icon">{{ block.settings.icon | default: '✓' }}</span>
            <span>{{ block.settings.rule_text }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- assign award_blocks = section.blocks | where: 'type', 'award' -%}
  {%- if award_blocks.size > 0 -%}
  <div class="tc-awards tc-section">
    <div class="tc-window">
      <h2 class="tc-section-title">{{ section.settings.awards_title | default: 'Awards & Prizes' }}</h2>
      {%- if section.settings.awards_subtitle != blank -%}
        <p class="tc-section-sub">{{ section.settings.awards_subtitle }}</p>
      {%- endif -%}
      <div class="tc-awards__grid">
        {%- for block in award_blocks -%}
          <div class="tc-award-card" {{ block.shopify_attributes }}>
            <div class="tc-award-card__emoji">{{ block.settings.emoji | default: '🏆' }}</div>
            <h3 class="tc-award-card__category">{{ block.settings.category_name }}</h3>
            <p class="tc-award-card__description">{{ block.settings.award_description }}</p>
            {%- if block.settings.prize_detail != blank -%}
              <div class="tc-award-card__prize">{{ block.settings.prize_detail }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- if section.settings.show_submission_form -%}
  <div class="tc-submit tc-section tc-section--dark" id="tc-submit">
    <div class="tc-window tc-window--narrow">
      <h2 class="tc-section-title">{{ section.settings.form_title | default: 'Submit Your Video' }}</h2>
      <p class="tc-section-sub">{{ section.settings.form_subtitle | default: 'Upload your video directly to our folder. No account required — just drop your file and go.' }}</p>

      <div class="tc-submit-cta">
        <a href="{{ section.settings.dropbox_url | default: 'https://www.dropbox.com/request/KVlCuV1loy6gHRAP3uCS' }}" target="_blank" rel="noopener" class="tc-btn tc-btn--primary tc-btn--upload">
          <span>{{ section.settings.dropbox_btn_text | default: 'Upload Your Video' }}</span>
        </a>
        {%- if section.settings.submit_note != blank -%}
          <p class="tc-submit-note">{{ section.settings.submit_note }}</p>
        {%- else -%}
          <p class="tc-submit-note">Opens in a new tab. No Dropbox account required.</p>
        {%- endif -%}
      </div>

      {%- if section.settings.terms_text != blank -%}
        <p class="tc-terms-note">{{ section.settings.terms_text }}</p>
      {%- endif -%}

    </div>
  </div>
  {%- endif -%}

  {%- if section.settings.show_contact -%}
  <div class="tc-contact tc-section">
    <div class="tc-window tc-window--narrow tc-text-center">
      <p class="tc-contact__text">{{ section.settings.contact_text | default: 'Questions? We&#39;d love to hear from you.' }}</p>
      <a href="mailto:{{ section.settings.contact_email | default: 'mckenzie@threadwallets.com' }}" class="tc-btn tc-btn--outline">Email Us</a>
    </div>
  </div>
  {%- endif -%}

</section>

