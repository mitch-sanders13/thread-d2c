<!-- sections/reviews-carousel.liquid -->
{% comment %}
  Reviews carousel section.
  Shows a heading with star rating, and a carousel of review cards.
  Each card has: product image, product name, star rating, review quote, reviewer name.
  Mobile: single full-width slide with dot indicators.
  Desktop: horizontal scrolling carousel using component__slider.
{% endcomment %}

<section class="{{ section.settings.visibility }}{% if section.settings.use_global_spacing == 'global' %} spacing-global{% elsif section.settings.use_global_spacing == 'global-sides' %} spacing-sides{% endif %}"
  style="
    {% if section.settings.use_global_spacing == 'custom' %}
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;
    {% elsif section.settings.use_global_spacing == 'global-sides' %}
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;
    {% endif %}
    {% if section.settings.background_color != blank %}
      background-color:{{ section.settings.background_color }};
    {% endif %}">

  {%- comment -%} Resolve heading font token vs manual {%- endcomment -%}
  {% assign rc_heading_use_token = false %}
  {% assign rc_heading_token_class = '' %}
  {% assign rc_heading_font_style = '' %}
  {% if section.settings.heading_font contains 'token-' %}
    {% assign rc_heading_use_token = true %}
    {% assign rc_heading_token_class = section.settings.heading_font | replace: 'token-', 'type-' %}
  {% elsif section.settings.heading_font == 'body' %}
    {% assign rc_heading_font_style = 'font-family:var(--type-font-body-family);' %}
  {% elsif section.settings.heading_font == 'heading' %}
    {% assign rc_heading_font_style = 'font-family:var(--type-font-header-family);' %}
  {% elsif section.settings.heading_font == 'nav' %}
    {% assign rc_heading_font_style = 'font-family:var(--type-font-nav-family);' %}
  {% elsif section.settings.heading_font == 'handwritten' %}
    {% assign rc_heading_font_style = 'font-family:var(--type-font-handwritten-family);' %}
  {% endif %}

  {%- comment -%} Header area: star rating + heading {%- endcomment -%}
  <div class="flex flex-col items-center text-center px-4 pb-6 gap-2">

    {%- unless section.settings.heading == blank -%}
      <{{ section.settings.heading_tag }} style="
        {% if section.settings.heading_color != blank %}
          color:{{ section.settings.heading_color }};
        {% endif %}
        {% unless rc_heading_use_token %}
          font-size:{{ section.settings.heading_size }}px;
          font-weight:{{ section.settings.heading_weight }};
          line-height:1.1;
          letter-spacing:0.02em;
          text-transform:{{ section.settings.heading_transform }};
          {{ rc_heading_font_style }}
        {% endunless %}
        margin:0;"
        class="m-0{% if rc_heading_use_token %} {{ rc_heading_token_class }}{% endif %}">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {%- endunless -%}

    {%- unless section.settings.show_header_stars == false -%}
      <div class="flex items-center gap-2 flex-wrap justify-center">
        {%- for i in (1..5) -%}
          <span style="font-size:{{ section.settings.star_size }}px;line-height:1;{% if section.settings.star_color != blank %}color:{{ section.settings.star_color }};{% endif %}">★</span>
        {%- endfor -%}
        {%- unless section.settings.rating_text == blank -%}
          <span style="
            font-size:{{ section.settings.rating_text_size }}px;
            {% if section.settings.rating_text_color != blank %}
              color:{{ section.settings.rating_text_color }};
            {% endif %}">
            {{ section.settings.rating_text }}
          </span>
        {%- endunless -%}
      </div>
    {%- endunless -%}
  </div>

  {%- comment -%} ===== MOBILE: full-width single-slide carousel with dot indicators ===== {%- endcomment -%}
  <div class="md:hidden"
    x-data="{
      current: 0,
      total: {{ section.blocks.size }},
      touchStartX: 0,
      touchEndX: 0,
      handleSwipe() {
        const diff = this.touchStartX - this.touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0 && this.current < this.total - 1) this.current++;
          else if (diff < 0 && this.current > 0) this.current--;
        }
      }
    }"
    @touchstart="touchStartX = $event.changedTouches[0].screenX"
    @touchend="touchEndX = $event.changedTouches[0].screenX; handleSwipe()">

    <div class="relative overflow-hidden">
      <div class="flex transition-transform duration-300 ease-in-out"
        :style="'transform: translateX(-' + (current * 100) + '%)'">
        {% for block in section.blocks %}
          <div class="w-full flex-shrink-0 flex flex-col items-center text-center px-4">

            {%- unless block.settings.image == blank -%}
              <div class="w-full overflow-hidden mb-3"
                style="
                  {% if section.settings.image_max_height != blank %}
                    max-height:{{ section.settings.image_max_height }}px;
                  {% endif %}
                  border-radius:{{ section.settings.image_border_radius }}px;">
                {% if block.settings.link_url != blank %}
                  <a href="{{ block.settings.link_url }}" class="no-underline">
                {% endif %}
                {{ block.settings.image | image_url: width: 800 | image_tag:
                  class: 'w-full h-full object-cover object-top',
                  loading: 'lazy',
                  alt: block.settings.product_name }}
                {% if block.settings.link_url != blank %}
                  </a>
                {% endif %}
              </div>
            {%- endunless -%}

            {%- unless block.settings.product_name == blank -%}
              <div style="
                font-size:{{ section.settings.product_name_size }}px;
                font-weight:{{ section.settings.product_name_weight }};
                text-transform:{{ section.settings.product_name_transform }};
                {% if section.settings.product_name_color != blank %}
                  color:{{ section.settings.product_name_color }};
                {% endif %}"
                class="mb-1">
                {{ block.settings.product_name }}
              </div>
            {%- endunless -%}

            {%- if section.settings.show_card_stars -%}
              <div class="flex items-center justify-center gap-0.5 mb-2">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.star_rating -%}
                    <span style="font-size:{{ section.settings.card_star_size }}px;line-height:1;{% if section.settings.card_star_color != blank %}color:{{ section.settings.card_star_color }};{% endif %}">★</span>
                  {%- else -%}
                    <span style="font-size:{{ section.settings.card_star_size }}px;line-height:1;opacity:0.25;{% if section.settings.card_star_color != blank %}color:{{ section.settings.card_star_color }};{% endif %}">★</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- unless block.settings.review_text == blank -%}
              <p class="whitespace-normal px-2 mb-2"
                style="
                  font-size:{{ section.settings.review_text_size }}px;
                  line-height:{{ section.settings.review_text_line_height }};
                  {% if section.settings.review_text_color != blank %}
                    color:{{ section.settings.review_text_color }};
                  {% endif %}">
                "{{ block.settings.review_text }}"
              </p>
            {%- endunless -%}

            {%- unless block.settings.reviewer_name == blank -%}
              <p class="mb-0"
                style="
                  font-size:{{ section.settings.reviewer_name_size }}px;
                  font-weight:{{ section.settings.reviewer_name_weight }};
                  {% if section.settings.reviewer_name_color != blank %}
                    color:{{ section.settings.reviewer_name_color }};
                  {% endif %}">
                {{ block.settings.reviewer_name }}
              </p>
            {%- endunless -%}

          </div>
        {% endfor %}
      </div>
    </div>

    {%- comment -%} Dot indicators {%- endcomment -%}
    <div class="flex justify-center items-center gap-2 pt-4 pb-2">
      {% for block in section.blocks %}
        <button
          @click="current = {{ forloop.index0 }}"
          :style="current === {{ forloop.index0 }}
            ? 'width:{{ section.settings.dot_size }}px;height:{{ section.settings.dot_size }}px;border-radius:50%;border:none;padding:0;cursor:pointer;transition:background 0.3s ease;background:{{ section.settings.dot_active_color }};'
            : 'width:{{ section.settings.dot_size }}px;height:{{ section.settings.dot_size }}px;border-radius:50%;border:none;padding:0;cursor:pointer;transition:background 0.3s ease;background:{{ section.settings.dot_inactive_color }};'"
          aria-label="Go to slide {{ forloop.index }}">
        </button>
      {% endfor %}
    </div>
  </div>

  {%- comment -%} ===== DESKTOP: horizontal scrolling carousel ===== {%- endcomment -%}
  {% assign slider_size = section.blocks.size | minus: 1 %}

  {%- capture slides -%}
    {% for block in section.blocks %}
      <div class="snap-center flex flex-col items-center flex-none text-center
        md:w-{{ section.settings.desktop_slide_width }}/12"
        x-bind:data-slide="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}>

        {%- unless block.settings.image == blank -%}
          <div class="w-full overflow-hidden mb-3"
            style="
              {% if section.settings.image_max_height != blank %}
                max-height:{{ section.settings.image_max_height }}px;
              {% endif %}
              border-radius:{{ section.settings.image_border_radius }}px;">
            {% if block.settings.link_url != blank %}
              <a href="{{ block.settings.link_url }}" class="no-underline">
            {% endif %}
            {{ block.settings.image | image_url: width: 800 | image_tag:
              class: 'w-full h-full object-cover object-top',
              loading: 'lazy',
              alt: block.settings.product_name }}
            {% if block.settings.link_url != blank %}
              </a>
            {% endif %}
          </div>
        {%- endunless -%}

        {%- unless block.settings.product_name == blank -%}
          <div style="
            font-size:{{ section.settings.product_name_size }}px;
            font-weight:{{ section.settings.product_name_weight }};
            text-transform:{{ section.settings.product_name_transform }};
            {% if section.settings.product_name_color != blank %}
              color:{{ section.settings.product_name_color }};
            {% endif %}"
            class="mb-1">
            {{ block.settings.product_name }}
          </div>
        {%- endunless -%}

        {%- if section.settings.show_card_stars -%}
          <div class="flex items-center justify-center gap-0.5 mb-2"
            style="
              font-size:{{ section.settings.card_star_size }}px;
              {% if section.settings.card_star_color != blank %}
                color:{{ section.settings.card_star_color }};
              {% endif %}">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.star_rating -%}
                <span>★</span>
              {%- else -%}
                <span style="opacity:0.25;">★</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- unless block.settings.review_text == blank -%}
          <p class="whitespace-normal px-2 mb-2"
            style="
              font-size:{{ section.settings.review_text_size }}px;
              line-height:{{ section.settings.review_text_line_height }};
              {% if section.settings.review_text_color != blank %}
                color:{{ section.settings.review_text_color }};
              {% endif %}">
            "{{ block.settings.review_text }}"
          </p>
        {%- endunless -%}

        {%- unless block.settings.reviewer_name == blank -%}
          <p class="mb-0"
            style="
              font-size:{{ section.settings.reviewer_name_size }}px;
              font-weight:{{ section.settings.reviewer_name_weight }};
              {% if section.settings.reviewer_name_color != blank %}
                color:{{ section.settings.reviewer_name_color }};
              {% endif %}">
            {{ block.settings.reviewer_name }}
          </p>
        {%- endunless -%}

      </div>
    {% endfor %}
  {%- endcapture -%}

  <div class="hidden md:block">
    {% render 'component__slider',
      hide_arrows: true,
      outer_class: 'px-0',
      container_class: 'px-4',
      slider_size: slider_size,
      slides: slides %}
  </div>

</section>

{% schema %}
{
  "name": "Reviews carousel",
  "class": "section",
  "settings": [

    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OVER 40,000 5-STAR REVIEWS"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#3B5BDB"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size (px)",
      "min": 16,
      "max": 72,
      "step": 1,
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font family",
      "options": [
        { "value": "token-display", "label": "↳ Use theme token (Display)" },
        { "value": "token-h1", "label": "↳ Use theme token (H1)" },
        { "value": "token-h2", "label": "↳ Use theme token (H2)" },
        { "value": "token-h3", "label": "↳ Use theme token (H3)" },
        { "value": "token-body", "label": "↳ Use theme token (Body)" },
        { "value": "token-small", "label": "↳ Use theme token (Small)" },
        { "value": "token-label", "label": "↳ Use theme token (Label)" },
        { "value": "inherit", "label": "Theme default" },
        { "value": "body", "label": "Forma DJR" },
        { "value": "heading", "label": "PP Right Grotesk" },
        { "value": "handwritten", "label": "Thread Handwritten" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "900"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Heading text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },

    {
      "type": "header",
      "content": "Star rating (header)"
    },
    {
      "type": "checkbox",
      "id": "show_header_stars",
      "label": "Show stars in header",
      "default": true
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#F59F00"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size (px)",
      "min": 12,
      "max": 40,
      "step": 1,
      "default": 20
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text (next to stars)",
      "default": "5.0 | 40,569 Reviews"
    },
    {
      "type": "range",
      "id": "rating_text_size",
      "label": "Rating text size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14
    },
    {
      "type": "color",
      "id": "rating_text_color",
      "label": "Rating text color"
    },

    {
      "type": "header",
      "content": "Card stars"
    },
    {
      "type": "checkbox",
      "id": "show_card_stars",
      "label": "Show stars on each card",
      "default": true
    },
    {
      "type": "color",
      "id": "card_star_color",
      "label": "Card star color",
      "default": "#3B5BDB"
    },
    {
      "type": "range",
      "id": "card_star_size",
      "label": "Card star size (px)",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 18
    },

    {
      "type": "header",
      "content": "Product name"
    },
    {
      "type": "range",
      "id": "product_name_size",
      "label": "Font size (px)",
      "min": 10,
      "max": 32,
      "step": 1,
      "default": 16
    },
    {
      "type": "select",
      "id": "product_name_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "product_name_transform",
      "label": "Text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "color",
      "id": "product_name_color",
      "label": "Color"
    },

    {
      "type": "header",
      "content": "Review text"
    },
    {
      "type": "range",
      "id": "review_text_size",
      "label": "Font size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "review_text_line_height",
      "label": "Line height",
      "min": 1.0,
      "max": 2.5,
      "step": 0.1,
      "default": 1.5
    },
    {
      "type": "color",
      "id": "review_text_color",
      "label": "Color"
    },

    {
      "type": "header",
      "content": "Reviewer name"
    },
    {
      "type": "range",
      "id": "reviewer_name_size",
      "label": "Font size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14
    },
    {
      "type": "select",
      "id": "reviewer_name_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "reviewer_name_color",
      "label": "Color"
    },

    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "text",
      "id": "image_max_height",
      "label": "Image max height (px, blank = auto)",
      "default": "500"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius (px)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0
    },

    {
      "type": "header",
      "content": "Desktop slide width"
    },
    {
      "type": "range",
      "id": "desktop_slide_width",
      "label": "Desktop slide width (x/12)",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3,
      "info": "3 = ~4 cards visible, 4 = 3 cards visible"
    },

    {
      "type": "header",
      "content": "Mobile dot indicators"
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Dot size (px)",
      "min": 6,
      "max": 16,
      "step": 1,
      "default": 10
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Dot active color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "dot_inactive_color",
      "label": "Dot inactive color",
      "default": "#CCCCCC"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        { "value": "", "label": "All devices" },
        { "value": "hidden md:block", "label": "Desktop only" },
        { "value": "md:hidden", "label": "Mobile only" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "use_global_spacing",
      "label": "Spacing mode",
      "options": [
        { "value": "global", "label": "↳ Use global spacing" },
        { "value": "global-sides", "label": "↳ Use global sides only" },
        { "value": "custom", "label": "Custom (use settings below)" }
      ],
      "default": "custom",
      "info": "Global spacing is set in Theme Settings > Typography tokens"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    }
  ],

  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product name",
          "default": "Product Name"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "range",
          "id": "star_rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "This product is amazing! I love it."
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer name",
          "default": "Customer Name"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Reviews carousel",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "product_name": "Product 1",
            "review_text": "This product is incredible! Best purchase I've ever made.",
            "reviewer_name": "Dan S."
          }
        },
        {
          "type": "review",
          "settings": {
            "product_name": "Product 2",
            "review_text": "Amazing quality and so comfortable. Highly recommend!",
            "reviewer_name": "Lance C."
          }
        },
        {
          "type": "review",
          "settings": {
            "product_name": "Product 3",
            "review_text": "Perfect fit and great feeling. Will definitely buy again.",
            "reviewer_name": "Rebecca M."
          }
        }
      ]
    }
  ]
}
{% endschema %}
