<script>
  /* Publish the y-coordinate of the header's bottom edge as a CSS
     custom property (--cs-header-h) on the document root so the
     mega-menu dropdown panel can pin itself directly below the
     header without hard-coding a pixel value or leaving a gap.

     Why .bottom instead of .height: when the page is at the top and
     a notification/announcement bar is visible ABOVE the sticky
     header, the header's actual viewport-y bottom = announcement
     height + header height. Using .height alone left a gap exactly
     equal to the announcement bar height. .bottom resolves to the
     true bottom edge in viewport space, which is what fixed-position
     uses anyway. After the user scrolls past the announcement bar,
     the header sticks to top: 0 and .bottom == .height naturally.

     Recomputes on load, resize, scroll (passive), and on the next
     animation frame after fonts/images settle. */
  (function () {
    if (window.__csHeaderHInstalled) return;
    window.__csHeaderHInstalled = true;

    function updateHeaderH() {
      var headerEl = document.querySelector('header');
      if (!headerEl) return;
      var b = Math.round(headerEl.getBoundingClientRect().bottom);
      if (b > 0) {
        document.documentElement.style.setProperty('--cs-header-h', b + 'px');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateHeaderH);
    } else {
      updateHeaderH();
    }
    window.addEventListener('load', updateHeaderH);
    window.addEventListener('resize', updateHeaderH, { passive: true });
    window.addEventListener('scroll', updateHeaderH, { passive: true });
    // Belt-and-suspenders: rAF once more after first paint settles.
    requestAnimationFrame(updateHeaderH);
  })();

  /* Hover-with-intent for the mega-menu dropdowns.

     Pure CSS :hover has a browser-quirk failure mode here: the moment
     the cursor exits `.js-header-nav-item`'s :hover area (the link +
     its ::after bridge), the scoped `height: 0; opacity: 0` rule
     instantly collapses the dropdown's bounding box to zero. With
     bounding-box height 0, the cursor isn't "over" the dropdown
     anymore, so `.header__dropdown:hover` can never fire to re-open
     it. The dropdown closes the moment the cursor crosses from the
     bridge into the panel.

     This handler attaches mouseenter/mouseleave to BOTH the nav-item
     AND the dropdown for each top-level nav link. Entering either
     adds the `header__nav-item--open` class (CSS forces height:auto
     + opacity:1). Leaving either schedules a 250 ms close timer;
     entering the OTHER half cancels the timer before it fires, so
     the cursor can travel freely between the nav-link and the
     dropdown panel without the dropdown collapsing mid-motion. */
  (function () {
    if (window.__megaMenuHoverInstalled) return;
    window.__megaMenuHoverInstalled = true;

    // Tight close delay so moving the cursor off the visible card snaps
    // the dropdown shut (Herschel-style). Long enough to absorb the
    // ~50ms it takes the cursor to traverse from the nav link down
    // into the card across any sub-pixel gap.
    var CLOSE_DELAY = 80;

    // Resolved lazily — at script-run time the header may not be in
    // the DOM yet if the section is being re-rendered. Each handler
    // re-queries so it always gets the current element.
    function getHeaderEl() {
      return document.querySelector('header');
    }

    // True when the cursor is moving INTO another element that should
    // keep the dropdown open: anywhere in the <header> bar itself,
    // OR into a .mega-menu-card. The card is technically a descendant
    // of <header> so the first check covers it, but we keep the
    // explicit card check in case the layout ever moves the card out.
    function isStayingInOpenSurface(relatedTarget) {
      if (!relatedTarget || !relatedTarget.closest) return false;
      var headerEl = getHeaderEl();
      if (headerEl && headerEl.contains(relatedTarget)) return true;
      if (relatedTarget.closest('.mega-menu-card')) return true;
      return false;
    }

    function wireNavItem(navItem) {
      if (!navItem || navItem.__megaMenuWired) return;
      var dropdown = navItem.querySelector(':scope > .header__dropdown');
      if (!dropdown) return;
      navItem.__megaMenuWired = true;

      var closeTimer = null;

      function open() {
        if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
        // Close any sibling dropdown that's already open. Without this,
        // moving the cursor from one nav item's panel up through the
        // header bar (which now keeps panels open) to a different nav
        // item would leave both panels visible at once.
        document.querySelectorAll('.js-header-nav-item.header__nav-item--open').forEach(function (other) {
          if (other !== navItem) other.classList.remove('header__nav-item--open');
        });
        navItem.classList.add('header__nav-item--open');
      }
      function scheduleClose(e) {
        // Keep the dropdown open while the cursor is anywhere in the
        // header bar — including empty space between nav items, the
        // logo, the cart icon, etc. Only schedule a close once the
        // cursor leaves the header entirely (or skips past the visible
        // card down to the page content below).
        if (e && isStayingInOpenSurface(e.relatedTarget)) return;
        if (closeTimer) clearTimeout(closeTimer);
        closeTimer = setTimeout(function () {
          navItem.classList.remove('header__nav-item--open');
          closeTimer = null;
        }, CLOSE_DELAY);
      }

      // Stash on the element so the header-level listener below can
      // re-trigger close logic without each navItem keeping its own
      // copy of the relatedTarget heuristics.
      navItem.__megaMenuScheduleClose = scheduleClose;

      navItem.addEventListener('mouseenter', open);
      navItem.addEventListener('mouseleave', scheduleClose);

      // Listen on the visible card rather than the full-viewport
      // dropdown wrapper. With pointer-events: none on .header__dropdown
      // and pointer-events: auto on .mega-menu-card, the cursor only
      // counts as "over the dropdown" while it's actually over the
      // visible panel — so moving the cursor off the card to the left,
      // right, or below immediately triggers the close timer.
      var card = dropdown.querySelector('.mega-menu-card');
      if (card) {
        card.addEventListener('mouseenter', open);
        card.addEventListener('mouseleave', scheduleClose);
      }
    }

    function wireAll() {
      document.querySelectorAll('.js-header-nav-item').forEach(wireNavItem);

      // One-shot header-level mouseleave: when the cursor finally
      // exits the entire header bar, ask every currently-open nav
      // item to schedule its close. Without this the dropdown would
      // hang open forever after the customer mouses off the empty
      // area of the header into page content (because no nav-item /
      // card mouseleave fires from that empty space).
      var headerEl = getHeaderEl();
      if (headerEl && !headerEl.__megaMenuHeaderWired) {
        headerEl.__megaMenuHeaderWired = true;
        headerEl.addEventListener('mouseleave', function (e) {
          // If the cursor moved to a mega-menu card that lives outside
          // <header> (defensive — current layout keeps the card inside),
          // don't close.
          if (e && e.relatedTarget && e.relatedTarget.closest && e.relatedTarget.closest('.mega-menu-card')) {
            return;
          }
          document.querySelectorAll('.js-header-nav-item.header__nav-item--open').forEach(function (navItem) {
            if (navItem.__megaMenuScheduleClose) {
              navItem.__megaMenuScheduleClose(e);
            }
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wireAll);
    } else {
      wireAll();
    }
  })();
</script>

