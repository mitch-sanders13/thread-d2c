<!-- sections/theme__header.liquid -->
{% comment %}
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .header__nav-link,
  #shopify-section-{{ section.id }} .header__nav-link *,
  #shopify-section-{{ section.id }} .header__nav-link .header__link-text {
    font-family: var({{ section.settings.nav_font_family | default: '--type-font-nav-family' }}) !important;
    font-size: {{ section.settings.nav_font_size | default: 14 }}px !important;
    font-weight: {{ section.settings.nav_font_weight | default: '600' }} !important;
    letter-spacing: {{ section.settings.nav_letter_spacing | default: '0.08em' }} !important;
    text-transform: {{ section.settings.nav_text_transform | default: 'uppercase' }} !important;
    color: {{ section.settings.nav_text_color | default: 'inherit' }};
  }
  #shopify-section-{{ section.id }} .cart-count-badge {
    /* Badge straddles the bag icon's right edge (center sits ON the
       edge = 50% overlap, per merchant). The cart anchors are
       position:relative; offsets account for each bar's right
       padding (desktop pl-4 only -> icon flush right; mobile px-2
       -> 8px right padding). */
    position: absolute !important;
    top: 2px !important;
    right: -9px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 18px !important;
    height: 18px !important;
    min-width: 18px !important;
    min-height: 18px !important;
    max-width: 18px !important;
    max-height: 18px !important;
    border-radius: 50% !important;
    padding: 0 !important;
    margin-left: 0 !important;
    font-family: var(--type-font-body-family) !important;
    font-size: 10px !important;
    font-weight: 600 !important;
    line-height: 1 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    text-indent: 0 !important;
    text-align: center !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
  }
  @media (max-width: 1279.98px) {
    #shopify-section-{{ section.id }} .cart-count-badge {
      /* 14px tap padding - 9px half-badge, +2px left nudge per merchant */
      right: 7px !important;
    }
  }
  {% if section.settings.bar_layout_desktop == "left-inline" or section.settings.bar_layout_desktop == "left-center" %}
  /* Page-centered nav: split desktop bar into a 3-column grid
     (1fr | auto | 1fr). The nav sits in the auto middle column and is
     therefore always centered to the page regardless of the logo / cart
     column widths. */
  @media (min-width: 1280px) {
    #shopify-section-{{ section.id }} .js-header-desktop-bar {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
    }
    #shopify-section-{{ section.id }} .js-header-desktop-bar > .js-header-col--left   { justify-self: start; }
    #shopify-section-{{ section.id }} .js-header-desktop-bar > .js-header-col--center { justify-self: center; }
    #shopify-section-{{ section.id }} .js-header-desktop-bar > .js-header-col--right  { justify-self: end; }
    /* The nav's inner flex wrapper uses flex-grow for left-inline — disable
       it so the nav hugs its content and the grid auto column can center. */
    #shopify-section-{{ section.id }} .js-header-col--center .flex-grow { flex-grow: 0 !important; }
  }
  {% endif %}

  /* Keep the mega-menu dropdown open while the cursor is anywhere over
     the wrapper that contains both the nav link and the dropdown panel.
     The transparent ::after pseudo is a hover bridge below the link
     that spans the entire gap from the nav-link bottom down to where
     the dropdown begins, so the cursor doesn't cross a dead zone where
     neither :hover applies. Sized generously (40px) to cover header
     padding-bottom + transition rounding. */
  #shopify-section-{{ section.id }} .js-header-nav-item {
    position: relative;
  }
  #shopify-section-{{ section.id }} .js-header-nav-item::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 40px;
    background: transparent;
  }

  /* Mega-menu dropdown panel — pinned below the sticky header at the
     viewport edges so it spans full width regardless of where the
     individual nav-item sits in the bar. The --cs-header-h CSS variable
     is set by the small inline script at the bottom of this section
     file so the panel always lands directly below the actual header
     height with no gap.

     pointer-events: none on the wrapper so the full-viewport empty
     area to the left and right of the centered card doesn't capture
     hover (which was keeping the dropdown open while the cursor was
     visibly outside it). pointer-events: auto on .mega-menu-card
     re-enables hover on the actual visible panel — matching the
     Herschel-style behavior where hovering off the visible card
     immediately starts the close timer. */
  #shopify-section-{{ section.id }} .header__dropdown {
    position: fixed !important;
    /* -2px nudge to close the hairline gap between the header's
       bottom edge and the dropdown card. getBoundingClientRect().bottom
       can land a sub-pixel below where the visible header reads,
       depending on borders and sub-pixel rounding. */
    top: calc(var(--cs-header-h, 80px) - 2px) !important;
    left: 0 !important;
    right: 0 !important;
    width: 100vw !important;
    height: 0;
    opacity: 0;
    overflow: hidden;
    z-index: 49;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .header__dropdown .mega-menu-card {
    pointer-events: auto;
  }

  /* Hover OPEN — driven by:
       1. The `header__nav-item--open` class added by the hover-with-
          intent script at the bottom of this section. This is the
          primary mechanism; it survives the cursor moving between
          the nav link and the dropdown panel.
       2. Pure-CSS :hover / :focus-within as a graceful-degradation
          fallback if the script doesn't load. Keep in mind these
          can collapse the dropdown mid-traverse (the very bug the
          script is here to solve), but they're still useful for
          keyboard a11y and no-JS environments. */
  #shopify-section-{{ section.id }} .js-header-nav-item.header__nav-item--open > .header__dropdown,
  #shopify-section-{{ section.id }} .js-header-nav-item:hover > .header__dropdown,
  #shopify-section-{{ section.id }} .js-header-nav-item:focus-within > .header__dropdown,
  #shopify-section-{{ section.id }} .header__dropdown:hover,
  #shopify-section-{{ section.id }} .header__dropdown:focus-within {
    height: auto !important;
    opacity: 1 !important;
  }

  {%- comment -%}
    Search bar styling. Targets both the mobile (#search-mobile) and
    desktop (#search-desktop) inputs at the same time. Variables are
    set on this section's wrapper so the input inherits — overrides
    have !important to beat the global .form-input rule.
  {%- endcomment -%}
  {%- assign hd_search_font_var = '--type-font-body-family' -%}
  {%- case section.settings.search_font_family -%}
    {%- when 'heading' -%}{%- assign hd_search_font_var = '--type-font-header-family' -%}
    {%- when 'nav' -%}{%- assign hd_search_font_var = '--type-font-nav-family' -%}
    {%- when 'handwritten' -%}{%- assign hd_search_font_var = '--type-font-handwritten-family' -%}
  {%- endcase -%}
  #shopify-section-{{ section.id }} {
    --hd-search-font: var({{ hd_search_font_var }});
    --hd-search-weight: {{ section.settings.search_font_weight | default: '400' }};
    --hd-search-case: {{ section.settings.search_font_case | default: 'none' }};
    --hd-search-size: {{ section.settings.search_font_size | default: 14 }}px;
    --hd-search-ls: {{ section.settings.search_letter_spacing | default: '0em' }};
    --hd-search-bg: {{ section.settings.search_input_bg | default: '#ffffff' }};
    --hd-search-text: {{ section.settings.search_input_text_color | default: '#1a1a1a' }};
    --hd-search-border: {{ section.settings.search_input_border_color | default: '#cccccc' }};
    --hd-search-placeholder: {{ section.settings.search_placeholder_color | default: '#888888' }};
    --hd-search-icon: {{ section.settings.search_icon_color | default: '#1a1a1a' }};
  }
  #shopify-section-{{ section.id }} #search-mobile,
  #shopify-section-{{ section.id }} #search-desktop {
    font-family: var(--hd-search-font) !important;
    font-weight: var(--hd-search-weight) !important;
    text-transform: var(--hd-search-case) !important;
    font-size: var(--hd-search-size) !important;
    letter-spacing: var(--hd-search-ls) !important;
    background-color: var(--hd-search-bg) !important;
    color: var(--hd-search-text) !important;
    border-color: var(--hd-search-border) !important;
  }
  #shopify-section-{{ section.id }} #search-mobile::placeholder,
  #shopify-section-{{ section.id }} #search-desktop::placeholder {
    color: var(--hd-search-placeholder) !important;
    font-family: var(--hd-search-font) !important;
    font-weight: var(--hd-search-weight) !important;
    font-size: var(--hd-search-size) !important;
    text-transform: var(--hd-search-case) !important;
    letter-spacing: var(--hd-search-ls) !important;
    opacity: 1; /* Firefox lowers placeholder opacity by default */
  }
  /* Magnifying glass + X close button inside the search input wrapper */
  #shopify-section-{{ section.id }} #search-mobile ~ * svg,
  #shopify-section-{{ section.id }} #search-desktop ~ * svg {
    color: var(--hd-search-icon) !important;
    stroke: var(--hd-search-icon);
  }
  /* iOS Safari auto-zooms any focused input with computed font-size < 16px.
     On mobile we force the input to at least 16px so tapping the search
     bar doesn't zoom the page. Desktop keeps the merchant's chosen size. */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} #search-mobile,
    #shopify-section-{{ section.id }} #search-desktop {
      font-size: max(16px, var(--hd-search-size)) !important;
    }
  }

  {%- comment -%}
    Search RESULTS typography — the dropdown under the input: suggestion
    links, section labels (Products / Collections / Top searches), product
    titles, type/vendor meta, and prices. Scoped via the .hd-search-results
    class on both the desktop and mobile dropdown containers. The input
    itself is excluded (its #search-mobile/#search-desktop ID rules above
    out-rank these class selectors).
  {%- endcomment -%}
  {%- assign hd_sr_font_var = '--type-font-body-family' -%}
  {%- case section.settings.search_results_font_family -%}
    {%- when 'heading' -%}{%- assign hd_sr_font_var = '--type-font-header-family' -%}
    {%- when 'nav' -%}{%- assign hd_sr_font_var = '--type-font-nav-family' -%}
    {%- when 'handwritten' -%}{%- assign hd_sr_font_var = '--type-font-handwritten-family' -%}
  {%- endcase -%}
  /* Family / case / letter-spacing apply everywhere in the dropdown. */
  #shopify-section-{{ section.id }} .hd-search-results,
  #shopify-section-{{ section.id }} .hd-search-results a,
  #shopify-section-{{ section.id }} .hd-search-results button,
  #shopify-section-{{ section.id }} .hd-search-results span,
  #shopify-section-{{ section.id }} .hd-search-results p,
  #shopify-section-{{ section.id }} .hd-search-results li,
  #shopify-section-{{ section.id }} .hd-search-results strong,
  #shopify-section-{{ section.id }} .hd-search-results s {
    font-family: var({{ hd_sr_font_var }}) !important;
    text-transform: {{ section.settings.search_results_font_case | default: 'none' }} !important;
    letter-spacing: {{ section.settings.search_results_letter_spacing | default: '0em' }} !important;
    {% if section.settings.search_results_text_color != blank %}color: {{ section.settings.search_results_text_color }} !important;{% endif %}
  }
  /* Base size + weight for links, labels, and buttons. <strong> labels
     keep their bold because we don't touch strong's weight here. */
  #shopify-section-{{ section.id }} .hd-search-results {
    font-size: {{ section.settings.search_results_text_size | default: 14 }}px !important;
  }
  #shopify-section-{{ section.id }} .hd-search-results a,
  #shopify-section-{{ section.id }} .hd-search-results button,
  #shopify-section-{{ section.id }} .hd-search-results span,
  #shopify-section-{{ section.id }} .hd-search-results p,
  #shopify-section-{{ section.id }} .hd-search-results li {
    font-size: inherit !important;
    font-weight: {{ section.settings.search_results_font_weight | default: '400' }} !important;
  }
  /* Product title (the p.type--base inside each result card). */
  #shopify-section-{{ section.id }} .hd-search-results .type--base {
    font-size: {{ section.settings.search_results_title_size | default: 15 }}px !important;
    font-weight: {{ section.settings.search_results_title_weight | default: '500' }} !important;
  }
  /* Meta (type / vendor) + price rows inside each result card. */
  #shopify-section-{{ section.id }} .hd-search-results li.type--small,
  #shopify-section-{{ section.id }} .hd-search-results a p.type--small,
  #shopify-section-{{ section.id }} .hd-search-results a .type--small {
    font-size: {{ section.settings.search_results_meta_size | default: 12 }}px !important;
  }
</style>

{% capture desktop_logo %}
  <div class="md:py-4 flex items-center max-w-xs py-2{% if section.settings.bar_layout_desktop == "center-below" %} justify-center{% endif %}">
    <a class="inline-block relative items-center hover:!opacity-100"
      href="{{ routes.root_url }}"
      rel="nofollow"
      title="{{ shop.name }}">
      <img
        src="{{ 'Thread-Stitch.png' | asset_url }}"
        alt="{{ shop.name }}"
        style="height: 35px; width: auto;">
    </a>
  </div>
{% endcapture %}

{% capture desktop_navigation %}
  {%- comment -%}
    hidescrollbar: overflow-x-auto computes overflow-y to auto too, so
    a 1px content overflow spawned a visible vertical scrollbar beside
    the last nav link on Windows-style non-overlay scrollbars.
  {%- endcomment -%}
  <div class="flex flex-wrap items-center overflow-x-auto hidescrollbar
    type__nav
    {{ settings.type_header_capitilization }}
    {% if section.settings.bar_layout_desktop == "center-below" %}w-full justify-center{% endif %}
    {% if section.settings.bar_layout_desktop == "left-below" %}w-full{% endif %}
    {% if section.settings.bar_layout_desktop == "left-inline" %}flex-grow justify-start{% endif %}
    {% if section.settings.bar_layout_desktop == "left-center" %}justify-center flex-nowrap{% endif %}
    {% if section.settings.bar_layout_desktop == "center-inline" %}justify-start flex-nowrap{% endif %}">

    {% assign activeLinkCounter = 0 %}
    {%- for link in section.settings.dropdown_links.links -%}
      {% if link.child_active %}
        {% assign activeLinkCounter = activeLinkCounter | plus: 1 %}
      {% else %}
        {% if link.active %}
          {% assign activeLinkCounter = activeLinkCounter | plus: 1 %}
        {% endif %}
      {% endif %}

      <div class="flex-shrink h-full js-header-nav-item">
        <a
          href="{{ link.url }}"
          onclick=""
          class="header__link header__nav-link type__nav type--small h-full flex items-center mr-2 block no-underline hover:no-underline
          {{ settings.type_header_capitilization }}
          {% if section.settings.bar_layout_desktop == "center-below" %}px-4 md:py-6 py-2 type--small{% endif %}
          {% if section.settings.bar_layout_desktop == "left-below" %}pr-4 pt-2 pb-4 type--small{% endif %}
          {% if section.settings.bar_layout_desktop == "left-inline" %}px-4 md:py-6 py-2{% endif %}
          {% if activeLinkCounter <= 1 %}
            {% if link.child_active %}header__link--hover{% endif %}
            {% if link.active %}header__link--hover{% endif %}
          {% endif %}
          {% if section.settings.bar_layout_desktop == "center-below" %}
            px-4 mx-2
          {% elsif section.settings.bar_layout_desktop == "left-center" or section.settings.bar_layout_desktop == "center-inline" %}
            px-4
          {% else %}
            mr-2 pr-4
          {% endif %}">
          <span class="header__link-text">{{ link.title }}</span>

          {%- comment -%}
            {% if link.levels >= 1 %}
                {% render 'component__icon', icon: 'chevron-down', class: 'ml-1', size: '16' %}
            {% endif %}
          {%- endcomment -%}
        </a>

        {%- comment -%}
          Render the dropdown wrapper when the nav link has Shopify-menu
          children OR when the merchant has attached any mega-menu blocks
          to this link via the block's "Attach to nav link (title)"
          setting. Previously this guarded on `link.levels >= 1` alone,
          so a merchant who only configured blocks (no menu children)
          got no dropdown wrapper at all and hovering revealed nothing.
        {%- endcomment -%}
        {%- assign _mm_has_blocks = false -%}
        {%- if link.levels < 1 -%}
          {%- assign _mm_link_key = link.title | strip | downcase -%}
          {%- for block in section.blocks -%}
            {%- assign _mm_block_key = block.settings.parent_link_title | default: '' | strip | downcase -%}
            {%- if _mm_block_key != '' and _mm_block_key == _mm_link_key -%}
              {%- assign _mm_has_blocks = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {% if link.levels >= 1 or _mm_has_blocks %}
          <div class="header__dropdown animation-300 block h-0 overflow-hidden normal-case opacity-0">
            {% render 'mega-menu__panel', link: link, section: section %}
          </div>
        {% endif %}
        
      </div>
    {%- endfor -%}

  </div>
{% endcapture %}

{% capture desktop_search %}
  {% if section.settings.enable_search %}
    {% render 'header__search-desktop' %} 
  {% endif %}
{% endcapture %}

{% capture desktop_actions %}
  <div class="flex items-center justify-end flex-shrink pl-2 text-right">

    {% if section.settings.enable_search %}
      {% if section.settings.bar_button_search_type == "text" %}
        <a
          class="hover:underline inline-flex pl-4 ml-2 no-underline
          type__nav
          {{ settings.type_header_capitilization }}"
          href="{{ routes.search_url }}"
          rel="nofollow"
          @click.prevent="search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-desktop').focus(); });">
          {{ 'general.search.search' | t }}
        </a>
      {% else %}
        <a
          class="type__nav hover:underline inline-flex pl-4 ml-2 no-underline"
          href="{{ routes.search_url }}"
          rel="nofollow"
          title="{{ 'general.search.search' | t }}"
          @click.prevent="search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-desktop').focus(); });">
          {% render 'component__icon', icon: 'search', size: '24', class: '' %}
        </a>
      {% endif %}
    {% endif %}

    {%- if shop.customer_accounts_enabled -%}
     {% unless section.settings.bar_button_login_type == "none" %}
      {% if section.settings.bar_button_login_type == "text" %}
        <a
          class="hover:underline inline-flex pl-4 ml-2 no-underline
          type__nav
          {{ settings.type_header_capitilization }}"
          href="{{ routes.account_url }}"
          rel="nofollow">
          {% if customer %}
            {{ 'general.navigation.account' | t }}
          {% else %}
            {{ 'customer.account.log_in' | t }}
          {% endif %}

        </a>
      {% else %}
        <a
          class="type__nav hover:underline inline-flex pl-4 ml-2 no-underline"
          href="{{ routes.account_url }}"
          rel="nofollow"
          title=" {% if customer %}{{ 'general.navigation.account' | t }}{% else %}{{ 'customer.account.log_in' | t }}{% endif %}">
          {% render 'component__icon', icon: 'account', size: '24', class: '' %} 
        </a>
      {% endif %}
     {% endunless %}
    {% endif %}

    {% if section.settings.bar_button_cart_type == "text" %}
      <a
        class="inline-flex pl-4 ml-2 no-underline items-center
        type__nav
        {{ settings.type_header_capitilization }}"
        {% if settings.enable_audio %}
          {% assign audio = 'const click_audio = new Audio(window.__initialData.click_audio); click_audio.play();' %}
        {% endif %}
        {% if settings.cart_icon_behavior == "open_cart_drawer" %}@click.prevent="cart_drawer = true; {{ audio }}"{% endif %}
        {% if settings.enable_audio %}  {% endif %} 
        href="{{ routes.cart_url }}"
        rel="nofollow"
        >
        {{ 'cart.general.title' | t }} 
        <span class="ml-1
        type__nav
        {{ settings.type_header_capitilization }}" 
          x-show="cart.item_count > 0" 
          x-cloak>(<span class="
          type__nav
          {{ settings.type_header_capitilization }}" x-text="cart.item_count">{{ cart.item_count }}</span>)</span>
      </a>
    {% else %}
      <a
        class="type__nav relative inline-flex items-center pl-4 ml-2 !no-underline"
        href="{{ routes.cart_url }}"
        rel="nofollow"
        title="{{ 'cart.general.title' | t }}"
        {% if settings.enable_audio %}
          {% assign audio = 'const click_audio = new Audio(window.__initialData.click_audio); click_audio.play();' %}
        {% endif %}
        {% if settings.cart_icon_behavior == "open_cart_drawer" %}@click.prevent="cart_drawer = true; {{ audio }}"{% endif %}>
        {% render 'component__icon', icon: 'cart', size: '24', class: '' %} 
        <span
          class="cart-count-badge color__bg-primary color__primary"
          x-show="cart.item_count > 0"
          x-cloak
          x-text="cart.item_count">{{ cart.item_count }}</span>
      </a>
    {% endif %}

  </div>
{% endcapture %}

{% capture desktop_actions--minor %}
  <div class="basis-0 flex items-center justify-start flex-grow flex-shrink pr-2
    {% if section.settings.bar_layout_desktop == "center-below" %}grow-0{% endif %}">

    {% if section.settings.enable_search %}
      {% unless section.settings.bar_layout_desktop == "left-below" %}
        {% if section.settings.bar_button_search_type == "text" %}
          <a
            class="hover:underline inline-flex pl-0 ml-0 no-underline
            type__nav
            {{ settings.type_header_capitilization }}"
            href="{{ routes.search_url }}"
            rel="nofollow"
            @click.prevent="search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-desktop').focus(); });">
            {{ 'general.search.search' | t }}
          </a>
        {% else %}
          <a
            class="type__nav hover:underline inline-flex pl-0 ml-0 no-underline"
            href="{{ routes.search_url }}"
            rel="nofollow"
            title="{{ 'general.search.search' | t }}"
            @click.prevent="search_visible = true; search_active = true; $nextTick(() => { document.querySelector('#search-desktop').focus(); });">
            {% render 'component__icon', icon: 'search', size: '24', class: '' %} 
          </a>
        {% endif %}
      {% endunless %}
    {% endif %}
    
  </div>
{% endcapture %}

{% capture desktop_search %}
  {% if section.settings.enable_search %}
    {% render 'header__search-desktop' %} 
  {% endif %}
{% endcapture %}

{% if template.name == 'index' %}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var header = document.querySelector('header.header--transparent');
      if (header) header.classList.add('header--text-{{ section.settings.transparent_text_color }}');
    });
  </script>
{% endif %}

<nav
  aria-label="Header Navigation"
  class="
    border--b-width
    {{ section.settings.visibility }}
    {{ section.settings.bar_color_scheme }}
    {{ section.settings.bar_color_border }}
  ">
  
  <div class="relative">
    
    {%- comment -%} mobile {%- endcomment -%}
    <div
      style="padding-left: 20px; padding-right: 20px;"
      class="
        xl:hidden flex flex-wrap items-center py-2
      ">
      
      {%- comment -%} mobile bar — logo far left (per merchant) {%- endcomment -%}
      <div class="basis-0 flex items-center justify-start flex-grow flex-shrink max-w-[45%] sm:max-w-[70%]">
        <a
          class="inline-block relative items-center"
          href="{{ routes.root_url }}"
          rel="nofollow"
          title="{{ shop.name }}">
            <img
              src="{{ 'Thread-Stitch.png' | asset_url }}"
              alt="{{ shop.name }}"
              style="height: 38px; width: auto;">
        </a>
      </div>

      {%- comment -%} mobile bar — right: search, cart, hamburger (per merchant) {%- endcomment -%}
      <div class="basis-0 flex items-center justify-end flex-grow flex-shrink text-right">
        <button
          @click="search_visible = true; search_active = true; $nextTick(() => { var el = document.querySelector('#search-mobile'); if (el) el.focus(); });"
          class="type__nav no-js--hide inline-flex py-2 no-underline"
          style="padding-left: 14px; padding-right: 14px;"
          title="{{ 'general.search.title' | t | default: 'Search' }}"
