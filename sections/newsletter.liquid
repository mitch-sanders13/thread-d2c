<!-- sections/newsletter.liquid -->
{% comment %} 
  Email newsletter signup form.

  Globals:
    - settings.layout_horizontal: horizontaly margin
    - settings.thumbnails_color_scheme: set color of items
    - settings.thumbnails_color_border: set border of cards

  Recommendations:
    - Connect your customer emails to a email service like Klaviyo to send automatic welcome emails.
{% endcomment %}

<section class="
  {{ section.settings.visibility }}
  {{ section.settings.color_border }}
  {{ section.settings.style_border }}"
  x-intersect.half="
    body_background_color = '{{ section.settings.color_background }}';
    body_text_color = '{{ section.settings.color_text }}';
  ">
  <div class="{{ settings.layout_horizontal }}"
    style="
      padding-top:{{ section.settings.spacing_top }}px;
      padding-bottom:{{ section.settings.spacing_bottom }}px;" >

    <div class="flex flex-row flex-wrap -mx-4
      {{ section.settings.layout_y_alignment }}
      {{ section.settings.layout_x_alignment }}">

      {% for block in section.blocks %}
        {% case block.type %}

        {% when 'newsletter' %}
          <div class="p-4
            {{ block.settings.layout_x_alignment }}
            {% if block.settings.layout_desktop_width == 12 %}
              md:w-full
            {% else %}
              md:w-{{ block.settings.layout_desktop_width }}/12
            {% endif %}
            {% if block.settings.layout_mobile_width == 12 %}
              w-full
            {% else %}
              w-{{ block.settings.layout_mobile_width }}/12
            {% endif %}">

            {% form 'customer' %}

              {% unless block.settings.heading == blank %}
                <h3 class="mb-2">{{ block.settings.heading }}</h3>
              {% endunless %}
              {% if form.posted_successfully? %}
                <div class="m-0--clear mb-2">
                  {{ block.settings.success }}
                </div>
              {% else %}
                {% unless block.settings.content == blank %}
                  <div class="m-0--clear mb-2">
                    {{ block.settings.content }}
                  </div>
                {% endunless %}
                {% if form.errors %}
                  <div class="color__bg-overlay-1 type--small border--radius p-2 mt-2 mb-4">
                    {{ form.errors | default_errors }}
                  </div>
                {% endif %}
                <div class="flex w-full">
                  <label for="customer_email" class="sr-only">{{ 'contact.form.email' | t }}</label>
                  <input id="customer_email" class="form-input flex-grow -mr-8"
                    name="contact[email]"
                    type="email"
                    placeholder="{{ 'contact.form.email_placeholder' | t }}"
                    autocorrect="off"
                    autocapitalize="off"/>
                  <button type="submit" class="btn btn--small {{ section.settings.color_button }} whitespace-nowrap shrink-0">
                    <span class="btn__content">{{ block.settings.button_label }}</span>
                  </button>
                </div>
                <div class="m-0--clear type--smaller mt-2 opacity-75">
                  {{ block.settings.disclaimer }}
                </div>
              {% endif %}

            {% endform %}

          </div>

        {% when 'image' %}
          <div class="px-4
            {% if block.settings.layout_desktop_width == 12 %}
              md:w-full
            {% else %}
              md:w-{{ block.settings.layout_desktop_width }}/12
            {% endif %}
            {% if block.settings.layout_mobile_width == 12 %}
              w-full
            {% else %}
              w-{{ block.settings.layout_mobile_width }}/12
            {% endif %}">
            {% if block.settings.image_featured == blank %}
              <div class="border--radius relative w-full overflow-hidden 
                {{ settings.thumbnails_color_scheme }}
                {{ settings.thumbnails_color_border }}">
                {{ 'image' | placeholder_svg_tag: 'w-full' }}
              </div>
            {% else %}
              <div class="border--radius relative w-full overflow-hidden
                {{ settings.thumbnails_color_scheme }}">
                {{ block.settings.image_featured | image_url: width: 1400 | image_tag: style: 'object-fit:cover', class: 'w-full', loading: 'lazy', alt: block.settings.image_featured.alt }}
              </div>
            {% endif %}
          </div>

        {% endcase %}
      {% endfor -%}

    </div>
    
  </div>
</section>

