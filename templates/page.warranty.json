    "liquid_MjTLpT": {
      "type": "liquid",
      "name": "t:sections.liquid.name",
      "settings": {
        "liquid": "{% comment %}\n  Custom Liquid block to make \"Start Claim\" button open in a new tab.\n  Add this as a \"Custom liquid\" section on the warranty page.\n{% endcomment %}\n\n<script>\n(function() {\n  function makeStartClaimOpenInNewTab() {\n    // Find the \"Start Claim\" button link\n    const startClaimLinks = Array.from(document.querySelectorAll('a')).filter(link => {\n      const text = link.textContent.trim();\n      const href = link.getAttribute('href') || '';\n      return text === 'Start Claim' || href.includes('returns-portal/login');\n    });\n\n    startClaimLinks.forEach(link => {\n      link.setAttribute('target', '_blank');\n      link.setAttribute('rel', 'noopener noreferrer');\n    });\n  }\n\n  // Run when DOM is ready\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', makeStartClaimOpenInNewTab);\n  } else {\n    makeStartClaimOpenInNewTab();\n  }\n})();\n</script>",
        "spacing_top": 0,
