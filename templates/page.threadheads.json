      "blocks": {
        "template--15922140283018__aa4bb5d3-2c94-4cc5-a4a0-67fa7bb9b8c2-content-1": {
          "type": "content",
          "settings": {
            "heading": "ACE PELKA",
            "content": "<p><strong>What is your favorite Thread product and why?<\/strong><\/p><p>My favorite product from Thread would of course be the Mini Backpack! For me this is the perfect day travel pack because ti fits all of my needs and is so light and compact. I take it with me for all of my daily adventures!<br\/><br\/><strong>What does Carry On mean to me?<\/strong><\/p><p>Carrying On means to persevere and push through the hard times and the adversity. Remembering that without darkness there’d be no light.<\/p>",
            "image_featured": "shopify:\/\/shop_images\/IMG_0919_230d8daf-fb77-418d-9432-82e0c6e40216.jpg",
            "button_label": "Button",
            "button_url": "",
            "spacing_top": 0,
            "spacing_bottom": 0,
            "color_scheme": "color__bg-overlay-1 color__text",
            "color_border": "!color__border-transparent",
            "color_text": "color__dark",
            "color_button": "btn",
            "enable_gradient": false,
            "layout_y_alignment": "items-start",
