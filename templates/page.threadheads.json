            "enable_padding": true
          }
        },
        "template--15922140283018__aa4bb5d3-2c94-4cc5-a4a0-67fa7bb9b8c2-content-3": {
          "type": "content",
          "settings": {
            "heading": "ETHAN JONES",
            "content": "<p><strong>What is your favorite Thread product and why?<\/strong><\/p><p>My favorite Thread product would be the Crossbody Bag, perfect for being a photographer and always on the go.<br\/><br\/><strong>What does Carry On mean to me?<\/strong><\/p><p>I believe it’s so important to have a good work-life balance. Getting out in the water or out for a run really keeps me sane, that’s how I Carry On!<\/p>",
            "image_featured": "shopify:\/\/shop_images\/SP002246-25A_5964ff10-b338-41ca-8209-ef8cafdb045a.jpg",
            "button_label": "Button",
            "button_url": "",
            "spacing_top": 0,
