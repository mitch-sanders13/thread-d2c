        "8065b7f5-9a80-43b3-b055-433d419c41d6": {
          "type": "content",
          "disabled": true,
          "settings": {
            "heading": "Rob Roethler",
            "content": "<h6><em>Favorite product and why:<\/em><\/h6><p>Favorite Thread product is the Crossbody Bag—so convenient to have all the essentials on you.<\/p><h6><\/h6><h6><em>What does Carry On mean to you:<\/em> <\/h6><p>Carry On to me means to snowboard, skateboard, golf, or just get active—to stay focused on the things that make me happy is how I am able to Carry On. I can get pretty beat down, mentally, physically, and emotionally, but having those outlets reminds me why I keep pushing.<\/p>",
            "image_featured": "shopify:\/\/shop_images\/IMG_0217.jpg",
            "button_label": "Button",
            "button_url": "",
            "spacing_top": 0,
            "spacing_bottom": 0,
            "color_scheme": "color__bg-body color__text",
            "color_border": "color__border-divider-1",
            "color_text": "color__text",
            "color_button": "btn btn--secondary",
