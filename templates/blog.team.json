        "f8aea7d4-3da5-41d9-af93-9d82e358e9d0": {
          "type": "content",
          "disabled": true,
          "settings": {
            "heading": "Sawyer Lindblad",
            "content": "<h6><em>Favorite product and why:<\/em><\/h6><p>My favorite Thread product is the Tote Bag.<\/p><h6><\/h6><h6><em>What does Carry On mean to you:<\/em> <\/h6><p>Carry on means to me to live every day to the fullest.<\/p>",
            "image_featured": "shopify:\/\/shop_images\/alihuxmansummer23-288_b9f6856e-805b-48e8-963c-a67b3dca9033.jpg",
            "button_label": "",
            "button_url": "",
            "spacing_top": 0,
            "spacing_bottom": 0,
            "color_scheme": "color__bg-body color__text",
            "color_border": "color__border-divider-1",
            "color_text": "color__text",
            "color_button": "btn",
            "enable_gradient": false,
            "layout_y_alignment": "items-end",
