        "8e6a3ac1-991f-48e1-b5b4-2b643b638b51": {
          "type": "content",
          "settings": {
            "heading": "Jack Soren",
            "content": "<h6><em>Favorite product and why:<\/em><\/h6><p>I dig the Crossbody, I like to keep all my nicknacks on me. Always got the small essentials on me.<\/p><h6><\/h6><h6><em>What does Carry On mean to you:<\/em> <\/h6><p>Win or lose, I'll still be doing my thing. No matter what comes, keep pushing, keep moving forward.<\/p>",
            "image_featured": "shopify:\/\/shop_images\/IMG_3738.jpg",
            "button_label": "Button",
            "button_url": "",
            "spacing_top": 0,
            "spacing_bottom": 0,
            "color_scheme": "color__bg-body color__text",
            "color_border": "color__border-divider-1",
            "color_text": "color__text",
            "color_button": "btn btn--secondary",
            "enable_gradient": false,
