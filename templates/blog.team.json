        "9432b773-8165-4c19-92eb-e95f402bc337": {
          "type": "content",
          "disabled": true,
          "settings": {
            "heading": "Janthavy Norton",
            "content": "<h6><em>Favorite product and why:<\/em><\/h6><p>My favorite Thread product is the Keychain Clip because it is nice and compact. It's convenient for quick bike rides, skating, and traveling.<\/p><h6><\/h6><h6><em>What does Carry On mean to you:<\/em> <\/h6><p>Carry On means to keep pushing yourself to be your best; to see the positive in everything even when times get tough.<\/p>",
            "image_featured": "shopify:\/\/shop_images\/image_6483441.jpg",
            "button_label": "Button",
            "button_url": "",
            "spacing_top": 0,
            "spacing_bottom": 0,
            "color_scheme": "color__bg-body color__text",
            "color_border": "color__border-divider-1",
