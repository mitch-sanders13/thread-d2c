        "6f72bbf8-437c-40c4-ae5b-99420d06c422": {
          "type": "content",
          "disabled": true,
          "settings": {
            "heading": "Keani Canullo",
            "content": "<h6><em>Favorite product and why:<\/em><\/h6><p>My favorite Thread product is the Crossbody Bag! They come in so many colors & they're the best to travel with.<\/p><h6><\/h6><h6><em>What does Carry On mean to you:<\/em> <\/h6><p>Carrying On means to not give up when things get tough but to also recognize when its time to ask for help. I'm grateful to be supported by a brand that helps their athletes when it comes to mental health. It is an important subject that every brand should talk about.<\/p>",
            "image_featured": "shopify:\/\/shop_images\/sp001511-37.jpg",
            "button_label": "Button",
            "button_url": "",
            "spacing_top": 0,
            "spacing_bottom": 0,
            "color_scheme": "color__bg-body color__text",
            "color_border": "color__border-divider-1",
            "color_text": "color__text",
            "color_button": "btn btn--secondary",
