{% comment %}
  Reactive subtotal / discount / total breakdown for the bundle builder.
  Inputs:
    - discount_type: 'percent' | 'fixed_off' | 'none'
    - discount_value: numeric (percent value OR dollar amount)
{% endcomment %}

<div class="bundle-builder__summary w-full max-w-md" x-cloak>
  <div class="flex justify-between py-1">
    <span>Subtotal</span>
    <span x-text="formatMoney(subtotalCents())"></span>
  </div>

  {% if discount_type != 'none' and discount_value > 0 %}
    <div class="flex justify-between py-1" x-show="discountCents() > 0">
      <span>
        Bundle discount
        {%- if discount_type == 'percent' -%}
          ({{ discount_value }}%)
        {%- endif -%}
      </span>
      <span x-text="'−' + formatMoney(discountCents())"></span>
    </div>
  {% endif %}

  <div class="flex justify-between py-2 border--t-width font-medium">
    <span>Total</span>
    <span x-text="formatMoney(totalCents())"></span>
  </div>
</div>
