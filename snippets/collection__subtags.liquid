<!-- snippets/collection__subtags.liquid -->
{% comment %} 
  Secondary navigation for collection pages. Use tags for quick filtering.

  Usage:
    {% render 'collection__subtags' %}

  Globals:
    - settings.layout_horizontal: horizontaly margin

  Pro tips:
    - Use this snippet on collection templates.
{% endcomment %}

{% comment %}sub tags{% endcomment %}
{% assign raw_sub_tags = collection.metafields.custom.subtags %}
{% comment %}Hide subtags for collegiate collection{% endcomment %}
{% if raw_sub_tags != blank and collection.handle != 'collegiate' %}
  <nav class="flex flex-wrap
    md:{{ settings.layout_horizontal }} {% unless section.settings.hide_sublinks_divider %}border--b-width{% endunless %} color__border-divider-1">
    <div class="relative w-full">

      <div class="whitespace-nowrap scroll-smooth snap-x inline-flex w-full gap-2 overflow-x-auto hidescrollbar">
        <div class="snap-center flex justify-center flex-none">
          <a href="{{ collection.url }}"
            class="no-underline type__nav type--small py-4 border-b-4 color__border-selected-1 px-4
            {% if current_tags != blank %}opacity-50 !border-b-0{% endif %}">
            All
          </a>
        </div>
        {% for item in raw_sub_tags.value -%}
          <div class="snap-center flex justify-center flex-none">
            <a href="{{ collection.url }}/{{ item }}"
              class="no-underline type__nav type--small opacity-50 py-4 px-4
              {% capture lowercase_item %}{{ item | handle }}{% endcapture %}
              {% if current_tags contains lowercase_item %}
                !opacity-100
                border-b-4
                color__border-selected-1
              {% endif %}">
              {{ item }}
            </a>
          </div>
        {% endfor %}
      </div>

    </div>
  </nav> 
{% endif %}