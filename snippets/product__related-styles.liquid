<!-- snippets/product__related-styles.liquid -->
{% comment %}
  Related Styles — renders ONE section of product swatches.
  Used by sections/product__main.liquid (block.type == 'related_styles').

  One block = one section. Add multiple related_styles blocks to the
  product template for multiple sections (e.g. Best Sellers, Seasonal).

  Source options (blocksettings.source_type):
    - 'silhouette' (default): per-product custom.swatch_collection metafield
    - 'collection': merchant-picked collection (blocksettings.collection)

  Optional cross-filter (blocksettings.filter_collection): only include
  products that also exist in this collection. e.g. silhouette + best-sellers
  shows best sellers of the current product's silhouette.

  Accepts:
    - blocksettings: block.settings
    - block_id: block.id (for CSS scoping)
{% endcomment %}

{%- assign current_handle = product.handle -%}
{%- assign source_type = blocksettings.source_type | default: 'silhouette' -%}
{%- assign filter_handle = blocksettings.filter_collection -%}
{%- assign heading_text = blocksettings.heading -%}

{%- comment -%} Resolve source collection {%- endcomment -%}
{%- assign coll = nil -%}
{%- assign rs_variant_mode = false -%}
{%- if source_type == 'silhouette' -%}
  {%- comment -%} Bundle sets: colors are VARIANTS, and their swatch
      metafield points at the sibling-set collection — whose products
      are all Bundles, which the grid excludes by design. Render the
      product's own variants instead. {%- endcomment -%}
  {%- if product.variants.size > 1 -%}
    {%- if product.type == 'Bundle' or product.tags contains 'bundle' -%}
      {%- assign rs_variant_mode = true -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign coll = product.metafields.custom.swatch_collection.value -%}
  {%- comment -%} Products without the metafield: multi-variant products
      (bundles/sets where each color combo is a VARIANT, not a sibling
      product) render their own variants as the swatch grid; single-
      variant products fall back to the block's collection so the
      selector never silently disappears. {%- endcomment -%}
  {%- if coll == empty or coll == nil -%}
    {%- if product.variants.size > 1 -%}
      {%- assign rs_variant_mode = true -%}
    {%- elsif blocksettings.collection != blank -%}
      {%- assign coll = collections[blocksettings.collection] -%}
    {%- endif -%}
  {%- endif -%}
{%- else -%}
  {%- assign coll = collections[blocksettings.collection] -%}
{%- endif -%}

{%- comment -%} Build cross-filter handle set if filter_collection is set {%- endcomment -%}
{%- assign filter_handles = '' -%}
{%- if filter_handle != blank -%}
  {%- assign filter_coll = collections[filter_handle] -%}
  {%- if filter_coll != empty and filter_coll != nil -%}
    {%- assign filter_handles = '|' -%}
    {%- for fp in filter_coll.products limit: 2000 -%}
      {%- assign filter_handles = filter_handles | append: fp.handle | append: '|' -%}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} Layout helpers {%- endcomment -%}
{%- assign aspect_value = '1 / 1' -%}
{%- case blocksettings.swatch_aspect -%}
  {%- when '3/4' -%}{%- assign aspect_value = '3 / 4' -%}
  {%- when '4/5' -%}{%- assign aspect_value = '4 / 5' -%}
{%- endcase -%}
{%- assign shape_radius = '0px' -%}
{%- case blocksettings.swatch_shape -%}
  {%- when 'square' -%}{%- assign shape_radius = '0px' -%}
  {%- when 'rounded' -%}{%- assign shape_radius = blocksettings.swatch_radius | append: 'px' -%}
  {%- when 'circle' -%}{%- assign shape_radius = '50%' -%}
{%- endcase -%}
{%- assign soldout_opacity = blocksettings.soldout_image_opacity | default: 50 | divided_by: 100.0 -%}

<style>
  [data-rs-block="{{ block_id }}"] {
    padding: {{ blocksettings.pad_top_d | default: 32 }}px 16px {{ blocksettings.pad_bot_d | default: 32 }}px;
    {%- if blocksettings.section_bg != blank %}background: {{ blocksettings.section_bg }};{%- endif %}
  }

  /* Override the global .pdp-section-divider's hardcoded `margin-bottom: 16px`
     (in assets/bundle-builder.css) for the divider that precedes THIS block.
     `:has(+ X)` matches an element whose next sibling is X — modern Chrome /
     Safari / Firefox all support it. Lets the merchant tighten the gap
     between the price/title divider and "Select Your Style" via the
     block-level `rs_divider_mb_d` setting. */
  .pdp-section-divider:has(+ [data-rs-block="{{ block_id }}"]) {
    margin-bottom: {{ blocksettings.rs_divider_mb_d | default: 16 }}px;
  }
  [data-rs-block="{{ block_id }}"] .rs-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin: 0 0 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    font-size: {{ blocksettings.heading_size_d | default: 14 }}px;
    font-weight: {{ blocksettings.heading_weight | default: '500' }};
    text-transform: {{ blocksettings.heading_transform | default: 'none' }};
    letter-spacing: {{ blocksettings.heading_ls | default: '0.05em' }};
    {%- if blocksettings.heading_color != blank %}color: {{ blocksettings.heading_color }};{%- endif %}
  }
  /* Style count ("N styles") — merchant-controlled via rs_count_*
     settings. Shared by the heading row's count, the title-row count
     (heading hidden), and the tabbed-mode shared count below. */
  [data-rs-block="{{ block_id }}"] .rs-count {
    font-size: {{ blocksettings.rs_count_size_d | default: 12 }}px;
    font-weight: {{ blocksettings.rs_count_weight | default: '400' }};
    color: {{ blocksettings.rs_count_color | default: 'var(--thread-grey)' }};
    text-transform: none;
    letter-spacing: {{ blocksettings.rs_count_ls | default: '0em' }};
  }
  @media (max-width: 749px) {
    [data-rs-block="{{ block_id }}"] .rs-count {
      font-size: {{ blocksettings.rs_count_size_m | default: 12 }}px;
    }
  }
  /* "Select Your Style" title — merchant-controlled via rs_title_*
     settings on the block (see schema). Each related_styles block
     can render its own title (non-tabbed mode); in tabbed mode this
     selector is hidden and the shared .rs-tabbed-title takes over. */
  [data-rs-block="{{ block_id }}"] .rs-title {
    margin: 0 0 {{ blocksettings.rs_title_mb | default: 12 }}px;
    line-height: 1.3;
    text-align: left;
    font-size: {{ blocksettings.rs_title_size_d | default: 15 }}px;
    font-weight: {{ blocksettings.rs_title_weight | default: '700' }};
    text-transform: {{ blocksettings.rs_title_transform | default: 'none' }};
    letter-spacing: {{ blocksettings.rs_title_ls | default: '0em' }};
    {%- case blocksettings.rs_title_font -%}
      {%- when 'body'        -%}font-family: var(--type-font-body-family);
      {%- when 'heading'     -%}font-family: var(--type-font-header-family);
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
    {%- endcase -%}
    {%- if blocksettings.rs_title_color != blank %}color: {{ blocksettings.rs_title_color }};{%- endif %}
  }
  @media (max-width: 749px) {
    [data-rs-block="{{ block_id }}"] .rs-title {
      font-size: {{ blocksettings.rs_title_size_m | default: 15 }}px;
    }
  }

  /* (.rs-current-name removed — the hover/selected style name was
     pulled per merchant request. rs_cn_* schema settings remain
     defined in the block but no longer drive any CSS.) */

  /* Arrows now live inside .rs-header (top-right of each block) so
     they sit above the grid instead of below it. The per-block
     .rs-footer is no longer rendered. */
  [data-rs-block="{{ block_id }}"] .rs-arrows {
    display: none;
    gap: 8px;
    flex: 0 0 auto;
    margin-left: auto;
  }
  @media (min-width: 750px) {
    [data-rs-block="{{ block_id }}"].rs-has-pagination .rs-arrows {
      display: inline-flex;
    }
  }

  /* Title row: "Select Your Style" left + (when the section heading
     is hidden) the style count right-justified on the same line —
     mirrors the tabbed-mode shared title row. The title's typography
     comes from the merchant-controlled .rs-title rule above; a
     second hardcoded .rs-title rule used to live here and silently
     overrode those settings (same-specificity, later in source) —
     removed. */
  [data-rs-block="{{ block_id }}"] .rs-titlerow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 {{ blocksettings.rs_title_mb | default: 12 }}px;
    min-width: 0;
  }
  [data-rs-block="{{ block_id }}"] .rs-titlerow .rs-title {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
  }
  /* When the arrows share the title row they cluster on the right —
     the count's margin-left:auto pushes count + arrows together to
     the right edge, with the row's gap separating them. */
  [data-rs-block="{{ block_id }}"] .rs-titlerow .rs-arrows {
    margin-left: 0;
  }
  [data-rs-block="{{ block_id }}"] .rs-titlerow-count {
    flex: 0 0 auto;
    margin-left: auto;
    font-size: {{ blocksettings.rs_count_size_d | default: 12 }}px;
    font-weight: {{ blocksettings.rs_count_weight | default: '400' }};
    color: {{ blocksettings.rs_count_color | default: 'var(--thread-grey)' }};
    text-transform: none;
    letter-spacing: {{ blocksettings.rs_count_ls | default: '0em' }};
  }
  @media (max-width: 749px) {
    [data-rs-block="{{ block_id }}"] .rs-titlerow-count {
      font-size: {{ blocksettings.rs_count_size_m | default: 12 }}px;
    }
  }
  /* With the heading hidden the header row only holds the desktop
     pagination arrows — drop its bottom margin unless the arrows are
     actually showing so it doesn't add a phantom gap above the grid. */
  /* With the heading hidden the header row holds nothing visible
     (the arrows moved up into the title row) — collapse its margin
     so it doesn't add a phantom gap above the grid. */
  [data-rs-block="{{ block_id }}"] .rs-header--noheading {
    margin-bottom: 0;
  }

  /* Header row above the grid: rs-heading (optional) on the left +
     the current/hover style name on the right. The name uses
     margin-left:auto so it stays right-aligned even when the
     heading is hidden (tabbed mode) or omitted. */
  [data-rs-block="{{ block_id }}"] .rs-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: {{ blocksettings.rs_tab_bar_mb | default: 8 }}px;
    min-width: 0;
  }
  [data-rs-block="{{ block_id }}"] .rs-header .rs-heading {
    /* Strip the heading's own margin — the header row owns the gap
       below now. Lets the heading shrink instead of pushing the
       name off-screen on narrow viewports. */
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding-bottom: 0;
    border-bottom: 0;
  }
  [data-rs-block="{{ block_id }}"] .rs-current-name {
    margin: 0 0 0 auto;
    font-size: 0.8rem;
    line-height: 1.2;
    color: #4a4a4a;
    font-weight: 500;
    white-space: nowrap;
    flex: 0 0 auto;
    text-align: right;
  }

  [data-rs-block="{{ block_id }}"] .rs-arrow {
    /* Visual styling (size, bg, border, shadow) comes from the
     * shared .btn .btn--plain .btn--small .shadow-sm classes so
     * these arrows match the PDP product-gallery slider arrows.
     * Only layout + disabled state is customized here. */
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  [data-rs-block="{{ block_id }}"] .rs-arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* Column-flow scrolling grid.
       - Items fill column 1 top-to-bottom (up to `rows`), then column 2,
         then column 3, etc.
       - Each column is sized so `cols` columns plus a `creep` peek of the
         next column are visible at once. The peek signals "scroll right
         for more styles".
       - `overflow-x: auto` exposes additional columns past the visible
         set; `scroll-snap-type: x mandatory` snaps each scroll step to
         the next column edge.

     Merchant controls (block schema → "Grid"):
       rs_grid_cols_d  / rs_grid_cols_m   visible columns at a time
       rs_grid_rows_d  / rs_grid_rows_m   rows per column
       rs_grid_creep_d / rs_grid_creep_m  peek of next column, in %
                                          (30 = 30% of one column visible)
  */
  {%- assign _rs_cols_d    = blocksettings.rs_grid_cols_d  | default: 4  -%}
  {%- assign _rs_cols_m    = blocksettings.rs_grid_cols_m  | default: 3  -%}
  {%- assign _rs_rows_d    = blocksettings.rs_grid_rows_d  | default: 3  -%}
  {%- assign _rs_rows_m    = blocksettings.rs_grid_rows_m  | default: 3  -%}
  {%- assign _rs_creep_d   = blocksettings.rs_grid_creep_d | default: 30 -%}
  {%- assign _rs_creep_m   = blocksettings.rs_grid_creep_m | default: 20 -%}
  {%- assign _rs_gap_col_d = blocksettings.rs_grid_gap_col_d | default: 8 -%}
  {%- assign _rs_gap_col_m = blocksettings.rs_grid_gap_col_m | default: 8 -%}
  [data-rs-block="{{ block_id }}"] .rs-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat({{ _rs_rows_d }}, auto);
    grid-auto-columns: calc((100% - ({{ _rs_cols_d }} * {{ _rs_gap_col_d }}px)) / ({{ _rs_cols_d }} + {{ _rs_creep_d }} / 100));
    gap: {{ blocksettings.rs_grid_gap_row_d | default: 12 }}px {{ _rs_gap_col_d }}px;
    /* padding-top creates clearance for the .rs-swatch-badge to
     * protrude above the selected swatch without being clipped by
     * the grid's overflow-y: hidden. */
    padding-top: 8px;
    padding-bottom: 2px;
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  [data-rs-block="{{ block_id }}"] .rs-grid::-webkit-scrollbar { display: none; }

  /* JS wraps each .rs-swatch anchor in a .rs-swatch-cell flex column
     that holds the swatch image and the style-name label below. */
  [data-rs-block="{{ block_id }}"] .rs-swatch-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ blocksettings.rs_cell_gap | default: 4 }}px;
    min-width: 0;
    scroll-snap-align: start;
  }
  [data-rs-block="{{ block_id }}"] .rs-swatch-cell .rs-swatch {
    width: 100%;
    flex: 0 0 auto;
    transition: transform 0.12s ease;
  }
  [data-rs-block="{{ block_id }}"] .rs-swatch-cell:hover .rs-swatch { transform: scale(1.04); }
  [data-rs-block="{{ block_id }}"] .rs-swatch-name {
    line-height: 1.15;
    text-align: center;
    opacity: 0.85;
    width: 100%;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
    font-size: {{ blocksettings.rs_sn_size_d | default: 11 }}px;
    font-weight: {{ blocksettings.rs_sn_weight | default: '400' }};
    text-transform: {{ blocksettings.rs_sn_transform | default: 'none' }};
    letter-spacing: {{ blocksettings.rs_sn_ls | default: '0em' }};
    {%- case blocksettings.rs_sn_font -%}
      {%- when 'body'        -%}font-family: var(--type-font-body-family);
      {%- when 'heading'     -%}font-family: var(--type-font-header-family);
      {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
    {%- endcase -%}
    {%- if blocksettings.rs_sn_color != blank %}color: {{ blocksettings.rs_sn_color }};{%- endif %}
  }
  @media (max-width: 749px) {
    [data-rs-block="{{ block_id }}"] .rs-swatch-name {
      font-size: {{ blocksettings.rs_sn_size_m | default: 11 }}px;
    }
  }
  [data-rs-block="{{ block_id }}"] .rs-swatch-cell.rs-swatch-cell--selected .rs-swatch-name {
    opacity: 1;
    font-weight: {{ blocksettings.rs_sn_current_weight | default: '700' }};
    {%- if blocksettings.rs_sn_current_ls != blank %}letter-spacing: {{ blocksettings.rs_sn_current_ls }};{%- endif %}
    {%- if blocksettings.rs_sn_current_color != blank %}color: {{ blocksettings.rs_sn_current_color }};{%- endif %}
  }

  [data-rs-block="{{ block_id }}"] .rs-swatch {
    position: relative;
    aspect-ratio: {{ aspect_value }};
    border-radius: {{ shape_radius }};
    /* overflow:hidden removed so the .rs-swatch-badge on the
     * selected swatch can extend slightly past the corner. The
     * image inherits the swatch's border-radius below for the
     * rounded-corner clipping that overflow:hidden used to give. */
    background: #f5f5f5;
    border: {{ blocksettings.selected_border_width | default: 2 }}px solid transparent;
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  [data-rs-block="{{ block_id }}"] .rs-swatch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: inherit;
  }

  /* Checkmark badge in a black bubble on the upper-right of the
     currently-selected swatch. Slightly off the corner via negative
     top/right offsets. The white box-shadow ring helps it pop against
     dark images. */
  [data-rs-block="{{ block_id }}"] .rs-swatch-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: {{ blocksettings.rs_badge_bg | default: 'var(--thread-ink)' }};
    /* The checkmark SVG strokes with currentColor, so `color` here IS
       the checkmark color. */
    color: {{ blocksettings.rs_badge_check_color | default: '#ffffff' }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 2;
  }
  [data-rs-block="{{ block_id }}"] .rs-swatch-badge svg {
    display: block;
  }
  {%- if blocksettings.hover_scale %}
  [data-rs-block="{{ block_id }}"] .rs-swatch:hover { transform: scale(1.02); }
  {%- endif %}
  [data-rs-block="{{ block_id }}"] .rs-swatch--selected {
    border-color: {{ blocksettings.selected_border_color | default: 'var(--thread-ink)' }};
  }
  {%- assign _rs_inner_w = blocksettings.selected_inner_width | default: 1 -%}
  {%- if _rs_inner_w > 0 -%}
  /* Inner separator ring just inside the selected border — creates a
     visual gap between the border and the swatch image. Width/color
     merchant-controlled; set width to 0 to remove it. The inner
     radius tracks the outer radius minus the border width so the
     ring hugs the border at any width setting. */
  [data-rs-block="{{ block_id }}"] .rs-swatch--selected::after {
    content: '';
    position: absolute;
    inset: 0;
    border: {{ _rs_inner_w }}px solid {{ blocksettings.selected_inner_color | default: '#ffffff' }};
    border-radius: calc({{ shape_radius }} - {{ blocksettings.selected_border_width | default: 2 }}px);
    pointer-events: none;
  }
  {%- endif -%}
  [data-rs-block="{{ block_id }}"] .rs-swatch--soldout img { opacity: {{ soldout_opacity }}; }
  [data-rs-block="{{ block_id }}"] .rs-swatch--soldout::before {
    content: 'Sold Out';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--thread-ink);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--thread-ls-label);
    /* No background pill — just text on the grayed-out swatch. The
       text-shadow gives it a subtle outline so it stays readable on
       dark or busy images. white-space prevents the label from
       wrapping to two lines ("SOLD" / "OUT") on narrow swatches. */
    white-space: nowrap;
    text-shadow: 0 0 4px rgba(255, 255, 255, 0.85);
    z-index: 2;
  }
  @media (max-width: 749px) {
    [data-rs-block="{{ block_id }}"] {
      padding: {{ blocksettings.pad_top_m | default: 24 }}px 16px {{ blocksettings.pad_bot_m | default: 24 }}px;
    }
    [data-rs-block="{{ block_id }}"] .rs-heading {
      font-size: {{ blocksettings.heading_size_m | default: 14 }}px;
    }
    [data-rs-block="{{ block_id }}"] .rs-grid {
      grid-template-rows: repeat({{ _rs_rows_m }}, auto);
      grid-auto-columns: calc((100% - ({{ _rs_cols_m }} * {{ _rs_gap_col_m }}px)) / ({{ _rs_cols_m }} + {{ _rs_creep_m }} / 100));
      gap: {{ blocksettings.rs_grid_gap_row_m | default: 10 }}px {{ _rs_gap_col_m }}px;
    }
  }
</style>

{%- assign rs_no_source = false -%}
{%- if coll == empty or coll == nil -%}{%- assign rs_no_source = true -%}{%- endif -%}
{%- if rs_variant_mode -%}{%- assign rs_no_source = false -%}{%- endif -%}
{%- if rs_no_source -%}
  {%- if request.design_mode -%}
    <div class="rs-block" data-rs-block="{{ block_id }}" style="padding: 24px 16px;">
      <div style="padding:24px;border:1px dashed #ccc;border-radius:8px;text-align:center;color:#666;font-size:13px;">
        No swatches to show. {% if source_type == 'silhouette' %}This product is missing a <code>custom.swatch_collection</code> metafield.{% else %}Pick a source collection.{% endif %}
      </div>
    </div>
  {%- endif -%}
{%- else -%}

  {%- assign current_html = '' -%}
  {%- assign in_html = '' -%}
  {%- assign out_html = '' -%}
  {%- assign ord_html = '' -%}
  {%- assign group_count = 0 -%}

  {%- if rs_variant_mode -%}
  {%- assign rs_cur_variant = product.selected_or_first_available_variant -%}
  {%- for v in product.variants limit: 2000 -%}
    {%- assign p_classes = 'rs-swatch' -%}
    {%- if v.id == rs_cur_variant.id -%}{%- assign p_classes = p_classes | append: ' rs-swatch--selected' -%}{%- endif -%}
    {%- unless v.available -%}{%- assign p_classes = p_classes | append: ' rs-swatch--soldout' -%}{%- endunless -%}
    {%- assign tag = 'a' -%}
    {%- if v.available == false and blocksettings.soldout_tappable == false -%}{%- assign tag = 'div' -%}{%- endif -%}
    {%- assign p_img = v.featured_image | default: product.featured_image -%}
    {%- capture swatch_html -%}<{{ tag }} class="{{ p_classes }}"{% if tag == 'a' %} href="{{ product.url }}?variant={{ v.id }}" data-rs-vswatch data-vid="{{ v.id }}" data-vprice="{{ v.price }}" data-vcompare="{{ v.compare_at_price | default: 0 }}" data-vavail="{{ v.available }}"{% if v.featured_media %} data-vmedia="{{ v.featured_media.position | minus: 1 }}" data-vmediaid="{{ v.featured_media.id }}"{% endif %}{% if v.featured_image %} data-vimgid="{{ v.featured_image.id }}"{% endif %}{% endif %}{% if v.id == rs_cur_variant.id %} aria-current="true"{% endif %} title="{{ v.title | escape }}">{% if p_img %}<img src="{{ p_img | image_url: width: 400 }}" srcset="{{ p_img | image_url: width: 200 }} 200w, {{ p_img | image_url: width: 400 }} 400w, {{ p_img | image_url: width: 600 }} 600w" sizes="(max-width: 749px) 25vw, 15vw" alt="{{ v.title | escape }}" loading="lazy" width="400" height="400">{% endif %}{% if v.id == rs_cur_variant.id %}<span class="rs-swatch-badge" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2L4.8 8.5L9.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endif %}</{{ tag }}>{%- endcapture -%}
    {%- if v.id == rs_cur_variant.id -%}
      {%- assign current_html = current_html | append: swatch_html -%}
    {%- elsif v.available -%}
      {%- assign in_html = in_html | append: swatch_html -%}
    {%- else -%}
      {%- assign out_html = out_html | append: swatch_html -%}
    {%- endif -%}
    {%- unless v.id == rs_cur_variant.id -%}
      {%- assign ord_html = ord_html | append: swatch_html -%}
    {%- endunless -%}
    {%- assign group_count = group_count | plus: 1 -%}
  {%- endfor -%}
  {%- else -%}
  {%- for p in coll.products limit: 2000 -%}
    {%- if filter_handle != blank and filter_handles != '' -%}
      {%- assign h_marker = '|' | append: p.handle | append: '|' -%}
      {%- unless filter_handles contains h_marker -%}{%- continue -%}{%- endunless -%}
    {%- endif -%}

    {%- comment -%}
      Exclude Trifecta Bundle products from every related-styles grid.
      They share tags / colors with the individual silhouettes (so the
      collection rules pick them up) but they aren't a "style" of the
      current silhouette — they're a multi-product bundle that lives
      in its own slot. When we set up dedicated bundle collections /
      tabs in Shopify we'll revisit, but for now: skip them.

      Tag-based so we don't miss any. All current bundles have
      product_type = "Bundle" AND tag "trifecta" or "bundle". Tag is
      more flexible if the merchant later adds non-Trifecta bundle
      products that SHOULD show up (e.g., a duo bundle).
    {%- endcomment -%}
    {%- if p.type == 'Bundle' -%}{%- continue -%}{%- endif -%}
    {%- if p.tags contains 'trifecta' -%}{%- continue -%}{%- endif -%}

    {%- assign p_classes = 'rs-swatch' -%}
    {%- if p.handle == current_handle -%}{%- assign p_classes = p_classes | append: ' rs-swatch--selected' -%}{%- endif -%}
    {%- unless p.available -%}{%- assign p_classes = p_classes | append: ' rs-swatch--soldout' -%}{%- endunless -%}

    {%- assign tag = 'a' -%}
    {%- if p.available == false and blocksettings.soldout_tappable == false -%}{%- assign tag = 'div' -%}{%- endif -%}

    {%- assign p_img = p.featured_image -%}
    {%- if blocksettings.swatch_image_source == 'second' and p.images.size > 1 -%}
      {%- assign p_img = p.images[1] -%}
    {%- endif -%}

    {%- capture swatch_html -%}<{{ tag }} class="{{ p_classes }}"{% if tag == 'a' %} href="{{ p.url }}"{% endif %}{% if p.handle == current_handle %} aria-current="true"{% endif %} title="{{ p.title | escape }}">{% if p_img %}<img src="{{ p_img | image_url: width: 400 }}" srcset="{{ p_img | image_url: width: 200 }} 200w, {{ p_img | image_url: width: 400 }} 400w, {{ p_img | image_url: width: 600 }} 600w" sizes="(max-width: 749px) 25vw, 15vw" alt="{{ p.title | escape }}" loading="lazy" width="400" height="400">{% endif %}{% if p.handle == current_handle %}<span class="rs-swatch-badge" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2L4.8 8.5L9.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endif %}</{{ tag }}>{%- endcapture -%}

    {%- comment -%}
      The selected swatch lives in its own bucket so it always
      renders FIRST in the grid regardless of the natural order
      from the source collection. Per merchant request.
    {%- endcomment -%}
    {%- if p.handle == current_handle -%}
      {%- assign current_html = current_html | append: swatch_html -%}
    {%- elsif p.available -%}
      {%- assign in_html = in_html | append: swatch_html -%}
    {%- else -%}
      {%- assign out_html = out_html | append: swatch_html -%}
    {%- endif -%}
    {%- unless p.handle == current_handle -%}
      {%- assign ord_html = ord_html | append: swatch_html -%}
    {%- endunless -%}
    {%- assign group_count = group_count | plus: 1 -%}
  {%- endfor -%}
  {%- endif -%}

  {%- if blocksettings.instock_first -%}
    {%- assign all_html = current_html | append: in_html | append: out_html -%}
  {%- else -%}
    {%- assign all_html = current_html | append: ord_html -%}
  {%- endif -%}

  {%- if group_count > 0 -%}
    {%- comment -%}
      Tabbed treatment only kicks in when the merchant has the global
      "Show Related Styles sections as toggleable tabs" setting on AND
      there are 2+ related_styles blocks in the section. With one block
      there's no tab strip to switch between, so the block renders as a
      standalone widget — its own "Select Your Style" title takes over
      (the shared tabbed title only renders with multiple blocks).
    {%- endcomment -%}
    {%- assign rs_tabbed = settings.related_styles_tabbed_mode -%}
    {%- if rs_total != nil and rs_total < 2 -%}{%- assign rs_tabbed = false -%}{%- endif -%}
    {%- comment -%}
      Thin desktop-only divider above the swatch widget — sits
      between the price/review block and the "Select Your Style"
      title to mirror the merchant reference. In tabbed mode this
      per-block divider is hidden by the shared CSS and a single
      divider is injected via the shared script (so we don't get
      one divider per tabbed block).
    {%- endcomment -%}
    <hr class="pdp-section-divider hidden md:block" aria-hidden="true" />
    <div
      class="rs-block{% if rs_tabbed %} rs-block--tabbed{% endif %}"
      data-rs-block="{{ block_id }}"
      data-current-title="{{ product.title | escape }}"
      data-current-handle="{{ product.handle }}"
      {% if rs_tabbed %}data-rs-tabbed="true"{% endif %}
    >
      {%- comment -%}
        The existing rs-heading already serves as the section title
        and has its own merchant settings (heading_text plus the
        heading_size_d/heading_weight/etc. font controls higher up
        in the inline <style> block). No separate hardcoded "Select
        Style" h4 needed here — would just duplicate the merchant's
        configured heading.
      {%- endcomment -%}
      {%- comment -%}
        Widget title above everything. In tabbed mode the shared CSS
        block hides this title on all but the first tabbed block so
        it doesn't repeat above each tab's content. The text matches
        the product__options widget for visual consistency between
        the two swatch experiences.
      {%- endcomment -%}
      {%- comment -%}
        Per-block heading visibility. `== false` (not truthiness) so
        blocks saved before the checkbox existed keep showing their
        heading. When hidden, the style count moves up into the title
        row so "Select Your Style ... N styles" share one line.
      {%- endcomment -%}
      {%- assign rs_heading_visible = false -%}
      {%- if heading_text != blank -%}
        {%- unless blocksettings.rs_show_heading == false -%}
          {%- assign rs_heading_visible = true -%}
        {%- endunless -%}
      {%- endif -%}
      {%- comment -%}
        Pagination arrows — captured once, placed exactly once. With
        the heading hidden and the title shown they join the title row
        (title left, count + arrows right-justified on the SAME line);
        otherwise they keep their spot on the header row.
      {%- endcomment -%}
      {%- capture rs_arrows_html -%}
        <div class="rs-arrows">
          <button type="button" class="rs-arrow rs-arrow--prev btn btn--plain btn--small shadow-sm" aria-label="Previous styles" disabled>
            {% render 'component__icon', icon: 'arrow-left', size: '20', class: '' %}
          </button>
          <button type="button" class="rs-arrow rs-arrow--next btn btn--plain btn--small shadow-sm" aria-label="Next styles" disabled>
            {% render 'component__icon', icon: 'arrow-right', size: '20', class: '' %}
          </button>
        </div>
      {%- endcapture -%}
      {%- assign rs_arrows_in_titlerow = false -%}
      {%- if blocksettings.rs_show_title and rs_heading_visible == false -%}
        {%- assign rs_arrows_in_titlerow = true -%}
      {%- endif -%}
      {%- if blocksettings.rs_show_title -%}
        <div class="rs-titlerow">
          <h4 class="rs-title">{{ blocksettings.rs_title_text | default: 'Select Your Style' | escape }}</h4>
          {%- unless rs_heading_visible -%}
            <span class="rs-titlerow-count">{{ group_count }} {% if group_count == 1 %}style{% else %}styles{% endif %}</span>
          {%- endunless -%}
          {%- if rs_arrows_in_titlerow -%}{{ rs_arrows_html }}{%- endif -%}
        </div>
      {%- endif -%}
      {%- comment -%}
        Header row: heading on the left (hidden in tabbed mode) and
        the pagination arrows on the right. The hover/selected style
        name was removed per merchant request.

        The heading stays in the DOM even when toggled off (inline
        display:none) because the tabbed-mode script reads each tab's
        label from `.rs-heading span` and the count from `.rs-count`.
      {%- endcomment -%}
      <div class="rs-header{% unless rs_heading_visible %} rs-header--noheading{% endunless %}">
        {%- if heading_text != blank -%}
          <div class="rs-heading"{% unless rs_heading_visible %} style="display: none;"{% endunless %}>
            <span>{{ heading_text }}</span>
            <span class="rs-count">{{ group_count }} {% if group_count == 1 %}style{% else %}styles{% endif %}</span>
          </div>
        {%- endif -%}
        {%- unless rs_arrows_in_titlerow -%}{{ rs_arrows_html }}{%- endunless -%}
      </div>
      <div class="rs-grid" data-rs-grid>{{ all_html }}</div>
    </div>
  {%- endif -%}

  {%- if rs_variant_mode -%}
  <script>
    /* Variant-mode swatches swap IN PLACE (no reload): move the
       selected badge, update the Alpine variant state (price / ATC /
       express input), jump the gallery to the variant's image, and
       keep the URL in sync for share/refresh. */
    (function () {
      var root = document.querySelector('[data-rs-block="{{ block_id }}"]');
      if (!root) return;

      /* On load, pre-select the current variant so the real Add to
         Cart renders immediately — the "Choose options" state never
         shows on variant-swatch products. Alpine loads as a deferred
         module after this inline script, so retry until its scope
         exists. */
      function rsAutoSelect() {
        var pdpRoot = document.querySelector('[x-ref="formContainer"]');
        if (!pdpRoot || !window.Alpine) return false;
        var scope;
        try { scope = window.Alpine.$data(pdpRoot); } catch (_) { return false; }
        if (!scope || typeof scope.handleForm !== 'function') return false;
        if (scope.buttonDisabled) scope.handleForm(false, {{ rs_cur_variant.id }});
        return true;
      }
      if (!rsAutoSelect()) {
        document.addEventListener('alpine:initialized', function () { rsAutoSelect(); }, { once: true });
        var rsTries = 0;
        var rsTimer = setInterval(function () {
          if (rsAutoSelect() || ++rsTries > 40) clearInterval(rsTimer);
        }, 250);
      }

      var BADGE = '<span class="rs-swatch-badge" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2L4.8 8.5L9.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>';
      root.addEventListener('click', function (e) {
        var a = e.target.closest('[data-rs-vswatch]');
        if (!a || !root.contains(a)) return;
        e.preventDefault();
        /* highlight */
        root.querySelectorAll('.rs-swatch--selected').forEach(function (s) {
          s.classList.remove('rs-swatch--selected');
          s.removeAttribute('aria-current');
          var b = s.querySelector('.rs-swatch-badge');
          if (b) b.remove();
        });
        a.classList.add('rs-swatch--selected');
        a.setAttribute('aria-current', 'true');
        if (!a.querySelector('.rs-swatch-badge')) a.insertAdjacentHTML('beforeend', BADGE);
        /* Full variant selection via the theme's own handleForm — sets
           the option selections (so the real Add to Cart replaces the
           "Choose options" button), price, availability, and scrolls
           the gallery to the variant's image. Manual state pokes kept
           only as a fallback for older cached scripts. */
        var pdpRoot = document.querySelector('[x-ref="formContainer"]');
        if (pdpRoot && window.Alpine) {
          var scope;
          try { scope = window.Alpine.$data(pdpRoot); } catch (_) { scope = null; }
          if (scope) {
            var vid = parseInt(a.dataset.vid, 10);
            if (typeof scope.handleForm === 'function') {
              /* quickAdd=true: state only (options/price/CTA) — no
                 gallery side effects, no scrolling of any kind. */
              try { scope.handleForm(true, vid); } catch (_) {}
            } else {
              scope.defaultVariantId = vid;
              scope.defaultVariantPrice = parseInt(a.dataset.vprice, 10);
              scope.defaultVariantComparePrice = parseInt(a.dataset.vcompare, 10) || 0;
              scope.defaultAvailable = a.dataset.vavail !== 'false';
              scope.buttonDisabled = false;
              scope.allOptionsSelected = true;
            }
            if (a.dataset.vimgid) scope.current_variant_featured_image_id = a.dataset.vimgid;
            if (a.dataset.vmediaid) scope.current_variant_featured_media_id = a.dataset.vmediaid;
            var idx = parseInt(a.dataset.vmedia, 10);
            if (!isNaN(idx) && typeof scope.scrollToIndex === 'function') {
              /* Zero-motion swap: fade the gallery out (150ms), jump it
                 to the variant's image while invisible, fade back in.
                 No page scroll, no slider glide — nothing can fight. */
              var sliderEl = pdpRoot.querySelector('[x-ref="slider"]');
              var jump = function () {
                try {
                  scope.gallery_index_scroll = idx;
                  scope.scrollToIndex(idx, 'instant');
                } catch (_) {}
              };
              if (sliderEl) {
                sliderEl.style.transition = 'opacity 0.15s ease';
                sliderEl.style.opacity = '0';
                setTimeout(function () {
                  jump();
                  requestAnimationFrame(function () { sliderEl.style.opacity = '1'; });
                }, 160);
              } else {
                jump();
              }
            }
          }
        }
        var expressInput = document.querySelector('[data-pdp-express-variant]');
        if (expressInput) expressInput.value = a.dataset.vid;
        try { history.replaceState({}, '', a.href); } catch (_) {}
      });
    })();
  </script>
  {%- endif -%}

{%- endif -%}

{%- if settings.related_styles_tabbed_mode and rs_index == 1 -%}
  {%- comment -%}
    Tabbed mode shared assets — emitted exactly once per page (gated by
    rs_index == 1 passed from sections/product__main.liquid).

    No-FOUC strategy:
    - The `.rs-block--tabbed ~ .rs-block--tabbed` rule hides every tabbed
      sibling that follows another tabbed sibling, so on first paint
      only the first block is visible. No JS, no body class wait.
    - The `.rs-heading` inside any tabbed block is hidden from the
      start — the tab pill IS the heading.
    - Once JS builds the tab strip and assigns `.rs-tabbed-active`, the
      stronger compound-class rule takes over so the user can switch tabs
      while the first block (no longer active) gets hidden.
  {%- endcomment -%}
  <style>
    /* Per-block titles, header rows, and the heading-with-count
       block all need to stay hidden in tabbed mode — the shared
       script renders ONE title row at the top (title left, count
       right) and ONE tab strip, so every tab renders identically.
       Using !important because per-block `[data-rs-block]` rules
       above set display: flex with higher specificity than the
       single-class `.rs-block--tabbed` selector. */
    .rs-block--tabbed .rs-title    { display: none !important; }
    .rs-block--tabbed .rs-titlerow { display: none !important; }
    .rs-block--tabbed .rs-header   { display: none !important; }
    .rs-block--tabbed .rs-heading  { display: none !important; }
    .rs-block--tabbed ~ .rs-block--tabbed { display: none; }
    /* Each rs-block renders its own <hr class="pdp-section-divider">
       above its container. In tabbed mode we want only one divider
       at the top — hide every divider that comes AFTER a tabbed
       block so the layout collapses to ONE divider → title → tabs
       → grid regardless of how many tabbed blocks the merchant has. */
    .rs-block--tabbed ~ .pdp-section-divider { display: none; }
    .rs-block--tabbed.rs-tabbed-active { display: block; }
    .rs-block--tabbed.rs-tabbed-hidden { display: none; }
    /* Shared title row above the tab strip. Title text on the left,
       active-tab style count on the right, sharing the same baseline.
       Driven by the FIRST related_styles block's rs_title_* settings
       so a merchant editing the first block controls the look for all
       tabs (every tab renders identically). */
    .rs-tabbed-titlerow {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin: 0 16px 12px;
      padding: 12px 0 0;
    }
    .rs-tabbed-title {
      margin: 0;
      padding: 0;
      line-height: 1.3;
      text-align: left;
      flex: 1 1 auto;
      min-width: 0;
      font-size: {{ blocksettings.rs_title_size_d | default: 15 }}px;
      font-weight: {{ blocksettings.rs_title_weight | default: '700' }};
      text-transform: {{ blocksettings.rs_title_transform | default: 'none' }};
      letter-spacing: {{ blocksettings.rs_title_ls | default: '0em' }};
      {%- case blocksettings.rs_title_font -%}
        {%- when 'body'        -%}font-family: var(--type-font-body-family);
        {%- when 'heading'     -%}font-family: var(--type-font-header-family);
        {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
      {%- endcase -%}
      {%- if blocksettings.rs_title_color != blank %}color: {{ blocksettings.rs_title_color }};{%- endif %}
    }
    /* Tabbed-mode shared count — driven by the FIRST related_styles
       block's rs_count_* settings (same convention as the shared
       title). */
    .rs-tabbed-count {
      flex: 0 0 auto;
      font-size: {{ blocksettings.rs_count_size_d | default: 12 }}px;
      font-weight: {{ blocksettings.rs_count_weight | default: '400' }};
      color: {{ blocksettings.rs_count_color | default: 'var(--thread-grey)' }};
      letter-spacing: {{ blocksettings.rs_count_ls | default: '0em' }};
      line-height: 1.3;
      white-space: nowrap;
    }
    @media (max-width: 749px) {
      .rs-tabbed-title { font-size: {{ blocksettings.rs_title_size_m | default: 15 }}px; }
      .rs-tabbed-count { font-size: {{ blocksettings.rs_count_size_m | default: 12 }}px; }
    }

    /* One row holds tabs (left) + pagination arrows (right). The
       current/hover style name was removed — only arrows + pills
       live on this row now. */
    .rs-tabbed-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0 16px;
      padding: 0 0 {{ blocksettings.rs_tab_bar_mb | default: 8 }}px;
      min-width: 0;
    }
    .rs-tabbed-arrows {
      display: none;
      gap: 8px;
      flex: 0 0 auto;
      margin-left: auto;
    }
    @media (min-width: 750px) {
      .rs-tabbed-arrows.is-pagination { display: inline-flex; }
    }
    /* Visual styling (size, bg, border, shadow) comes from the shared
     * .btn .btn--plain .btn--small .shadow-sm classes added in JS so
     * these tabbed-mode arrows match the PDP product-gallery arrows. */
    .rs-tabbed-arrow {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .rs-tabbed-arrow:disabled { opacity: 0.4; cursor: default; }

    .rs-tabbed-tabs {
      display: flex;
      flex-wrap: nowrap;
      gap: {{ blocksettings.rs_tab_gap | default: 6 }}px;
      flex: 1 1 auto;
      min-width: 0;
      margin: 0;
      /* Padding gives the scaled active pill room to render without
         clipping its left/top/bottom edges; overflow stays X-only so
         vertical scrolling never appears even when an X scrollbar
         spawns. */
      padding: 2px 0 2px 2px;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }
    .rs-tabbed-tab {
      flex: 0 0 auto;
      border-radius: 999px;
      padding: {{ blocksettings.rs_tab_pad_v | default: 7 }}px {{ blocksettings.rs_tab_pad_h | default: 14 }}px;
      cursor: pointer;
      white-space: nowrap;
      line-height: 1.2;
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
      font-size: {{ blocksettings.rs_tab_size_d | default: 12 }}px;
      font-weight: {{ blocksettings.rs_tab_weight | default: '700' }};
      text-transform: {{ blocksettings.rs_tab_transform | default: 'none' }};
      letter-spacing: {{ blocksettings.rs_tab_ls | default: '0em' }};
      {%- case blocksettings.rs_tab_font -%}
        {%- when 'body'        -%}font-family: var(--type-font-body-family);
        {%- when 'heading'     -%}font-family: var(--type-font-header-family);
        {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
      {%- endcase -%}
      color: {{ blocksettings.rs_tab_color | default: 'inherit' }};
      background: {{ blocksettings.rs_tab_bg | default: 'rgba(0, 0, 0, 0.04)' }};
      border: {{ blocksettings.rs_tab_border_width | default: 1.5 }}px solid {{ blocksettings.rs_tab_border | default: '#c4c4c4' }};
    }
    @media (max-width: 749px) {
      .rs-tabbed-tab { font-size: {{ blocksettings.rs_tab_size_m | default: 12 }}px; }
    }
    .rs-tabbed-tab:hover { border-color: {{ blocksettings.rs_tab_active_bg | default: 'var(--background_primary_light, var(--thread-blue))' }}; }
    .rs-tabbed-tab.is-active {
      background: {{ blocksettings.rs_tab_active_bg | default: 'var(--background_primary_light, var(--thread-blue))' }};
      border-color: {{ blocksettings.rs_tab_active_bg | default: 'var(--background_primary_light, var(--thread-blue))' }};
      color: {{ blocksettings.rs_tab_active_color | default: 'var(--foreground_primary_light, #fff)' }};
      transform: scale(1.03);
    }
  </style>
  <script>
    (function(){
      function init(){
        var blocks = document.querySelectorAll('.rs-block--tabbed');
        if (blocks.length === 0) return;
        blocks = Array.prototype.slice.call(blocks);
        // Single block: nothing to toggle — leave as-is.
        if (blocks.length === 1) return;
        var tabs = document.createElement('div');
        tabs.className = 'rs-tabbed-tabs';
        tabs.setAttribute('role', 'tablist');
        var buttons = [];

        function activate(idx){
          for (var i = 0; i < blocks.length; i++) {
            var on = i === idx;
            blocks[i].classList.toggle('rs-tabbed-active', on);
            blocks[i].classList.toggle('rs-tabbed-hidden', !on);
            buttons[i].classList.toggle('is-active', on);
            buttons[i].setAttribute('aria-selected', on ? 'true' : 'false');
          }
        }

        blocks.forEach(function(b, i){
          var head = b.querySelector('.rs-heading span') || b.querySelector('.rs-heading');
          var label = (head ? head.textContent : '').trim() || ('Section ' + (i + 1));
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'rs-tabbed-tab';
          btn.setAttribute('role', 'tab');
          btn.textContent = label;
          btn.addEventListener('click', function(){ activate(i); });
          tabs.appendChild(btn);
          buttons.push(btn);
        });
        /* Layout in tabbed mode:
         *   [title]
         *   [bar: tabs (left) | arrows (right)]
         *   [active block: grid]
         * Shared arrows live in the bar so they sit beside the tab
         * row instead of below the grid. Click delegation: the
         * shared arrows trigger .click() on whichever block is
         * currently active — the per-block JS already knows how to
         * scroll its own grid. A MutationObserver mirrors the active
         * block's disabled state to the shared buttons. */
        // Title row: "Select Your Style" on the left, active-tab's
        // style count on the right. Same line for every tab — the
        // count text gets refreshed on every activate().
        var titleRow = document.createElement('div');
        titleRow.className = 'rs-tabbed-titlerow';
        /* Title visibility is driven by the first related_styles block's
         * rs_show_title checkbox — same toggle that controls the per-
         * block title in single-block mode. When off, the bar still
         * renders the tabs + arrows + style count but skips the title. */
        {%- if blocksettings.rs_show_title -%}
        var titleEl = document.createElement('h4');
        titleEl.className = 'rs-tabbed-title';
        titleEl.textContent = {{ blocksettings.rs_title_text | default: 'Select Your Style' | json }};
        titleRow.appendChild(titleEl);
        {%- endif -%}
        var countEl = document.createElement('span');
        countEl.className = 'rs-tabbed-count';
        titleRow.appendChild(countEl);

        function refreshCount(idx) {
          var b = blocks[idx];
          if (!b) { countEl.textContent = ''; return; }
          // Each block renders a hidden .rs-count inside its own
          // .rs-heading. Read straight from that so the displayed
          // number always matches the active tab's actual style total.
          var src = b.querySelector('.rs-count');
          countEl.textContent = src ? src.textContent.trim() : '';
        }

        var bar = document.createElement('div');
        bar.className = 'rs-tabbed-bar';
        bar.appendChild(tabs);

        var arrowsEl = document.createElement('div');
        arrowsEl.className = 'rs-tabbed-arrows';
        var rsArrowLeftSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left inline-block"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>';
        var rsArrowRightSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right inline-block"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>';
        var sharedPrev = document.createElement('button');
        sharedPrev.type = 'button';
        sharedPrev.className = 'rs-tabbed-arrow rs-tabbed-arrow--prev btn btn--plain btn--small shadow-sm';
        sharedPrev.setAttribute('aria-label', 'Previous styles');
        sharedPrev.innerHTML = rsArrowLeftSvg;
        var sharedNext = document.createElement('button');
        sharedNext.type = 'button';
        sharedNext.className = 'rs-tabbed-arrow rs-tabbed-arrow--next btn btn--plain btn--small shadow-sm';
        sharedNext.setAttribute('aria-label', 'Next styles');
        sharedNext.innerHTML = rsArrowRightSvg;
        arrowsEl.appendChild(sharedPrev);
        arrowsEl.appendChild(sharedNext);
        bar.appendChild(arrowsEl);

        function activeBlock(){
          return document.querySelector('.rs-block--tabbed.rs-tabbed-active') || blocks[0];
        }
        function activeBtn(dir){
          var b = activeBlock();
          return b && b.querySelector(dir === 'prev' ? '.rs-arrow--prev' : '.rs-arrow--next');
        }
        function syncSharedDisabled(){
          var p = activeBtn('prev'), n = activeBtn('next');
          sharedPrev.disabled = !p || p.disabled;
          sharedNext.disabled = !n || n.disabled;
          /* Pagination only makes sense when the active block has
           * overflow — mirror the per-block .rs-has-pagination class
           * onto the shared arrow container so it shows/hides
           * accordingly. */
          var b = activeBlock();
          arrowsEl.classList.toggle(
            'is-pagination',
            !!(b && b.classList.contains('rs-has-pagination'))
          );
        }
        sharedPrev.addEventListener('click', function(){
          var p = activeBtn('prev'); if (p && !p.disabled) p.click();
        });
        sharedNext.addEventListener('click', function(){
          var n = activeBtn('next'); if (n && !n.disabled) n.click();
        });

        var observer = null;
        function rebindObserver(){
          if (observer) { observer.disconnect(); observer = null; }
          var p = activeBtn('prev'), n = activeBtn('next');
          if (!p && !n) return;
          observer = new MutationObserver(syncSharedDisabled);
          if (p) observer.observe(p, { attributes: true, attributeFilter: ['disabled'] });
          if (n) observer.observe(n, { attributes: true, attributeFilter: ['disabled'] });
          /* The .rs-has-pagination class lives on the rs-block itself
           * (toggled by per-block updateArrows). Observe each block's
           * class attribute too so the shared arrows appear/disappear
           * as a tab is switched onto a block whose grid overflows. */
          blocks.forEach(function(b){
            observer.observe(b, { attributes: true, attributeFilter: ['class'] });
          });
          syncSharedDisabled();
        }

        /* Wrap the original activate() so each tab switch re-binds
         * the observer to the newly active block's arrows AND
         * refreshes the title-row count to that tab's total. */
        var origActivate = activate;
        activate = function(idx){
          origActivate(idx);
          rebindObserver();
          refreshCount(idx);
        };

        blocks[0].parentNode.insertBefore(titleRow, blocks[0]);
        blocks[0].parentNode.insertBefore(bar, blocks[0]);
        activate(0);
      }
      // The shared assets are emitted at the FIRST tabbed block's location
      // in the DOM, so subsequent blocks aren't parsed yet. Run init after
      // DOM ready to ensure every block is in the tree.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
