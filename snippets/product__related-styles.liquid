<script>
  (function(){
    var rootEl = document.querySelector('[data-rs-block="{{ block_id }}"]');
    if (!rootEl || rootEl.dataset.rsReady) return;
    rootEl.dataset.rsReady = '1';

    var grid = rootEl.querySelector('[data-rs-grid]');
    var prevBtn = rootEl.querySelector('.rs-arrow--prev');
    var nextBtn = rootEl.querySelector('.rs-arrow--next');
    /* The shared tabbed-mode bar inserts a .rs-tabbed-current-name
     * after DOMContentLoaded; this per-block <script> runs inline
     * BEFORE that, so we resolve the target element lazily inside
     * setColorLabel rather than caching it once at init. Falls back
     * to the per-block .rs-current-name (non-tabbed mode). */
    function getColorNameEl(){
      return document.querySelector('.rs-tabbed-current-name')
        || rootEl.querySelector('.rs-current-name');
    }
    if (!grid) return;

    var currentTitle = rootEl.getAttribute('data-current-title') || '';
    var currentHandle = rootEl.getAttribute('data-current-handle') || '';
    var canHover = !!(window.matchMedia && window.matchMedia('(hover: hover)').matches);

    /* Product titles are conventionally "<Color> - <Type>", e.g.
     * "Clark - Elastic Wallet". Only the color part is shown under a
     * swatch and in the "Color: …" header; the type is implied. */
    function shortName(s){
      if (!s) return '';
      var idx = s.indexOf(' - ');
      return idx > 0 ? s.slice(0, idx) : s;
    }
    var currentShortTitle = shortName(currentTitle);

    /* Hero preview state (lazy capture on first hover so we don't race
     * the gallery's own init). previousSrc holds pre-hover src and is
     * cleared on mouseleave so subsequent hovers re-capture whatever
     * the gallery shows then (e.g. after a variant change). */
    var heroImg = null;
    var heroPreviousSrc = null;
    var heroPreviousSrcset = null;
    var heroHoverHandle = null;
    var heroCache = {};
    var heroInFlight = {};

    /* Find a visible image in the gallery — multiple slides exist and
     * in variant-image mode all but the active one are hidden via
     * Alpine x-show, so picking the first matching <img> can silently
     * swap an off-screen one. */
    function getHeroImg(){
      if (heroImg && document.body.contains(heroImg) && heroImg.clientWidth > 0) return heroImg;
      var candidates = document.querySelectorAll('.pdp-gallery-track img, .product__media img');
      for (var i = 0; i < candidates.length; i++) {
        if (candidates[i].clientWidth > 0 && candidates[i].clientHeight > 0) {
          heroImg = candidates[i];
          return heroImg;
        }
      }
      heroImg = candidates[0] || null;
      return heroImg;
    }
    function applyHeroSrc(img, url){
      if (heroPreviousSrc === null) {
        heroPreviousSrc = img.src;
        heroPreviousSrcset = img.getAttribute('srcset');
      }
      /* Clearing srcset is required: with srcset present the browser
       * re-picks a source on layout and undoes our swap. */
      img.removeAttribute('srcset');
      img.src = url;
    }
    function setColorLabel(name){
      var el = getColorNameEl();
      if (el) el.textContent = shortName(name) || currentShortTitle;
    }
    function previewHero(handle){
      var img = getHeroImg();
      if (!img) return;
      if (heroCache[handle]) {
        applyHeroSrc(img, heroCache[handle]);
        return;
      }
      /* Route through fetchProduct so the FULL product JSON also
       * lands in productCache — when the customer hovers and then
       * clicks, the click handler's fetchProduct() finds the entry
       * cached and the swap is fully synchronous (no network wait
       * for variant id / price). */
      fetchProduct(handle).then(function(p){
        if (!p) return;
        var src = p.featured_image;
        if (src && src.indexOf('//') === 0) src = 'https:' + src;
        if (!src) return;
        heroCache[handle] = src;
        if (heroHoverHandle === handle) applyHeroSrc(img, src);
      });
    }
    function revertHero(){
      var img = getHeroImg();
      if (img && heroPreviousSrc !== null) {
        img.src = heroPreviousSrc;
        if (heroPreviousSrcset !== null) img.setAttribute('srcset', heroPreviousSrcset);
      }
      heroPreviousSrc = null;
      heroPreviousSrcset = null;
      heroHoverHandle = null;
    }

    /* ---------- In-place product swap on swatch click ----------
     * Each color/pattern is its own Shopify product (SKU-per-product
     * model). Clicking a swatch normally follows <a href> and full-
     * reloads the PDP. This block intercepts that click and swaps the
     * active product in place: gallery image + title + price + ATC
     * variant id + URL all update, no navigation. Description /
     * accordions / review widget remain on the original product
     * (server-rendered) — acceptable for sibling swaps within the
     * same silhouette. The merchant accepts this trade-off for now;
     * the proper fix is the planned variant-restructure on the
     * Shopify side. */

    var productCache = {};
    var productInFlight = {};

    function fetchProduct(handle) {
      if (productCache[handle]) return Promise.resolve(productCache[handle]);
      if (productInFlight[handle]) return productInFlight[handle];
      var promise = fetch('/products/' + encodeURIComponent(handle) + '.js', { credentials: 'same-origin' })
        .then(function(r){ return r.ok ? r.json() : null; })
        .then(function(p){
          if (p) productCache[handle] = p;
          productInFlight[handle] = null;
          return p;
        })
        .catch(function(){
          productInFlight[handle] = null;
          return null;
        });
      productInFlight[handle] = promise;
      return promise;
    }

    function abs(src){
      if (!src) return '';
      return src.indexOf('//') === 0 ? 'https:' + src : src;
    }

    /* Collapse the PDP gallery to a single slide with the new product's
     * featured image. Side effects: remove sibling slides (they belong
     * to the old product), clear srcset on the remaining img so the
     * browser doesn't re-pick from the old resolutions, hide the
     * pagination dots, and hide the desktop thumbnail strip — all the
     * old product's media is no longer relevant after the swap. */
    function swapGalleryToSingleImage(imgUrl) {
      var src = abs(imgUrl);
      if (!src) return;
      var track = document.querySelector('.pdp-gallery-track');
      if (!track) return;
      var slides = track.querySelectorAll(':scope > div');
      for (var i = 1; i < slides.length; i++) slides[i].remove();
      var img = track.querySelector('img');
      if (img) {
        img.removeAttribute('srcset');
        img.src = src;
      }
      var dots = document.querySelector('.pdp-gallery-dots');
      if (dots) dots.style.display = 'none';
      var thumbCol = document.querySelector('.pdp-thumb-col');
      if (thumbCol) thumbCol.style.display = 'none';
    }

    /* Rebuild the FULL gallery for a swapped product: all slides, the
     * desktop thumbnail column, and the mobile dots — so the customer
     * can browse every photo of the style they picked (previously the
     * swap collapsed the gallery to a single image and hid the
     * thumbnails/dots entirely).
     *
     * The Liquid-rendered slides carry Alpine bindings with hardcoded
     * indices (x-intersect, @click) that can't survive DOM
     * replacement, so the rebuilt gallery drives the SAME Alpine scope
     * (gallery_index / scrollToIndex / show_arrows) through plain
     * listeners + one IntersectionObserver. Zoom-on-click is not
     * re-wired for swapped galleries — the fullscreen viewer's markup
     * is server-rendered for the original product only. */
    function rebuildGallery(p) {
      var images = (p && p.images) || [];
      if (images.length < 2) {
        if (p && p.featured_image) swapGalleryToSingleImage(p.featured_image);
        return;
      }
      var track = document.querySelector('.pdp-gallery-track');
      if (!track) return;
      var scope = null;
      try { scope = window.Alpine ? window.Alpine.$data(track) : null; } catch (_) {}

      function sized(url, w) {
        var u = abs(url);
        return u + (u.indexOf('?') === -1 ? '?' : '&') + 'width=' + w;
      }

      /* Clone the structural classes off the server-rendered markup so
       * the rebuilt gallery inherits the theme's borders/radius/snap
       * styling — minus zoom affordance (see comment above). */
      var firstSlide = track.querySelector(':scope > div');
      var slideClass = (firstSlide ? firstSlide.className : 'relative snap-center flex-none border--width border--radius overflow-hidden w-full')
        .replace('cursor-zoom-in', '').trim();
      var firstImg = firstSlide ? firstSlide.querySelector('img') : null;
      var imgClass = firstImg ? firstImg.className : 'w-full h-full object-cover';

      while (track.firstChild) track.removeChild(track.firstChild);
      images.forEach(function (url, idx) {
        var slide = document.createElement('div');
        slide.className = slideClass;
        slide.setAttribute('data-slide', idx);
        var img = document.createElement('img');
        img.className = imgClass;
        img.style.objectFit = 'cover';
        img.src = sized(url, 1100);
        img.srcset = sized(url, 600) + ' 600w, ' + sized(url, 900) + ' 900w, ' + sized(url, 1400) + ' 1400w';
        img.sizes = '(min-width: 768px) 45vw, 100vw';
        img.loading = idx === 0 ? 'eager' : 'lazy';
        img.decoding = 'async';
        img.alt = (p.title || '') + ' — image ' + (idx + 1);
        slide.appendChild(img);
        track.appendChild(slide);
      });

      var dots = document.querySelector('.pdp-gallery-dots');
      if (dots) {
        while (dots.firstChild) dots.removeChild(dots.firstChild);
        images.forEach(function (_u, idx) {
          var b = document.createElement('button');
          b.setAttribute('aria-label', 'gallery_button_' + idx);
          b.className = 'pdp-gallery-dot color__bg-text animation-100 rounded-full w-2 h-2 opacity-25';
          b.addEventListener('click', function () {
            if (scope && typeof scope.scrollToIndex === 'function') {
              scope.gallery_index_scroll = idx;
              scope.scrollToIndex(idx);
            }
          });
          dots.appendChild(b);
        });
        dots.style.display = '';
      }

      var thumbCol = document.querySelector('.pdp-thumb-col');
      if (thumbCol) {
        var firstThumbImg = thumbCol.querySelector('img');
        var thumbImgClass = firstThumbImg ? firstThumbImg.className : 'w-full h-full object-cover !bg-transparent';
        while (thumbCol.firstChild) thumbCol.removeChild(thumbCol.firstChild);
        images.forEach(function (url, idx) {
          var t = document.createElement('div');
          t.className = 'pdp-thumb relative snap-center flex-none hover:cursor-pointer w-full border--width border--radius overflow-hidden animation-300';
          t.setAttribute('data-slide', idx);
          t.tabIndex = 0;
          var wrap = document.createElement('div');
          wrap.className = 'overflow-hidden object-cover aspect-[1/1] aspect-w-1 aspect-h-1 w-full';
          var img = document.createElement('img');
          img.className = thumbImgClass;
          img.style.objectFit = 'cover';
          img.src = sized(url, 192);
          img.loading = 'lazy';
          img.decoding = 'async';
          img.alt = '';
          wrap.appendChild(img);
          t.appendChild(wrap);
          var go = function (behavior) {
            if (scope && typeof scope.scrollToIndex === 'function') {
              scope.gallery_index_scroll = idx;
              scope.scrollToIndex(idx, behavior);
            }
          };
          t.addEventListener('click', function () { go(); });
          t.addEventListener('mouseenter', function () { go('instant'); });
          t.addEventListener('focus', function () { go('instant'); });
          thumbCol.appendChild(t);
        });
        thumbCol.style.display = '';
      }

      /* Active-state sync — replaces the per-slide x-intersect bindings. */
      function setActive(idx) {
        if (scope) scope.gallery_index = idx;
        if (dots) Array.prototype.forEach.call(dots.children, function (d, i) {
          d.classList.toggle('pdp-gallery-dot--active', i === idx);
          d.classList.toggle('!opacity-100', i === idx);
        });
        if (thumbCol) Array.prototype.forEach.call(thumbCol.children, function (t, i) {
          t.classList.toggle('pdp-thumb--active', i === idx);
          t.classList.toggle('color__border-selected-1', i === idx);
        });
      }
      if (window.__rsGalleryObserver) { try { window.__rsGalleryObserver.disconnect(); } catch (_) {} }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            /* Loop clones carry no data-slide — ignore them so the
             * active dot/thumb never snaps to 0 mid-wrap. */
            if (en.isIntersecting && en.target.hasAttribute('data-slide')) {
              setActive(parseInt(en.target.getAttribute('data-slide'), 10) || 0);
            }
          });
        }, { root: track, threshold: 0.5 });
        Array.prototype.forEach.call(track.querySelectorAll(':scope > [data-slide]'), function (s) { io.observe(s); });
        window.__rsGalleryObserver = io;
      }

      track.scrollLeft = 0;
      setActive(0);
      if (scope) {
        scope.gallery_index = 0;
        scope.gallery_index_scroll = 0;
        /* Desktop arrows (CSS hides them on mobile). */
        scope.show_arrows = true;
      }

    }

    /* Extract the first color_<x> tag from a product JSON's tags so
     * the bundle's color-match logic can re-rank the OTHER slots
     * around the new active product. */
    function extractColorTag(p) {
      if (!p) return '';
      var tags = p.tags;
      if (typeof tags === 'string') tags = tags.split(',');
      if (!Array.isArray(tags)) return '';
      for (var t = 0; t < tags.length; t++) {
        var tag = String(tags[t]).trim().toLowerCase();
        if (tag.indexOf('color_') === 0) return tag.slice(6);
      }
      return '';
    }

    /* Push the new product into the trifecta bundle widget's locked
     * slot so the bundle's "current" card + ATC variant id follow the
     * swap. Also re-rank the OTHER slots: the bundle's pickBestDefault
     * uses currentColorTag to color-match across slots, so updating
     * that var + re-running pickBestDefault for every slot makes the
     * lanyard + chapstick auto-flip to the matching colour. Bails
     * silently if no bundle widget on the page. */
    function notifyBundleOfNewProduct(p) {
      var bundleRoot = document.querySelector('.bundle-pdp-preview[x-data]');
      if (!bundleRoot || !window.Alpine) return;
      var scope;
      try { scope = window.Alpine.$data(bundleRoot); } catch (_) { return; }
      if (!scope || !Array.isArray(scope.slots)) return;

      scope.bundlePdpHandle = p.handle;
      scope.currentColorTag = extractColorTag(p);

      /* Make sure the new product is present in the current slot's
       * products array — the bundle's pickBestDefault for the current
       * slot looks up by handle. If the swatch we just clicked is past
       * the server-rendered 50-product limit (collection.products is
       * capped), the AJAX paging may not have reached it yet; in that
       * case synthesize a minimal entry and prepend it. */
      var bundleSlotIdx = -1;
      for (var i = 0; i < scope.slots.length; i++) {
        if (scope.slots[i].label === scope.bundleSlot) { bundleSlotIdx = i; break; }
      }
      if (bundleSlotIdx >= 0) {
        var slot = scope.slots[bundleSlotIdx];
        var v = p.variants && p.variants[0] ? p.variants[0] : null;
        var has = (slot.products || []).some(function(sp){ return sp.handle === p.handle; });
        if (!has && v) {
          slot.products.unshift({
            handle: p.handle,
            title: p.title,
            url: '/products/' + p.handle,
            image: abs(p.featured_image),
            variantId: v.id,
            price: v.price,
            available: v.available !== false,
            colorTag: scope.currentColorTag,
            type: p.type || ''
          });
        }
      }

      /* Re-evaluate the default selection for every slot. The current
       * slot pins to bundlePdpHandle (so it follows our swap); the
       * other slots re-rank by colour against the new currentColorTag,
       * picking e.g. the matching-pattern lanyard. */
      if (typeof scope.pickBestDefault === 'function') {
        for (var s = 0; s < scope.slots.length; s++) {
          scope.pickBestDefault(s);
        }
      }
    }

    /* Update the Alpine state in script_product.liquid so the price
     * spans (x-text bindings) and ATC button (reads defaultVariantId
     * at click time) follow the swap. */
    function updateActiveVariantState(p) {
      var v = p.variants && p.variants[0] ? p.variants[0] : null;
      if (!v) return;
      var pdpRoot = document.querySelector('[x-ref="formContainer"]');
      if (!pdpRoot || !window.Alpine) return;
      var scope;
      try { scope = window.Alpine.$data(pdpRoot); } catch (_) { return; }
      if (!scope) return;
      scope.defaultVariantId = v.id;
      scope.defaultVariantPrice = v.price;
      scope.defaultVariantComparePrice = v.compare_at_price || 0;
      scope.defaultAvailable = v.available !== false;
      /* Keep the express-checkout (Buy It Now) hidden input in sync —
       * the Liquid product form can't know about client-side swaps. */
      var expressInput = document.querySelector('[data-pdp-express-variant]');
      if (expressInput) expressInput.value = v.id;
    }

    /* Toggle the .rs-swatch--selected anchor class + black-circle
     * checkmark badge on/off for a cell. The badge markup matches
     * the server-rendered version in the swatch_html capture above. */
    function setSelectedBadge(cell, isSelected) {
      if (!cell) return;
      var anchor = cell.querySelector('.rs-swatch');
      if (!anchor) return;
      if (isSelected) {
        anchor.classList.add('rs-swatch--selected');
        if (!anchor.querySelector('.rs-swatch-badge')) {
          var badge = document.createElement('span');
          badge.className = 'rs-swatch-badge';
          badge.setAttribute('aria-hidden', 'true');
          badge.innerHTML =
            '<svg width="10" height="10" viewBox="0 0 12 12" fill="none">' +
              '<path d="M2.5 6.2L4.8 8.5L9.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>' +
            '</svg>';
          anchor.appendChild(badge);
        }
      } else {
        anchor.classList.remove('rs-swatch--selected');
        var b = anchor.querySelector('.rs-swatch-badge');
        if (b) b.remove();
      }
    }

    /* (Previously had a moveSwatchCellToFront helper that promoted
     * the just-clicked swatch to position 0 of the grid. Removed per
     * merchant request — keeping the swatches in place avoids the
     * grid shuffling on every click.) */


    function swapActiveProduct(newHandle, cell, swatchAnchor) {
      /* ===== Instant visual updates (no fetch wait) =====
       * Run synchronously so the customer sees the click "land" on
       * the new swatch immediately, even on the first interaction
       * with that swatch (when fetchProduct hasn't been primed by
       * a prior hover). The Alpine variant state still needs the
       * JSON fetch — that update happens below in .then(). */

      /* 1. Move the highlight + black-circle checkmark badge */
      document.querySelectorAll('.rs-swatch-cell--selected').forEach(function(c){
        c.classList.remove('rs-swatch-cell--selected');
        setSelectedBadge(c, false);
      });
      if (cell) {
        cell.classList.add('rs-swatch-cell--selected');
        setSelectedBadge(cell, true);
      }

      /* 2. Swap hero image right away. Use the cached high-res URL
       * if we have it; otherwise use the swatch's own <img> src as
       * a placeholder. The 400px swatch image gets stretched in the
       * hero for ~100ms until the JSON fetch returns the full-res
       * featured_image — still feels far snappier than waiting for
       * the fetch before showing anything. */
      var heroUrl = heroCache[newHandle];
      if (!heroUrl && swatchAnchor) {
        var swImg = swatchAnchor.querySelector('img');
        heroUrl = swImg ? (swImg.currentSrc || swImg.src) : '';
      }
      if (heroUrl) swapGalleryToSingleImage(heroUrl);

      /* The hover-revert machinery's "previous src" pointer is now
       * stale (we'll never want to revert to the original PDP image
       * after a permanent swap). Reset so future hovers re-capture
       * the new baseline. */
      heroPreviousSrc = null;
      heroPreviousSrcset = null;
      heroHoverHandle = null;

      /* 3. Title from the swatch's title attribute (instant). */
      var swTitle = swatchAnchor ? (swatchAnchor.getAttribute('title') || '') : '';
      if (swTitle) {
        var titleEl = document.querySelector('.pdp-title');
        if (titleEl) titleEl.textContent = swTitle;
        currentTitle = swTitle;
        currentShortTitle = shortName(swTitle);
      }

      /* 4. URL bar — replaceState (not pushState) so back leaves the
       * PDP entirely. Reload at the new URL renders fresh. */
      if (window.history && history.replaceState) {
        try { history.replaceState({}, '', '/products/' + newHandle); } catch (_) {}
      }

      currentHandle = newHandle;
      rootEl.setAttribute('data-current-handle', newHandle);

      /* ===== Async: pull full product JSON for variant id + price
       * + bundle widget. The ATC button reads scope.defaultVariantId
       * at click time, so as long as we update this before the
       * customer taps ATC (typically a beat later), the right
       * variant ships to /cart/add.js. */
      fetchProduct(newHandle).then(function(p){
        if (!p) return;

        updateActiveVariantState(p);
        notifyBundleOfNewProduct(p);

        /* Cache the full-res hero for future hover-previews, then
         * rebuild the WHOLE gallery (all slides + thumbnails + dots)
         * from the swapped product's image set — the instant
         * single-image swap above was just the placeholder while this
         * fetch was in flight. */
        var fullSrc = p.featured_image;
        if (fullSrc && fullSrc.indexOf('//') === 0) fullSrc = 'https:' + fullSrc;
        if (fullSrc) heroCache[newHandle] = fullSrc;
        rebuildGallery(p);

        /* Re-apply title in case the JSON title differs from the
         * swatch's title attribute (rare but possible). */
        if (p.title) {
          var t2 = document.querySelector('.pdp-title');
          if (t2) t2.textContent = p.title;
          currentTitle = p.title;
          currentShortTitle = shortName(p.title);
        }
      });
    }

    Array.prototype.forEach.call(grid.querySelectorAll(':scope > .rs-swatch'), function(sw){
      var title = sw.getAttribute('title') || '';
      var href = sw.getAttribute('href') || '';
      var match = href.match(/\/products\/([^?#\/]+)/);
      var handle = match ? decodeURIComponent(match[1]) : '';

      var cell = document.createElement('div');
      cell.className = 'rs-swatch-cell';
      if (handle && handle === currentHandle) cell.classList.add('rs-swatch-cell--selected');
      sw.parentNode.insertBefore(cell, sw);
      cell.appendChild(sw);
      var label = document.createElement('span');
      label.className = 'rs-swatch-name';
      label.textContent = shortName(title);
      cell.appendChild(label);

      cell.addEventListener('mouseenter', function(){
        setColorLabel(title);
        if (canHover && handle) {
          heroHoverHandle = handle;
          previewHero(handle);
        }
      });
      /* No mouseleave on individual cells — reverting per-cell flashes
       * the original image as the cursor crosses gaps between swatches.
       * The block-level mouseleave below handles revert when the cursor
       * leaves the whole widget. */

      /* Intercept the swatch click: instead of navigating to the
       * other product's PDP (full reload), swap the active product
       * in place. Modifier keys / non-primary buttons fall through
       * to the browser default so cmd-click / middle-click still
       * open the sibling in a new tab. */
      if (sw.tagName === 'A') {
        sw.addEventListener('click', function(e){
          if (e.defaultPrevented) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (typeof e.button === 'number' && e.button !== 0) return;
          if (!handle || handle === currentHandle) {
            e.preventDefault();
            return;
          }
          e.preventDefault();
          /* The hover-preview already updated the hero — no need to
           * revert before swap; the swap call writes the new image
           * over whatever's showing. Skipping revertHero() here
           * shaves off one DOM mutation + transition flash. */
          swapActiveProduct(handle, cell, sw);
        });
      }
    });

    rootEl.addEventListener('mouseleave', function(){
      setColorLabel(currentTitle);
      if (canHover) revertHero();
    });

    function updateArrows(){
      var max = grid.scrollWidth - grid.clientWidth;
      var hasOverflow = max > 1;
      rootEl.classList.toggle('rs-has-pagination', hasOverflow);
      if (!prevBtn || !nextBtn) return;
      if (!hasOverflow) {
        prevBtn.disabled = true;
        nextBtn.disabled = true;
        return;
      }
      prevBtn.disabled = grid.scrollLeft <= 1;
      nextBtn.disabled = grid.scrollLeft >= max - 1;
    }
    function pageBy(dir){
      var step = Math.max(grid.clientWidth * 0.9, 120);
      grid.scrollBy({ left: dir * step, behavior: 'smooth' });
    }
    if (prevBtn) prevBtn.addEventListener('click', function(){ pageBy(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function(){ pageBy(1); });
    grid.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    /* In tabbed mode the block starts display:none; ResizeObserver
     * re-evaluates arrows when the grid becomes visible after a tab
     * switch (clientWidth changes from 0 → real width). */
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(updateArrows).observe(grid);
    }
    requestAnimationFrame(updateArrows);
  })();
</script>
