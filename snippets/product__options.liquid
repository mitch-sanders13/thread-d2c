<!-- snippets/product__options.liquid -->
{% comment %}
  Add to cart block for product sections. Includes quantity selector, variant picker, subscription options and addtional content.

  Accepts:
    - blocksettings: liquid object of block settings
    - featured: boolean to assign product object from section settings, set this to true if block is used within a section rather than product template

  Usage:
    {% render 'product__options',
      blocksettings: block.settings,
      featured: true %}

  Globals:
    - settings.product_variant_selection: set variants style to dropdown or buttons
    - settings.product_color_selection: set color option picker style to dropdown, buttons or swatches
    - settings.type_seperator: setting to pick the type of seperator between text

  Possible enhancements:
    - Include nesting container within snippet.
{% endcomment %}

{% if featured %}
  {%- assign product = section.settings.product -%}
{% endif %}

{% if settings.enable_unavailable_options %}
  {%- liquid
    assign variants_available_arr = product.variants | map: 'available'
    assign variants_option1_arr = product.variants | map: 'option1'
    assign variants_option2_arr = product.variants | map: 'option2'
    assign variants_option3_arr = product.variants | map: 'option3'
  -%}
{% endif %}

{% if product.tags contains 'sale' %}
  <div class="hidden">
    <label
      for="custom-sale"
      class="flex mb-2 opacity-75 type--smaller"
    >
    </label>
    <input
      id="custom-sale"
      type="text"
      name="properties[SALE]"
      class="custom-input_{{ product.handle }}"
      @keyup.debounce="checkLineItems('{{ product.handle }}')"
      value="ALL SALES ARE FINAL ON ITEM"
    >
  </div>
{% endif %}

{% comment %} Swatches {% endcomment %}

{% comment %} Check if this is a collegiate product {% endcomment %}
{% assign is_collegiate = false %}
{% for tag in product.tags %}
  {% assign tag_lowercase = tag | downcase | strip %}
  {% if tag_lowercase == 'collegiate' %}
    {% assign is_collegiate = true %}
    {% break %}
  {% endif %}
{% endfor %}

{% comment %} All products now use unified JavaScript-based swatch loading {% endcomment %}
{% if product.metafields.custom.swatch_collection %}
  {%- comment -%}
    PDP swatch list. The bundled main-*.js renders one <div> per group
    (each containing a <p> heading + a row of <a> swatch anchors) into
    the .js:pdp-swatches container. The inline script below decorates
    that output with:
      - Filter pills built from group headings (always visible at top).
      - A "Color: <style>" header that updates live on swatch hover.
      - Per-swatch cells with a style-name label rendered below each
        swatch image.
      - A 3-column grid with horizontal pagination arrows; the visible
        page is sized to ~3.3 columns so the 4th column peeks in,
        giving the customer a swipe affordance.
      - Desktop-only hover-swap on the PDP gallery hero image: hovering
        a swatch previews that color's product image; mouseleave reverts.
    Bundled JS is untouched — all enhancements are post-render DOM
    decorations.
  {%- endcomment -%}
    {%- comment -%}
      Thin section divider — desktop only — that separates the
      title/price/review block above from the swatch picker below.
      Lives inside the px-4 wrapper so it respects the same 16px
      side margin as the rest of the PDP content.
    {%- endcomment -%}
    <hr class="pdp-section-divider hidden md:block" aria-hidden="true" />

    {%- comment -%}
      Per-instance style block for the merchant-controlled "Select
      Style" title. Settings live on the options block in product__
      main.liquid. Scoped via .pdp-swatches-tabbed so it doesn't
      bleed into the related-styles widget's own title.
    {%- endcomment -%}
    {%- assign st_title_text = blocksettings.swatch_title_text | default: 'Select Your Style' -%}
    <style>
      .pdp-swatches-tabbed .pdp-swatches-title {
        text-align: left;
        {% if blocksettings.swatch_title_size_d %}font-size: {{ blocksettings.swatch_title_size_d }}px;{% endif %}
        {% if blocksettings.swatch_title_weight != blank %}font-weight: {{ blocksettings.swatch_title_weight }};{% endif %}
        {% if blocksettings.swatch_title_case != blank %}text-transform: {{ blocksettings.swatch_title_case }};{% endif %}
        {% if blocksettings.swatch_title_ls != blank %}letter-spacing: {{ blocksettings.swatch_title_ls }};{% endif %}
        {% if blocksettings.swatch_title_color != blank %}color: {{ blocksettings.swatch_title_color }};{% endif %}
      }
      @media (max-width: 749px) {
        .pdp-swatches-tabbed .pdp-swatches-title {
          {% if blocksettings.swatch_title_size_m %}font-size: {{ blocksettings.swatch_title_size_m }}px;{% endif %}
        }
      }
    </style>
    <div class="px-4 flex pdp-swatches-tabbed"
         data-current-title="{{ product.title | escape }}"
         data-current-handle="{{ product.handle }}">
      <div class="w-full">
        <h4 class="pdp-swatches-title">{{ st_title_text | escape }}</h4>
        {%- comment -%}
          Tabs row + current/hover style name share one flex line so
          the name sits in the top-right above the swatch grid (per
          the merchant reference). Tabs take the remaining width and
          stay horizontally scrollable when there are many groups.
        {%- endcomment -%}
        <div class="pdp-swatches-header">
          <div class="pdp-swatches-tabs" role="tablist" aria-label="Swatch groups">
            {%- comment -%} Populated by the inline script after the bundled JS renders. {%- endcomment -%}
          </div>
          <p class="pdp-swatches-current-name" x-cloak>{{ product.title | split: ' - ' | first }}</p>
        </div>
        {% if is_collegiate %}
          <div
            class="js:pdp-collegiate-swatches pdp-swatches-stage w-full"
            data-product-type="{{ product.type }}"
            data-product-handle="{{ product.handle }}"
          >
        {% else %}
          <div
            class="js:pdp-swatches pdp-swatches-stage w-full"
            data-product-type="{{ product.type }}"
            data-product-handle="{{ product.handle }}"
          >
        {% endif %}
          {% comment %} Placeholder swatches {% endcomment %}
          <div class="inline-flex flex-wrap gap-4 w-full">
            {% for i in (1..6) %}
              <span
                class="animate-pulse btn btn--plain btn--small bg-center !w-8 !h-8 !min-w-[2rem] !min-h-[2rem] bg-gray-200 !rounded-full !p-0"
              ></span>
            {% endfor %}
          </div>
        </div>
        {%- comment -%}
          Footer now only holds the desktop pagination arrows (right-
          aligned). The current/hover name moved to the header row
          beside the tabs so the grid has full width below.
        {%- endcomment -%}
        <div class="pdp-swatches-footer">
          <div class="pdp-swatches-arrows">
            <button
              type="button"
              class="pdp-swatches-arrow pdp-swatches-arrow--prev btn btn--plain btn--small shadow-sm"
              aria-label="Previous styles"
              disabled
            >
              {% render 'component__icon', icon: 'arrow-left', size: '20', class: '' %}
            </button>
            <button
              type="button"
              class="pdp-swatches-arrow pdp-swatches-arrow--next btn btn--plain btn--small shadow-sm"
              aria-label="Next styles"
              disabled
            >
              {% render 'component__icon', icon: 'arrow-right', size: '20', class: '' %}
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      (function(){
        function init(wrap){
          var swatchEl = wrap.querySelector('.js\\:pdp-swatches, .js\\:pdp-collegiate-swatches');
          var tabsEl = wrap.querySelector('.pdp-swatches-tabs');
          var colorNameEl = wrap.querySelector('.pdp-swatches-current-name');
          var prevBtn = wrap.querySelector('.pdp-swatches-arrow--prev');
          var nextBtn = wrap.querySelector('.pdp-swatches-arrow--next');
          if (!swatchEl || !tabsEl) return;

          var currentTitle = wrap.getAttribute('data-current-title') || '';
          var currentHandle = wrap.getAttribute('data-current-handle') || '';
          var canHover = !!(window.matchMedia && window.matchMedia('(hover: hover)').matches);

          /* Hover-preview state for the PDP gallery hero. The hero <img>
           * is captured lazily on the first hover so we don't race the
           * gallery's own init. previousSrc holds the pre-hover src and
           * is cleared on mouseleave so subsequent hovers re-capture
           * whatever the gallery shows at that moment (e.g. after a
           * variant change). */
          var heroImg = null;
          var heroPreviousSrc = null;
          var heroPreviousSrcset = null;
          var heroHoverHandle = null;
          var heroImageCache = {};
          var heroFetchInFlight = {};

          /* Find a *visible* image in the gallery. The theme has
           * multiple media slides; in variant-image mode all but the
           * active slide are hidden via Alpine x-show. Walking through
           * candidates and picking the one with non-zero size avoids
           * swapping the src of an invisible img. */
          function getHeroImg(){
            if (heroImg && document.body.contains(heroImg) && heroImg.clientWidth > 0) return heroImg;
            var candidates = document.querySelectorAll('.pdp-gallery-track img, .product__media img');
            for (var i = 0; i < candidates.length; i++) {
              if (candidates[i].clientWidth > 0 && candidates[i].clientHeight > 0) {
                heroImg = candidates[i];
                return heroImg;
              }
            }
            heroImg = candidates[0] || null;
            return heroImg;
          }

          function applyHeroSrc(img, url){
            if (heroPreviousSrc === null) {
              heroPreviousSrc = img.src;
              heroPreviousSrcset = img.getAttribute('srcset');
            }
            /* Clearing srcset is required: with srcset present the
             * browser re-picks a source on layout and undoes our swap. */
            img.removeAttribute('srcset');
            img.src = url;
          }

          function slugify(s){ return (s || '').toLowerCase().trim().replace(/\s+/g, '-'); }

          /* Product titles are conventionally "<Color> - <Type>", e.g.
           * "Clark - Elastic Wallet". Only the color part is shown
           * under a swatch and in the "Color: …" header; the type is
           * implied by the widget context. */
          function shortName(s){
            if (!s) return '';
            var idx = s.indexOf(' - ');
            return idx > 0 ? s.slice(0, idx) : s;
          }
          var currentShortTitle = shortName(currentTitle);

          function setColorLabel(name){
            if (colorNameEl) colorNameEl.textContent = shortName(name) || currentShortTitle;
          }

          function previewHero(handle){
            var img = getHeroImg();
            if (!img) return;
            if (heroImageCache[handle]) {
              applyHeroSrc(img, heroImageCache[handle]);
              return;
            }
            if (heroFetchInFlight[handle]) return;
            heroFetchInFlight[handle] = true;
            fetch('/products/' + encodeURIComponent(handle) + '.js', { credentials: 'same-origin' })
              .then(function(r){ return r.ok ? r.json() : null; })
              .then(function(p){
                if (!p) return;
                var src = p.featured_image;
                if (src && src.indexOf('//') === 0) src = 'https:' + src;
                if (!src) return;
                heroImageCache[handle] = src;
                if (heroHoverHandle === handle) applyHeroSrc(img, src);
              })
              .catch(function(){})
              .finally(function(){ heroFetchInFlight[handle] = false; });
          }

          function revertHero(){
            var img = getHeroImg();
            if (img && heroPreviousSrc !== null) {
              img.src = heroPreviousSrc;
              if (heroPreviousSrcset !== null) img.setAttribute('srcset', heroPreviousSrcset);
            }
            heroPreviousSrc = null;
            heroPreviousSrcset = null;
            heroHoverHandle = null;
          }

          function wireCell(anchor){
            if (anchor.parentNode && anchor.parentNode.classList.contains('pdp-swatch-cell')) return;
            var href = anchor.getAttribute('href') || '';
            var title = anchor.getAttribute('title') || '';
            var match = href.match(/\/products\/([^?#\/]+)/);
            var handle = match ? decodeURIComponent(match[1]) : '';

            var cell = document.createElement('div');
            cell.className = 'pdp-swatch-cell';
            if (handle && handle === currentHandle) cell.classList.add('is-current');
            anchor.parentNode.insertBefore(cell, anchor);
            cell.appendChild(anchor);
            var label = document.createElement('span');
            label.className = 'pdp-swatch-name';
            label.textContent = shortName(title);
            cell.appendChild(label);

            cell.addEventListener('mouseenter', function(){
              setColorLabel(title);
              if (canHover && handle) {
                heroHoverHandle = handle;
                previewHero(handle);
              }
            });
            /* No mouseleave on individual cells — reverting per-cell
             * flashes the original image as the cursor crosses gaps
             * between swatches. The container-level mouseleave below
             * handles revert when the cursor leaves the whole widget. */
          }

          function activeGrid(){
            var active = swatchEl.querySelector(':scope > [data-swatch-group].is-active');
            return active ? active.querySelector('.pdp-swatches-grid') : null;
          }

          function updateArrows(){
            var grid = activeGrid();
            if (!grid) {
              if (prevBtn) prevBtn.disabled = true;
              if (nextBtn) nextBtn.disabled = true;
              return;
            }
            var max = grid.scrollWidth - grid.clientWidth;
            var hasOverflow = max > 1;
            wrap.classList.toggle('has-pagination', hasOverflow);
            if (!hasOverflow) {
              if (prevBtn) prevBtn.disabled = true;
              if (nextBtn) nextBtn.disabled = true;
              return;
            }
            if (prevBtn) prevBtn.disabled = grid.scrollLeft <= 1;
            if (nextBtn) nextBtn.disabled = grid.scrollLeft >= max - 1;
          }

          function pageGrid(dir){
            var grid = activeGrid();
            if (!grid) return;
            /* Page by ~3 columns (one full visible page minus the peek). */
            var step = Math.max(grid.clientWidth * 0.9, 120);
            grid.scrollBy({ left: dir * step, behavior: 'smooth' });
          }

          if (prevBtn) prevBtn.addEventListener('click', function(){ pageGrid(-1); });
          if (nextBtn) nextBtn.addEventListener('click', function(){ pageGrid(1); });

          function activate(slug){
            swatchEl.querySelectorAll(':scope > [data-swatch-group]').forEach(function(g){
              var on = g.getAttribute('data-swatch-group') === slug;
              g.classList.toggle('is-active', on);
              g.style.display = on ? '' : 'none';
            });
            tabsEl.querySelectorAll('.pdp-swatches-tab').forEach(function(b){
              var isActive = b.getAttribute('data-group') === slug;
              b.classList.toggle('is-active', isActive);
              b.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });
            /* Reset scroll to start when switching groups + re-evaluate arrows. */
            var grid = activeGrid();
            if (grid) grid.scrollLeft = 0;
            requestAnimationFrame(updateArrows);
          }

          function build(){
            var groups = [];
            swatchEl.querySelectorAll(':scope > div').forEach(function(g){
              var heading = g.querySelector('p');
              if (!heading) return;
              var name = (heading.textContent || '').trim();
              if (!name) return;
              var slug = slugify(name);
              g.setAttribute('data-swatch-group', slug);
              heading.style.display = 'none';
              groups.push({ name: name, slug: slug });

              /* Promote the inner row to a 3-col grid + wrap each
               * anchor in a cell with a label below. */
              var inner = g.querySelector(':scope > div');
              if (inner) {
                inner.classList.remove('inline-flex', 'flex-wrap', 'gap-2');
                inner.classList.add('pdp-swatches-grid');
                Array.prototype.forEach.call(inner.querySelectorAll(':scope > a'), wireCell);
                inner.addEventListener('scroll', updateArrows, { passive: true });
              }
            });
            if (groups.length === 0) return;
            tabsEl.innerHTML = '';
            groups.forEach(function(g){
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'pdp-swatches-tab';
              btn.setAttribute('data-group', g.slug);
              btn.setAttribute('role', 'tab');
              btn.textContent = g.name;
              btn.addEventListener('click', function(){ activate(g.slug); });
              tabsEl.appendChild(btn);
            });
            activate(groups[0].slug);
            wrap.classList.add('is-ready');
            window.addEventListener('resize', updateArrows);
          }

          function looksRendered(){
            return !!swatchEl.querySelector(':scope > div p');
          }

          if (looksRendered()) {
            build();
            return;
          }
          var observer = new MutationObserver(function(){
            if (looksRendered()) {
              observer.disconnect();
              build();
            }
          });
          observer.observe(swatchEl, { childList: true });

          /* Single revert trigger when the cursor leaves the entire
           * swatch widget — moving between cells does not fire this,
           * so the hero stays on the last-hovered preview without
           * flashing back to the selected product. */
          wrap.addEventListener('mouseleave', function(){
            setColorLabel(currentTitle);
            if (canHover) revertHero();
          });
        }
        document.querySelectorAll('.pdp-swatches-tabbed').forEach(init);
      })();
    </script>

  {% comment %}
    {% elsif false %}
      {% comment %} Legacy Liquid-based swatch rendering - now disabled in favor of unified JavaScript approach {% endcomment %}
      <div class="px-4" style="display: none;">
        {% assign swatch_groups = settings.swatch_order_groups | split: ',' %}

        {% for group in swatch_groups %}
          {% assign group_title = group | strip %}
          {% assign group_title_lowercase = group_title | downcase %}
          {% assign has_swatches_in_group = false %}

          {% comment %} Check if this group has any swatches - include ALL products even if sold out {% endcomment %}
          {% assign swatch_collection_handle = product.metafields.custom.swatch_collection.value.handle %}
          {% if swatch_collection_handle %}
            {% for linked_product in collections[swatch_collection_handle].products %}
              {% assign product_tags_lowercase = linked_product.tags | join: ',' | downcase %}
              {% if product_tags_lowercase contains group_title_lowercase %}
                {% assign has_swatches_in_group = true %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if has_swatches_in_group %}
            <div class="pb-4">
              <p class="mb-1 opacity-75 type--smaller">{{ group_title }}</p>
              <div class="inline-flex flex-wrap gap-2 w-full">
                {% assign swatch_collection_handle = product.metafields.custom.swatch_collection.value.handle %}
                {% for linked_product in collections[swatch_collection_handle].products %}
                  {% assign product_tags_lowercase = linked_product.tags | join: ',' | downcase %}

                  {% if product_tags_lowercase contains group_title_lowercase %}
                    {% capture swatch_image_filename %}swatch-{{ linked_product.title | handle }}.jpg{% endcapture %}
                    {% assign swatch_image = images[swatch_image_filename] %}

                    {% comment %} Check if swatch image exists {% endcomment %}
                    {% assign has_swatch_image = false %}
                    {% if swatch_image contains '.jpg' %}
                      {% assign has_swatch_image = true %}
                    {% endif %}

                    <a
                      href="{{ linked_product.url }}"
                      title="{{ linked_product.title }}"
                      class="
                                                                                                                                                btn btn--plain btn--small bg-center !w-8 !h-8 !min-w-[2rem] !min-h-[2rem] bg-contain !rounded-full !p-0 aspect-1
                      "
                      :class="
                        {
                          'btn--plain border--focus-outline' : '{{ product.handle }}' == '{{ linked_product.handle }}',
                          'btn--plain' : '{{ product.handle }}' != '{{ linked_product.handle }}',
                        }
                      "
                      style="
                        {% if has_swatch_image %}
                          background-image: url('{{ swatch_image | image_url }}');
                        {% elsif linked_product.featured_image %}
                          background-image: url('{{ linked_product.featured_image | image_url: width: 64, height: 64, crop: 'center' }}');
                          background-size: cover;
                        {% else %}
                          background-color: #cccccc;
                          background-image: none;
                        {% endif %}
                      "
                      @click="window.location.href = ''"
                    >
                    </a>
                  {% endif %}
                {% endfor %}

                {% comment %} Force display sold-out products that match current product type and have correct tags {% endcomment %}
                {% for store_product in collections.all.products %}
                  {% if store_product.available == false and store_product.type == product.type %}
                    {% assign store_product_tags = store_product.tags | join: ',' | downcase %}
                    {% if store_product_tags contains group_title_lowercase %}
                      {% comment %} Check if already shown in available products {% endcomment %}
                      {% assign already_shown = false %}
                      {% for shown_product in collections[swatch_collection_handle].products %}
                        {% if shown_product.handle == store_product.handle %}
                          {% assign already_shown = true %}
                          {% break %}
                        {% endif %}
                      {% endfor %}

                      {% unless already_shown %}
                        {% capture swatch_image_filename %}swatch-{{ store_product.title | handle }}.jpg{% endcapture %}
                        {% assign swatch_image = images[swatch_image_filename] %}
                        {% assign has_swatch_image = false %}
                        {% if swatch_image contains '.jpg' %}
                          {% assign has_swatch_image = true %}
                        {% endif %}

                        <a
                          href="{{ store_product.url }}"
                          title="{{ store_product.title }}"
                          class="
                                                                                                                                                                            btn btn--plain btn--small bg-center !w-8 !h-8 !min-w-[2rem] !min-h-[2rem] bg-contain !rounded-full !p-0 aspect-1
                          "
                          :class="
                            {
                              'btn--plain border--focus-outline' : '{{ product.handle }}' == '{{ store_product.handle }}',
                              'btn--plain' : '{{ product.handle }}' != '{{ store_product.handle }}',
                            }
                          "
                          style="
                            {% if has_swatch_image %}
                              background-image: url('{{ swatch_image | image_url }}');
                            {% elsif store_product.featured_image %}
                              background-image: url('{{ store_product.featured_image | image_url: width: 64, height: 64, crop: 'center' }}');
                              background-size: cover;
                            {% else %}
                              background-color: #cccccc;
                              background-image: none;
                            {% endif %}
                          "
                          @click="window.location.href = ''"
                        >
                        </a>
                      {% endunless %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {% comment %} Add "Other Colors" section for any swatches without matching tags {% endcomment %}
        {% assign other_swatches_exist = false %}
        {% assign swatch_collection_handle = product.metafields.custom.swatch_collection.value.handle %}
        {% for linked_product in collections[swatch_collection_handle].products %}
          {% assign has_group_tag = false %}
          {% for group in swatch_groups %}
            {% assign group_title = group | strip %}
            {% assign group_title_lowercase = group_title | downcase %}
            {% assign product_tags_lowercase = linked_product.tags | join: ',' | downcase %}
            {% if product_tags_lowercase contains group_title_lowercase %}
              {% assign has_group_tag = true %}
              {% break %}
            {% endif %}
          {% endfor %}

          {% if has_group_tag == false %}
            {% assign other_swatches_exist = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if other_swatches_exist %}
          <div class="">
            <p class="mb-1 opacity-75 type--smaller">Other Colors</p>
            <div class="inline-flex flex-wrap gap-2 w-full">
              {% assign swatch_collection_handle = product.metafields.custom.swatch_collection.value.handle %}
              {% for linked_product in collections[swatch_collection_handle].products %}
                {% assign has_group_tag = false %}
                {% for group in swatch_groups %}
                  {% assign group_title = group | strip %}
                  {% assign group_title_lowercase = group_title | downcase %}
                  {% assign product_tags_lowercase = linked_product.tags | join: ',' | downcase %}
                  {% if product_tags_lowercase contains group_title_lowercase %}
                    {% assign has_group_tag = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                {% if has_group_tag == false %}
                  {% capture swatch_image_filename %}swatch-{{ linked_product.title | handle }}.jpg{% endcapture %}
                  {% assign swatch_image = images[swatch_image_filename] %}

                  {% comment %} Check if swatch image exists {% endcomment %}
                  {% assign has_swatch_image = false %}
                  {% if swatch_image contains '.jpg' %}
                    {% assign has_swatch_image = true %}
                  {% endif %}

                  <a
                    href="{{ linked_product.url }}"
                    title="{{ linked_product.title }}"
                    class="
                                                                                                                                  btn btn--plain btn--small bg-center !w-8 !h-8 !min-w-[2rem] !min-h-[2rem] bg-contain !rounded-full !p-0 aspect-1
                    "
                    :class="
                      {
                        'btn--plain border--focus-outline' : '{{ product.handle }}' == '{{ linked_product.handle }}',
                        'btn--plain' : '{{ product.handle }}' != '{{ linked_product.handle }}',
                      }
                    "
                    style="
                      {% if has_swatch_image %}
                        background-image: url('{{ swatch_image | image_url }}');
                      {% elsif linked_product.featured_image %}
                        background-image: url('{{ linked_product.featured_image | image_url: width: 64, height: 64, crop: 'center' }}');
                        background-size: cover;
                      {% else %}
                        background-color: #cccccc;
                        background-image: none;
                      {% endif %}
                    "
                    @click="window.location.href = ''"
                  >
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
  {% endcomment %}
{% endif %}

{%- comment -%} Variants {%- endcomment -%}
<div
  class="
    flex flex-wrap px-4 no-js--hide
    {% if product.variants.size <= 1 %}
      hidden
    {% endif %}
  "
>
  <p
    class="mb-2 type--small"
    x-show="choosing && buttonDisabled"
    x-cloak
  >
    {{ 'products.general.options_prompt' | t }}
  </p>

  {% for product_option in product.options_with_values %}
    <div
      class="
        w-full
        {% if product_option.values.size <= 1 %}hidden{% endif %}
      "
    >
      {% comment %} Label and popup {% endcomment %}
      <div class="flex justify-between mb-2">
        <label
          class="flex opacity-75 type--smaller"
          for="{{ product.id }}-{{ product_option.name | handle | remove: '-' }}"
        >
          {{ product_option.name }}
          {% for value in product_option.values %}
            <span
              x-model="{{ product_option.name | handle | remove: '-' }}"
              class="ml-1"
              :class="
                {
                  'inline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                  'hidden' : {{ product_option.name | handle | remove: '-' }} != '{{ value | handle }}',
                }
              "
              x-cloak
              >: {{ value -}}
            </span>
          {% endfor %}
        </label>

        {% capture option_handle %}{{ product_option.name | handle | remove: '-' }}{% endcapture %}
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when 'popup' -%}
              {% if block.settings.option == option_handle %}
                <div x-data="{ drawer: false }">
                  <button
                    class="flex underline opacity-75 type--smaller"
                    type="button"
                    @click="drawer = true; hide_header = true;"
                  >
                    {{ block.settings.title }}
                  </button>
                  {% capture drawer_content %}
                    <div class="flex sticky top-0 flex-wrap justify-between items-center px-4 py-2 border--b-width color__border-divider-1 color__bg-body">
                      <div>
                        <button class="btn-close-dark btn--smaller" 
                          type="button"
                          title="{{ 'general.navigation.close' | t }}"
                          @click="drawer = false; hide_header = false;">
                          {% render 'component__icon', icon: 'x', size: '24', class: '' %}
                        </button>
                      </div>
                      <div class="text-right">
                        {{ block.settings.title }}
                      </div>
                    </div>
                    <div class="p-4">
                      {{ block.settings.page.content }}
                    </div>
                  {% endcapture %}
                  {% render 'component__drawer', drawer_id: 'drawer', position: 'right', content: drawer_content %}
                </div>
              {% endif %}
          {%- endcase -%}
        {% endfor %}
      </div>

      {%- assign color = 'general.color.color' | t -%}
      {%- assign colorDowncase = color | downcase -%}

      {% comment %} Color options {% endcomment %}
      {%- if product_option.name == color
        or product_option.name == colorDowncase
        or product_option.name == 'Colour'
        or product_option.name == 'colour'
      -%}
        {% if settings.product_color_selection == 'swatches' %}
          <div class="flex flex-wrap w-full gap-2 {% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}">
            {% for value in product_option.values %}
              {% if settings.enable_unavailable_options %}
                {%- liquid
                  assign option_disabled = true

                  for option1_name in variants_option1_arr
                    case product_option.position
                      when 1
                        if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 2
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 3
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                    endcase
                  endfor
                -%}
              {% endif %}

              {%- capture swatch_image_filename -%}swatch-{{ value | handle }}.jpg{%- endcapture -%}
              {% assign swatch_image = images[swatch_image_filename] %}
              <button
                type="button"
                class="btn btn--plain btn--small bg-center !w-8 !h-8 !min-w-0 !min-h-0"
                :class="
                  {
                    {% if settings.enable_unavailable_options %} 'strikethrough': {{ option_disabled }}, {% endif %}
                    'btn--plain border--focus-outline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                    'btn--plain' : {{ product_option.name | handle | remove: '-' }} != '{{ value | handle }}',
                  }
                "
                style="
                  background-color: {{ value | handle }};
                  {% if swatch_image contains '.jpg' %}
                    background-image: url('{{ swatch_image | image_url }}');
                  {% endif %}
                "
                @click="{{ product_option.name | handle | remove: '-' }} = '{{ value | handle }}'; handleForm();"
              ></button>
            {% endfor %}
          </div>
        {% elsif settings.product_color_selection == 'buttons' %}
          <div class="flex flex-wrap w-full gap-2 {% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}">
            {% for value in product_option.values %}
              {% if settings.enable_unavailable_options %}
                {%- liquid
                  assign option_disabled = true

                  for option1_name in variants_option1_arr
                    case product_option.position
                      when 1
                        if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 2
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 3
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                    endcase
                  endfor
                -%}
              {% endif %}
              <button
                type="button"
                class="btn btn--plain btn--small"
                :class="
                  {
                    {% if settings.enable_unavailable_options %} 'strikethrough': {{ option_disabled }}, {% endif %}
                    'btn--plain border--focus-outline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                    'btn--plain' : {{ product_option.name | handle | remove: '-' }} != '{{ value | handle }}',
                  }
                "
                @click="{{ product_option.name | handle | remove: '-' }} = '{{ value | handle }}'; handleForm();"
              >
                {{ value }}
              </button>
            {% endfor %}
          </div>
        {% else %}
          <select
            @change="handleForm()"
            class="{% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}"
            :class="{ '!border-rose-500': choosing }"
            id="{{ product.id }}-{{ product_option.name | handle | remove: '-' }}"
            x-model="{{ product_option.name | handle | remove: '-' }}"
          >
            <option disabled selected value="">
              {{ 'products.general.choose_option' | t }}
            </option>
            {% for value in product_option.values %}
              {% if settings.enable_unavailable_options %}
                {%- liquid
                  assign option_disabled = true

                  for option1_name in variants_option1_arr
                    case product_option.position
                      when 1
                        if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 2
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 3
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                    endcase
                  endfor
                -%}
              {% endif %}
              <option value="{{ value | handle }}">
                {{ value }}
                {% if settings.enable_unavailable_options and option_disabled %}
                  - {{ 'products.general.sold_out' | t -}}
                {%- endif %}
              </option>
            {% endfor %}
          </select>
        {% endif %}

        {% comment %} All other options {% endcomment %}
      {% else %}
        {% if settings.product_variant_selection == 'dropdowns' %}
          <select
            @change="handleForm()"
            class="{% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}"
            :class="{ '!border-rose-500': choosing }"
            id="{{ product.id }}-{{ product_option.name | handle | remove: '-' }}"
            x-model="{{ product_option.name | handle | remove: '-' }}"
          >
            <option disabled selected value="">
              {{ 'products.general.choose_option' | t }}
            </option>
            {% for value in product_option.values %}
              {% if settings.enable_unavailable_options %}
                {%- liquid
                  assign option_disabled = true

                  for option1_name in variants_option1_arr
                    case product_option.position
                      when 1
                        if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 2
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 3
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                    endcase
                  endfor
                -%}
              {% endif %}
              <option value="{{ value | handle }}">
                {{ value }}
                {% if settings.enable_unavailable_options and option_disabled %}
                  - {{ 'products.general.sold_out' | t -}}
                {%- endif %}
              </option>
            {% endfor %}
          </select>
        {% else %}
          <div class="flex flex-wrap w-full gap-2 {% if forloop.index == forloop.length %}mb-0{% else %}mb-4{% endif %}">
            {% for value in product_option.values %}
              {% if settings.enable_unavailable_options %}
                {%- liquid
                  assign option_disabled = true

                  for option1_name in variants_option1_arr
                    case product_option.position
                      when 1
                        if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 2
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                      when 3
                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                          assign option_disabled = false
                        endif
                    endcase
                  endfor
                -%}
              {% endif %}
              <button
                type="button"
                class="btn btn--plain btn--small"
                :class="
                  {
                    {% if settings.enable_unavailable_options %} 'strikethrough': {{ option_disabled }}, {% endif %}
                    'btn--plain border--focus-outline' : {{ product_option.name | handle | remove: '-' }} == '{{ value | handle }}',
                    'btn--plain' : {{ product_option.name | handle | remove: '-' }} != '{{ value | handle }}',
                  }
                "
                @click="{{ product_option.name | handle | remove: '-' }} = '{{ value | handle }}'; handleForm();"
              >
                {{ value }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}
    </div>
  {% endfor %}

  <select
    class="hidden"
    name="handle"
    x-model="variantHandle"
  >
    {% for variant in product.variants %}
      <option
        value="{{ variant.title | handle }}"
        data-id="{{ variant.id }}"
        {% if variant.id == product.selected_or_first_available_variant.id %}
          selected
        {% endif %}
      >
        {{ variant.title | handle }}
      </option>
    {% endfor %}
  </select>
</div>
<div
  class="
    flex-wrap px-4 hidden no-js--block
    {% if product.variants.size <= 1 %}hidden{% endif %}
  "
>
  <div class="w-full">
    <label
      class="flex mb-1 opacity-75 type--smaller"
      for="Variants-{{ section.id }}"
    >
      {{ 'products.general.sold_out' | t }}
    </label>
    <select
      id="Variants-{{ section.id }}"
      class="w-full"
      name="id"
      x-model="defaultVariantId"
    >
      {%- for variant in product.variants -%}
        <option
          value="{{ variant.id }}"
          {% if variant == product.selected_or_first_available_variant %}
            selected="selected"
          {% endif %}
          {% if variant.available == false %}
            disabled
          {% endif %}
        >
          {{ variant.title }}
          {%- if variant.available == false %}
            - {{ 'products.general.sold_out' | t -}}
          {%- endif %}
          - {{ variant.price | money | strip_html }}
        </option>
      {%- endfor -%}
    </select>
  </div>
</div>

{% comment %} Variant ID input {% endcomment %}
<input
  class="hidden"
  name="id"
  x-model="defaultVariantId"
  value="{{ variant.id }}"
>

{%- comment -%} Selling plan{%- endcomment -%}
{% if product.selected_or_first_available_selling_plan_allocation %}
  <div
    class="
      no-js--hide w-full px-4
      {% if product.variants.size <= 1 %}mt-4{% endif %}
    "
    x-show="defaultHasSellingPlan"
  >
    <div
      class="border--width color__border-divider-1 border--radius w-full !border-b-0 overflow-hidden"
    >
      {% unless product.requires_selling_plan %}
        <div
          class="border--b-width color__border-divider-1"
        >
          <label
            class="inline-flex justify-between items-center px-4 py-4 w-full"
            @click="sellingGroupId = 0"
          >
            <input
              type="radio"
              name="purchase_option"
              value="0"
              {% if product.selected_or_first_available_selling_plan_allocation %}
                checked
              {% endif %}
              :checked="{ 'checked': sellingGroupId == 0 }"
              @change="handleForm"
            >
            <span
              class="ml-2 grow"
            >
              {{ 'products.general.one_time_purchase' | t }}
            </span>
            <span>
              {{ product.price_min | money }}
            </span>
          </label>
        </div>
      {% endunless %}

      {% for group in product.selling_plan_groups %}
        <div
          class="border--b-width color__border-divider-1"
        >
          {% comment %} find lowest price {% endcomment %}
          {% assign selling_plan_price_min = product.price_max | plus: 0 %}
          {% assign selling_plan_discount = 0 %}
          {% for variant in product.variants %}
            {%- for allocation in variant.selling_plan_allocations -%}
              {% if allocation.selling_plan_group_id == group.id %}
                {% if selling_plan_price_min >= allocation.per_delivery_price %}
                  {% assign selling_plan_price_min = allocation.per_delivery_price | plus: 0 %}
                {% endif %}
              {% endif %}
            {%- endfor -%}
          {%- endfor -%}

          {% comment %} find biggest discount {% endcomment %}
          {% assign selling_plan_discount = 0 %}
          {% assign selling_plan_discount_original = 0 %}
          {% assign selling_plan_discount_type = '' %}
          {% for selling_plan in group.selling_plans %}
            {%- for price_adjustment in selling_plan.price_adjustments -%}
              {% assign current_discount = 0 %}
              {% if price_adjustment.value_type == 'fixed_amount' %}
                {% assign current_discount = price_adjustment.value %}
              {% elsif price_adjustment.value_type == 'price' %}
                {% assign current_discount = product.price | minus: price_adjustment.value %}
              {% elsif price_adjustment.value_type == 'percentage' %}
                {% assign current_discount = product.price | times: price_adjustment.value | divided_by: 100 %}
              {% endif %}
              {% if current_discount > selling_plan_discount %}
                {% assign selling_plan_discount = current_discount %}
                {% assign selling_plan_discount_original = price_adjustment.value %}
                {% assign selling_plan_discount_type = price_adjustment.value_type %}
              {% endif %}
            {%- endfor -%}
          {% endfor %}

          <label
            class="inline-flex justify-between items-center px-4 py-4 w-full"
            @click="sellingGroupId = '{{ group.id }}';"
          >
            <input
              type="radio"
              name="purchase_option"
              value="{{ group.id }}"
              {% if product.requires_selling_plan or product.selling_plan_groups.size == 1 %}
                checked
              {% endif %}
              {% if product.selling_plan_groups.size == 1 %}
                x-init="sellingGroupId = '{{ group.id }}';"
              {% endif %}
              @change="handleForm"
            >
            <span class="flex flex-wrap gap-1 items-center ml-2 grow">
              {{ group.name }}
              {% capture selling_plan_discount %}
                {% if selling_plan_discount_type == 'percentage' %}
                  {{ 'products.general.save_up_to' | t }} {{ selling_plan_discount_original | append: '%' }}
                {% else %}
                  {{ 'products.general.save_up_to' | t }} {{ selling_plan_discount_original | money }}
                {% endif %}
              {% endcapture %}
              {% render 'component__badge', color: 'overlay-1', icon: '', content: selling_plan_discount %}
            </span>
            <span class="flex flex-col items-end text-right">
              {{ selling_plan_price_min | money }}
              <span class="flex opacity-75 type--smaller">
                {{ 'products.general.each' | t }}
              </span>
            </span>
          </label>

          {% for variant in product.variants %}
            <div
              class="pb-4 pl-4 border--t-width color__border-divider-1 color__bg-overlay-1"
              x-show="defaultVariantId == {{ variant.id }} && sellingGroupId == '{{ group.id }}'"
              x-cloak
            >
              {% for selling_plan in group.selling_plans %}
                <label
                  class="inline-flex justify-between items-center px-4 pt-4 w-full"
                >
                  <input
                    class="js:{{ group.id }}_{{ variant.id }}_selling_plan"
                    type="radio"
                    name="{{ group.id }}_{{ variant.id }}_selling_plan"
                    value="{{ selling_plan.id }}"
                    {% if product.selected_or_first_available_selling_plan_allocation
                      or group.selling_plans.size == 1
                    %}
                      checked
                    {% endif %}
                    {% if group.selling_plans.size == 1 %}
                      x-init="handleForm"
                    {% endif %}
                    x-model="defaultSellingPlanId"
                    @change="handleForm"
                    data-selling-plan='
                      {
                        {%- for allocation in variant.selling_plan_allocations -%}
                          {% if allocation.selling_plan.id == selling_plan.id %}
                            "price": {{ allocation.price }},
                            "compare_at_price": {{ allocation.compare_at_price }},
                            "per_delivery_price": {{ allocation.per_delivery_price }},
                            "unit_price": {{ allocation.unit_price | default: "0" }},
                          {% endif %}
                        {%- endfor -%}
                        "recurring_deliveries": {{ selling_plan.recurring_deliveries }},
                        "name": "{{ selling_plan.name }}",
                        "description": "{{ selling_plan.description }}",
                        "price_adjustments": [
                          {%- for price_adjustment in selling_plan.price_adjustments -%}
                            {
                              "index": {{ price_adjustment.position }},
                              "value": {{ price_adjustment.value }},
                              "order_count": {{ price_adjustment.order_count | default: "null" }},
                              "value_type": "{{ price_adjustment.value_type }}"
                            }{% unless forloop.last == true %},{% endunless %}
                          {%- endfor -%}
                        ]
                      }
                    '
                  >
                  <span class="ml-2 grow">
                    {{ selling_plan.name }}
                  </span>
                  <span>
                    {%- for allocation in variant.selling_plan_allocations -%}
                      {% if allocation.selling_plan.id == selling_plan.id %}
                        <span class="flex flex-col items-end text-right">
                          {{ allocation.per_delivery_price | money }}
                          <span class="flex opacity-75 type--smaller">
                            {{ 'products.general.each' | t }}
                          </span>
                        </span>
                      {% endif %}
                    {%- endfor -%}
                  </span>
                </label>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>

    <div
      class="mt-2"
      x-show="defaultSellingPlanName && sellingGroupId != 0"
      x-cloak
    >
      <div class="flex gap-2 items-center">
        {% render 'component__icon', icon: 'refresh-cw', size: '16' %}
        <p class="mb-0 type--small">
          <span x-text="defaultSellingPlanName"></span>
          <span x-text="defaultSavingsSummary"></span>
          <span x-text="defaultSellingPlanDescription"></span>
        </p>
      </div>
    </div>
  </div>
  <div class="flex hidden flex-wrap px-4 no-js--block">
    <div class="w-full">
      <label
        class="flex mb-1 opacity-75 type--smaller"
        for="Variants-{{ section.id }}"
      >
        {{ 'products.general.purchase_options' | t }}
      </label>
      <select
        name="selling_plan"
        x-model="defaultSellingPlanId"
      >
        {% for group in product.selling_plan_groups %}
          <optgroup label="{{ group.name }}">
            {% for selling_plan in group.selling_plans %}
              <option value="{{ selling_plan.id }}">
                {{ selling_plan.name }}
              </option>
            {% endfor %}
          </optgroup>
        {% endfor %}
      </select>
    </div>
  </div>
{% endif %}
