{% comment %}
  PDP entry for the Market Tote bundler. Shows only when the current
  product belongs to the configured Market Tote collection (default:
  reusable-market-tote-bags). Links to the standalone bundler page with
  this product pre-selected (not locked) via ?preselect=<handle> — same
  pattern as Everyday Carry Set's ?slot_<key>=<handle> deep link.

  Cart upsell is intentionally skipped for V1.
{% endcomment %}

{% doc %}
  Market Tote PDP CTA — navigates to the bundler page.
  Renders nothing when the product is not in the Market Tote collection
  or the feature is disabled.
  @example
  {% render 'market-tote-bundler__pdp-cta' %}
{% enddoc %}

{%- liquid
  assign tote_handle = 'reusable-market-tote-bags'
  if settings.market_tote_collection.handle != blank
    assign tote_handle = settings.market_tote_collection.handle
  endif

  assign is_market_tote = false
  for c in product.collections
    if c.handle == tote_handle
      assign is_market_tote = true
      break
    endif
  endfor

  assign cta_text = settings.market_tote_pdp_cta_text | default: 'Build a tote bundle — Save 25%'
  assign page_path = settings.market_tote_page_path | default: '/pages/build-your-tote-bundle'
  assign bundler_url = page_path | append: '?preselect=' | append: product.handle
-%}

{%- if settings.market_tote_pdp_enable and is_market_tote -%}
  <div class="market-tote-pdp-cta px-4 py-4">
    <a
      href="{{ bundler_url }}"
      class="btn btn--secondary w-full market-tote-pdp-cta__btn">
      {{ cta_text }}
    </a>
  </div>
{%- endif -%}
