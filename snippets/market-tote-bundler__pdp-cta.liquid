{% comment %}
  PDP entry for the Market Tote bundler. Shows only when the current
  product belongs to the configured Market Tote collection (default:
  reusable-market-tote-bags). Links to the Market Tote collection
  bundler (or configured path) with this product pre-selected via
  ?preselect=<handle>#build-your-tote-bundle — same deep-link idea as
  Everyday Carry Set's ?slot_<key>=<handle>.

  Cart upsell is intentionally skipped for V1.
{% endcomment %}

{% doc %}
  Market Tote PDP CTA — navigates to the collection bundler with preselect.
  Renders nothing when the product is not in the Market Tote collection
  or the feature is disabled.
  @example
  {% render 'market-tote-bundler__pdp-cta' %}
{% enddoc %}

{%- liquid
  assign tote_handle = 'reusable-market-tote-bags'
  if settings.market_tote_collection.handle != blank
    assign tote_handle = settings.market_tote_collection.handle
  endif

  assign is_market_tote = false
  for c in product.collections
    if c.handle == tote_handle
      assign is_market_tote = true
      break
    endif
  endfor

  assign cta_text = settings.market_tote_pdp_cta_text | default: 'Build a tote bundle — Save 20%'
  comment
    Live bundler lives on the Market Tote collection template — the
    /pages/build-your-tote-bundle path was never published and 404s.
  endcomment
  assign page_path = settings.market_tote_page_path | default: '/collections/reusable-market-tote-bags'
  assign bundler_url = page_path | append: '?preselect=' | append: product.handle | append: '#build-your-tote-bundle'
-%}

{%- if settings.market_tote_pdp_enable and is_market_tote -%}
  <div class="market-tote-pdp-cta px-4 py-4">
    <a
      href="{{ bundler_url }}"
      class="btn btn--secondary w-full market-tote-pdp-cta__btn">
      {{ cta_text }}
    </a>
  </div>
{%- endif -%}
