{% comment %}
  Shared Market Tote bundler instance (page section + optional drawer).

  Renders the picker UI, product JSON, and Alpine factory. Callers pass
  an instance_id so multiple copies on one page stay unique.

  PDP CTAs link here with ?preselect=<handle> to preview that tote and
  seed it as pick #1 (not locked) — mirrors Everyday Carry Set deep links.
{% endcomment %}

{% doc %}
  @param {string} instance_id - Unique id (section.id or drawer id)
  @param {string} [heading] - Heading text
  @param {string} [savings_label] - Bronze savings line under heading
  @param {string} [add_bundle_label] - Add to Bundle button text
  @param {string} [cart_label] - Add Bundle to Cart button text
  @param {string} [discount_type] - percent | fixed_off | none
  @param {number} [discount_value] - Display discount amount
  @param {string} [discount_code] - Checkout discount code
  @param {object} [source_collection] - Collection of totes
  @param {number} [spacing_top]
  @param {number} [spacing_bottom]
  @param {string} [layout_horizontal]
  @param {string} [color_scheme]
  @param {string} [color_border]
  @param {string} [style_border]
  @param {string} [visibility]
  @param {boolean} [compact] - Tighter padding for drawer
{% enddoc %}

{%- liquid
  assign instance_id = instance_id | default: 'market-tote'
  assign section_id = 'market-tote-bundler-' | append: instance_id
  assign js_id = instance_id | replace: '-', '_'

  assign discount_type = discount_type | default: 'percent'
  assign discount_value = discount_value | default: 25
  assign required_count = 3
  assign add_bundle_label = add_bundle_label | default: 'Add to Bundle'
  assign cart_label = cart_label | default: 'Add Bundle to Cart'
  if compact
    comment
      Drawer chrome already shows the title — skip the H2 unless the
      caller passes one. Keep the bronze savings line by default.
    endcomment
    assign heading = heading | default: ''
  else
    assign heading = heading | default: 'Build Your Tote Bundle'
  endif
  assign savings_label = savings_label | default: '3 Market Totes = 25% OFF'

  if discount_code == blank
    assign discount_code = settings.market_tote_discount_code | default: ''
  endif

  assign tote_coll = source_collection
  if tote_coll == blank
    if settings.market_tote_collection != blank
      assign tote_coll = settings.market_tote_collection
    else
      assign tote_coll = collections['reusable-market-tote-bags']
    endif
  endif

  assign spacing_top = spacing_top | default: 60
  assign spacing_bottom = spacing_bottom | default: 60
  if compact
    assign spacing_top = 0
    assign spacing_bottom = 16
  endif
  assign layout_horizontal = layout_horizontal | default: 'window'
  assign color_scheme = color_scheme | default: 'color__bg-body color__text'
  assign color_border = color_border | default: 'color__border-divider-1'
  assign style_border = style_border | default: ''
  assign visibility = visibility | default: ''
-%}

{%- comment -%}
  Stable #build-your-tote-bundle anchor for PDP deep links (skip in
  compact drawer so multiple instances don't collide).
{%- endcomment -%}
<section
  id="{% if compact %}{{ section_id }}{% else %}build-your-tote-bundle{% endif %}"
  class="
    {{ visibility }}
    {{ color_scheme }}
    {{ color_border }}
    {{ style_border }}
  "
  {% unless compact %}data-section-id="{{ section_id }}"{% endunless %}>
  <div
    class="market-tote-bundler {{ layout_horizontal }}"
    style="
      padding-top:{{ spacing_top }}px;
      padding-bottom:{{ spacing_bottom }}px;
    "
    x-data="marketToteBundler_{{ js_id }}">

    {% comment %}
      Heading + savings live inside market-tote-bundler__pdp-layout so
      mobile stacks like Everyday Carry (intro → gallery → details)
      without a centered strip above the layout.
    {% endcomment %}
    {% render 'market-tote-bundler__pdp-layout',
        cart_label: cart_label,
        discount_type: discount_type,
        discount_value: discount_value,
        heading: heading,
        savings_label: savings_label %}

    <p
      class="type--small px-4 pb-4 text-center"
      x-show="incompleteReason"
      x-text="incompleteReason"
      x-cloak></p>

  </div>
</section>

<script type="application/json" id="{{ section_id }}-data">
{
  "discountCode": {{ discount_code | strip | json }},
  "requiredCount": {{ required_count | json }},
  "products": [
    {%- if tote_coll != blank -%}
      {%- paginate tote_coll.products by 50 -%}
        {%- for product in tote_coll.products limit: 50 -%}
          {%- assign first_variant = product.selected_or_first_available_variant -%}
          {
            "handle": {{ product.handle | json }},
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "price": {{ first_variant.price | json }},
            "compareAtPrice": {{ first_variant.compare_at_price | default: 0 | json }},
            "available": {{ first_variant.available | json }},
            "variantId": {{ first_variant.id | json }},
            "swatchImage": {{ product.featured_image | image_url: width: 200 | json }},
            "images": {% render 'bundle__gallery-frames', product: product %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- endpaginate -%}
    {%- endif -%}
  ]
}
</script>

<script>
(function() {
  function marketToteBundlerFactory_{{ js_id }}() {
    return {
      products: [],
      // Ordered picks (handles). Length ≤ requiredCount. Duplicates allowed.
      picks: [],
      previewHandle: null,
      galleryIndex: 0,
      // Stable hero <img> state — avoid x-if remount flash on SKU switch.
      heroSrc: '',
      heroSrcset: '',
      heroAlt: '',
      heroReady: false,
      // Hero media kind — image | video | external_video (PDP parity).
      heroMediaType: 'image',
      heroVideoUrl: '',
      heroExternalHost: '',
      heroExternalId: '',
      _pendingHero: '',
      _prefetchCache: {},
      // handle|galleryIndex|frame → { src, srcset } after first successful load
      _heroCache: {},
      // Full PDP media gallery (images + videos) loaded once per handle.
      _galleryHydrated: {},
      _galleryHydrating: {},
      requiredCount: {{ required_count }},
      cartLoading: false,
      incompleteReason: '',
      discountCode: '',

      init() {
        var dataEl = document.getElementById('{{ section_id }}-data');
        if (!dataEl) return;
        var data;
        try { data = JSON.parse(dataEl.textContent); }
        catch (e) { console.error('[market-tote-bundler] bad JSON data', e); return; }

        this.discountCode = (data.discountCode || '').trim();
        this.requiredCount = data.requiredCount || {{ required_count }};
        this.products = data.products || [];
        this.picks = [];
        this.galleryIndex = 0;
        this._prefetchCache = {};
        this._heroCache = {};
        this._galleryHydrated = {};
        this._galleryHydrating = {};
        var first = this.products.find(function(p){ return p.available; }) || this.products[0] || null;
        this.previewHandle = first ? first.handle : null;
        this.applyHero(true);
        // Deep link from Market Tote PDP: ?preselect=<handle>
        this._readUrlPrefill();
        // When the selected style changes, pull the full media list (PDP parity).
        var self = this;
        this.$watch('previewHandle', function(handle) {
          if (handle) self.hydrateGalleryFor(handle);
        });
        if (this.previewHandle) this.hydrateGalleryFor(this.previewHandle);
      },

      // Read ?preselect=<handle> so the PDP CTA lands on the product the
      // customer came from (selected as pick #1, not locked).
      _readUrlPrefill() {
        try {
          var params = new URLSearchParams(window.location.search || '');
          var handle = params.get('preselect');
          if (handle) this.preselect(handle);
        } catch (e) {
          console.warn('[market-tote-bundler] URL prefill failed', e);
        }
      },

      lockSlot(slotLabel, productHandle) {
        return this.preselect(productHandle);
      },

      // PDP deep link / drawer: preview this tote and seed it as pick #1 if empty.
      preselect(productHandle) {
        if (!productHandle) return false;
        var match = this.products.find(function(p){ return p.handle === productHandle; });
        if (!match) {
          console.warn('[market-tote-bundler] product not in catalog', productHandle);
          return false;
        }
        this.previewHandle = productHandle;
        this.galleryIndex = 0;
        this.applyHero(true);
        if (this.picks.length === 0 && match.available) {
          this.picks = [productHandle];
        }
        return true;
      },

      previewProduct() {
        return this.productByHandle(this.previewHandle) || this.products[0] || null;
      },

      previewImages() {
        var p = this.previewProduct();
        return (p && p.images && p.images.length) ? p.images : [];
      },

      currentHero() {
        var images = this.previewImages();
        if (!images.length) {
          var p = this.previewProduct();
          if (!p) return null;
          return {
            thumb: p.swatchImage,
            hero: p.swatchImage,
            hero600: p.swatchImage,
            hero900: p.swatchImage
          };
        }
        var idx = this.galleryIndex;
        if (idx < 0 || idx >= images.length) idx = 0;
        return images[idx];
      },

      heroSrcsetFor(image) {
        if (!image) return '';
        if (image.mediaType === 'video' || image.mediaType === 'external_video') return '';
        return (image.hero600 || '') + ' 600w, ' + (image.hero900 || '') + ' 900w, ' + (image.hero || '') + ' 1200w';
      },

      // Include frame URL so hydrate cannot revive a stale pre-hydrate entry.
      _heroCacheKey() {
        var image = this.currentHero();
        var frame = (image && (image.hero || image.videoUrl || image.thumb)) || '';
        return (this.previewHandle || '') + '|' + this.galleryIndex + '|' + frame;
      },

      _clearHeroCacheForHandle(handle) {
        if (!handle) return;
        var prefix = handle + '|';
        Object.keys(this._heroCache).forEach(function(key) {
          if (key.indexOf(prefix) === 0) delete this._heroCache[key];
        }.bind(this));
      },

      isHeroVideo() {
        return this.heroMediaType === 'video' && !!this.heroVideoUrl;
      },

      isHeroExternalVideo() {
        return this.heroMediaType === 'external_video' && !!this.heroExternalId;
      },

      heroEmbedUrl() {
        if (!this.isHeroExternalVideo()) return '';
        var id = encodeURIComponent(this.heroExternalId);
        var host = String(this.heroExternalHost || '').toLowerCase();
        if (host === 'youtube') {
          return 'https://www.youtube.com/embed/' + id + '?autoplay=1&mute=1&controls=0&playsinline=1&loop=1&playlist=' + id;
        }
        if (host === 'vimeo') {
          return 'https://player.vimeo.com/video/' + id + '?autoplay=1&muted=1&loop=1&background=1';
        }
        return '';
      },

      _setHeroMediaMeta(image) {
        var type = (image && image.mediaType) || 'image';
        this.heroMediaType = type;
        this.heroVideoUrl = (image && image.videoUrl) || '';
        this.heroExternalHost = (image && image.externalHost) || '';
        this.heroExternalId = (image && image.externalId) || '';
      },

      // Show the current sharp frame while the next hero loads (no blur flash).
      applyHero(useSwatchPlaceholder) {
        var p = this.previewProduct();
        var image = this.currentHero();
        if (!p || !image) return;

        this.heroAlt = p.title || '';
        this._setHeroMediaMeta(image);

        if (this.isHeroVideo() || this.isHeroExternalVideo()) {
          this._pendingHero = '';
          this.heroSrc = image.hero || image.thumb || p.swatchImage || '';
          this.heroSrcset = '';
          this.heroReady = true;
          return;
        }

        var cacheKey = this._heroCacheKey();
        var cached = this._heroCache[cacheKey];
        if (cached) {
          if (this.heroSrc === cached.src && this.heroReady) return;
          this._pendingHero = cached.src;
          this.heroSrc = cached.src;
          this.heroSrcset = cached.srcset || '';
          this.heroReady = true;
          return;
        }

        var placeholder = useSwatchPlaceholder
          ? (p.swatchImage || image.thumb || image.hero600 || image.hero)
          : (image.thumb || p.swatchImage || image.hero600 || image.hero);

        var target = image.hero || image.hero900 || placeholder;
        var targetSrcset = this.heroSrcsetFor(image);

        if (this.heroSrc === target && this.heroReady) return;

        var keepCurrent = !!(this.heroSrc && this.heroReady);
        if (!keepCurrent) {
          this.heroSrc = placeholder;
          this.heroSrcset = '';
          // Show the placeholder immediately (no blank/blur frame).
          this.heroReady = true;
        }
        this._loadHero(target, targetSrcset, cacheKey);
      },

      _loadHero(src, srcset, cacheKey) {
        if (!src) return;
        this._pendingHero = src;
        var self = this;
        var img = new Image();
        img.onload = function() {
          if (self._pendingHero !== src) return;
          var shouldFade = !!(self.heroSrc && self.heroSrc !== src);
          self.heroSrc = src;
          self.heroSrcset = srcset || '';
          if (shouldFade) {
            self.heroReady = false;
            requestAnimationFrame(function() {
              requestAnimationFrame(function() {
                if (self._pendingHero !== src) return;
                self.heroReady = true;
              });
            });
          } else {
            self.heroReady = true;
          }
          if (cacheKey) {
            self._heroCache[cacheKey] = { src: src, srcset: srcset || '' };
          }
        };
        img.onerror = function() {
          if (self._pendingHero !== src) return;
          self.heroReady = true;
        };
        if (srcset) {
          img.sizes = '(min-width: 990px) 45vw, 100vw';
          img.srcset = srcset;
        }
        img.src = src;
      },

      // Shopify CDN: append/replace ?width= so thumbs/heroes match Liquid image_url sizes.
      _cdnWidth(src, width) {
        if (!src) return '';
        var url = String(src);
        if (url.indexOf('//') === 0) url = 'https:' + url;
        try {
          var u = new URL(url, window.location.origin);
          u.searchParams.set('width', String(width));
          return u.toString();
        } catch (e) {
          return url;
        }
      },

      _bestVideoUrl(mediaItem) {
        var sources = (mediaItem && mediaItem.sources) || [];
        var mp4 = '';
        var fallback = '';
        for (var i = 0; i < sources.length; i++) {
          var s = sources[i];
          if (!s || !s.url) continue;
          if (!fallback) fallback = s.url;
          var fmt = String(s.format || '').toLowerCase();
          var mime = String(s.mime_type || '').toLowerCase();
          if (fmt === 'mp4' || mime === 'video/mp4') {
            mp4 = s.url;
            break;
          }
        }
        return mp4 || fallback || '';
      },

      // Build gallery frames from /products/{handle}.js media (images + videos),
      // matching the PDP which uses product.media — not product.images alone.
      _mediaToGalleryImages(productJson) {
        var self = this;
        var frames = [];
        var media = (productJson && productJson.media) || [];
        var MAX = 12;

        function pushFrame(src, mediaType, extra) {
          if (!src || frames.length >= MAX) return;
          var frame = {
            thumb: self._cdnWidth(src, 160),
            hero: self._cdnWidth(src, 1200),
            hero600: self._cdnWidth(src, 600),
            hero900: self._cdnWidth(src, 900),
            mediaType: mediaType || 'image',
            videoUrl: '',
            externalHost: '',
            externalId: ''
          };
          if (extra) {
            if (extra.videoUrl) frame.videoUrl = extra.videoUrl;
            if (extra.externalHost) frame.externalHost = extra.externalHost;
            if (extra.externalId) frame.externalId = extra.externalId;
          }
          frames.push(frame);
        }

        media.forEach(function(m) {
          if (!m || frames.length >= MAX) return;
          var type = m.media_type || 'image';
          var src = '';
          if (m.preview_image && m.preview_image.src) src = m.preview_image.src;
          else if (m.src && (type === 'image' || !m.media_type)) src = m.src;

          if (type === 'video') {
            if (!src) return;
            pushFrame(src, 'video', { videoUrl: self._bestVideoUrl(m) });
            return;
          }
          if (type === 'external_video') {
            if (!src) return;
            pushFrame(src, 'external_video', {
              externalHost: m.host || '',
              externalId: m.external_id || ''
            });
            return;
          }
          if (type !== 'image') return;
          if (src) pushFrame(src, 'image');
        });

        if (!frames.length && productJson && productJson.images) {
          (productJson.images || []).forEach(function(img) {
            var src = (img && (img.src || img)) || '';
            pushFrame(src, 'image');
          });
        }
        return frames;
      },

      _applyHydratedGallery(handle, gallery) {
        var p = this.productByHandle(handle);
        if (!p || !gallery || !gallery.length) return;
        this._clearHeroCacheForHandle(handle);
        p.images = gallery;
        p.galleryHydrated = true;
      },

      // Fetch full PDP media once per handle and swap into the catalog entry.
      hydrateGalleryFor(handle) {
        if (!handle) return;
        if (this._galleryHydrated[handle] || this._galleryHydrating[handle]) return;
        var existing = this.productByHandle(handle);
        if (existing && existing.galleryHydrated) {
          this._galleryHydrated[handle] = true;
          return;
        }

        var self = this;
        this._galleryHydrating[handle] = true;
        var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
        var url = root + 'products/' + encodeURIComponent(handle) + '.js';

        fetch(url, { credentials: 'same-origin' })
          .then(function(r) { return r.ok ? r.json() : null; })
          .then(function(data) {
            self._galleryHydrating[handle] = false;
            if (!data) return;
            var gallery = self._mediaToGalleryImages(data);
            if (!gallery.length) {
              self._galleryHydrated[handle] = true;
              return;
            }
            self._applyHydratedGallery(handle, gallery);
            self._galleryHydrated[handle] = true;
            // Refresh hero/thumbs if this is still the selected style.
            if (self.previewHandle === handle) {
              if (self.galleryIndex >= gallery.length) self.galleryIndex = 0;
              self.applyHero(false);
            }
          })
          .catch(function(err) {
            self._galleryHydrating[handle] = false;
            console.warn('[market-tote-bundler] gallery hydrate failed', handle, err);
          });
      },

      // Warm the primary hero for a tote on swatch hover/focus only —
      // not a bulk preload of the whole collection (egress-safe).
      prefetchProduct(handle) {
        var p = this.productByHandle(handle);
        if (!p) return;
        // Start media hydrate early so thumbs are ready when clicked.
        this.hydrateGalleryFor(handle);
        var image = (p.images && p.images[0]) || null;
        var url = image
          ? (image.hero900 || image.hero || p.swatchImage)
          : p.swatchImage;
        this.prefetchUrl(url);
      },

      prefetchUrl(url) {
        if (!url || this._prefetchCache[url]) return;
        this._prefetchCache[url] = true;
        var img = new Image();
        img.src = url;
      },

      selectGallery(index) {
        var images = this.previewImages();
        if (index < 0 || index >= images.length) return;
        this.galleryIndex = index;
        this.applyHero(false);
      },

      galleryPrev() {
        var images = this.previewImages();
        if (images.length < 2) return;
        var next = this.galleryIndex - 1;
        if (next < 0) next = images.length - 1;
        this.selectGallery(next);
      },

      galleryNext() {
        var images = this.previewImages();
        if (images.length < 2) return;
        var next = this.galleryIndex + 1;
        if (next >= images.length) next = 0;
        this.selectGallery(next);
      },

      productByHandle(handle) {
        return this.products.find(function(p){ return p.handle === handle; }) || null;
      },

      shortName(title) {
        if (!title) return '';
        var idx = title.indexOf(' - ');
        return idx > 0 ? title.slice(0, idx) : title;
      },

      selectPreview(handle) {
        var p = this.productByHandle(handle);
        if (!p || !p.available) return;
        this.previewHandle = handle;
        this.galleryIndex = 0;
        // false = keep prior sharp hero while the new frame loads (no blur flash).
        this.applyHero(false);
      },

      isPreview(handle) {
        return this.previewHandle === handle;
      },

      /* True when this tote appears at least once in the picks list. */
      isPicked(handle) {
        return this.picks.indexOf(handle) !== -1;
      },

      /* How many of this tote SKU are already in the bundle. */
      pickCount(handle) {
        if (!handle) return 0;
        var n = 0;
        for (var i = 0; i < this.picks.length; i++) {
          if (this.picks[i] === handle) n++;
        }
        return n;
      },

      totalSelected() {
        return this.picks.length;
      },

      remainingCount() {
        return Math.max(0, this.requiredCount - this.picks.length);
      },

      dotIndexes() {
        var out = [];
        for (var i = 1; i <= this.requiredCount; i++) out.push(i);
        return out;
      },

      isComplete() {
        return this.picks.length === this.requiredCount;
      },

      canAddToBundle() {
        if (this.isComplete()) return false;
        var p = this.previewProduct();
        return !!(p && p.available);
      },

      /* Market Tote only adds (no per-slot swap). Show Add/+ on the previewed swatch. */
      showPreviewAction(handle) {
        return this.isPreview(handle) && this.canAddToBundle();
      },

      /*
        First pick of a style: "Add".
        Already in the bundle and room left: "+" so shoppers can add another of the same SKU.
      */
      previewActionLabel() {
        if (this.isPicked(this.previewHandle)) return '+';
        return 'Add';
      },

      addToBundle() {
        if (!this.canAddToBundle()) return;
        this.picks = this.picks.concat([this.previewHandle]);
      },

      removePick(index) {
        if (index < 0 || index >= this.picks.length) return;
        this.picks = this.picks.filter(function(_, i){ return i !== index; });
      },

      /*
        Remove one instance of a tote from the bundle (last match).
        Used by the X on each product tile — duplicates are allowed,
        so we only drop a single pick per click.
      */
      removePickByHandle(handle) {
        var idx = this.picks.lastIndexOf(handle);
        if (idx === -1) return;
        this.removePick(idx);
      },

      pickProduct(index) {
        return this.productByHandle(this.picks[index]);
      },

      subtotalCents() {
        var sum = 0;
        var self = this;
        this.picks.forEach(function(handle) {
          var p = self.productByHandle(handle);
          if (p) sum += p.price;
        });
        return sum;
      },

      discountCents() {
        var sub = this.subtotalCents();
        if (!this.canAddToCart()) return 0;
        {% case discount_type %}
          {% when 'percent' %}
            return Math.round(sub * ({{ discount_value | default: 0 }} / 100));
          {% when 'fixed_off' %}
            return Math.min(sub, {{ discount_value | default: 0 | times: 100 }});
          {% else %}
            return 0;
        {% endcase %}
      },

      totalCents() {
        if (!this.canAddToCart()) return this.subtotalCents();
        return Math.max(0, this.subtotalCents() - this.discountCents());
      },

      formatMoney(cents) {
        if (typeof cents !== 'number') return '';
        if (window.Shopify && window.Shopify.formatMoney) {
          return window.Shopify.formatMoney(cents, '{{ cart.currency.symbol }}');
        }
        return '$' + (cents / 100).toFixed(2);
      },

      canAddToCart() {
        if (this.picks.length !== this.requiredCount) return false;
        for (var i = 0; i < this.picks.length; i++) {
          var p = this.productByHandle(this.picks[i]);
          if (!p || !p.available) return false;
        }
        return true;
      },

      primaryAction() {
        if (this.isComplete()) {
          this.finalizeBundle();
        } else {
          this.addToBundle();
        }
      },

      finalizeBundle() {
        if (!this.canAddToCart() || this.cartLoading) return Promise.resolve();
        this.cartLoading = true;
        this.incompleteReason = '';

        var bundleId = 'tote_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
        var items = [];
        for (var i = 0; i < this.picks.length; i++) {
          var p = this.productByHandle(this.picks[i]);
          if (!p) continue;
          items.push({
            id: p.variantId,
            quantity: 1,
            properties: {
              'Bundle Slot': 'Tote ' + (i + 1),
              '_bundle_id': bundleId,
              '_bundle_type': 'market_tote'
            }
          });
        }

        var self = this;
        var rootScope = (window.Alpine && document.body) ? window.Alpine.$data(document.body) : null;

        return fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: items })
        })
        .then(function(r){
          return r.json().then(function(body){
            if (!r.ok) throw Object.assign(new Error('Add to cart failed'), { body: body });
            return body;
          });
        })
        .then(function() {
          if (self.discountCode) {
            fetch('/discount/' + encodeURIComponent(self.discountCode), {
              method: 'GET',
              credentials: 'same-origin'
            }).catch(function(){});
          }
          if (rootScope && typeof rootScope.updateCart === 'function') {
            rootScope.updateCart(true);
          }
          window.dispatchEvent(new CustomEvent('market-tote-drawer:close'));
        })
        .catch(function(err){
          var msg = (err && err.body && err.body.description) || 'Could not add bundle to cart. Please try again.';
          self.incompleteReason = msg;
          if (rootScope) {
            rootScope.error_title = (err && err.body && err.body.message) || 'Something went wrong';
            rootScope.error_message = msg;
            rootScope.show_alert = true;
          }
          console.error('[market-tote-bundler]', err);
        })
        .finally(function(){
          self.cartLoading = false;
        });
      }
    };
  }

  window.marketToteBundler_{{ js_id }} = marketToteBundlerFactory_{{ js_id }};

  function registerMarketToteBundler_{{ js_id }}() {
    if (!window.Alpine || typeof window.Alpine.data !== 'function') return false;
    window.Alpine.data('marketToteBundler_{{ js_id }}', marketToteBundlerFactory_{{ js_id }});
    return true;
  }
  if (!registerMarketToteBundler_{{ js_id }}()) {
    document.addEventListener('alpine:init', registerMarketToteBundler_{{ js_id }});
  }
})();
</script>
