<!-- snippets/theme__styles.liquid -->
{% comment %} 
  All CSS for theme comes in through here.

  Usage:
    {% render 'theme__styles' %}

  Globals: 
    - settings.type_font_body: set font family for body text
    - settings.type_font_heading: set font family for heading text
    - settings.background_body_light: set the body background color for light mode
    - settings.background_body_dark: set the body background color for dark mode
    - settings.foreground_body_light: set the body foreground for light mode (used for text color)
    - settings.foreground_body_dark: set the body foreground for dark mode (used for text color)
    - settings.background_primary_light: set the primary background color for light mode
    - settings.background_primary_dark: set the primary background color for dark mode
    - settings.foreground_primary_light: set the primary foreground for light mode
    - settings.foreground_primary_dark: set the primary foreground for dark mode
    - settings.background_secondary_light: set the secondary background color for light mode
    - settings.background_secondary_dark: set the secondary background color for dark mode
    - settings.foreground_secondary_light: set the secondary foreground for light mode
    - settings.foreground_secondary_dark: set the secondary foreground for dark mode
    - settings.border_button_radius: set the border radius for buttons
    - settings.border_input_radius: set the border radius for input elements
    - settings.border_element_radius: set the border radius for secondary elements
    - settings.border_width: set the border width
    - settings.border_light: set the border color for light mode
    - settings.border_dark: set the border color for dark mode
    - settings.type_base_size: set base size for font size
    - settings.type_button_capitilization: set capitilization for button text
{% endcomment %}

<noscript><style>
  .js\:animation.opacity-0 {
    opacity: 100 !important;
  }
  .js\:animation.translate-y-4,
  .js\:animation.translate-y-8 {
    transform: translateY(0px) !important;
  }
  .no-js--hide {
    display: none !important;
  }
  .no-js--block {
    display: block !important;
  }
</style></noscript>

{%- liquid
  assign type_font_body = settings.type_font_body
  assign type_font_body_bold = settings.type_font_body | font_modify: 'weight', 'bold'
  assign type_font_body_italic = settings.type_font_body | font_modify: 'style', 'italic'
  assign type_font_body_bold_italic = type_font_body_bold | font_modify: 'style', 'italic'
  assign type_font_heading = settings.type_font_heading
%}

{% style %}

  /* PP Right Grotesk — Tight variants (primary heading font).
   * font-display: optional on the weights that get preloaded — if the
   * font is available within ~100ms it renders directly; otherwise the
   * page sticks with the system fallback for this session (no mid-paint
   * swap = no FOUT). Cached on first visit, so repeat visits render the
   * brand font from the start. */
  @font-face {
    font-family: "PP Right Grotesk";
    font-weight: 500;
    font-style: normal;
    font-display: swap;
    src:
      url("{{ 'RightGrotesk-TightMedium.woff2' | asset_url }}") format("woff2"),
      url("{{ 'RightGrotesk-TightMedium.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "PP Right Grotesk";
    font-weight: 700;
    font-style: normal;
    font-display: optional;
    src:
      url("https://cdn.shopify.com/s/files/1/1030/4291/files/PPRightGrotesk-TightBold.woff2?v=1712089722") format("woff2"),
      url("https://cdn.shopify.com/s/files/1/1030/4291/files/PPRightGrotesk-TightBold.woff?v=1712089722") format("woff"),
      url("https://cdn.shopify.com/s/files/1/1030/4291/files/PPRightGrotesk-TightBold.otf?v=1712089722") format("opentype");
  }

  /* Thread Handwritten — custom font */
  @font-face {
    font-family: "Thread Handwritten";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("{{ 'Handwritten.ttf' | asset_url }}") format("truetype");
  }

  /* Forma DJR Display — all weights */
  @font-face {
    font-family: "FormaDJR";
    font-style: normal;
    font-weight: 300;
    font-display: optional;
    src:
      url("{{ 'FormaDJRDisplay-Light.woff2' | asset_url }}") format("woff2"),
      url("{{ 'FormaDJRDisplay-Light-Testing.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "FormaDJR";
    font-style: italic;
    font-weight: 300;
    font-display: swap;
    src: url("{{ 'FormaDJRDisplay-LightItalic-Testing.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "FormaDJR";
    font-style: normal;
    font-weight: 400;
    font-display: optional;
    src: url("{{ 'FormaDJRDisplay-Regular-Testing.woff2' | file_url }}") format("woff2");
  }
  @font-face {
    font-family: "FormaDJR";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src:
      url("{{ 'FormaDJRDisplay-Medium.woff2' | asset_url }}") format("woff2"),
      url("{{ 'FormaDJRDisplay-Medium-Testing.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "FormaDJR";
    font-style: italic;
    font-weight: 500;
    font-display: swap;
    src: url("{{ 'FormaDJRDisplay-MediumItalic-Testing.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "FormaDJR";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src:
      url("{{ 'FormaDJRDisplay-Bold.woff2' | asset_url }}") format("woff2"),
      url("{{ 'FormaDJRDisplay-Bold-Testing.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "FormaDJR";
    font-style: italic;
    font-weight: 700;
    font-display: swap;
    src: url("{{ 'FormaDJRDisplay-BoldItalic-Testing.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "FormaDJR";
    font-style: normal;
    font-weight: 800;
    font-display: swap;
    src: url("{{ 'FormaDJRDisplay-ExtraBold-Testing.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "FormaDJR";
    font-style: italic;
    font-weight: 800;
    font-display: swap;
    src: url("{{ 'FormaDJRDisplay-ExtraBoldItalic-Testing.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "FormaDJR";
    font-style: normal;
    font-weight: 900;
    font-display: swap;
    src: url("{{ 'FormaDJRDisplay-Black-Testing.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "FormaDJR";
    font-style: italic;
    font-weight: 900;
    font-display: swap;
    src: url("{{ 'FormaDJRDisplay-BlackItalic-Testing.otf' | asset_url }}") format("opentype");
  }

  {{ type_font_body | font_face: font_display: 'optional' }}
  {{ type_font_body_bold | font_face: font_display: 'swap' }}
  {{ type_font_body_italic | font_face: font_display: 'swap' }}
  {{ type_font_body_bold_italic | font_face: font_display: 'swap' }}
  {{ type_font_heading | font_face: font_display: 'optional' }}

  :root {
    --oke-button-backgroundColor: {{ settings.background_primary_light }} !important;
    --oke-button-backgroundColorHover: {{ settings.background_primary_light }} !important;
    --oke-button-backgroundColorActive: {{ settings.background_primary_light }} !important;
    --oke-button-borderColor: {{ settings.background_primary_light }} !important;
    --oke-button-borderColorHover: {{ settings.background_primary_light }} !important;
    --oke-button-borderColorActive: {{ settings.background_primary_light }} !important;
    --oke-avatar-backgroundColor: {{ settings.background_primary_light }} !important;
    --oke-highlightColor: {{ settings.background_primary_light }} !important;
    --oke-attributeBar-markerColor: {{ settings.background_primary_light }} !important;
    --oke-filter-backgroundColorActive: {{ settings.background_primary_light }} !important;
    --oke-filter-borderColor: {{ settings.background_primary_light }} !important;
    --oke-filter-borderColorActive: {{ settings.background_primary_light }} !important;
    --oke-filter-textColor: {{ settings.background_primary_light }} !important;
    --oke-stars-foregroundColor: {{ settings.background_primary_light }} !important;
    
    --color__bg-body-light: {{ settings.background_body_light }};
    --color__bg-overlay-light-1: #f5f5f5;
    --color__bg-overlay-light-2: {{ settings.background_body_light | color_darken: 12 }};
    --color__bg-overlay-light-3: {{ settings.background_body_light | color_darken: 24 }};

    --color__text-light: {{ settings.foreground_body_light }};
    --color__link-light: {{ settings.background_primary_light }};

    --color__text-dark: {{ settings.foreground_body_dark }};

    --color__border-divider-light-1: {{ settings.border_light }};
    --color__border-divider-light-2: {{ settings.border_light | color_darken: 15 }};
    --color__border-divider-light-3: {{ settings.border_light | color_darken: 30 }};
    --color__border-selected-light-1: {{ settings.border_light | color_darken: 45 }};
    --color__border-selected-light-2: {{ settings.border_light | color_darken: 60 }};

    {%- assign _neutral_default = settings.background_body_light | color_darken: 5 | color_mix: settings.background_primary_light, 94 -%}
    {%- assign _plain_default = settings.background_body_light | color_darken: 6 -%}

    --color-primary-button-background-light: {{ settings.btn_primary_bg | default: settings.background_primary_light }};
    --color-primary-button-border-light: {{ settings.btn_primary_border | default: settings.background_primary_light }};
    --color-primary-button-text-light: {{ settings.btn_primary_text | default: settings.foreground_primary_light }};

    --color-secondary-button-background-light: {{ settings.btn_secondary_bg | default: settings.background_secondary_light }};
    --color-secondary-button-border-light: {{ settings.btn_secondary_border | default: settings.background_secondary_light }};
    --color-secondary-button-text-light: {{ settings.btn_secondary_text | default: settings.foreground_secondary_light }};

    --color-tertiary-button-background-light: {{ settings.btn_tertiary_bg | default: settings.background_tertiary_light }};
    --color-tertiary-button-border-light: {{ settings.btn_tertiary_border | default: settings.background_tertiary_light }};
    --color-tertiary-button-text-light: {{ settings.btn_tertiary_text | default: settings.foreground_tertiary_light }};

    --color-neutral-button-background-light: {{ settings.btn_neutral_bg | default: _neutral_default }};
    --color-neutral-button-border-light: {{ settings.btn_neutral_border | default: _neutral_default }};
    --color-neutral-button-text-light: {{ settings.btn_neutral_text | default: settings.foreground_body_light }};

    --color-plain-button-background-light: {{ settings.btn_plain_bg | default: _plain_default }};
    --color-plain-button-border-light: {{ settings.btn_plain_border | default: _plain_default }};
    --color-plain-button-text-light: {{ settings.btn_plain_text | default: settings.foreground_body_light }};

    --color-minimal-button-background-transparent: rgb(0,0,0,0);
    --color-minimal-button-border-light: {{ settings.btn_minimal_light_border | default: settings.foreground_minimal_light }};
    --color-minimal-button-text-light: {{ settings.btn_minimal_light_text | default: settings.foreground_minimal_light }};

    --color-minimal-button-border-dark: {{ settings.btn_minimal_dark_border | default: settings.foreground_minimal_dark }};
    --color-minimal-button-text-dark: {{ settings.btn_minimal_dark_text | default: settings.foreground_minimal_dark }};

    --sizes-border-button-radius: {{ settings.border_button_radius }}px;
    --sizes-border-input-radius: {{ settings.border_input_radius }}px;
    --sizes-border-element-radius: {{ settings.border_element_radius }}px;
    --sizes-border-width: {{ settings.border_width }}px;
    --sizes-gap-width: {{ settings.layout_gap_size }}px;

    /* ============================================================
       Thread brand tokens — the single source of truth for the
       design system (see docs/design-system.md). Sections consume
       these variables; never hardcode the underlying values.
       Colors are merchant-editable in Theme settings → Brand tokens.
       ============================================================ */
    /* Alias: some stored settings say "heading", the real var is
       --type-font-header-family — without this alias those silently
       fall back to the body font (the Shop by Category bug). */
    --type-font-heading-family: var(--type-font-header-family);
    /* Eyebrows track wide — distinct from the 0.085em label role. */
    --thread-ls-eyebrow: 0.16em;
    --thread-blue: {{ settings.brand_blue | default: '#1e7db3' }};
    --thread-ink: {{ settings.brand_ink | default: '#1c1c1c' }};
    --thread-gold: {{ settings.brand_gold | default: '#eebc2c' }};
    --thread-bronze: {{ settings.brand_bronze | default: '#c08951' }};
    --thread-bone: {{ settings.brand_bone | default: '#f4f1ea' }};
    --thread-putty: {{ settings.brand_putty | default: '#e0ddd8' }};
    --thread-hairline: {{ settings.brand_hairline | default: '#e3ded2' }};
    --thread-grey: {{ settings.brand_grey | default: '#888888' }};
    --thread-radius-pill: 999px;
    --thread-btn-height: 52px;
    --thread-ls-label: 0.085em;
    --thread-ls-body: 0.07em;
    --thread-ease: cubic-bezier(0, 0, 0.3, 1);
    --thread-dur-reveal: 0.55s;
    --thread-dur-hover: 0.3s;

    --type-font-body-family: "FormaDJR", {{ settings.type_font_body.fallback_families }};
    --type-font-body-style: {{ settings.type_font_body.style }};
    --type-font-body-weight: 300;
    --type-font-body-letter-spacing: var(--thread-ls-body);
    --type-font-header-family: "PP Right Grotesk", {{ settings.type_font_heading.fallback_families }};
    --type-font-header-style: {{ settings.type_font_heading.style }};
    --type-font-header-weight: {{ settings.type_font_heading.weight }};
    /* Nav font retired: Source Sans Pro removed. Anything still referencing --type-font-nav-* resolves to the body font (Forma DJR). */
    --type-font-nav-family: {{ settings.type_font_body.family }}, {{ settings.type_font_body.fallback_families }};
    --type-font-nav-style: {{ settings.type_font_body.style }};
    --type-font-nav-weight: {{ settings.type_font_body.weight }};
    --type-font-handwritten-family: "Thread Handwritten", cursive;
    --type-font-base-size: {{ settings.type_base_size }}px;
  }

  /* --- Pre-launch pass: global CTA/hover/focus rules --- */

  /* The compiled base stylesheet fades EVERY anchor to 50% on hover.
     Primary CTAs and header links must not fade — they have their own
     hover language (lift/sweep/arrow-nudge). */
  .ts-cta:hover,
  .ugc-gallery__cta:hover,
  [class*="ig-headlink"]:hover,
  a.thread-pill:hover,
  .bs-cta:hover {
    opacity: 1 !important;
  }

  /* Product cards: one hover language sitewide — lift + soft shadow,
     slow 1.03 zoom on the image. Hover-capable devices only. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .bs-product-item {
      transition: transform 0.3s cubic-bezier(0,0,.3,1), box-shadow 0.3s cubic-bezier(0,0,.3,1);
    }
    .bs-product-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 30px rgba(28,28,28,0.08);
    }
    .pc-media__frame { overflow: hidden; }
    .pc-media__frame img {
      transition: transform 0.9s cubic-bezier(0,0,.3,1);
    }
    .bs-product-item:hover .pc-media__frame img,
    .pc-media:hover .pc-media__frame img {
      transform: scale(1.03);
    }
  }

  /* Keyboard focus: visible ring on all custom interactive elements. */
  [class*="bs-filter-btn"]:focus-visible,
  .hp-qf-bar__chip:focus-visible,
  .pc-quick-add:focus-visible,
  .pc-media__slide:focus-visible,
  .ts-cta:focus-visible,
  .bs-cta:focus-visible,
  [class*="ig-headlink"]:focus-visible {
    outline: 2px solid var(--thread-blue);
    outline-offset: 2px;
    border-radius: 4px;
  }

{% endstyle %}

<style>
  /* ========================================
     Typography tokens — fluid clamp() classes
     Change in Theme Settings > Typography tokens
     ======================================== */

  .type-display {
    font-family: var(--type-font-{{ settings.token_display_font }}-family) !important;
    font-size: clamp({{ settings.token_display_min }}px, {{ settings.token_display_min | plus: settings.token_display_max | divided_by: 2 | divided_by: 16.0 | times: 1.0 }}vw + 1rem, {{ settings.token_display_max }}px) !important;
    font-weight: {{ settings.token_display_weight }} !important;
    text-transform: {{ settings.token_display_transform }} !important;
    letter-spacing: {{ settings.token_display_spacing }} !important;
    line-height: {{ settings.token_display_lh }} !important;
    {% if settings.token_display_color != blank %}color: {{ settings.token_display_color }} !important;{% endif %}
  }

  .type-h1 {
    font-family: var(--type-font-{{ settings.token_h1_font }}-family) !important;
    font-size: clamp({{ settings.token_h1_min }}px, {{ settings.token_h1_min | plus: settings.token_h1_max | divided_by: 2 | divided_by: 16.0 | times: 1.0 }}vw + 1rem, {{ settings.token_h1_max }}px) !important;
    font-weight: {{ settings.token_h1_weight }} !important;
    text-transform: {{ settings.token_h1_transform }} !important;
    letter-spacing: {{ settings.token_h1_spacing }} !important;
    line-height: {{ settings.token_h1_lh }} !important;
    {% if settings.token_h1_color != blank %}color: {{ settings.token_h1_color }} !important;{% endif %}
  }

  .type-h2 {
    font-family: var(--type-font-{{ settings.token_h2_font }}-family) !important;
    font-size: clamp({{ settings.token_h2_min }}px, {{ settings.token_h2_min | plus: settings.token_h2_max | divided_by: 2 | divided_by: 16.0 | times: 1.0 }}vw + 1rem, {{ settings.token_h2_max }}px) !important;
    font-weight: {{ settings.token_h2_weight }} !important;
    text-transform: {{ settings.token_h2_transform }} !important;
    letter-spacing: {{ settings.token_h2_spacing }} !important;
    line-height: {{ settings.token_h2_lh }} !important;
    {% if settings.token_h2_color != blank %}color: {{ settings.token_h2_color }} !important;{% endif %}
  }

  .type-h3 {
    font-family: var(--type-font-{{ settings.token_h3_font }}-family) !important;
    font-size: clamp({{ settings.token_h3_min }}px, {{ settings.token_h3_min | plus: settings.token_h3_max | divided_by: 2 | divided_by: 16.0 | times: 1.0 }}vw + 1rem, {{ settings.token_h3_max }}px) !important;
    font-weight: {{ settings.token_h3_weight }} !important;
    text-transform: {{ settings.token_h3_transform }} !important;
    letter-spacing: {{ settings.token_h3_spacing }} !important;
    line-height: {{ settings.token_h3_lh }} !important;
    {% if settings.token_h3_color != blank %}color: {{ settings.token_h3_color }} !important;{% endif %}
  }

  .type-body {
    font-family: var(--type-font-{{ settings.token_body_font }}-family) !important;
    font-size: clamp({{ settings.token_body_min }}px, {{ settings.token_body_min | plus: settings.token_body_max | divided_by: 2 | divided_by: 16.0 | times: 1.0 }}vw + 0.5rem, {{ settings.token_body_max }}px) !important;
    font-weight: {{ settings.token_body_weight }} !important;
    letter-spacing: {{ settings.token_body_spacing }} !important;
    line-height: {{ settings.token_body_lh }} !important;
    {% if settings.token_body_color != blank %}color: {{ settings.token_body_color }} !important;{% endif %}
  }

  .type-small {
    font-family: var(--type-font-{{ settings.token_small_font }}-family) !important;
    font-size: clamp({{ settings.token_small_min }}px, {{ settings.token_small_min | plus: settings.token_small_max | divided_by: 2 | divided_by: 16.0 | times: 1.0 }}vw + 0.25rem, {{ settings.token_small_max }}px) !important;
    font-weight: {{ settings.token_small_weight }} !important;
    letter-spacing: {{ settings.token_small_spacing }} !important;
    line-height: {{ settings.token_small_lh }} !important;
    {% if settings.token_small_color != blank %}color: {{ settings.token_small_color }} !important;{% endif %}
  }

  .type-label {
    font-family: var(--type-font-{{ settings.token_label_font }}-family) !important;
    font-size: clamp({{ settings.token_label_min }}px, {{ settings.token_label_min | plus: settings.token_label_max | divided_by: 2 | divided_by: 16.0 | times: 1.0 }}vw + 0.25rem, {{ settings.token_label_max }}px) !important;
    font-weight: {{ settings.token_label_weight }} !important;
    text-transform: {{ settings.token_label_transform }} !important;
    letter-spacing: {{ settings.token_label_spacing }} !important;
    line-height: {{ settings.token_label_lh }} !important;
    {% if settings.token_label_color != blank %}color: {{ settings.token_label_color }} !important;{% endif %}
  }

  /* Global spacing tokens */
  .spacing-global {
    padding-left: {{ settings.token_padding_sides_mobile }}px !important;
    padding-right: {{ settings.token_padding_sides_mobile }}px !important;
    padding-top: {{ settings.token_padding_top_mobile }}px;
    padding-bottom: {{ settings.token_padding_bottom_mobile }}px;
  }
  @media (min-width: 768px) {
    .spacing-global {
      padding-left: {{ settings.token_padding_sides_desktop }}px !important;
      padding-right: {{ settings.token_padding_sides_desktop }}px !important;
      padding-top: {{ settings.token_padding_top_desktop }}px;
      padding-bottom: {{ settings.token_padding_bottom_desktop }}px;
    }
  }
  /* Side padding only (for sections that control top/bottom independently) */
  .spacing-sides {
    padding-left: {{ settings.token_padding_sides_mobile }}px !important;
    padding-right: {{ settings.token_padding_sides_mobile }}px !important;
  }
  @media (min-width: 768px) {
    .spacing-sides {
      padding-left: {{ settings.token_padding_sides_desktop }}px !important;
      padding-right: {{ settings.token_padding_sides_desktop }}px !important;
    }
  }

  /* ======================================== */

  .btn {
    border-width: var(--sizes-border-width) !important;
    border-radius: var(--sizes-border-button-radius) !important;
  }

  {%- assign _btn_variants = 'primary,secondary,tertiary,neutral,plain,minimal_light,minimal_dark' | split: ',' -%}
  {%- for _v in _btn_variants -%}
    {%- case _v -%}
      {%- when 'minimal_light' -%}{%- assign _sel = '.btn--minimal-light' -%}
      {%- when 'minimal_dark'  -%}{%- assign _sel = '.btn--minimal-dark'  -%}
      {%- else -%}{%- assign _sel = '.btn--' | append: _v -%}
    {%- endcase -%}
    {%- assign _kp = 'btn_' | append: _v -%}
    {%- assign _font_key = _kp | append: '_font' -%}
    {%- assign _pv_key   = _kp | append: '_padding_v' -%}
    {%- assign _ph_key   = _kp | append: '_padding_h' -%}
    {%- assign _fs_key   = _kp | append: '_font_size' -%}
    {%- assign _fsm_key  = _kp | append: '_font_size_mobile' -%}
    {%- assign _fw_key   = _kp | append: '_font_weight' -%}
    {%- assign _tt_key   = _kp | append: '_text_transform' -%}
    {%- assign _ls_key   = _kp | append: '_letter_spacing' -%}
    {%- assign _font = settings[_font_key] | default: 'inherit' -%}
    {%- assign _pv   = settings[_pv_key]   | default: 8 -%}
    {%- assign _ph   = settings[_ph_key]   | default: 24 -%}
    {%- assign _fs   = settings[_fs_key]   | default: 14 -%}
    {%- assign _fsm  = settings[_fsm_key]  | default: 14 -%}
    {%- assign _fw   = settings[_fw_key]   | default: '800' -%}
    {%- assign _tt   = settings[_tt_key]   | default: 'uppercase' -%}
    {%- assign _ls   = settings[_ls_key]   | default: '0.1em' -%}

    {{ _sel }} {
      padding: {{ _pv }}px {{ _ph }}px !important;
      font-size: {{ _fs }}px !important;
      font-weight: {{ _fw }} !important;
      text-transform: {{ _tt }} !important;
      letter-spacing: {{ _ls }} !important;
      {% if _font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if _font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if _font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if _font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
    {{ _sel }} * {
      font-size: {{ _fs }}px !important;
      font-weight: {{ _fw }} !important;
      text-transform: {{ _tt }} !important;
      letter-spacing: {{ _ls }} !important;
      {% if _font == 'body' %}font-family: var(--type-font-body-family) !important;{% endif %}
      {% if _font == 'heading' %}font-family: var(--type-font-header-family) !important;{% endif %}
      {% if _font == 'nav' %}font-family: var(--type-font-nav-family) !important;{% endif %}
      {% if _font == 'handwritten' %}font-family: var(--type-font-handwritten-family) !important;{% endif %}
    }
    @media (max-width: 749px) {
      {{ _sel }} { font-size: {{ _fsm }}px !important; }
      {{ _sel }} * { font-size: {{ _fsm }}px !important; }
    }
  {%- endfor -%}

  {%- comment -%} Underline controls for plain / minimal-light / minimal-dark {%- endcomment -%}
  {%- assign _ul_variants = 'plain,minimal_light,minimal_dark' | split: ',' -%}
  {%- for _v in _ul_variants -%}
    {%- case _v -%}
      {%- when 'minimal_light' -%}{%- assign _sel = '.btn--minimal-light' -%}
      {%- when 'minimal_dark'  -%}{%- assign _sel = '.btn--minimal-dark'  -%}
      {%- else -%}{%- assign _sel = '.btn--' | append: _v -%}
    {%- endcase -%}
    {%- assign _ukp = 'btn_' | append: _v -%}
    {%- assign _us_key = _ukp | append: '_underline_show' -%}
    {%- assign _ut_key = _ukp | append: '_underline_thickness' -%}
    {%- assign _uw_key = _ukp | append: '_underline_width' -%}
    {%- assign _uo_key = _ukp | append: '_underline_offset' -%}
    {%- assign _upv_key = _ukp | append: '_padding_v' -%}
    {%- assign _u_show   = settings[_us_key] -%}
    {%- assign _u_thick  = settings[_ut_key]  | default: 1 -%}
    {%- assign _u_width  = settings[_uw_key]  | default: 'text' -%}
    {%- assign _u_offset = settings[_uo_key]  | default: 3 -%}
    {%- assign _u_pv     = settings[_upv_key] | default: 8 -%}
    {%- assign _u_pb_full = _u_pv | plus: _u_offset -%}

    {%- if _u_show -%}
      {%- if _u_width == 'full' -%}
        {{ _sel }} {
          text-decoration: none !important;
          border-bottom: {{ _u_thick }}px solid currentColor !important;
          padding-bottom: {{ _u_pb_full }}px !important;
        }
      {%- else -%}
        {{ _sel }} {
          text-decoration: underline !important;
          text-decoration-thickness: {{ _u_thick }}px !important;
          text-underline-offset: {{ _u_offset }}px !important;
          text-decoration-color: currentColor !important;
          border-bottom: 0 !important;
        }
      {%- endif -%}
    {%- else -%}
      {{ _sel }} {
        text-decoration: none !important;
        border-bottom: 0 !important;
      }
    {%- endif -%}
  {%- endfor -%}

  /* Glass (light) button — customizable via Theme Settings > Buttons */
  .btn--glass,
  a.btn--glass,
  a.btn--glass:link,
  a.btn--glass:visited,
  a.btn--glass:active,
  a.btn--glass:hover {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: {{ settings.btn_glass_pad_v }}px {{ settings.btn_glass_pad_h }}px !important;
    {% assign gl_r = settings.btn_glass_bg | color_extract: 'red' %}
    {% assign gl_g = settings.btn_glass_bg | color_extract: 'green' %}
    {% assign gl_b = settings.btn_glass_bg | color_extract: 'blue' %}
    {% assign gl_a = settings.btn_glass_opacity | divided_by: 100.0 %}
    background-color: rgba({{ gl_r }}, {{ gl_g }}, {{ gl_b }}, {{ gl_a }}) !important;
    {% if settings.btn_glass_blur > 0 %}
      backdrop-filter: blur({{ settings.btn_glass_blur }}px) !important;
      -webkit-backdrop-filter: blur({{ settings.btn_glass_blur }}px) !important;
    {% endif %}
    border: {{ settings.border_width }}px solid {{ settings.btn_glass_border_color }} !important;
    border-bottom: {{ settings.border_width }}px solid {{ settings.btn_glass_border_color }} !important;
    border-radius: var(--sizes-border-button-radius) !important;
    color: {{ settings.btn_glass_text }} !important;
    font-family: var(--type-font-{{ settings.btn_glass_font }}-family) !important;
    font-weight: {{ settings.btn_glass_weight }} !important;
    font-size: {{ settings.btn_glass_size }}px !important;
    letter-spacing: {{ settings.btn_glass_letter_spacing }} !important;
    text-transform: {{ settings.btn_glass_transform }} !important;
    text-decoration: none !important;
    text-decoration-line: none !important;
    line-height: 1.4 !important;
    cursor: pointer !important;
    box-shadow: none !important;
    transition: background-color 0.2s ease !important;
  }
  a.btn--glass:hover {
    {% assign gl_a_hover = settings.btn_glass_opacity | plus: 15 | at_most: 100 | divided_by: 100.0 %}
    background-color: rgba({{ gl_r }}, {{ gl_g }}, {{ gl_b }}, {{ gl_a_hover }}) !important;
  }
  .btn--glass *, a.btn--glass * {
    color: {{ settings.btn_glass_text }} !important;
    text-decoration: none !important;
  }

  /* Glass (dark) button */
  .btn--glass-dark,
  a.btn--glass-dark,
  a.btn--glass-dark:link,
