  /* Subtle top-down gradient behind the transparent header to improve white-text contrast
     over the hero. Fades out once the user scrolls (header--scrolled). */
  {% if settings.header_gradient_enable %}
    {%- assign _hg_color = settings.header_gradient_color | default: '#000000' -%}
    {%- assign _hg_r = _hg_color | color_extract: 'red' -%}
    {%- assign _hg_g = _hg_color | color_extract: 'green' -%}
    {%- assign _hg_b = _hg_color | color_extract: 'blue' -%}
    {%- assign _hg_alpha = settings.header_gradient_opacity | default: 35 | divided_by: 100.0 -%}
    .header--transparent::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: {{ settings.header_gradient_height | default: 80 }}px;
      pointer-events: none;
      background: linear-gradient(to bottom, rgba({{ _hg_r }}, {{ _hg_g }}, {{ _hg_b }}, {{ _hg_alpha }}) 0%, rgba({{ _hg_r }}, {{ _hg_g }}, {{ _hg_b }}, 0) 100%);
      z-index: -1;
      opacity: 1;
      transition: opacity 0.3s ease;
    }
    .header--transparent.header--scrolled::before {
      opacity: 0;
    }
  {% endif %}

  /* Transparent header on homepage — fixed at top; the opaque bar slides down from above
     behind the logo and links as the user scrolls past 10px. Driven by `html.is-scrolled`. */
  .header--transparent {
    position: fixed !important;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }
  .header--transparent nav {
    position: relative;
    background-color: transparent !important;
    border-color: transparent !important;
    isolation: isolate;
  }
  .header--transparent nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-body-background-light, #ffffff);
    border-bottom: 1px solid var(--color-border-divider-1, #e5e5e5);
    transform: translateY(-100%);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: -1;
    pointer-events: none;
  }
  html.is-scrolled .header--transparent nav::before {
    transform: translateY(0);
  }
  /* Hover opens the bar early when unscrolled */
  html:not(.is-scrolled) .header--transparent nav:hover::before {
    transform: translateY(0);
  }
  /* Announcement bar — protected by its own !important styles */
  /* Dropdown always keeps its own colors */
  .header--transparent .header__dropdown,
  .header--transparent .header__dropdown * {
    color: inherit !important;
    stroke: currentColor !important;
    filter: none !important;
  }
  /* Light text mode — only top-level bar elements, NOT dropdowns.

     IMPORTANT: the nav link's text lives in an inner
     <span class="header__link-text">, and the header section's nav
     typography rule (#shopify-section-X .header__nav-link *) sets
     `color` DIRECTLY on that span when the merchant has picked a
     nav text color. A direct declaration always beats an inherited
     value — even an !important one on the parent — so the rules
     here must target the span (and any other descendants) directly,
     not rely on inheritance from the <a>. */
  .header--transparent:not(.header--scrolled).header--text-light > * > nav > div > div > a,
  .header--transparent:not(.header--scrolled).header--text-light > * > nav > div > div > div > a,
  .header--transparent:not(.header--scrolled).header--text-light > * > nav > div > div > div > button,
  .header--transparent:not(.header--scrolled).header--text-light > * > nav > div > div > div > div > a,
  .header--transparent:not(.header--scrolled).header--text-light > * > nav > div > div > div > div > span,
  .header--transparent:not(.header--scrolled).header--text-light .header__link,
  .header--transparent:not(.header--scrolled).header--text-light .header__link *:not(.cart-count-badge),
  .header--transparent:not(.header--scrolled).header--text-light .header__nav-link,
  .header--transparent:not(.header--scrolled).header--text-light .header__nav-link *:not(.cart-count-badge),
  .header--transparent:not(.header--scrolled).header--text-light .header__link-text {
    color: #ffffff !important;
  }
  .header--transparent:not(.header--scrolled).header--text-light > * > nav > div > div svg,
  .header--transparent:not(.header--scrolled).header--text-light > * > nav > div > div > div svg {
    stroke: #ffffff !important;
  }
  .header--transparent:not(.header--scrolled).header--text-light > * > nav > div > div img {
    filter: brightness(0) invert(1);
  }
  /* Dark text mode — only top-level bar elements. Same direct-span
     coverage as light mode above. */
  .header--transparent:not(.header--scrolled).header--text-dark .header__link,
  .header--transparent:not(.header--scrolled).header--text-dark .header__link *:not(.cart-count-badge),
  .header--transparent:not(.header--scrolled).header--text-dark .header__nav-link,
  .header--transparent:not(.header--scrolled).header--text-dark .header__nav-link *:not(.cart-count-badge),
  .header--transparent:not(.header--scrolled).header--text-dark .header__link-text {
    color: var(--thread-ink) !important;
  }
  /* Reset colors on hover (transparent state) — the white bar slides
     down on nav hover even before scrolling, so the text must flip to
     dark here too. Must match (or beat) the specificity of the
     .header--text-light rules above: those target inner spans directly
     (.header__nav-link *:not(...)), so this reset needs the same
     direct-descendant selectors or the white wins the !important tie. */
  .header--transparent:not(.header--scrolled):hover .header__link,
  .header--transparent:not(.header--scrolled):hover .header__link *:not(.cart-count-badge),
  .header--transparent:not(.header--scrolled):hover .header__nav-link,
  .header--transparent:not(.header--scrolled):hover .header__nav-link *:not(.cart-count-badge),
  .header--transparent:not(.header--scrolled):hover .header__link-text,
  .header--transparent:not(.header--scrolled):hover a,
  .header--transparent:not(.header--scrolled):hover button,
  .header--transparent:not(.header--scrolled):hover span:not(.cart-count-badge) {
    color: var(--thread-ink) !important;
  }
  .header--transparent:not(.header--scrolled):hover svg,
  .header--transparent:not(.header--scrolled):hover > * > nav svg,
  .header--transparent:not(.header--scrolled):hover > * > nav > div > div svg,
  .header--transparent:not(.header--scrolled):hover > * > nav > div > div > div svg {
    stroke: var(--thread-ink) !important;
  }
  .header--transparent:not(.header--scrolled):hover img,
  .header--transparent:not(.header--scrolled):hover > * > nav > div > div img {
    filter: none !important;
  }
  /* Reset colors when scrolled */
  .header--transparent.header--scrolled .header__link,
  .header--transparent.header--scrolled .header__nav-link,
  .header--transparent.header--scrolled a,
  .header--transparent.header--scrolled button,
  .header--transparent.header--scrolled span:not(.cart-count-badge) {
    color: var(--thread-ink) !important;
  }
  .header--transparent.header--scrolled svg,
  .header--transparent.header--scrolled > * > nav svg,
  .header--transparent.header--scrolled > * > nav > div > div svg,
  .header--transparent.header--scrolled > * > nav > div > div > div svg {
    stroke: var(--thread-ink) !important;
  }
  .header--transparent.header--scrolled img {
    filter: none !important;
  }
  /* Protect badge text — always keep white */
  .header--transparent .cart-count-badge,
  .header--transparent.header--scrolled .cart-count-badge,
  .header--transparent:hover .cart-count-badge {
    color: var(--color-primary-button-text-light, #ffffff) !important;
    filter: none !important;
  }
  .header--transparent .border__button--radius,
  .header--transparent .border__button--radius span {
    filter: none !important;
  }

  /* Nav hover underline — thin, text-width only */
  .header__link:hover,
  .header__link--hover {
    box-shadow: none !important;
  }
  .header__link .header__link-text {
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .header__link:hover .header__link-text,
  .header__link--hover .header__link-text {
    border-bottom-color: var(--thread-ink);
  }

  /* Kill hover dropdown on product cards */
  .group:hover .group-hover\:flex { display: none !important; }
  .group:hover .group-hover\:invisible { visibility: visible !important; }
  .group:hover { border-color: transparent !important; }
  .group { border: none !important; }

  /* Product card badges — merchant-controlled size */
  .js-product-card-badges > div {
    padding: {{ settings.product_card_badge_pad_v | default: 4 }}px {{ settings.product_card_badge_pad_h | default: 8 }}px !important;
  }
  .js-product-card-badges > div > .type--smaller {
    font-size: {{ settings.product_card_badge_font_size | default: 12 }}px !important;
    line-height: 1.2 !important;
  }
  .js-product-card-badges {
    gap: {{ settings.product_card_badge_gap | default: 4 }}px !important;
  }

  /* Bigger swatches on desktop */
  [class*="js\:swatchList"] .btn.btn--plain.btn--small {
    width: {{ settings.product_card_swatch_size | default: 20 }}px !important;
    height: {{ settings.product_card_swatch_size | default: 20 }}px !important;
    min-width: {{ settings.product_card_swatch_size | default: 20 }}px !important;
    min-height: {{ settings.product_card_swatch_size | default: 20 }}px !important;
    padding: 0 !important;
    border: none !important;
  }
  [class*="js\:swatchList"] .flex.flex-wrap {
    gap: {{ settings.product_card_swatch_gap | default: 6 }}px !important;
  }

  /* ============================================================
     Server-rendered swatch carousel (component__swatch-list.liquid)
     All siblings drag-scroll horizontally in one track. Size/gap/padding/
     margin values are viewport-specific via --tw-*-d (desktop) / --tw-*-m (mobile)
     custom properties set inline on .tw-swatch-wrap.
     ============================================================ */
  .tw-swatch-wrap {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    margin-bottom: var(--tw-mb-m, 6px);
    padding: 0 var(--tw-pad-m, 0px);
  }
  .tw-swatch-track {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    column-gap: var(--tw-gap-m, 4px);
    min-width: 0;
    max-width: 100%;
    min-height: calc(var(--tw-size-m, 18px) + 6px);
    /* 2px horizontal padding so the 1.5px selected-swatch ring (box-shadow)
       on the first/last swatch isn't clipped by overflow-x. */
    padding-left: 2px;
    padding-right: 2px;
    overflow-x: auto;
    overflow-y: hidden;
    /* pan-x pan-y lets the browser route horizontal drags to the track
       (overflow-x:auto) and vertical drags up to the page (overflow-y:hidden). */
    touch-action: pan-x pan-y;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    box-sizing: border-box;
  }
  .tw-swatch-track::-webkit-scrollbar { display: none; }
  .tw-swatch {
    display: block;
    flex-shrink: 0;
    width: var(--tw-size-m, 18px);
    height: var(--tw-size-m, 18px);
    min-width: var(--tw-size-m, 18px);
    border-radius: 50%;
    background: #e8e8e8 center/cover no-repeat;
    transition: transform 0.15s ease;
    scroll-snap-align: start;
  }
  .tw-swatch:hover { transform: scale(1.08); }
  /* Selected-state ring drawn INSIDE the swatch circle so the first/last
     item in the scroll track can't clip it against overflow-x: auto. */
  .tw-swatch--current { box-shadow: inset 0 0 0 1.5px currentColor; }
  /* "+N" overflow count after the capped swatch row */
  .tw-swatch-more {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--tw-size-m, 18px);
    min-width: var(--tw-size-m, 18px);
    padding: 0 5px;
    border-radius: var(--thread-radius-pill);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--thread-grey);
    background: #f0ede6;
    text-decoration: none;
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    .tw-swatch-wrap {
      margin-bottom: var(--tw-mb-d, 8px);
      padding: 0 var(--tw-pad-d, 0px);
    }
    .tw-swatch-track {
      column-gap: var(--tw-gap-d, 6px);
      min-height: calc(var(--tw-size-d, 24px) + 6px);
    }
    .tw-swatch {
      width: var(--tw-size-d, 24px);
      height: var(--tw-size-d, 24px);
      min-width: var(--tw-size-d, 24px);
    }
    .tw-swatch-more {
      height: var(--tw-size-d, 24px);
      min-width: var(--tw-size-d, 24px);
      font-size: 11px;
    }
  }

  /* ============================================================
     Product-card image carousel (.pc-media)
     Desktop: hover reveals left/right arrows; click arrows to cycle
              through product.images (scrollBy a full viewport).
     Mobile:  native touch swipe via scroll-snap; thin progress bar
              at the bottom indicates current position.
     Swatch overlay: absolute <img> layered on top of the track, shown
              by the script layer when a swatch is hovered or tapped.
     ============================================================ */
  /* Collection sidebar — desktop edge-padding override (mobile is inline). */
  @media (min-width: 768px) {
    .cs-grid-edge {
      padding-left: var(--cs-pad-d, 16px) !important;
      padding-right: var(--cs-pad-d, 16px) !important;
    }
  }

  .pc-media {
    position: relative;
    width: 100%;
  }
  /* .pc-media__frame carries the aspect-ratio class (aspect-w-*/aspect-h-*)
     which forces its sole direct child — the track — to absolute inset:0.
     We isolate the aspect-ratio wrapper to avoid the Tailwind plugin's
     `> *` rule stacking every slide on top of each other. */
  .pc-media__frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    /* Paint containment: prevents sub-pixel render of the neighboring
       slide from bleeding past the frame edges during iOS snap/bounce. */
    contain: paint;
  }
  .pc-media__track {
    position: absolute;
    inset: 0;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    /* pan-x pan-y: horizontal drag → track scroll, vertical drag → page scroll. */
    touch-action: pan-x pan-y;
    /* `none` (not `contain`) disables the inner rubber-band bounce on iOS
       so the next slide can't peek past the edge during overshoot. */
    overscroll-behavior-x: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
    width: 100%;
    height: 100%;
  }
  .pc-media__track::-webkit-scrollbar { display: none; }
  .pc-media__slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .pc-media__img { display: block; width: 100%; height: 100%; }

  .pc-media__preview-link {
    position: absolute;
    inset: 0;
    display: block;
    color: inherit;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.18s ease;
    pointer-events: none;
    z-index: 2;
  }
  .pc-media[data-pc-preview-active="true"] .pc-media__preview-link {
