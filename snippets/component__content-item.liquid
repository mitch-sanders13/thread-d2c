<!-- snippets/component__content-item.liquid -->
{% comment %} 
  Thumbnail for simple content in a product or collection grid.
  Accepts:
    - background_color: set background color
    - background_image: desktop image
    - mobile_image: mobile image
    - video: desktop video
    - mobile_video: mobile video
    - url: url to link to
    - title: string for title
    - content: string for content text
    - button_label: string for button label
    - index: where to place item in a grid
    - size_desktop: how wide the block spans on desktop
    - size_mobile: how wide the block spans on mobile
  
  Usage:
    {% render 'component__content-item',
      background_color: settings.thumbmails_color_scheme,
      url: block.settings.url,
      title: block.settings.heading,
      content: block.settings.content,
      button_label: block.settings.button_label, 
      index: gridIndex %}
  
  Globals:
    - settings.thumbnails_color_border: border color
    - settings.thumbmails_color_scheme: color scheme of thumbnails
    - settings.enable_animations: boolean to enable animations
  
  Possible enhancements: 
    - Add support to change background color.
    - Add support to include background image or video. 
    - Merge component with component__card.
  
  Pro tips:
    - Use this snippet to display promotional content within a product or collection grid.
{% endcomment %}


{%- assign has_overlay_content = false -%}
{%- unless title == blank and content == blank and button_label == blank -%}
  {%- assign has_overlay_content = true -%}
{%- endunless -%}

{% if url != blank %}
  <a href="{{ url }}"
    class="relative hover:no-underline border--radius md:min-h-[300px] overflow-hidden no-underline object-cover flex flex-col justify-end w-full
    {{ size_desktop }}
    {{ size_mobile }}
    {{ background_color }}  
    {{ settings.thumbnails_color_border }}">
  {% else %} 
    <div
      class="relative hover:no-underline border--radius md:min-h-[300px] overflow-hidden no-underline object-cover flex flex-col justify-end w-full
      {{ size_desktop }}
      {{ size_mobile }}
      {{ background_color }}  
      {{ settings.thumbnails_color_border }}">
  {% endif %}
    
    {%- assign has_mobile_video = false -%}
    {%- assign has_mobile_image = false -%}
    {%- if mobile_video != blank -%}
      {%- assign has_mobile_video = true -%}
    {%- endif -%}
    {%- if mobile_image != blank -%}
      {%- assign has_mobile_image = true -%}
    {%- endif -%}
    {%- assign has_mobile_media = false -%}
    {%- if has_mobile_video or has_mobile_image -%}
      {%- assign has_mobile_media = true -%}
    {%- endif -%}
    {%- assign desktop_media_class = 'w-full object-cover grow h-0' -%}
    {%- assign mobile_media_class = 'w-full object-cover grow h-0 md:hidden' -%}
    {%- if has_mobile_media -%}
      {%- assign desktop_media_class = 'w-full object-cover grow h-0 hidden md:block' -%}
    {%- endif -%}

    {%- if has_mobile_media -%}
      {%- if has_overlay_content -%}
        {%- comment -%} Mobile media (with content): match product card image sizing {%- endcomment -%}
        {%- if has_mobile_video -%}
          <div class="md:hidden w-full overflow-hidden color__bg-overlay-1">
            <div class="{{ settings.thumbnails_ratio }} relative overflow-hidden">
              {{ mobile_video | video_tag: class: 'absolute inset-0 w-full h-full object-cover', style: 'object-fit:cover', sizes: sizes, loading: 'lazy', autoplay: autoplay, loop: loop, muted: muted, controls: false }}
            </div>
          </div>
        {%- elsif has_mobile_image -%}
          <div class="md:hidden w-full overflow-hidden color__bg-overlay-1">
            {% render 'component__image',
              image: mobile_image,
              aspect_ratio: settings.thumbnails_ratio,
              background: 'color__bg-shade-2',
              crop: 'object-cover',
              container_class: 'h-full w-full',
              image_class: 'w-full h-full object-cover',
              max_width: 400,
              enable_lazy_load: true,
              include_2x: true
            %}
          </div>
        {%- endif -%}
      {%- else -%}
        {%- comment -%} Mobile media (no content): behave exactly like desktop (fill card) {%- endcomment -%}
        {%- if has_mobile_video -%}
          {{ mobile_video | video_tag: class: mobile_media_class, style: 'object-fit:cover', sizes: sizes, loading: 'lazy', autoplay: autoplay, loop: loop, muted: muted, controls: false }}
        {%- elsif has_mobile_image -%}
          {{ mobile_image | image_url: width: 800 | image_tag: style: 'object-fit:cover', class: mobile_media_class, loading: 'lazy', alt: mobile_image.alt }}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}

    {%- if video != blank -%}
      {{ video | video_tag: class: desktop_media_class, style: 'object-fit:cover', sizes: sizes, loading: 'lazy', autoplay: autoplay, loop: loop, muted: muted, controls: false }}
    {%- elsif background_image != blank -%}
      {{ background_image | image_url: width: 1000 | image_tag: style: 'object-fit:cover', class: desktop_media_class, loading: 'lazy', alt: background_image.alt }}
    {%- endif -%}
    
    {% unless title == blank and content == blank and button_label == blank %}
    <div class="p-4
      {{ settings.thumbnail_alignment }}">
      <h3 class="type__heading type__heading--bold-2 mb-1 !leading-none">
        {{ title }}
      </h3>
      <div class="m-0--clear mb-1">
        {{ content | truncate: 200 | strip_html }}
      </div>
      {%- unless button_label == blank -%}
        <button class="btn btn--small btn--secondary !w-full md:!w-auto">
          {{ button_label }}
        </button>
      {%- endunless -%}
    </div>
    {% endunless %}
  
  {% if url != blank %} 
  </a>
  {% else %}
  </div>
  {% endif %}