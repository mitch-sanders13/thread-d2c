<!-- snippets/product__gallery-thumbnail-slider.liquid -->
{% comment %} 
  Block to display product photos in a slider with thumbnails.

  Accepts:
    - featured: boolean to assign product object from section settings, set this to true if block is used within a section rather than product template
  
  Usage:
    {% render 'product__gallery-grid', 
      featured: true %}

  Globals:
    - settings.savings_badge: boolean to display savings badge

  Possible enhancements:
    - Add global setting to set grid gap width and apply to entire theme.
    - Move position of indicators to avoid overlap of alt text.
{% endcomment %}

{% if featured %}
  {%- assign product = section.settings.product -%}
{% endif %}

{% comment %} Mobile only blocks {% endcomment %}
<div class="md:hidden w-full">
  {% for block in section.blocks %}
    {%- case block.type -%}
      
      {%- when 'breadcrumb' -%}
        {% render 'product__breadcrumb', blocksettings: block.settings %}
      
      {%- when 'title' -%}
        {% render 'product__title', blocksettings: block.settings %}

      {%- when 'price' -%}
        <div class="px-4
            {{ section.settings.color_border }}
            {{ block.settings.color_scheme }} 
            {{ block.settings.style_border }}"
          style="
            padding-top:{{ block.settings.spacing_top }}px;
            padding-bottom:{{ block.settings.spacing_bottom }}px;">
          <div class="relative flex items-end justify-between">
            {% render 'product__price', blocksettings: block.settings %}
          </div>
        </div>

    {%- endcase -%}
  {% endfor %}
</div>

<div class="pdp-gallery-col {{ section.settings.layout_gallery_size }} flex flex-col h-full">
  <div class="md:flex-nowrap flex flex-wrap h-full"
    style="
      margin-bottom: {{ settings.layout_gap_size }}px;">

    {% comment %} thumbnails {% endcomment %}
    <div class="pdp-thumb-col hidden md:flex flex-col basis-[10%] max-h-[500px] overflow-x-hidden overflow-y-auto"
      style="
        gap: {{ settings.layout_gap_size }}px;"
      x-ref="thumbnail_slider">
      {% for media in product.media %}
        <div
          class="pdp-thumb relative snap-center flex-none hover:cursor-pointer w-full border--width border--radius overflow-hidden animation-300
          {{ media | handle }}"
          :class="{ 'pdp-thumb--active color__border-selected-1': gallery_index === {{ forloop.index0 }} }"
          {% if section.settings.enable_variant_images %}
            x-show="'{{ media.alt | handle }}'.includes(variantHandle)"
            x-cloak
          {% endif %}
          x-bind:data-slide="{{ forloop.index0 }}"
          tabindex="0"
          @mouseenter="gallery_index_scroll = {{ forloop.index0 }}; scrollToIndex(gallery_index_scroll, 'instant');"
          @focus="gallery_index_scroll = {{ forloop.index0 }}; scrollToIndex(gallery_index_scroll, 'instant');"
          @click="gallery_index_scroll = {{ forloop.index0 }}; scrollToIndex(gallery_index_scroll);">
          <div class="overflow-hidden object-cover aspect-[1/1] aspect-w-1 aspect-h-1 w-full">
            {% capture image_class %}w-full h-full object-cover !bg-transparent {{ settings.thumbmails_color_scheme }}{% endcapture %}
            {{ media
              | image_url: width: 192, height: 192
              | image_tag: style: 'object-fit:cover', class: image_class, loading: 'lazy', alt: media.alt }}
          </div>
        </div>
      {% endfor %}
    </div>

    {% comment %} main images {% endcomment %}
    <div class="pdp-main-col relative flex w-full md:basis-[90%]">

      {%- comment -%}
        Badges — same set as product cards (Sale, Low Stock, Sold Out, custom metafield, tag-based).
        Star rating removed. Badges render INSIDE the first image's slide (below)
        so they scroll horizontally with the featured image.
      {%- endcomment -%}
      {% if section.settings.show_product_badges %}
        {%- assign hide_sale = false -%}
        {% if product.tags contains 'hide_sale' %}{%- assign hide_sale = true -%}{% endif %}
        {% capture badge_background %}
          {% if settings.product-cards_badge_scheme == "light_outline" or settings.product-cards_badge_scheme == "dark_outline" %}
            transparent
          {% else %}
            {{ settings.product-cards_badge_scheme }}
          {% endif %}
        {% endcapture %}
        {% capture badge_foreground %}
          {% if settings.product-cards_badge_scheme == "light_outline" %}light
          {% elsif settings.product-cards_badge_scheme == "dark_outline" %}dark
          {% else %}{{ settings.product-cards_badge_scheme }}{% endif %}
        {% endcapture %}
        {% assign product_qty = 0 %}
        {% for variant in product.variants %}
          {% if variant.inventory_quantity > 0 %}{% assign product_qty = product_qty | plus: variant.inventory_quantity %}{% endif %}
        {% endfor %}
        {% assign badges_placed = false %}
      {% endif %}
    
      {%- comment -%}arrows{%- endcomment -%}
      {% if product.media.size > 1 %}
        <div x-show="show_arrows" class="md:block top-1/2 left-4 absolute z-10 hidden -translate-y-1/2">
          <button class="btn btn--plain btn--small shadow-sm"
            title="{{ 'general.media.previous_slide' | t }}"
            {% if settings.enable_animations %}
              x-transition:enter="animation-300"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="animation-300"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
            {% endif %}
            x-cloak
            @click="scrollBack();">
            {% render 'component__icon', icon: 'arrow-left', size: '20', class: '' %}
          </button>
        </div>
        <div x-show="show_arrows" class="md:block top-1/2 right-4 absolute z-10 hidden -translate-y-1/2">
          <button class="btn btn--plain btn--small shadow-sm"
            title="{{ 'general.media.next_slide' | t }}"
            {% if settings.enable_animations %}
              x-transition:enter="animation-300"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="animation-300"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
            {% endif %}
            x-cloak
            @click="scrollNext();">
            {% render 'component__icon', icon: 'arrow-right', size: '20', class: '' %}
          </button>
        </div>
      {% endif %}

      {%- comment -%}slides{%- endcomment -%}
      <div class="pdp-gallery-track whitespace-nowrap snap-x hidescrollbar md:px-0 md:margin--r-gap md:margin--l-gap inline-flex w-full overflow-x-auto overflow-y-hidden text-center"
        style="
          gap: {{ settings.layout_gap_size }}px;
          scroll-snap-type: x mandatory;
          -webkit-scroll-snap-type: x mandatory;"
        x-init="setTimeout(function(){ if (isOverflown($el)) show_arrows = true}, 600)"
        x-ref="slider">
  
        {% for media in product.media %}
          {% case media.media_type %}
            {% when 'image' %}
              <div class="relative snap-center flex-none border--width border--radius overflow-hidden
                {{ section.settings.image_border }}
                {{ media | handle }} 
                {% if section.settings.enable_zoom %}cursor-zoom-in{% endif %}  
                w-full"
                {% if section.settings.enable_variant_images %}
                  x-show="'{{ media.alt | handle }}'.includes(variantHandle)"
                  x-cloak
                {% endif %}  
                {% if section.settings.enable_zoom %}
                  @click="fullscreen = true; hide_header = true;"
                {% endif %}   
                x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
                x-bind:data-slide="{{ forloop.index0 }}">
                {% if section.settings.show_product_badges and badges_placed == false %}
                  {% assign badges_placed = true %}
                  <div class="js-product-card-badges absolute top-0 left-0 z-10 flex flex-wrap w-full gap-1 p-2 whitespace-normal">
                    {% for tag in product.tags %}
                      {% if tag contains 'badge_' %}
                        {% capture badge_content %}{{ tag | remove: "badge_" }}{% endcapture %}
                        {% render 'component__badge', background: badge_background, text: badge_foreground, border: badge_foreground, icon: '', content: badge_content %}
                      {% endif %}
                    {% endfor %}
                    {% if product.price < product.compare_at_price and hide_sale == false %}
                      {% capture badge_content %}Sale{% endcapture %}
                      {% render 'component__badge', background: badge_background, text: badge_foreground, border: badge_foreground, icon: '', content: badge_content %}
                    {% endif %}
                    {% if settings.stock_threshold and product_qty < settings.stock_threshold and product_qty > 0 %}
                      {% capture badge_content %}Low Stock{% endcapture %}
                      {% render 'component__badge', background: badge_background, text: badge_foreground, border: badge_foreground, icon: '', content: badge_content %}
                    {% endif %}
                    {% unless product.available %}
                      {% capture badge_content %}{{ 'products.general.sold_out' | t }}{% endcapture %}
                      {% render 'component__badge', background: badge_background, text: badge_foreground, border: badge_foreground, icon: '', content: badge_content %}
                    {% endunless %}
                    {% assign metafield = product.metafields.custom.badge %}
                    {% if metafield %}
                      {% capture badge_content %}{{ metafield }}{% endcapture %}
                      {% render 'component__badge', background: badge_background, text: badge_foreground, border: badge_foreground, icon: '', content: badge_content %}
                    {% endif %}
                  </div>
                {% endif %}
                <div class="overflow-hidden object-cover h-full
                  {% if section.settings.enable_ratio %}{{ section.settings.media_ratio }}{% endif %}
                  {{ section.settings.media_color_scheme }}">
                  {% if section.settings.media_object-sizing == "cover" %}
                    {% capture image_class %}w-full h-full object-cover {{ section.settings.media_color_scheme }}{% endcapture %}
                  {% else %}
                    {% capture image_class %}w-full h-full object-contain {{ section.settings.media_color_scheme }}{% endcapture %}
                  {% endif %}
                  {%- if forloop.first -%}
                    {{ media | image_url: width: 1400 | image_tag: style: 'object-fit:cover', class: image_class, loading: 'eager', fetchpriority: 'high', widths: '400, 600, 900, 1200, 1400', sizes: '(min-width: 768px) 50vw, 100vw', alt: media.alt }}
                  {%- else -%}
                    {{ media | image_url: width: 1400 | image_tag: style: 'object-fit:cover', class: image_class, loading: 'lazy', widths: '400, 600, 900, 1200, 1400', sizes: '(min-width: 768px) 50vw, 100vw', alt: media.alt }}
                  {%- endif -%}
                </div>
                {% if section.settings.enable_alt == true and media.alt != product.title %}
                  <div class="type--smaller absolute bottom-0 w-full p-2 text-left whitespace-normal opacity-75">
                    {{ media.alt }}
                  </div>
                {% endif %}
              </div>
              
            {% when 'external_video' %}
              <div class="relative snap-center flex-none border--width border--radius overflow-hidden
                {{ section.settings.image_border }}
                w-full"
                x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
                x-bind:data-slide="{{ forloop.index0 }}">
                <div class="overflow-hidden object-cover
                  {% if section.settings.enable_ratio %}{{ section.settings.media_ratio }}{% endif %}
                  {{ section.settings.media_color_scheme }}">
                  <div class="flex items-center">
                    <div class="aspect-video aspect-w-16 aspect-h-9 object-cover w-full">
                      {% if media.host == 'youtube' %}
                        {{ media | external_video_url: color: 'white' | external_video_tag: class: 'w-full h-full aspect-video max-w-full' }}
                      {% elsif media.host == 'vimeo' %}
                        {{ media | external_video_url: loop: '1', muted: '1' | external_video_tag: class: 'w-full h-full aspect-video max-w-full' }}
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
  
            {% when 'video' %}
              <div class="relative snap-center flex-none border--width border--radius overflow-hidden
                {{ section.settings.image_border }}
                w-full"
                x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
                x-bind:data-slide="{{ forloop.index0 }}">
                <div class="overflow-hidden object-contain
                  {% if section.settings.enable_ratio %}{{ section.settings.media_ratio }}{% endif %}
                  {{ section.settings.media_color_scheme }}">
                  <div class="flex items-center">
                    {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'w-full h-full' }}
                  </div>
                </div>
              </div>
              
            {% when 'model' %}
              <div class="relative snap-center flex-none border--width border--radius overflow-hidden
                {{ section.settings.image_border }}
                w-full" 
                x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
                x-bind:data-slide="{{ forloop.index0 }}" data-media-id="{{ media.id }}">
                <div class="bottom-2 left-2 absolute z-10">
                  {% capture badge_content %}
                    {% render 'component__icon', icon: 'box', size: '16' %}
                  {% endcapture %}
                  {% render 'component__badge', 
                    background: 'body',
                    text: 'text',
                    icon: '',
                    content: badge_content %}
                </div>
                <div class="bottom-2 absolute left-auto right-auto z-10 w-full">
                  <button class="btn btn--small btn--secondary"
                    data-shopify-xr
                    data-shopify-model3d-id="{{ media.id }}"
                    data-shopify-title="{{ product.title | escape }}"
                    data-shopify-xr-hidden>
                    {{ 'general.media.view_in_space' | t }}
                  </button>
                </div>
                <div class="overflow-hidden object-contain h-full
                  {{ section.settings.media_ratio }}
                  {{ section.settings.media_color_scheme }}">
                  <div class="flex items-center h-full">
                    {{ media | model_viewer_tag: class: 'w-full h-full' }}
                  </div>
                </div>
              </div>
  
          {% endcase %}
        {% endfor %}
        
      </div>
      
      {%- comment -%}indicators{%- endcomment -%}
      {% if product.media.size > 1 and product.media.size <= 12 %}
        <div class="pdp-gallery-dots absolute bottom-4 left-0 right-0 flex flex-wrap items-center justify-center gap-2 px-4 text-center">
          {% for media in product.media %}
            <button aria-label="gallery_button_{{ forloop.index0 }}" class="pdp-gallery-dot color__bg-text animation-100 rounded-full w-2 h-2 opacity-25"
              :class="{ 'pdp-gallery-dot--active !opacity-100': gallery_index === {{ forloop.index0 }} }"
              @click="gallery_index_scroll = {{ forloop.index0 }}; scrollToIndex(gallery_index_scroll);"></button>
          {% endfor %}
        </div>
      {% endif %}
      
    </div>
  
    {% comment %} mobile thumbnails — hidden (mobile users navigate via swipe + dots) {% endcomment %}
    <div class="hidden hidescrollbar margin--t-gap padding--l-gap padding--r-gap flex h-full overflow-x-auto"
      style="
        gap: {{ settings.layout_gap_size }}px;">
      {% for media in product.media %}
        <div 
          class="relative snap-center flex-none w-16 border--width border--radius overflow-hidden
          {{ media | handle }}"
          {% if section.settings.enable_variant_images %}
            x-show="'{{ media.alt | handle }}'.includes(variantHandle)"
            x-cloak
          {% endif %}  
          x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
          x-bind:data-slide="{{ forloop.index0 }}"
          @click="gallery_index_scroll = {{ forloop.index0 }}; scrollToIndex(gallery_index_scroll);">
          <div class="overflow-hidden object-cover aspect-[1/1] aspect-w-1 aspect-h-1 w-full">
            {% capture image_class %}w-full h-full object-cover !bg-transparent {{ settings.thumbmails_color_scheme }}{% endcapture %}
            {{ media
              | image_url: width: 192, height: 192
              | image_tag: style: 'object-fit:cover', class: image_class, loading: 'lazy', alt: media.alt }}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</div>
  
{%- assign first_3d_model = product.media | where: "media_type", "model" | first -%}
{% if first_3d_model %}
  <script type="application/json" id="ProductJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
  <script>
    function setupShopifyXr(){
      if (!window.ShopifyXR) {
        document.addEventListener('shopify_xr_initialized', function() {
          setupShopifyXr();
        });
      }else{
        document.querySelectorAll('[id^="ProductJSON-"]').forEach((modelJSON) => {
          window.ShopifyXR.addModels(JSON.parse(modelJSON.textContent));
          window.ShopifyXR.setupXRElements();
          modelJSON.remove();
        });
      }
    }

    window.Shopify.loadFeatures([{
      name: 'shopify-xr',
      version: '1.0',
      onLoad: setupShopifyXr
    }]);
  </script>
{% endif %}
  