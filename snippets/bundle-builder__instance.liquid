{% comment %}
  Shared Everyday Carry Set bundler instance (page section + cart drawer).

  Market Tote–style picker with three typed slots:
    Wallet → Lanyard → Chapstick Holder

  Cart line property "Bundle Slot" still uses Wallet / Lanyard / Chapstick.
  "_bundle_type" is stamped as everyday_carry for the Discount Function.
  so cart grouping, inline edit, and upsell keep working.

  PDP CTAs link here with ?slot_<key>=<handle> to pre-select (not lock)
  the product the customer came from.

  Catalog size: Liquid embeds the first ~50 products per slot for a fast
  first paint. Alpine then pages /collections/<handle>/products.json in
  the background (same approach as bundle__cart-edit-data) so type
  filters and swatches cover large collections like lanyards.
{% endcomment %}

{% doc %}
  @param {string} instance_id - Unique id (section.id or drawer id)
  @param {string} [heading]
  @param {string} [savings_label]
  @param {string} [add_bundle_label]
  @param {string} [cart_label]
  @param {string} [discount_type]
  @param {number} [discount_value]
  @param {string} [discount_code]
  @param {object} [wallet_collection]
  @param {object} [lanyard_collection]
  @param {object} [chapstick_collection]
  @param {number} [spacing_top]
  @param {number} [spacing_bottom]
  @param {string} [layout_horizontal]
  @param {string} [color_scheme]
  @param {string} [color_border]
  @param {string} [style_border]
  @param {string} [visibility]
  @param {boolean} [compact]
{% enddoc %}

{%- liquid
  assign instance_id = instance_id | default: 'trifecta'
  assign section_id = 'bundle-builder-' | append: instance_id
  assign js_id = instance_id | replace: '-', '_'

  assign discount_type = discount_type | default: 'percent'
  assign discount_value = discount_value | default: 20
  assign add_bundle_label = add_bundle_label | default: 'Add to Bundle'
  assign cart_label = cart_label | default: 'Add Bundle to Cart'
  if compact
    assign heading = heading | default: ''
  else
    assign heading = heading | default: 'Build Your Everyday Carry Set'
  endif
  assign savings_label = savings_label | default: 'Save 20% when you bundle a wallet, lanyard, and chapstick holder'

  if discount_code == blank
    assign discount_code = settings.trifecta_discount_code | default: ''
  endif

  assign wallet_coll = wallet_collection
  if wallet_coll == blank
    if settings.trifecta_wallet_collection != blank
      assign wallet_coll = settings.trifecta_wallet_collection
    else
      assign wallet_coll = collections['all-wallets']
    endif
  endif

  assign lanyard_coll = lanyard_collection
  if lanyard_coll == blank
    if settings.trifecta_lanyard_collection != blank
      assign lanyard_coll = settings.trifecta_lanyard_collection
    else
      assign lanyard_coll = collections['lanyards']
    endif
  endif

  assign chapstick_coll = chapstick_collection
  if chapstick_coll == blank
    if settings.trifecta_chapstick_collection != blank
      assign chapstick_coll = settings.trifecta_chapstick_collection
    else
      assign chapstick_coll = collections['chapstick-holder-keychains']
    endif
  endif

  assign spacing_top = spacing_top | default: 60
  assign spacing_bottom = spacing_bottom | default: 60
  if compact
    assign spacing_top = 0
    assign spacing_bottom = 16
  endif
  assign layout_horizontal = layout_horizontal | default: 'window'
  assign color_scheme = color_scheme | default: 'color__bg-body color__text'
  assign color_border = color_border | default: 'color__border-divider-1'
  assign style_border = style_border | default: ''
  assign visibility = visibility | default: ''
-%}

{%- comment -%}
  Capture product JSON per slot so the Alpine data island stays readable.
{%- endcomment -%}
{%- capture slot_products_wallet -%}
  {%- if wallet_coll != blank -%}
    {%- comment -%}
      Liquid caps collection.products at 50/page. Embed the first page for
      fast paint; Alpine _loadMoreProducts fetches the rest via products.json.
      Skip Bundle / trifecta SKUs (prebuilt sets) — same as best-sellers.
      All wallet types are included; Elastic / Vertical / Zip stay first
      in the type-filter pills (see walletPreferredTypes in Alpine).
    {%- endcomment -%}
    {%- assign _ecs_emitted = 0 -%}
    {%- paginate wallet_coll.products by 100 -%}
      {%- for product in wallet_coll.products limit: 100 -%}
        {%- if product.type == 'Bundle' or product.tags contains 'trifecta' -%}
          {%- continue -%}
        {%- endif -%}
        {%- if _ecs_emitted >= 50 -%}
          {%- break -%}
        {%- endif -%}
        {%- if _ecs_emitted > 0 -%},{%- endif -%}
        {%- assign _ecs_emitted = _ecs_emitted | plus: 1 -%}
        {%- assign first_variant = product.selected_or_first_available_variant -%}
        {%- assign color_tag = '' -%}
        {%- for tag in product.tags -%}
          {%- assign tag_lc = tag | downcase | strip -%}
          {%- if tag_lc contains 'color_' -%}
            {%- assign color_tag = tag_lc | remove_first: 'color_' -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {
          "handle": {{ product.handle | json }},
          "title": {{ product.title | json }},
          "url": {{ product.url | json }},
          "price": {{ first_variant.price | json }},
          "compareAtPrice": {{ first_variant.compare_at_price | default: 0 | json }},
          "available": {{ first_variant.available | json }},
          "variantId": {{ first_variant.id | json }},
          "type": {{ product.type | json }},
          "colorTag": {{ color_tag | json }},
          "swatchImage": {{ product.featured_image | image_url: width: 200 | json }},
          "images": {% render 'bundle__gallery-frames', product: product %}
        }
      {%- endfor -%}
    {%- endpaginate -%}
  {%- endif -%}
{%- endcapture -%}

