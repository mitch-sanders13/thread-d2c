<section
  id="{{ section_id }}"
  class="
    {{ visibility }}
    {{ color_scheme }}
    {{ color_border }}
    {{ style_border }}
  ">
  <div
    class="trifecta-bundler {{ layout_horizontal }}"
    style="
      padding-top:{{ spacing_top }}px;
      padding-bottom:{{ spacing_bottom }}px;
    "
    x-data="bundleBuilder_{{ js_id }}">

    {%- unless heading == blank and savings_label == blank -%}
      <div class="flex flex-col items-center px-4 pb-4 text-center">
        <div class="max-w-prose">
          {%- unless heading == blank -%}
            <h2>{{ heading }}</h2>
          {%- endunless -%}
          {%- unless savings_label == blank -%}
            <p class="mtb-pdp__savings">{{ savings_label }}</p>
          {%- endunless -%}
        </div>
      </div>
    {%- endunless -%}

    {% render 'bundle-builder__pdp-layout',
        add_bundle_label: add_bundle_label,
        cart_label: cart_label,
        discount_type: discount_type,
        discount_value: discount_value %}

    <p
      class="type--small px-4 pb-4 text-center"
      x-show="incompleteReason"
      x-text="incompleteReason"
      x-cloak></p>

  </div>
</section>

<script type="application/json" id="{{ section_id }}-data">
{
  "discountCode": {{ discount_code | strip | json }},
  "slots": [
    {
      "key": "Wallet",
      "label": "Wallet",
      "collectionHandle": {{ wallet_coll.handle | default: '' | json }},
      "products": [{{ slot_products_wallet | strip }}]
    },
    {
      "key": "Lanyard",
      "label": "Lanyard",
      "collectionHandle": {{ lanyard_coll.handle | default: '' | json }},
      "products": [{{ slot_products_lanyard | strip }}]
    },
    {
      "key": "Chapstick",
      "label": "Chapstick Holder",
      "collectionHandle": {{ chapstick_coll.handle | default: '' | json }},
      "products": [{{ slot_products_chapstick | strip }}]
    }
  ]
}
</script>

<script>
(function() {
  function bundleBuilderFactory_{{ js_id }}() {
    return {
      slots: [],
      activeSlotIndex: 0,
      previewHandle: null,
      typeFilter: 'all',
      galleryIndex: 0,
      heroSrc: '',
      heroSrcset: '',
      heroAlt: '',
      heroReady: false,
      _pendingHero: '',
      _prefetchCache: {},
      _heroCache: {},
      requiredCount: 3,
      cartLoading: false,
      incompleteReason: '',
      discountCode: '',
      editingBundleId: null,
      editingKeys: [],
      // URL deep-link items to re-apply after AJAX pages load (handle may
      // sit past Liquid's first-50 collection page).
      _pendingPrefillItems: [],

      init() {
        var dataEl = document.getElementById('{{ section_id }}-data');
        if (!dataEl) return;
        var data;
        try { data = JSON.parse(dataEl.textContent); }
        catch (e) { console.error('[bundle-builder] bad JSON data', e); return; }

        this.discountCode = (data.discountCode || '').trim();
        this.slots = (data.slots || []).map(function(slot) {
          return {
            key: slot.key,
            label: slot.label,
            collectionHandle: slot.collectionHandle || '',
            products: (slot.products || []).filter(function(p) {
              var t = (p.type || '').toLowerCase();
              return t !== 'bundle';
            }),
            selectedHandle: null,
            locked: false
          };
        });
        this.requiredCount = this.slots.length || 3;
        this.galleryIndex = 0;
        this.typeFilter = 'all';
        this._prefetchCache = {};
        this._heroCache = {};
        this._pendingPrefillItems = [];
        this.activeSlotIndex = 0;
        this._syncPreviewFromActive(true);
        this._readUrlPrefill();

        // Liquid only embeds the first ~50 products per collection.
        // Background-fetch the rest so type filters / swatches cover
        // large catalogs (e.g. lanyards 1000+). Same pattern as cart edit.
        var self = this;
        this.slots.forEach(function(slot, sIdx) {
          if (slot.collectionHandle) self._loadMoreProducts(slot.collectionHandle, sIdx);
        });
      },

      _readUrlPrefill() {
        try {
          var params = new URLSearchParams(window.location.search || '');
          var items = [];
          this.slots.forEach(function(slot) {
            var handle = params.get('slot_' + slot.key.toLowerCase());
            if (handle) items.push({ slotLabel: slot.key, handle: handle, key: null });
          });
          if (!items.length) return;
          var replaceKeys = (params.get('replace_keys') || '').split(',').filter(Boolean);
          this._pendingPrefillItems = items.slice();
          this._prefillSlots({ items: items });
          this.editingBundleId = null;
          this.editingKeys = replaceKeys;

          if (replaceKeys.length) {
            // Cart upsell: jump to the first slot still needing a pick.
            var next = this.firstIncompleteSlot();
            this.activeSlotIndex = next >= 0 ? next : 0;
            this.typeFilter = 'all';
            this._syncPreviewFromActive(true);
          } else {
            // PDP deep link: land on the product the customer came from
            // (selected, not locked) so they see it immediately.
            var landIdx = -1;
            var first = items[0];
            if (first) {
              var target = (first.slotLabel || '').toLowerCase();
              for (var j = 0; j < this.slots.length; j++) {
                if (this.slots[j].key.toLowerCase() === target) {
                  landIdx = j;
                  break;
                }
              }
            }
            this.activeSlotIndex = landIdx >= 0 ? landIdx : 0;
            this._syncPreviewFromActive(true);
            this._matchTypeFilterToPreview();
          }
        } catch (e) {
          console.error('[bundle-builder] url prefill failed', e);
        }
      },

      // Re-apply pending URL prefills after AJAX pages add more products.
      _retryPendingPrefill() {
        if (!this._pendingPrefillItems || !this._pendingPrefillItems.length) return;
        var before = this.totalSelected();
        this._prefillSlots({ items: this._pendingPrefillItems });
        if (this.totalSelected() !== before && this.activeSlot()) {
          this._syncPreviewFromActive(true);
          this._matchTypeFilterToPreview();
        }
      },

      _isExcludedProduct(p) {
        var t = ((p && (p.type || p.product_type)) || '').toLowerCase();
        if (t === 'bundle') return true;
        var tags = (p && p.tags) || '';
        if (Array.isArray(tags)) tags = tags.join(',');
        if (typeof tags === 'string' && tags.toLowerCase().indexOf('trifecta') !== -1) return true;
        return false;
      },

      _colorTagFromTags(tags) {
        var list = [];
        if (Array.isArray(tags)) list = tags;
        else if (typeof tags === 'string') list = tags.split(',');
        for (var i = 0; i < list.length; i++) {
          var tag = String(list[i] || '').toLowerCase().trim();
          if (tag.indexOf('color_') === 0) return tag.slice(6);
        }
        return '';
      },

      _normalizeAjaxProduct(p) {
        if (!p || !p.variants || !p.variants.length) return null;
        if (this._isExcludedProduct(p)) return null;
        var v = p.variants[0];
        // products.json returns variant.price as a dollar string ("15.99").
        var priceCents;
        if (typeof v.price === 'number') {
          priceCents = v.price;
        } else {
          priceCents = Math.round(parseFloat(v.price || '0') * 100);
        }
        var images = [];
        (p.images || []).slice(0, 8).forEach(function(img) {
          var src = (img && (img.src || img)) || '';
          if (!src) return;
          images.push({
            thumb: src,
            hero: src,
            hero600: src,
            hero900: src
          });
        });
        var swatch = images.length ? images[0].thumb : '';
        return {
          handle: p.handle,
          title: p.title || '',
          url: '/products/' + p.handle,
          price: priceCents,
          compareAtPrice: 0,
          available: v.available !== false,
          variantId: v.id,
          type: p.product_type || '',
          colorTag: this._colorTagFromTags(p.tags),
          swatchImage: swatch,
          images: images
        };
      },

      _loadMoreProducts(handle, sIdx) {
        // Fetches up to ~1500 products from /collections/<handle>/products.json
        // (250 per page, max 6 pages) and merges handles not already present.
        // Mirrors snippets/bundle__cart-edit-data.liquid.
        var self = this;
        var MAX_PAGES = 6;
        var PAGE_SIZE = 250;

        function fetchPage(page) {
          var url = window.Shopify.routes.root + 'collections/' + encodeURIComponent(handle)
            + '/products.json?limit=' + PAGE_SIZE + '&page=' + page;
          return fetch(url, { credentials: 'same-origin' })
            .then(function(r) { return r.ok ? r.json() : { products: [] }; })
            .then(function(data) {
              var slot = self.slots[sIdx];
              if (!slot || !data || !Array.isArray(data.products) || !data.products.length) {
                return false;
              }
              var existing = {};
              slot.products.forEach(function(p) { existing[p.handle] = true; });
              data.products.forEach(function(raw) {
                if (existing[raw.handle]) return;
                var normalized = self._normalizeAjaxProduct(raw);
                if (!normalized) return;
                existing[normalized.handle] = true;
                slot.products.push(normalized);
              });
              self._retryPendingPrefill();
              return data.products.length >= PAGE_SIZE;
            });
        }

        (function loop(page) {
          if (page > MAX_PAGES) return;
          fetchPage(page).then(function(hasMore) {
            if (hasMore) loop(page + 1);
          }).catch(function(err) {
            console.warn('[bundle-builder] page', page, 'fetch failed', err);
          });
        })(1);
      },

      activeSlot() {
        return this.slots[this.activeSlotIndex] || null;
      },

      activeProducts() {
        var slot = this.activeSlot();
        return slot ? slot.products : [];
      },

      activeTypeFilters() {
        var seen = {};
        var types = [];
        this.activeProducts().forEach(function(p) {
          var t = (p.type || '').trim();
          if (!t || seen[t]) return;
          seen[t] = true;
          types.push(t);
        });
        types.sort(function(a, b) { return a.localeCompare(b); });
        return types;
      },

      showTypeFilters() {
        return this.activeTypeFilters().length > 1;
      },

      filteredProducts() {
        var products = this.activeProducts();
        if (!this.typeFilter || this.typeFilter === 'all') return products;
        var filter = this.typeFilter;
        return products.filter(function(p) { return p.type === filter; });
      },

      shortTypeLabel(type) {
        if (!type) return '';
        return type
          .replace(/\s+Holder Keychain$/i, '')
          .replace(/\s+Keychain$/i, '')
          .replace(/\s+Wallet$/i, '')
          .replace(/\s+Lanyard$/i, '')
          .trim() || type;
      },

      setTypeFilter(type) {
        this.typeFilter = type || 'all';
        var list = this.filteredProducts();
        var self = this;
        var stillVisible = list.some(function(p) { return p.handle === self.previewHandle; });
        if (!stillVisible) {
          var first = this._firstAvailable(list);
          if (first) {
            this.previewHandle = first.handle;
            this.galleryIndex = 0;
            this.applyHero(true);
          }
        }
      },

      _matchTypeFilterToPreview() {
        var p = this.previewProduct();
        if (p && p.type && this.activeTypeFilters().length > 1) {
          this.typeFilter = p.type;
        } else {
          this.typeFilter = 'all';
        }
      },

      _firstAvailable(products) {
        if (!products || !products.length) return null;
        return products.find(function(p){ return p.available; }) || products[0] || null;
      },

      _syncPreviewFromActive(useSwatchPlaceholder) {
        var slot = this.activeSlot();
        if (!slot) {
          this.previewHandle = null;
          return;
        }
        var selected = slot.selectedHandle
          ? this.productByHandleInSlot(this.activeSlotIndex, slot.selectedHandle)
          : null;
        var pool = this.filteredProducts();
        if (!pool.length) pool = slot.products;
        var fallback = this._firstAvailable(pool);
        this.previewHandle = (selected || fallback) ? (selected || fallback).handle : null;
        this.galleryIndex = 0;
        this.applyHero(!!useSwatchPlaceholder);
      },

      selectSlot(idx) {
        if (idx < 0 || idx >= this.slots.length) return;
        this.activeSlotIndex = idx;
        this.typeFilter = 'all';
        this._syncPreviewFromActive(true);
        // If this slot already has a pick, filter to that product's type.
        var slot = this.activeSlot();
        if (slot && slot.selectedHandle) {
          this._matchTypeFilterToPreview();
        }
      },

      lockSlot(slotLabel, productHandle) {
        var target = (slotLabel || '').toLowerCase();
        for (var i = 0; i < this.slots.length; i++) {
          var slot = this.slots[i];
          if (slot.key.toLowerCase() !== target && slot.label.toLowerCase() !== target) continue;
          var match = slot.products.find(function(p){ return p.handle === productHandle; });
          if (!match) {
            console.warn('[bundle-builder] product not in slot catalog', slotLabel, productHandle);
            return false;
          }
          slot.selectedHandle = productHandle;
          slot.locked = true;
          var next = this.firstIncompleteSlot();
          this.activeSlotIndex = next >= 0 ? next : i;
          this.typeFilter = 'all';
          this._syncPreviewFromActive(true);
          return true;
        }
        console.warn('[bundle-builder] no slot with label', slotLabel);
        return false;
      },

      _prefillSlots(payload) {
        if (!payload || !payload.items) return;
        var self = this;
        payload.items.forEach(function(it) {
          var target = (it.slotLabel || '').toLowerCase();
          for (var i = 0; i < self.slots.length; i++) {
            var slot = self.slots[i];
            if (slot.key.toLowerCase() !== target && slot.label.toLowerCase() !== target) continue;
            var found = slot.products.find(function(p){ return p.handle === it.handle; });
            if (found) {
              slot.selectedHandle = it.handle;
              slot.locked = false;
            }
            break;
          }
        });
      },

      prefillFromCart(payload) {
        this._prefillSlots(payload);
        this.editingBundleId = (payload && payload.bundleId) || null;
        this.editingKeys = (payload && payload.items || []).map(function(p){ return p.key; }).filter(Boolean);
        this.activeSlotIndex = 0;
        this.typeFilter = 'all';
        this._syncPreviewFromActive(true);
      },

      prefillForUpsell(payload) {
        this._prefillSlots(payload);
        this.editingBundleId = null;
        this.editingKeys = (payload && payload.items || []).map(function(p){ return p.key; }).filter(Boolean);
        var next = this.firstIncompleteSlot();
        this.activeSlotIndex = next >= 0 ? next : 0;
        this.typeFilter = 'all';
        this._syncPreviewFromActive(true);
      },

      productByHandleInSlot(slotIdx, handle) {
        var slot = this.slots[slotIdx];
        if (!slot) return null;
        return slot.products.find(function(p){ return p.handle === handle; }) || null;
      },

      productByHandle(handle) {
        for (var i = 0; i < this.slots.length; i++) {
          var p = this.productByHandleInSlot(i, handle);
          if (p) return p;
        }
        return null;
      },

      previewProduct() {
        return this.productByHandleInSlot(this.activeSlotIndex, this.previewHandle)
          || this._firstAvailable(this.activeProducts());
      },

      previewImages() {
        var p = this.previewProduct();
        return (p && p.images && p.images.length) ? p.images : [];
      },

      currentHero() {
        var images = this.previewImages();
        if (!images.length) {
          var p = this.previewProduct();
          if (!p) return null;
          return {
            thumb: p.swatchImage,
            hero: p.swatchImage,
            hero600: p.swatchImage,
            hero900: p.swatchImage
          };
        }
        var idx = this.galleryIndex;
        if (idx < 0 || idx >= images.length) idx = 0;
        return images[idx];
      },

      heroSrcsetFor(image) {
        if (!image) return '';
        return (image.hero600 || '') + ' 600w, ' + (image.hero900 || '') + ' 900w, ' + (image.hero || '') + ' 1200w';
      },

      _heroCacheKey() {
        return this.activeSlotIndex + '|' + (this.previewHandle || '') + '|' + this.galleryIndex;
      },

      applyHero(useSwatchPlaceholder) {
        var p = this.previewProduct();
        var image = this.currentHero();
        if (!p || !image) return;

        this.heroAlt = p.title || '';
        var cacheKey = this._heroCacheKey();
        var cached = this._heroCache[cacheKey];
        if (cached) {
          if (this.heroSrc === cached.src && this.heroReady) return;
          this._pendingHero = cached.src;
          this.heroSrc = cached.src;
          this.heroSrcset = cached.srcset || '';
          this.heroReady = true;
          return;
        }

        var placeholder = useSwatchPlaceholder
          ? (p.swatchImage || image.thumb || image.hero600 || image.hero)
          : (image.thumb || p.swatchImage || image.hero600 || image.hero);

        var target = image.hero || image.hero900 || placeholder;
        var targetSrcset = this.heroSrcsetFor(image);

        if (this.heroSrc === target && this.heroReady) return;

        this.heroSrc = placeholder;
        this.heroSrcset = '';
        this.heroReady = false;
        this._loadHero(target, targetSrcset, cacheKey);
      },

      _loadHero(src, srcset, cacheKey) {
        if (!src) return;
        this._pendingHero = src;
        var self = this;
        var img = new Image();
        img.onload = function() {
          if (self._pendingHero !== src) return;
          self.heroSrc = src;
          self.heroSrcset = srcset || '';
          self.heroReady = true;
          if (cacheKey) {
            self._heroCache[cacheKey] = { src: src, srcset: srcset || '' };
          }
        };
        img.onerror = function() {
          if (self._pendingHero !== src) return;
          self.heroReady = true;
        };
        if (srcset) {
          img.sizes = '(min-width: 990px) 45vw, 100vw';
          img.srcset = srcset;
        }
        img.src = src;
      },

      prefetchProduct(handle) {
        var p = this.productByHandleInSlot(this.activeSlotIndex, handle);
        if (!p) return;
        var image = (p.images && p.images[0]) || null;
        var url = image
          ? (image.hero900 || image.hero || p.swatchImage)
          : p.swatchImage;
        this.prefetchUrl(url);
      },

      prefetchUrl(url) {
        if (!url || this._prefetchCache[url]) return;
        this._prefetchCache[url] = true;
        var img = new Image();
        img.src = url;
      },

      selectGallery(index) {
        var images = this.previewImages();
        if (index < 0 || index >= images.length) return;
        this.galleryIndex = index;
        this.applyHero(false);
      },

      shortName(title) {
        if (!title) return '';
        var idx = title.indexOf(' - ');
        return idx > 0 ? title.slice(0, idx) : title;
      },

      selectPreview(handle) {
        var p = this.productByHandleInSlot(this.activeSlotIndex, handle);
        if (!p) return;
        var slot = this.activeSlot();
        if (slot && slot.locked) return;
        this.previewHandle = handle;
        this.galleryIndex = 0;
        this.applyHero(true);
      },

      isPreview(handle) {
        return this.previewHandle === handle;
      },

      totalSelected() {
        var n = 0;
        for (var i = 0; i < this.slots.length; i++) {
          if (this.slots[i].selectedHandle) n++;
        }
        return n;
      },

      remainingCount() {
        return Math.max(0, this.requiredCount - this.totalSelected());
      },

      dotIndexes() {
        var out = [];
        for (var i = 1; i <= this.requiredCount; i++) out.push(i);
        return out;
      },

      firstIncompleteSlot() {
        for (var i = 0; i < this.slots.length; i++) {
          if (!this.slots[i].selectedHandle) return i;
        }
        return -1;
      },

      isComplete() {
        return this.totalSelected() === this.requiredCount;
      },

      canAddToBundle() {
        var slot = this.activeSlot();
        if (!slot || slot.locked) return false;
        var p = this.previewProduct();
        return !!(p && p.available);
      },

      addToBundle() {
        if (!this.canAddToBundle()) return;
        var slot = this.activeSlot();
        slot.selectedHandle = this.previewHandle;
        var next = this.firstIncompleteSlot();
        if (next >= 0) {
          this.selectSlot(next);
        }
      },

      removePick(slotIdx) {
        var slot = this.slots[slotIdx];
        if (!slot || slot.locked) return;
        slot.selectedHandle = null;
        if (this.activeSlotIndex === slotIdx) {
          this.typeFilter = 'all';
          this._syncPreviewFromActive(true);
        }
      },

      pickProduct(slotIdx) {
        var slot = this.slots[slotIdx];
        if (!slot || !slot.selectedHandle) return null;
        return this.productByHandleInSlot(slotIdx, slot.selectedHandle);
      },

      filledPicks() {
        var out = [];
        for (var i = 0; i < this.slots.length; i++) {
          if (!this.slots[i].selectedHandle) continue;
          out.push({
            idx: i,
            slot: this.slots[i],
            product: this.pickProduct(i)
          });
        }
        return out;
      },

      slotFilled(slotIdx) {
        return !!(this.slots[slotIdx] && this.slots[slotIdx].selectedHandle);
      },

      subtotalCents() {
        var sum = 0;
        for (var i = 0; i < this.slots.length; i++) {
          var p = this.pickProduct(i);
          if (p) sum += p.price;
        }
        return sum;
      },

      discountCents() {
        var sub = this.subtotalCents();
        if (!this.canAddToCart()) return 0;
        {% case discount_type %}
          {% when 'percent' %}
            return Math.round(sub * ({{ discount_value | default: 0 }} / 100));
          {% when 'fixed_off' %}
            return Math.min(sub, {{ discount_value | default: 0 | times: 100 }});
          {% else %}
            return 0;
        {% endcase %}
      },

      totalCents() {
        if (!this.canAddToCart()) return this.subtotalCents();
        return Math.max(0, this.subtotalCents() - this.discountCents());
      },

      formatMoney(cents) {
        if (typeof cents !== 'number') return '';
        if (window.Shopify && window.Shopify.formatMoney) {
          return window.Shopify.formatMoney(cents, '{{ cart.currency.symbol }}');
        }
        return '$' + (cents / 100).toFixed(2);
      },

      canAddToCart() {
        if (!this.isComplete()) return false;
        for (var i = 0; i < this.slots.length; i++) {
          var p = this.pickProduct(i);
          if (!p || !p.available) return false;
        }
        return true;
      },

      finalizeBundle() {
        if (!this.canAddToCart() || this.cartLoading) return Promise.resolve();
        this.cartLoading = true;
        this.incompleteReason = '';

        var bundleId = 'tri_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
        var items = [];
        for (var i = 0; i < this.slots.length; i++) {
          var slot = this.slots[i];
          var p = this.pickProduct(i);
          if (!p) continue;
          items.push({
            id: p.variantId,
            quantity: 1,
            properties: {
              'Bundle Slot': slot.key,
              '_bundle_id': bundleId
            }
          });
        }

        var self = this;
        var rootScope = (window.Alpine && document.body) ? window.Alpine.$data(document.body) : null;
        var isEditingExistingBundle = !!this.editingBundleId;
        var editingKeys = this.editingKeys.slice();
        var hasEditingKeys = editingKeys.length > 0;

        return fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: items })
        })
        .then(function(r){
          return r.json().then(function(body){
            if (!r.ok) throw Object.assign(new Error('Add to cart failed'), { body: body });
            return body;
          });
        })
        .then(function(){
          if (hasEditingKeys && rootScope && typeof rootScope.changeCartItemQuantity === 'function') {
            return editingKeys.reduce(function(chain, key) {
              return chain.then(function() {
                return rootScope.changeCartItemQuantity(key, 0, false, false);
              });
            }, Promise.resolve());
          }
        })
        .then(function() {
          if (isEditingExistingBundle) {
            if (rootScope && typeof rootScope.updateCart === 'function') {
              rootScope.updateCart(true);
            }
            window.dispatchEvent(new CustomEvent('bundle-drawer:close'));
            return;
          }
          if (self.discountCode) {
            fetch('/discount/' + encodeURIComponent(self.discountCode), {
              method: 'GET',
              credentials: 'same-origin'
            }).catch(function(){});
          }
          if (rootScope && typeof rootScope.updateCart === 'function') {
            rootScope.updateCart(true);
          }
          window.dispatchEvent(new CustomEvent('bundle-drawer:close'));
        })
        .catch(function(err){
          var msg = (err && err.body && err.body.description) || 'Could not add bundle to cart. Please try again.';
          self.incompleteReason = msg;
          if (rootScope) {
            rootScope.error_title = (err && err.body && err.body.message) || 'Something went wrong';
            rootScope.error_message = msg;
            rootScope.show_alert = true;
          }
          console.error('[bundle-builder]', err);
        })
        .finally(function(){
          self.cartLoading = false;
        });
      }
    };
  }

  window.bundleBuilder_{{ js_id }} = bundleBuilderFactory_{{ js_id }};

  function registerBundleBuilder_{{ js_id }}() {
    if (!window.Alpine || typeof window.Alpine.data !== 'function') return false;
    window.Alpine.data('bundleBuilder_{{ js_id }}', bundleBuilderFactory_{{ js_id }});
    return true;
  }
  if (!registerBundleBuilder_{{ js_id }}()) {
    document.addEventListener('alpine:init', registerBundleBuilder_{{ js_id }});
  }
})();
</script>
