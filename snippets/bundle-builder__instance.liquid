<section
  id="{{ section_id }}"
  class="
    {{ visibility }}
    {{ color_scheme }}
    {{ color_border }}
    {{ style_border }}
  ">
  <div
    class="trifecta-bundler {{ layout_horizontal }}"
    style="
      padding-top:{{ spacing_top }}px;
      padding-bottom:{{ spacing_bottom }}px;
    "
    x-data="bundleBuilder_{{ js_id }}">

    {% comment %}
      Heading + savings (and mobile title placement) are handled inside
      bundle-builder__pdp-layout so mobile stacks correctly without a
      centered gold strip above the layout.
    {% endcomment %}
    {% render 'bundle-builder__pdp-layout',
        cart_label: cart_label,
        discount_type: discount_type,
        discount_value: discount_value,
        heading: heading,
        savings_label: savings_label %}

    <p
      class="type--small px-4 pb-4 text-center"
      x-show="incompleteReason"
      x-text="incompleteReason"
      x-cloak></p>

  </div>
</section>

<script type="application/json" id="{{ section_id }}-data">
{
  "discountCode": {{ discount_code | strip | json }},
  "slots": [
    {
      "key": "Wallet",
      "label": "Wallet",
      "silhouette": "https://cdn.shopify.com/s/files/1/1030/4291/files/mystery_elastic.jpg?v=1761880186",
      "collectionHandle": {{ wallet_coll.handle | default: '' | json }},
      "products": [{{ slot_products_wallet | strip }}]
    },
    {
      "key": "Lanyard",
      "label": "Lanyard",
      "silhouette": "https://cdn.shopify.com/s/files/1/1030/4291/files/mystery_lanyard.jpg?v=1761880151",
      "collectionHandle": {{ lanyard_coll.handle | default: '' | json }},
      "products": [{{ slot_products_lanyard | strip }}]
    },
    {
      "key": "Chapstick",
      "label": "Chapstick Holder",
      "silhouette": "https://cdn.shopify.com/s/files/1/1030/4291/files/mystery_lp.jpg?v=1761880027",
      "collectionHandle": {{ chapstick_coll.handle | default: '' | json }},
      "products": [{{ slot_products_chapstick | strip }}]
    }
  ]
}
</script>

<script>
(function() {
  function bundleBuilderFactory_{{ js_id }}() {
    return {
      slots: [],
      activeSlotIndex: 0,
      previewHandle: null,
      typeFilter: 'all',
      galleryIndex: 0,
      heroSrc: '',
      heroSrcset: '',
      heroAlt: '',
      heroReady: false,
      // Hero media kind — image | video | external_video (PDP parity).
      heroMediaType: 'image',
      heroVideoUrl: '',
      heroExternalHost: '',
      heroExternalId: '',
      _pendingHero: '',
      _prefetchCache: {},
      _heroCache: {},
      // Full PDP media gallery (images + videos) loaded once per handle.
      _galleryHydrated: {},
      _galleryHydrating: {},
      requiredCount: 3,
      cartLoading: false,
      incompleteReason: '',
      discountCode: '',
      editingBundleId: null,
      editingKeys: [],
      // Swatch-grid arrow state (mirrors PDP related-styles pagination).
      swatchHasPagination: false,
      swatchCanPrev: false,
      swatchCanNext: false,
      _swatchResizeObs: null,
      // URL deep-link items to re-apply after AJAX pages load (handle may
      // sit past Liquid's first-50 collection page).
      _pendingPrefillItems: [],
      // Wallet type-filter order: Elastic / Vertical / Zip first, then
      // every other wallet type present in the collection (A–Z).
      walletPreferredTypes: [
        'Elastic Wallet',
        'Vertical Leather Wallet',
        'Leather Zip Wallet'
      ],
      // Lanyard type-filter order: Wrist → Neck → Keychain Clip first,
      // then every other lanyard type present (A–Z). Both "Wrist Lanyard"
      // and "Wide Wrist Lanyard" are listed so whichever Shopify type the
      // catalog uses still lands in the lead pill slot.
      lanyardPreferredTypes: [
        'Wrist Lanyard',
        'Wide Wrist Lanyard',
        'Neck Lanyard',
        'Keychain Clip'
      ],

      init() {
        var dataEl = document.getElementById('{{ section_id }}-data');
        if (!dataEl) return;
        var data;
        try { data = JSON.parse(dataEl.textContent); }
        catch (e) { console.error('[bundle-builder] bad JSON data', e); return; }

        var self = this;
        this.discountCode = (data.discountCode || '').trim();
        this.slots = (data.slots || []).map(function(slot) {
          return {
            key: slot.key,
            label: slot.label,
            silhouette: slot.silhouette || '',
            collectionHandle: slot.collectionHandle || '',
            products: (slot.products || []).filter(function(p) {
              if (self._isExcludedProduct(p, slot.key)) return false;
              return true;
            }),
            selectedHandle: null,
            locked: false
          };
        });
        this.requiredCount = this.slots.length || 3;
        this.galleryIndex = 0;
        this.typeFilter = 'all';
        this._prefetchCache = {};
        this._heroCache = {};
        this._galleryHydrated = {};
        this._galleryHydrating = {};
        this._pendingPrefillItems = [];
        this.activeSlotIndex = 0;
        this._syncPreviewFromActive(true);
        this._readUrlPrefill();

        // Liquid only embeds the first ~50 products per collection.
        // Background-fetch the rest so type filters / swatches cover
        // large catalogs (e.g. lanyards 1000+). Same pattern as cart edit.
        this.slots.forEach(function(slot, sIdx) {
          if (slot.collectionHandle) self._loadMoreProducts(slot.collectionHandle, sIdx);
        });

        // Keep arrow disabled state in sync when the grid size or filter changes.
        this.$watch('typeFilter', function() { self.resetSwatchScroll(); });
        this.$watch('activeSlotIndex', function() { self.resetSwatchScroll(); });
        // When the selected style changes, pull the full media list (PDP parity).
        this.$watch('previewHandle', function(handle) {
          if (handle) self.hydrateGalleryFor(handle);
        });
        if (this.previewHandle) this.hydrateGalleryFor(this.previewHandle);
        this.$nextTick(function() { self._bindSwatchResize(); self.updateSwatchArrows(); });
      },

      _readUrlPrefill() {
        try {
          var params = new URLSearchParams(window.location.search || '');
          var items = [];
          this.slots.forEach(function(slot) {
            var handle = params.get('slot_' + slot.key.toLowerCase());
            if (handle) items.push({ slotLabel: slot.key, handle: handle, key: null });
          });
          if (!items.length) return;
          var replaceKeys = (params.get('replace_keys') || '').split(',').filter(Boolean);
          this._pendingPrefillItems = items.slice();
          this._prefillSlots({ items: items });
          this.editingBundleId = null;
          this.editingKeys = replaceKeys;

          if (replaceKeys.length) {
            // Cart upsell: jump to the first slot still needing a pick.
            var next = this.firstIncompleteSlot();
            this.activeSlotIndex = next >= 0 ? next : 0;
            this.typeFilter = 'all';
            this._syncPreviewFromActive(true);
          } else {
            // PDP deep link: land on the product the customer came from
            // (selected, not locked) so they see it immediately.
            var landIdx = -1;
            var first = items[0];
            if (first) {
              var target = (first.slotLabel || '').toLowerCase();
              for (var j = 0; j < this.slots.length; j++) {
                if (this.slots[j].key.toLowerCase() === target) {
                  landIdx = j;
                  break;
                }
              }
            }
            this.activeSlotIndex = landIdx >= 0 ? landIdx : 0;
            this._syncPreviewFromActive(true);
            this._matchTypeFilterToPreview();
          }
        } catch (e) {
          console.error('[bundle-builder] url prefill failed', e);
        }
      },

      // Re-apply pending URL prefills after AJAX pages add more products.
      _retryPendingPrefill() {
        if (!this._pendingPrefillItems || !this._pendingPrefillItems.length) return;
        var before = this.totalSelected();
        this._prefillSlots({ items: this._pendingPrefillItems });
        if (this.totalSelected() !== before && this.activeSlot()) {
          this._syncPreviewFromActive(true);
          this._matchTypeFilterToPreview();
        }
      },

      _isExcludedProduct(p, slotKey) {
        var t = ((p && (p.type || p.product_type)) || '').toLowerCase();
        if (t === 'bundle') return true;
        var tags = (p && p.tags) || '';
        if (Array.isArray(tags)) tags = tags.join(',');
        if (typeof tags === 'string' && tags.toLowerCase().indexOf('trifecta') !== -1) return true;
        return false;
      },

      _colorTagFromTags(tags) {
        var list = [];
        if (Array.isArray(tags)) list = tags;
        else if (typeof tags === 'string') list = tags.split(',');
        for (var i = 0; i < list.length; i++) {
          var tag = String(list[i] || '').toLowerCase().trim();
          if (tag.indexOf('color_') === 0) return tag.slice(6);
        }
        return '';
      },

      _normalizeAjaxProduct(p, slotKey) {
        if (!p || !p.variants || !p.variants.length) return null;
        if (this._isExcludedProduct(p, slotKey)) return null;
        var v = p.variants[0];
        // products.json returns variant.price as a dollar string ("15.99").
        var priceCents;
        if (typeof v.price === 'number') {
          priceCents = v.price;
        } else {
          priceCents = Math.round(parseFloat(v.price || '0') * 100);
        }
        var images = [];
        (p.images || []).slice(0, 8).forEach(function(img) {
          var src = (img && (img.src || img)) || '';
          if (!src) return;
          images.push({
            thumb: src,
            hero: src,
            hero600: src,
            hero900: src
          });
        });
        var swatch = images.length ? images[0].thumb : '';
        return {
          handle: p.handle,
          title: p.title || '',
          url: '/products/' + p.handle,
          price: priceCents,
          compareAtPrice: 0,
          available: v.available !== false,
          variantId: v.id,
          type: p.product_type || '',
          colorTag: this._colorTagFromTags(p.tags),
          swatchImage: swatch,
          images: images
        };
      },

      _loadMoreProducts(handle, sIdx) {
        // Fetches up to ~1500 products from /collections/<handle>/products.json
        // (250 per page, max 6 pages) and merges handles not already present.
        // Mirrors snippets/bundle__cart-edit-data.liquid.
        var self = this;
        var MAX_PAGES = 6;
        var PAGE_SIZE = 250;

        function fetchPage(page) {
          var url = window.Shopify.routes.root + 'collections/' + encodeURIComponent(handle)
            + '/products.json?limit=' + PAGE_SIZE + '&page=' + page;
          return fetch(url, { credentials: 'same-origin' })
            .then(function(r) { return r.ok ? r.json() : { products: [] }; })
            .then(function(data) {
              var slot = self.slots[sIdx];
              if (!slot || !data || !Array.isArray(data.products) || !data.products.length) {
                return false;
              }
              var existing = {};
              slot.products.forEach(function(p) { existing[p.handle] = true; });
              data.products.forEach(function(raw) {
                if (existing[raw.handle]) return;
                var normalized = self._normalizeAjaxProduct(raw, slot.key);
                if (!normalized) return;
                existing[normalized.handle] = true;
                slot.products.push(normalized);
              });
              self._retryPendingPrefill();
              // New swatches may unlock horizontal overflow — refresh arrows.
              if (sIdx === self.activeSlotIndex) {
                self.$nextTick(function() { self.updateSwatchArrows(); });
              }
              return data.products.length >= PAGE_SIZE;
            });
        }

        (function loop(page) {
          if (page > MAX_PAGES) return;
          fetchPage(page).then(function(hasMore) {
            if (hasMore) loop(page + 1);
          }).catch(function(err) {
            console.warn('[bundle-builder] page', page, 'fetch failed', err);
          });
        })(1);
      },

      activeSlot() {
        return this.slots[this.activeSlotIndex] || null;
      },

      activeProducts() {
        var slot = this.activeSlot();
        return slot ? slot.products : [];
      },

      activeTypeFilters() {
        var slot = this.activeSlot();
        var present = {};
        this.activeProducts().forEach(function(p) {
          var t = (p.type || '').trim();
          if (t) present[t] = true;
        });
        var types = [];
        // Preferred types first (wallet / lanyard), then the rest A–Z.
        var preferred = null;
        if (slot && slot.key === 'Wallet') preferred = this.walletPreferredTypes || [];
        else if (slot && slot.key === 'Lanyard') preferred = this.lanyardPreferredTypes || [];
        if (preferred) {
          preferred.forEach(function(t) {
            if (present[t]) types.push(t);
          });
          Object.keys(present).sort(function(a, b) { return a.localeCompare(b); }).forEach(function(t) {
            if (preferred.indexOf(t) === -1) types.push(t);
          });
          return types;
        }
        Object.keys(present).forEach(function(t) { types.push(t); });
        types.sort(function(a, b) { return a.localeCompare(b); });
        return types;
      },

      showTypeFilters() {
        return this.activeTypeFilters().length > 1;
      },

      filteredProducts() {
        var products = this.activeProducts();
        if (!this.typeFilter || this.typeFilter === 'all') return products;
        var filter = this.typeFilter;
        return products.filter(function(p) { return p.type === filter; });
      },

      shortTypeLabel(type) {
        if (!type) return '';
        return type
          .replace(/\s+Holder Keychain$/i, '')
          .replace(/\s+Keychain$/i, '')
          .replace(/\s+Wallet$/i, '')
          .replace(/\s+Lanyard$/i, '')
          .trim() || type;
      },

      setTypeFilter(type) {
        this.typeFilter = type || 'all';
        var list = this.filteredProducts();
        var self = this;
        var stillVisible = list.some(function(p) { return p.handle === self.previewHandle; });
        if (!stillVisible) {
          var first = this._firstAvailable(list);
          if (first) {
            this.previewHandle = first.handle;
            this.galleryIndex = 0;
            this.applyHero(true);
          }
        }
        this.resetSwatchScroll();
      },

      /* Swatch paging — vertical scroll (compact 4/5-col grid). */
      updateSwatchArrows() {
        var grid = this.$refs.swatchGrid;
        if (!grid) {
          this.swatchHasPagination = false;
          this.swatchCanPrev = false;
          this.swatchCanNext = false;
          return;
        }
        var max = grid.scrollHeight - grid.clientHeight;
        var hasOverflow = max > 1;
        this.swatchHasPagination = hasOverflow;
        if (!hasOverflow) {
          this.swatchCanPrev = false;
          this.swatchCanNext = false;
          return;
        }
        this.swatchCanPrev = grid.scrollTop > 1;
        this.swatchCanNext = grid.scrollTop < max - 1;
      },

      scrollSwatches(dir) {
        var grid = this.$refs.swatchGrid;
        if (!grid) return;
