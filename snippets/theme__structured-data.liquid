<!-- snippets/theme__structured-data.liquid -->
{% comment %}
  Include structured data for better SEO visibility.

  Usage:
    {% render 'theme__structured-data' %}

    Collection pages with paginated product lists must render this snippet
    inside a {% paginate %} block so list positions continue across pages:

    {% render 'theme__structured-data', collection: collection, paginate: paginate %}

  Globals:
    - settings.favicon: set the favicon image
    - settings.social_instagram_link: link to instagram
    - settings.social_twitter_link: link to twitter
    - settings.social_facebook_link: link to facebook
    - settings.social_pinterest_link: link to pinterest
    - settings.social_snapchat_link: link to snapchat
    - settings.social_tumblr_link: link to tumblr
    - settings.social_youtube_link: link to youtube
    - settings.social_vimeo_link: link to vimeo
    - settings.enable_local_business: enable local business structured data

  Pro tips:
    - For stores with a single physical location the enable_local_business will help improve local SEO. Your address will be included in structured data along with your logo.
{% endcomment %}

{%- if template.name == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": "{{ shop.name }}",
      "url": "{{ shop.url | append: page.url }}",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ shop.url }}/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "Organization",
      "name": "{{ shop.name }}",
      "url": "{{ shop.url | append: page.url }}",
      {%- if settings.favicon -%}
        "logo": "https:{{ settings.favicon | image_url: original }}",
      {%- endif -%}
      "sameAs": [
        "{{ settings.social_twitter_link }}",
        "{{ settings.social_facebook_link }}",
        "{{ settings.social_pinterest_link }}",
        "{{ settings.social_instagram_link }}",
        "{{ settings.social_tumblr_link }}",
        "{{ settings.social_snapchat_link }}",
        "{{ settings.social_youtube_link }}",
        "{{ settings.social_vimeo_link }}"
      ]
    }
  </script>

  {%- if settings.enable_local_business -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Store",
        "name": "{{ shop.name }}",
        "url": "{{ shop.url }}",
        "telephone": "{{ shop.address.phone }}",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "{{ shop.address.address1 }}",
          "addressLocality": "{{ shop.address.city }}",
          "addressRegion": "{{ shop.address.province }}",
          "postalCode": "{{ shop.address.zip }}",
          "addressCountry": "{{ shop.address.country }}"
        }
      }
    </script>
  {%- endif -%}
{%- endif -%}

{%- if template.name == 'list-collections' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ shop.url }}"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Collections"
        }
      ]
    }
  </script>
{%- endif -%}

{%- if template.name == 'collection' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ shop.url }}"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Collections",
          "item": "{{ shop.url }}/collections"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{ collection.title }}"
        }
      ]
    }
  </script>
{%- endif -%}

{%- if collection != blank and paginate != blank and collection.products.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": {{ canonical_url | append: '#collection' | json }},
      "name": {{ collection.title | json }},
      "url": {{ canonical_url | json }},
      {%- if collection.description != blank -%}
        "description": {{ collection.description | strip_html | strip_newlines | json }},
      {%- endif -%}
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ paginate.items }},
        "itemListElement": [
          {%- for product in collection.products -%}
            {
              "@type": "ListItem",
              "position": {{ paginate.current_offset | plus: forloop.index }},
              "url": {{ shop.url | append: product.url | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    }
  </script>
{%- endif -%}

{%- if template.name == 'product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": "{{ shop.url }}{{ product.url }}#product",
      "name": {{ product.title | json }},
      "description": {{ product.description | default: product.title | strip_html | strip_newlines | truncate: 500 | json }},
      "image": [{% for img in product.images %}{{ img | image_url: width: 2000 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: "Thread Wallets" | json }}
      },
      "category": {{ product.type | json }},
      {% comment %}{% if product.metafields.custom.gtin %}"gtin13": {{ product.metafields.custom.gtin | json }},{% endif %}{% endcomment %}
      {% if product.metafields.custom.mpn %}"mpn": {{ product.metafields.custom.mpn | json }},{% endif %}
      {%- liquid
        assign review_summary = product.metafields.okendo.summaryData.value | default: product.metafields.okendo.summaryData
        assign review_count = review_summary.reviewCount | plus: 0
        assign review_rating = review_summary.reviewAverageValue | plus: 0
      -%}
      {% if review_count > 0 and review_rating >= 1 and review_rating <= 5 %}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ review_rating | json }},
        "reviewCount": {{ review_count | json }}
      },
      {% endif %}
      "offers": {
        "@type": "Offer",
        "url": "{{ shop.url }}{{ product.url }}",
        "price": {{ product.price_max | money_without_currency | replace: ",", "" }},
        "priceCurrency": {{ shop.currency | json }},
        "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
        "gtin": {{ product.selected_or_first_available_variant.barcode | json }},
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "US",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": {{ shop.metafields.policies.return_days | default: 30 }},
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn",
          "merchantReturnLink": {{ shop.policy_refund_url | default: shop.url | append: "/policies/refund-policy" | json }}
        },
        "shippingDetails": [
          {
            "@type": "OfferShippingDetails",
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "US" },
            "shippingRate": {
              "@type": "MonetaryAmount",
              "value": {{ shop.metafields.shipping.us_rate | default: 0 }},
              "currency": {{ shop.currency | json }}
            },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 2, "unitCode": "d" },
              "transitTime": { "@type": "QuantitativeValue", "minValue": 3, "maxValue": 7, "unitCode": "d" }
            }
          }
        ]
      }
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ shop.url }}"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Categories",
          "item": "{{ shop.url }}/collections"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Products",
          "item": "{{ shop.url }}/collections/all"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "{{ product.title }}"
        }
      ]
    }
  </script>
{%- endif -%}

{% if template.name == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "Article",
      "articleBody": "{{ article.content | strip_html }}",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ shop.url | append: page.url }}"
      },
      "headline": "{{ article.title }}",
      {% if article.excerpt != blank %}
        "description": "{{ article.excerpt | strip_html }}",
      {% endif %}
      "image": [
        "https:{{ page_image | image_url: 'master' }}"
      ],
      "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
      "dateCreated": "{{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
      "author": {
        "@type": "Person",
        "name": "{{ article.author }}"
      },
      "publisher": {
        "@type": "Organization",
        {% if settings.favicon %}
          {% assign image_size = settings.favicon.width | append: 'x' %}
          "logo": {
            "@type": "ImageObject",
            "url": "{{ settings.favicon | image_url: image_size | prepend: "https:" }}",
            "height": "{{ settings.favicon.height }}",
            "width": "{{ settings.favicon.width }}"
          },
        {% endif %}
        "name": "{{ shop.name }}"
      }
    }
  </script>
{% endif -%}
