{% comment %}
  PDP-style Market Tote bundler body: hero image, swatch grid, progress
  dots, mini-bundle strip with remove, and Add to Bundle / Add to Cart CTA.
{% endcomment %}

{% doc %}
  Market Tote bundler PDP layout.
  @param {string} add_bundle_label - Add to Bundle button text
  @param {string} cart_label - Add to Cart button text
  @param {string} discount_type - percent | fixed_off | none
  @param {number} discount_value - display savings amount
  @example
  {% render 'market-tote-bundler__pdp-layout', add_bundle_label: 'Add to Bundle', cart_label: 'Add Bundle to Cart', discount_type: 'percent', discount_value: 25 %}
{% enddoc %}

{%- assign _add_label = add_bundle_label | default: 'Add to Bundle' -%}
{%- assign _cart_label = cart_label | default: 'Add Bundle to Cart' -%}

<div class="mtb-pdp" x-show="products.length > 0" x-cloak>
  <div
    class="mtb-pdp__media"
    :class="{ 'mtb-pdp__media--solo': previewImages().length <= 1 }">
    <div
      class="mtb-pdp__thumbs"
      x-show="previewImages().length > 1"
      x-cloak
      role="listbox"
      aria-label="Product images">
      <template x-for="(image, imgIdx) in previewImages()" :key="imgIdx">
        <button
          type="button"
          role="option"
          class="mtb-pdp__thumb"
          :class="{ 'is-active': galleryIndex === imgIdx }"
          :aria-selected="galleryIndex === imgIdx"
          @click="selectGallery(imgIdx)"
          @mouseenter="prefetchUrl(image.hero900 || image.hero)">
          <img
            :src="image.thumb"
            width="80"
            height="80"
            :alt="(previewProduct()?.title || '') + ' image ' + (imgIdx + 1)"
            loading="lazy"
            decoding="async" />
        </button>
      </template>
    </div>

    <div class="mtb-pdp__hero" :class="{ 'is-loading': !heroReady }">
      <img
        x-show="heroSrc"
        :src="heroSrc"
        :srcset="heroSrcset || null"
        sizes="(min-width: 990px) 45vw, 100vw"
        width="1200"
        height="1200"
        :alt="heroAlt"
        decoding="async"
        fetchpriority="high" />
    </div>
  </div>

  <div class="mtb-pdp__info">
    <div x-show="previewProduct()">
      <h3 class="mtb-pdp__title" x-text="previewProduct()?.title || ''"></h3>
      <p class="mtb-pdp__price" x-text="previewProduct() ? formatMoney(previewProduct().price) : ''"></p>
    </div>

    <div class="mtb-pdp__styles-header">
      <p class="mtb-pdp__styles-label">
        Select Your Style
        <span class="mtb-pdp__styles-count" x-text="'(' + products.length + ' styles)'"></span>
      </p>
    </div>

    <div class="mtb-pdp__swatches" role="listbox" aria-label="Market Tote styles">
      <template x-for="product in products" :key="product.handle">
        <button
          type="button"
          role="option"
          class="mtb-pdp__swatch"
          :class="{
            'is-current': isPreview(product.handle),
            'is-unavailable': !product.available
          }"
          :aria-selected="isPreview(product.handle)"
          :aria-label="product.title"
          :disabled="!product.available"
          @mouseenter="prefetchProduct(product.handle)"
          @focus="prefetchProduct(product.handle)"
          @click="selectPreview(product.handle)">
          <span class="mtb-pdp__swatch-img">
            <img
              :src="product.swatchImage"
              width="120"
              height="120"
              :alt="product.title"
              loading="lazy"
              decoding="async" />
            <span
              class="mtb-pdp__swatch-check"
              x-show="isPreview(product.handle)"
              aria-hidden="true">✓</span>
          </span>
          <span class="mtb-pdp__swatch-name" x-text="shortName(product.title)"></span>
        </button>
      </template>
    </div>

    <div class="mtb-pdp__progress" aria-label="Bundle progress">
      <template x-for="i in dotIndexes()" :key="i">
        <span
          class="mtb-pdp__dot"
          :class="{ 'is-filled': totalSelected() >= i }"
          aria-hidden="true"></span>
      </template>
      <span class="mtb-pdp__progress-label type--small" x-text="totalSelected() + ' of ' + requiredCount + ' added'"></span>
    </div>

    <div class="mtb-pdp__cta">
      <button
        type="button"
        class="btn btn--primary w-full"
        x-show="!isComplete()"
        :disabled="!canAddToBundle()"
        :class="{ 'opacity-50 cursor-not-allowed': !canAddToBundle() }"
        @click="addToBundle()">
        {{ _add_label }}
      </button>
      <button
        type="button"
        class="btn btn--primary w-full"
        x-show="isComplete()"
        x-cloak
        :disabled="!canAddToCart() || cartLoading"
        :class="{ 'opacity-50 cursor-not-allowed': !canAddToCart() || cartLoading }"
        @click="finalizeBundle()">
        <span x-show="!cartLoading">{{ _cart_label }} &mdash; Save {{ discount_value | default: 25 }}%</span>
        <span x-show="cartLoading" x-cloak>Adding&hellip;</span>
      </button>
    </div>

    <div class="mtb-pdp__summary" x-show="totalSelected() > 0" x-cloak>
      <p class="mtb-pdp__summary-total">
        <span class="mtb-pdp__summary-label">Bundle total:</span>
        <strong
          class="mtb-pdp__summary-now"
          x-text="formatMoney(isComplete() ? totalCents() : subtotalCents())"></strong>
        <s
          class="mtb-pdp__summary-was"
          x-show="isComplete() && discountCents() > 0"
          x-text="formatMoney(subtotalCents())"
          x-cloak></s>
      </p>
    </div>

    <div class="mtb-pdp__picks" x-show="totalSelected() > 0" x-cloak>
      <p class="mtb-pdp__picks-label type--small">In your bundle</p>
      <ul class="mtb-pdp__picks-list">
        <template x-for="(handle, idx) in picks" :key="idx + '-' + handle">
          <li class="mtb-pdp__pick">
            <img
              :src="pickProduct(idx)?.swatchImage"
              width="48"
              height="48"
              :alt="pickProduct(idx)?.title || ''"
              loading="lazy" />
            <span class="mtb-pdp__pick-name" x-text="shortName(pickProduct(idx)?.title || '')"></span>
            <button
              type="button"
              class="mtb-pdp__pick-remove"
              :aria-label="'Remove ' + shortName(pickProduct(idx)?.title || 'tote') + ' from bundle'"
              @click="removePick(idx)">Remove from Bundle</button>
          </li>
        </template>
      </ul>
    </div>
  </div>
</div>

<p
  class="type--small italic text-center"
  style="padding: 24px 16px;"
  x-show="products.length === 0"
  x-cloak>
  No Market Totes available.
</p>
