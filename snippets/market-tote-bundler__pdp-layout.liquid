{% comment %}
  PDP-style Market Tote bundler body — aligned with Everyday Carry Set:
  page intro (heading + savings) in the right column, styles header,
  swatch grid with in-tile Add and X-to-remove, progress, CTA.

  Heading + savings are the first DOM child so mobile stacks
  intro → gallery → details (same grid-area trick as ECS).
{% endcomment %}

{% doc %}
  Market Tote bundler PDP layout.
  @param {string} cart_label - Add to Cart button text
  @param {string} discount_type - percent | fixed_off | none
  @param {number} discount_value - display savings amount
  @param {string} [heading] - Page heading (right column on desktop)
  @param {string} [savings_label] - Bronze savings line under heading
  @example
  {% render 'market-tote-bundler__pdp-layout', cart_label: 'Add Bundle to Cart', discount_type: 'percent', discount_value: 20, heading: 'Build Your Tote Bundle', savings_label: '3 Market Totes = 20% OFF' %}
{% enddoc %}

{%- assign _cart_label = cart_label | default: 'Add Bundle to Cart' -%}

<div
  class="mtb-pdp tri-pdp{% unless heading == blank and savings_label == blank %} tri-pdp--has-intro{% endunless %}"
  x-show="products.length > 0"
  x-cloak>
  {%- unless heading == blank and savings_label == blank -%}
    <div class="tri-pdp__page-intro">
      {%- unless heading == blank -%}
        <h2 class="tri-pdp__page-heading">{{ heading }}</h2>
      {%- endunless -%}
      {%- unless savings_label == blank -%}
        <p class="mtb-pdp__savings">{{ savings_label }}</p>
      {%- endunless -%}
    </div>
  {%- endunless -%}

  <div
    class="mtb-pdp__media"
    :class="{ 'mtb-pdp__media--solo': previewImages().length <= 1 }">
    <div
      class="mtb-pdp__thumbs"
      x-show="previewImages().length > 1"
      x-cloak
      role="listbox"
      aria-label="Product images">
      <template x-for="(image, imgIdx) in previewImages()" :key="(image.hero || image.thumb || '') + '-' + imgIdx">
        <button
          type="button"
          role="option"
          class="mtb-pdp__thumb"
          :class="{
            'is-active': galleryIndex === imgIdx,
            'is-video': image.mediaType === 'video' || image.mediaType === 'external_video'
          }"
          :aria-selected="galleryIndex === imgIdx"
          :aria-label="(previewProduct()?.title || 'Product') + (image.mediaType === 'video' || image.mediaType === 'external_video' ? ' video ' : ' image ') + (imgIdx + 1)"
          @click="selectGallery(imgIdx)"
          @mouseenter="prefetchUrl(image.hero900 || image.hero)">
          <img
            :src="image.thumb"
            width="80"
            height="80"
            :alt="(previewProduct()?.title || '') + ' image ' + (imgIdx + 1)"
            loading="lazy"
            decoding="async" />
        </button>
      </template>
    </div>

    {%- comment -%}
      Main hero — same wrap + arrows/dots pattern as Everyday Carry Set.
      Videos play muted/looped (same as PDP); thumbs show a play badge.
    {%- endcomment -%}
    <div class="mtb-pdp__hero-wrap">
      <div
        class="mtb-pdp__hero"
        :class="{
          'is-loading': !heroReady,
          'is-video': isHeroVideo() || isHeroExternalVideo()
        }">
        <template x-if="isHeroVideo()">
          <video
            class="mtb-pdp__hero-video"
            :key="'vid-' + heroVideoUrl"
            :src="heroVideoUrl"
            :poster="heroSrc || null"
            autoplay
            loop
            muted
            playsinline
            @loadeddata="heroReady = true"></video>
        </template>
        <template x-if="isHeroExternalVideo() && heroEmbedUrl()">
          <iframe
            class="mtb-pdp__hero-embed"
            :key="'ext-' + heroExternalHost + '-' + heroExternalId"
            :src="heroEmbedUrl()"
            :title="heroAlt || 'Product video'"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
            loading="lazy"
            @load="heroReady = true"></iframe>
        </template>
        <img
          x-show="!isHeroVideo() && !isHeroExternalVideo() && heroSrc"
          :src="heroSrc"
          :srcset="heroSrcset || null"
          sizes="(min-width: 990px) 55vw, 100vw"
          width="1200"
          height="1200"
          :alt="heroAlt"
          decoding="async"
          fetchpriority="high" />
      </div>

      <template x-if="previewImages().length > 1">
        <div class="mtb-pdp__hero-arrows" aria-hidden="false">
          <button
            type="button"
            class="mtb-pdp__hero-arrow mtb-pdp__hero-arrow--prev btn btn--plain btn--small shadow-sm"
            aria-label="Previous image"
            @click="galleryPrev()">
            {% render 'component__icon', icon: 'arrow-left', size: '20', class: '' %}
          </button>
          <button
            type="button"
            class="mtb-pdp__hero-arrow mtb-pdp__hero-arrow--next btn btn--plain btn--small shadow-sm"
            aria-label="Next image"
            @click="galleryNext()">
            {% render 'component__icon', icon: 'arrow-right', size: '20', class: '' %}
          </button>
        </div>
      </template>

      <div
        class="mtb-pdp__hero-dots"
        x-show="previewImages().length > 1 && previewImages().length <= 12"
        x-cloak
        role="tablist"
        aria-label="Image pagination">
        <template x-for="(image, imgIdx) in previewImages()" :key="'dot-' + imgIdx">
          <button
            type="button"
            class="mtb-pdp__hero-dot"
            role="tab"
            :class="{ 'is-active': galleryIndex === imgIdx }"
            :aria-selected="galleryIndex === imgIdx"
            :aria-label="'Image ' + (imgIdx + 1)"
            @click="selectGallery(imgIdx)"></button>
        </template>
      </div>
    </div>
  </div>

  {%- comment -%}
    Mobile-only product title/price above the gallery — same pattern as
    Everyday Carry / PDP. Desktop keeps the copy inside .mtb-pdp__info.
  {%- endcomment -%}
  <div class="tri-pdp__mobile-only tri-pdp__mobile-summary">
    <div x-show="previewProduct()" x-cloak>
      <h3 class="mtb-pdp__title" x-text="previewProduct()?.title || ''"></h3>
      <p class="mtb-pdp__price" x-text="previewProduct() ? formatMoney(previewProduct().price) : ''"></p>
    </div>
  </div>

  <div class="mtb-pdp__info">
    <div class="tri-pdp__desktop-only" x-show="previewProduct()" x-cloak>
      <h3 class="mtb-pdp__title" x-text="previewProduct()?.title || ''"></h3>
      <p class="mtb-pdp__price" x-text="previewProduct() ? formatMoney(previewProduct().price) : ''"></p>
    </div>

    {%- comment -%}
      Title row matches Everyday Carry / PDP related-styles: "Select Your Style"
      left, style count right-justified on the same line.
    {%- endcomment -%}
    <div class="mtb-pdp__styles-header">
      <div class="mtb-pdp__styles-titlerow">
        <h4 class="mtb-pdp__styles-label">Select Your Style</h4>
        <span
          class="mtb-pdp__styles-count"
          x-text="products.length + (products.length === 1 ? ' style' : ' styles')"></span>
      </div>
    </div>

    <div class="mtb-pdp__swatches" role="listbox" aria-label="Market Tote styles">
      <template x-for="product in products" :key="product.handle">
        {%- comment -%}
          Div (not button) so Add and Remove can be real nested buttons.
          Click/keyboard still previews the tote.
        {%- endcomment -%}
        <div
          role="option"
          class="mtb-pdp__swatch"
          :tabindex="product.available ? 0 : -1"
          :class="{
            'is-current': isPreview(product.handle),
            'is-unavailable': !product.available,
            'is-picked': isPicked(product.handle)
          }"
          :aria-selected="isPreview(product.handle)"
          :aria-disabled="!product.available"
          :aria-label="product.title"
          @mouseenter="prefetchProduct(product.handle)"
          @focus="prefetchProduct(product.handle)"
          @click="selectPreview(product.handle)"
          @keydown.enter.prevent="selectPreview(product.handle)"
          @keydown.space.prevent="selectPreview(product.handle)">
          <span class="mtb-pdp__swatch-img">
            <img
              :src="product.swatchImage"
              width="120"
              height="120"
              :alt="product.title"
              loading="lazy"
              decoding="async" />
            {%- comment -%}
              Qty badge (top-left) — how many of this SKU are in the bundle.
              Same style can be added more than once (up to 3 total picks).
            {%- endcomment -%}
            <span
              class="mtb-pdp__swatch-qty"
              x-show="pickCount(product.handle) > 0"
              x-cloak
              :aria-label="pickCount(product.handle) + ' in bundle'"
              x-text="pickCount(product.handle)"></span>
            {%- comment -%}
              X removes one instance of this tote from the bundle.
            {%- endcomment -%}
            <button
              type="button"
              class="mtb-pdp__swatch-remove"
              x-show="isPicked(product.handle)"
              x-cloak
              :aria-label="'Remove ' + shortName(product.title) + ' from bundle'"
              @click.stop="removePickByHandle(product.handle)">
              <span aria-hidden="true">&times;</span>
            </button>
            <span
              class="mtb-pdp__swatch-check"
              x-show="isPreview(product.handle) && !isPicked(product.handle)"
              aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 6.2L4.8 8.5L9.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </span>
          <span class="mtb-pdp__swatch-name" x-text="shortName(product.title)"></span>
          <button
            type="button"
            class="mtb-pdp__swatch-action btn btn--primary"
            :class="{ 'mtb-pdp__swatch-action--plus': isPicked(product.handle) }"
            x-show="showPreviewAction(product.handle)"
            x-cloak
            @click.stop="addToBundle()"
            :aria-label="isPicked(product.handle) ? ('Add another ' + shortName(product.title)) : ('Add ' + shortName(product.title))"
            x-text="previewActionLabel()"></button>
        </div>
      </template>
    </div>

    <div class="mtb-pdp__progress" aria-label="Bundle progress">
      <template x-for="i in dotIndexes()" :key="i">
        <span
          class="mtb-pdp__dot"
          :class="{ 'is-filled': totalSelected() >= i }"
          aria-hidden="true"></span>
      </template>
      <span
        class="mtb-pdp__progress-label type--small"
        x-text="totalSelected() + ' of ' + requiredCount + ' added'"></span>
    </div>

    <div class="mtb-pdp__cta" x-show="isComplete()" x-cloak>
      <button
        type="button"
        class="btn btn--primary w-full"
        :disabled="!canAddToCart() || cartLoading"
        :class="{ 'opacity-50 cursor-not-allowed': !canAddToCart() || cartLoading }"
        @click="finalizeBundle()">
        <span x-show="!cartLoading">{{ _cart_label }} &mdash; Save {{ discount_value | default: 20 }}%</span>
        <span x-show="cartLoading" x-cloak>Adding&hellip;</span>
      </button>
    </div>

    <div class="mtb-pdp__summary" x-show="totalSelected() > 0" x-cloak>
      <p class="mtb-pdp__summary-total">
        <span class="mtb-pdp__summary-label">Bundle total:</span>
        <strong
          class="mtb-pdp__summary-now"
          x-text="formatMoney(isComplete() ? totalCents() : subtotalCents())"></strong>
        <s
          class="mtb-pdp__summary-was"
          x-show="isComplete() && discountCents() > 0"
          x-text="formatMoney(subtotalCents())"
          x-cloak></s>
      </p>
    </div>
  </div>
</div>

<p
  class="type--small italic text-center"
  style="padding: 24px 16px;"
  x-show="products.length === 0"
  x-cloak>
  No Market Totes available.
</p>
