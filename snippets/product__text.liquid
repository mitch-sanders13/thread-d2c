<!-- snippets/product__text.liquid -->
{% comment %} 
  Block for displaying rich text content.

  Accepts:
    - blocksettings: liquid object of block settings
      
  Usage:
    {% render 'product__text', 
      blocksettings: block.settings %}

  Pro tips:
    - Use metafields to display dynamic product content.
{% endcomment %}

{%- if settings.show_pdp_promos == true and blocksettings.content != blank -%}
<div class="pdp-block pdp-block--text px-4
    {{ section.settings.color_border }}
    {{ blocksettings.color_scheme }}
    {{ blocksettings.style_border }}"
  data-pdp-block
  style="
    padding-top:{{ blocksettings.spacing_top }}px;
    padding-bottom:{{ blocksettings.spacing_bottom }}px;" >
  <div class="pdp-text m-0--clear block
    {{ blocksettings.layout_x_alignment }}">
    {{ blocksettings.content }}
  </div>
</div>
{%- endif -%}