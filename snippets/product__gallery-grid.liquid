<!-- snippets/product__gallery-grid.liquid -->
{% comment %} 
  Block to display product photos in a grid.

  Accepts:
    - featured: boolean to assign product object from section settings, set this to true if block is used within a section rather than product template
  
  Usage:
    {% render 'product__gallery-grid', 
      featured: true %}

  Globals:
    - settings.savings_badge: boolean to display savings badge

  Possible enhancements:
    - Add global setting to set grid gap width and apply to entire theme.
    - Add alterntive grid layouts (e.g. 2x2, 3x3, 4x4, etc.).
    - Move position of indicators to avoid overlap of alt text.
  
  Pro tips:
    - When a product only has one photo the image will not be shown in a grid.
    - Mobile will default to the slider layout regardless.
{% endcomment %}

{% if featured %}
  {%- assign product = section.settings.product -%}
{% endif %}

{% comment %} Mobile only blocks {% endcomment %}
<div class="w-full md:hidden">
  {% for block in section.blocks %}
    {%- case block.type -%}
      
      {%- when 'breadcrumb' -%}
        {% render 'product__breadcrumb', blocksettings: block.settings %}
      
      {%- when 'title' -%}
        {% render 'product__title', blocksettings: block.settings %}

      {%- when 'price' -%}
        <div class="px-4
            {{ section.settings.color_border }}
            {{ block.settings.color_scheme }} 
            {{ block.settings.style_border }}"
          style="
            padding-top:{{ block.settings.spacing_top }}px;
            padding-bottom:{{ block.settings.spacing_bottom }}px;">
          <div class="relative flex items-end justify-between">
            {% render 'product__price', blocksettings: block.settings %}
          </div>
        </div>

    {%- endcase -%}
  {% endfor %}
</div>

<div
  class="
    pdp-gallery-col pdp-gallery-grid-d hidden md:grid items-start relative h-full padding--r-gap margin--t-gap margin--b-gap
    {{ section.settings.layout_gallery_size }}
    {% if product.media.size > 1 %}
      grid-cols-2
    {% endif %}
  "
  style="
    gap: {{ settings.layout_gap_size }}px;">
  
  {%- comment -%} Badges {%- endcomment -%}
  {% if section.settings.show_product_badges %}
    <div class="absolute top-0 left-0 z-10 flex flex-wrap w-full gap-2 p-2 whitespace-normal">

      {%- if product.metafields.reviews.rating.value != blank -%}
        {% capture badge_content %}
        {% assign rating = product.metafields.reviews.rating.value | strip %}
        {{ rating | times: 1 | round: 2 }}
          {% render 'component__icon', icon: 'star', size: '12', class: 'ml-1' %} 
        {% endcapture %}
        {% render 'component__badge', 
          background: 'overlay-2',
          text: 'text',
          icon: '',
          content: badge_content %}
      {%- endif -%}

      {% for tag in product.tags %}
        {% if tag contains "badge_" %}
          {% capture badge_content %}{{ tag | remove: "badge_" }}{% endcapture %}
          {% render 'component__badge', 
            background: 'secondary',
            text: 'secondary',
            icon: '',
            content: badge_content %}
        {% endif %}
      {% endfor %}

      {% render 'product__presale-badge',
        background: 'secondary',
        text: 'secondary',
        border: 'secondary'
      %}

      {% if settings.savings_badge != "none" %}
        {% if product.price < product.compare_at_price %}
          {% if settings.savings_badge == "percent" %}
            {% capture badge_content %}{{ discount_percentage }}{% endcapture %}
            {% capture a %}{{ product.compare_at_price | minus: product.price }} {% endcapture %}
            {% capture b %}{{ a | times: 100 }} {% endcapture %} 
            {% capture discount_percentage %}{{ b | divided_by: product.compare_at_price | round }} {% endcapture %} 
            {% capture badge_content %} {{ 'products.general.save' | t }} {{ discount_percentage | strip | append: '%' }} {% endcapture %}
          {% else %}
            {% capture discount_amount %}{{ product.compare_at_price | minus: product.price | money }}{% endcapture %}
            {% capture badge_content %}{{ 'products.general.save' | t }} {{ discount_amount }}{% endcapture %}
          {% endif %}
          {% render 'component__badge', 
            background: 'secondary',
            text: 'secondary'
            icon: '',
            content: badge_content %}
        {% endif %}
      {% endif %}
      
    </div>
  {% endif %}

  {% capture media_group %}{% endcapture %}

  {% for media in product.media %}
    {% case media.media_type %}
      {% when 'image' %}
        
        {% for variant in product.variants %}
          {% for variant in product.variants %}
            {% if media.src == variant.featured_image.src %}
              {% capture media_group %}
                {{ variant.featured_image.id }}
              {% endcapture %}
            {% endif %}
          {% endfor %}
        {% endfor %}
    
        <div class="relative border--width border--radius overflow-hidden
          {{ section.settings.image_border }}
          {{ media | handle }}
          {% if section.settings.enable_zoom %}cursor-zoom-in{% endif %}"
            {% if section.settings.enable_variant_images %}
              {% if media_group.size > 1 %}
                x-show="current_variant_featured_image_id == {{ media_group }}"
                x-cloak
              {% endif %}
            {% endif %}
            {% if section.settings.enable_zoom %}
              @click="fullscreen = true; hide_header = true;"
            {% endif %}>
          <div class="overflow-hidden object-cover
            {% if section.settings.enable_ratio %}{{ section.settings.media_ratio }}{% endif %}
            {{ section.settings.media_color_scheme }}">
            {% if section.settings.media_object-sizing == "cover" %}
              {% capture image_class %}w-full h-full object-cover {{ section.settings.media_color_scheme }}{% endcapture %}
            {% else %}
              {% capture image_class %}w-full h-full object-contain {{ section.settings.media_color_scheme }}{% endcapture %}
            {% endif %}
            {%- if forloop.first -%}
              {{ media | image_url: width: 1400 | image_tag: style: 'object-fit:cover', class: image_class, loading: 'eager', fetchpriority: 'high', widths: '400, 600, 900, 1200, 1400', sizes: '(min-width: 768px) 50vw, 100vw', alt: media.alt }}
            {%- else -%}
              {{ media | image_url: width: 1400 | image_tag: style: 'object-fit:cover', class: image_class, loading: 'lazy', widths: '400, 600, 900, 1200, 1400', sizes: '(min-width: 768px) 50vw, 100vw', alt: media.alt }}
            {%- endif -%}
          </div>
          {% if section.settings.enable_alt == true and media.alt != product.title %}
            <div class="absolute bottom-0 w-full p-2 text-left whitespace-normal opacity-75 type--smaller">
              {{ media.alt }}
            </div>
          {% endif %}
        </div>

      {% when 'external_video' %}
        <div class="relative border--width border--radius overflow-hidden
          {{ section.settings.image_border }}">
          <div class="overflow-hidden object-cover
            {{ section.settings.media_color_scheme }}
            {% if section.settings.enable_ratio %}{{ section.settings.media_ratio }}{% endif %}">
            <div class="flex items-center">
              <div class="object-cover w-full aspect-video aspect-w-16 aspect-h-9">
                {% if media.host == 'youtube' %}
                  {{ media | external_video_url: color: 'white' | external_video_tag: class: 'w-full h-full aspect-video max-w-full' }}
                {% elsif media.host == 'vimeo' %}
                  {{ media | external_video_url: loop: '1', muted: '1' | external_video_tag: class: 'w-full h-full aspect-video max-w-full' }}
                {% endif %}
              </div>
            </div>
          </div>
        </div>

      {% when 'video' %}
        <div class="relative border--width border--radius overflow-hidden
          {{ section.settings.image_border }}">
          <div class="overflow-hidden object-cover
            {{ section.settings.media_color_scheme }}
            {% if section.settings.enable_ratio %}{{ section.settings.media_ratio }}{% endif %}">
            <div class="flex items-center">
              {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'w-full h-full' }}
            </div>
          </div>
        </div>

      {% when 'model' %}
        <div class="relative border--width border--radius overflow-hidden
          {{ section.settings.image_border }}">
          <div class="absolute z-10 bottom-2 left-2">
            {% capture badge_content %}
              {% render 'component__icon', icon: 'box', size: '16' %}
            {% endcapture %}
            {% render 'component__badge', 
              background: 'body',
              text: 'text',
              icon: '',
              content: badge_content %}
          </div>
          <div class="absolute left-auto right-auto z-10 w-full bottom-2">
            <button
              class="btn btn--small btn--secondary"
              data-shopify-xr
              data-shopify-model3d-id="{{ media.id }}"
              data-shopify-title="{{ product.title | escape }}"
              data-shopify-xr-hidden>
              {{ 'general.media.view_in_space' | t }}
            </button>
          </div>
          <div class="overflow-hidden object-cover h-full
            {{ section.settings.media_color_scheme }}
            {{ section.settings.media_ratio }}">
            <div class="flex items-center h-full">
              {{ media | model_viewer_tag: class: 'w-full h-full' }}
            </div>
          </div>
        </div>

    {% endcase %}
  {% endfor %}

</div>

<div class="pdp-gallery-col md:hidden
  {{ section.settings.layout_gallery_size }}">
  <div class="relative flex w-full margin--t-gap margin--b-gap">

    {%- comment -%} Badges {%- endcomment -%}
    {% if section.settings.show_product_badges %}
      <div class="absolute top-0 left-0 z-10 flex flex-wrap w-full gap-2 px-4 py-2 whitespace-normal">
    
        {%- if product.metafields.reviews.rating.value != blank -%}
          {% capture badge_content %}
          {% assign rating = product.metafields.reviews.rating.value | strip %}
          {{ rating | times: 1 | round: 2 }}
            {% render 'component__icon', icon: 'star', size: '12', class: 'ml-1' %} 
          {% endcapture %}
          {% render 'component__badge', 
            background: 'overlay-2',
            text: 'text',
            icon: '',
            content: badge_content %}
        {%- endif -%}
    
        {% for tag in product.tags %}
          {% if tag contains "badge_" %}
            {% capture badge_content %}{{ tag | remove: "badge_" }}{% endcapture %}
            {% render 'component__badge', 
              background: 'secondary',
              text: 'secondary',
              icon: '',
              content: badge_content %}
          {% endif %}
        {% endfor %}

        {% render 'product__presale-badge',
          background: 'secondary',
          text: 'secondary',
          border: 'secondary'
        %}
        
        {% if settings.savings_badge != "none" %}
          {% if product.price < product.compare_at_price %}
            {% if settings.savings_badge == "percent" %}
              {% capture badge_content %}{{ discount_percentage }}{% endcapture %}
              {% capture a %}{{ product.compare_at_price | minus: product.price }} {% endcapture %}
              {% capture b %}{{ a | times: 100 }} {% endcapture %} 
              {% capture discount_percentage %}{{ b | divided_by: product.compare_at_price | round }} {% endcapture %} 
              {% capture badge_content %} {{ 'products.general.save' | t }} {{ discount_percentage | strip | append: '%' }} {% endcapture %}
            {% else %}
              {% capture discount_amount %}{{ product.compare_at_price | minus: product.price | money }}{% endcapture %}
              {% capture badge_content %}{{ 'products.general.save' | t }} {{ discount_amount }}{% endcapture %}
            {% endif %}
            {% render 'component__badge', 
              background: 'secondary',
              text: 'secondary',
              icon: '',
              content: badge_content %}
          {% endif %}
        {% endif %}

      </div>
    {% endif %}

    {%- comment -%} Arrows {%- endcomment -%}
    {% if product.media.size > 1 %}
      <div x-show="show_arrows" class="absolute z-10 hidden -translate-y-1/2 md:block top-1/2 left-4">
        <button class="shadow-sm btn btn--plain btn--small"
          title="{{ 'general.media.previous_slide' | t }}"
          {% if settings.enable_animations %}
            x-transition:enter="animation-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="animation-300"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
          {% endif %}
          x-cloak
          @click="scrollBack();">
          {% render 'component__icon', icon: 'arrow-left', size: '20', class: '' %}
        </button>
      </div>
      <div x-show="show_arrows" class="absolute z-10 hidden -translate-y-1/2 md:block top-1/2 right-4">
        <button class="shadow-sm btn btn--plain btn--small"
          title="{{ 'general.media.next_slide' | t }}"
          {% if settings.enable_animations %}
            x-transition:enter="animation-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="animation-300"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
          {% endif %}
          x-cloak
          @click="scrollNext();">
          {% render 'component__icon', icon: 'arrow-right', size: '20', class: '' %}
        </button>
      </div>
    {% endif %}
    
    {%- comment -%} Slides {%- endcomment -%}
    <div
      class="pdp-gallery-track inline-flex w-full overflow-x-auto overflow-y-hidden text-center whitespace-nowrap snap-x hidescrollbar md:px-0 md:margin--l-gap md:margin--r-gap"
      style="
        gap: {{ settings.layout_gap_size }}px;
        scroll-snap-type: x mandatory;
        -webkit-scroll-snap-type: x mandatory;"
      x-init="setTimeout(function(){ if (isOverflown($el)) show_arrows = true}, 600)"
      x-ref="slider">

      {% capture media_group %}{% endcapture %}

      {% for media in product.media %}
        {% case media.media_type %}
          
          {% when 'image' %}
            {% for variant in product.variants %}
              {% if media.src == variant.featured_image.src %}
                {% capture media_group %}
                  {{ variant.featured_image.id }}
                {% endcapture %}
              {% endif %}
            {% endfor %}
            <div class="relative snap-center flex-none border--width border--radius overflow-hidden
              {{ section.settings.image_border }}
              {{ media | handle }} 
              {% if section.settings.enable_zoom %}cursor-zoom-in{% endif %}  
              w-full"
              {% if section.settings.enable_variant_images %}
                {% if media_group.size > 1 %}
                  x-show="current_variant_featured_image_id == {{ media_group }}"
                  x-cloak
                {% endif %}
              {% endif %}  
              {% if section.settings.enable_zoom %}
                @click="fullscreen = true; hide_header = true;"
              {% endif %}   
              x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
              x-bind:data-slide="{{ forloop.index0 }}">
              <div class="overflow-hidden object-cover h-full
                {% if section.settings.enable_ratio %}{{ section.settings.media_ratio }}{% endif %}
                {{ section.settings.media_color_scheme }}">
                {% if section.settings.media_object-sizing == "cover" %}
                  {% capture image_class %}w-full h-full object-cover {{ section.settings.media_color_scheme }}{% endcapture %}
                {% else %}
                  {% capture image_class %}w-full h-full object-contain {{ section.settings.media_color_scheme }}{% endcapture %}
                {% endif %}
                {%- if forloop.first -%}
                  {{ media | image_url: width: 1400 | image_tag: style: 'object-fit:cover', class: image_class, loading: 'eager', fetchpriority: 'high', widths: '400, 600, 900, 1200, 1400', sizes: '(min-width: 768px) 50vw, 100vw', alt: media.alt }}
                {%- else -%}
                  {{ media | image_url: width: 1400 | image_tag: style: 'object-fit:cover', class: image_class, loading: 'lazy', widths: '400, 600, 900, 1200, 1400', sizes: '(min-width: 768px) 50vw, 100vw', alt: media.alt }}
                {%- endif -%}
              </div>
              {% if section.settings.enable_alt == true and media.alt != product.title %}
                <div class="absolute bottom-0 w-full p-2 text-left whitespace-normal opacity-75 type--smaller">
                  {{ media.alt }}
                </div>
              {% endif %}
            </div>
            
          {% when 'external_video' %}
            <div class="relative snap-center flex-none border--width border--radius overflow-hidden
              {{ section.settings.image_border }}
              w-full"
              x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
              x-bind:data-slide="{{ forloop.index0 }}">
              <div class="overflow-hidden object-cover 
                {% if section.settings.enable_ratio %}{{ section.settings.media_ratio }}{% endif %}
                {{ section.settings.media_color_scheme }}">
                <div class="flex items-center">
                  <div class="object-cover w-full aspect-video aspect-w-16 aspect-h-9">
                    {% if media.host == 'youtube' %}
                      {{ media | external_video_url: color: 'white' | external_video_tag: class: 'w-full h-full aspect-video max-w-full' }}
                    {% elsif media.host == 'vimeo' %}
                      {{ media | external_video_url: loop: '1', muted: '1' | external_video_tag: class: 'w-full h-full aspect-video max-w-full' }}
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>

          {% when 'video' %}
            <div class="relative snap-center flex-none border--width border--radius overflow-hidden
              {{ section.settings.image_border }}
              w-full"
              x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
              x-bind:data-slide="{{ forloop.index0 }}">
              <div class="overflow-hidden object-contain 
                {% if section.settings.enable_ratio %}{{ section.settings.media_ratio }}{% endif %}
                {{ section.settings.media_color_scheme }}">
                <div class="flex items-center">
                  {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'w-full h-full' }}
                </div>
              </div>
            </div>
            
          {% when 'model' %}
            <div class="relative snap-center flex-none border--width border--radius overflow-hidden
              {{ section.settings.image_border }}
              w-full" 
              x-intersect:enter.half="gallery_index = {{ forloop.index0 }};"
              x-bind:data-slide="{{ forloop.index0 }}" data-media-id="{{ media.id }}">
              <div class="absolute z-10 bottom-2 left-2">
                {% capture badge_content %}
                  {% render 'component__icon', icon: 'box', size: '16' %}
                {% endcapture %}
                {% render 'component__badge', 
                  background: 'body',
                  text: 'text',
                  icon: '',
                  content: badge_content %}
              </div>
              <div class="absolute left-auto right-auto z-10 w-full bottom-2">
                <button class="btn btn--small btn--secondary"
                  data-shopify-xr
                  data-shopify-model3d-id="{{ media.id }}"
                  data-shopify-title="{{ product.title | escape }}"
                  data-shopify-xr-hidden>
                  {{ 'general.media.view_in_space' | t }}
                </button>
              </div>
              <div class="overflow-hidden object-contain h-full
                {{ section.settings.media_ratio }}
                {{ section.settings.media_color_scheme }}">
                <div class="flex items-center h-full">
                  {{ media | model_viewer_tag: class: 'w-full h-full' }}
                </div>
              </div>
            </div>

        {% endcase %}
      {% endfor %}
      
    </div>

    {%- comment -%} Indicators {%- endcomment -%}
    {% if product.media.size > 1 and product.media.size <= 12 and section.settings.enable_variant_images == false %}
      <div class="pdp-gallery-dots absolute bottom-4 left-0 right-0 flex flex-wrap items-center justify-center gap-2 px-4 text-center">
        {% capture media_group %}{% endcapture %}
        {% for media in product.media %}
          {% for variant in product.variants %}
            {% if media.src == variant.featured_image %}
              {% capture media_group %}
                {{ variant.featured_image.id }}
              {% endcapture %}
            {% endif %}
          {% endfor %}
          <button
            aria-label="gallery_grid_button_{{ forloop.index0 }}"
            class="pdp-gallery-dot w-2 h-2 opacity-25 color__bg-text animation-100 rounded-full"
            :class="{ 'pdp-gallery-dot--active !opacity-100': gallery_index === {{ forloop.index0 }} }"
            @click="gallery_index_scroll = {{ forloop.index0 }}; scrollToIndex(gallery_index_scroll);"
            {% if media.media_type == 'image' and section.settings.enable_variant_images %}x-show="current_variant_featured_image_id == {{ media_group }}"{% endif %}>
          </button>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</div>

{%- assign first_3d_model = product.media | where: "media_type", "model" | first -%}
{% if first_3d_model %}
  <script type="application/json" id="ProductJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
  <script>
    function setupShopifyXr(){
      if (!window.ShopifyXR) {
        document.addEventListener('shopify_xr_initialized', function() {
          setupShopifyXr();
        });
      }else{
        document.querySelectorAll('[id^="ProductJSON-"]').forEach((modelJSON) => {
          window.ShopifyXR.addModels(JSON.parse(modelJSON.textContent));
          window.ShopifyXR.setupXRElements();
          modelJSON.remove();
        });
      }
    }

    window.Shopify.loadFeatures([{
      name: 'shopify-xr',
      version: '1.0',
      onLoad: setupShopifyXr
    }]);
  </script>
{% endif %}
