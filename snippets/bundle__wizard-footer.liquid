{% comment %}
  Sticky-bottom footer for the wizard slot steps (NOT the review screen).

  Factory state used:
    - currentStep (number)
    - slots[].length
    - stepComplete(idx)
    - subtotalCents(), formatMoney()
    - advanceFromCurrent()
{% endcomment %}

<div class="bundle-wizard__footer">
  <p
    class="bundle-wizard__footer-price"
    x-text="formatMoney(subtotalCents())"
    aria-label="Running subtotal"></p>

  <button
    type="button"
    class="btn btn--primary"
    :disabled="!stepComplete(currentStep)"
    @click="advanceFromCurrent()">
    <span x-show="currentStep < slots.length - 1">Add to bundle</span>
    <span x-show="currentStep === slots.length - 1">Review bundle</span>
  </button>
</div>
