{% comment %}
  One wizard step for the Market Tote bundler — product grid only (no
  silhouette toggles). Same tote can be selected in multiple slots.

  Inputs:
    - slot_index: 0-based index into factory.slots[]

  Factory state used:
    - slots[slot_index].products / selectedHandle / locked
    - selectColor(slotIdx, handle)
    - visibleProducts(slotIdx), hasMore(slotIdx), showMore(slotIdx)
    - formatMoney(cents)
{% endcomment %}

{% doc %}
  Renders one Market Tote bundler step (product picker for a single slot).
  @param {number} slot_index - 0-based slot index
  @example
  {% render 'market-tote-bundler__step', slot_index: 0 %}
{% enddoc %}

<h3 class="bundle-wizard__step-title">
  Step {{ slot_index | plus: 1 }}: <span x-text="slots[{{ slot_index }}].label"></span>
</h3>

<div class="bundle-wizard__grid" role="radiogroup" aria-label="Market Tote">
  <template x-for="product in visibleProducts({{ slot_index }})" :key="product.handle + '-' + {{ slot_index }}">
    <button
      type="button"
      role="radio"
      :aria-checked="slots[{{ slot_index }}].selectedHandle === product.handle"
      :aria-label="product.title"
      :disabled="!product.available || slots[{{ slot_index }}].locked"
      class="bundle-wizard__tile"
      :class="{
        'is-selected': slots[{{ slot_index }}].selectedHandle === product.handle,
        'is-unavailable': !product.available,
        'is-locked': slots[{{ slot_index }}].locked
      }"
      @click="product.available && selectColor({{ slot_index }}, product.handle)">
      <div class="bundle-wizard__tile-img">
        <img
          :src="product.swatchImage"
          :srcset="(product.swatchImage400 || '') + ' 400w, ' + (product.swatchImage600 || '') + ' 600w, ' + (product.swatchImage900 || '') + ' 900w'"
          sizes="(min-width: 750px) 25vw, 33vw"
          width="400"
          height="400"
          :alt="product.title"
          loading="lazy" />
        <span
          class="bundle-wizard__tile-check"
          x-show="slots[{{ slot_index }}].selectedHandle === product.handle"
          aria-hidden="true">✓</span>
      </div>
      <p class="bundle-wizard__tile-title" x-text="product.title"></p>
      <p class="bundle-wizard__tile-price" x-text="formatMoney(product.price)"></p>
    </button>
  </template>
</div>

<p
  class="type--small italic text-center"
  style="padding: 24px 16px;"
  x-show="(slots[{{ slot_index }}]?.products || []).length === 0"
  x-cloak>
  No Market Totes available.
</p>

<div class="bundle-wizard__load-more" x-show="hasMore({{ slot_index }})" x-cloak>
  <button
    type="button"
    class="btn btn--secondary"
    @click="showMore({{ slot_index }})">
    Show more
  </button>
</div>
