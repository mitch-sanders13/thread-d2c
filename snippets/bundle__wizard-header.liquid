{% comment %}
  Wizard header: persistent savings strip + step-progress dots + Back button.
  Mounted once per bundle-builder section. Reads factory state:
    - currentStep (number)
    - reviewMode (bool)
    - slots[] with .label
    - stepComplete(idx), goToStep(idx), goBack(), visitedSteps[]

  Liquid inputs (optional):
    - savings_label (string) — text shown in the savings strip
{% endcomment %}

{%- assign _savings = savings_label | default: 'Save 10% when you build your Trifecta' -%}

<div class="bundle-wizard__savings-strip">{{ _savings }}</div>

<div class="bundle-wizard__header">
  <button
    type="button"
    class="bundle-wizard__back"
    :disabled="currentStep === 0 && !reviewMode"
    @click="reviewMode ? (reviewMode = false) : goBack()">
    {{ 'general.navigation.back' | t | default: 'Back' }}
  </button>

  <ol class="bundle-wizard__progress" aria-label="Bundle progress">
    <template x-for="(slot, i) in slots" :key="i">
      <li
        class="bundle-wizard__step-dot"
        :class="{
          'is-current': !reviewMode && currentStep === i,
          'is-complete': stepComplete(i)
        }"
        :aria-current="!reviewMode && currentStep === i ? 'step' : null"
        :title="slot.label"
        @click="(stepComplete(i) || visitedSteps[i]) && goToStep(i)">
        <span class="bundle-wizard__step-num" x-text="i + 1"></span>
        <svg class="bundle-wizard__step-check" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M9.55 17.6 4 12.05l1.4-1.4 4.15 4.15 9.05-9.05 1.4 1.4z"/>
        </svg>
      </li>
    </template>
  </ol>

  {%- comment -%} right column is intentionally empty for visual balance with .back {%- endcomment -%}
  <span aria-hidden="true"></span>
</div>
