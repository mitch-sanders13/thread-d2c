<!-- snippets/product__countdown.liquid -->
{% comment %} 
  Block to display a countdown timer with text.

  Accepts:
    - blocksettings: liquid object of block settings
  
  Usage:
    {% render 'product__countdown', 
      blocksettings: block.settings
    %}
{% endcomment %}

{%- if settings.show_pdp_promos == true and blocksettings.countdown_date != blank -%}
    <div
    class="pdp-block pdp-block--countdown pdp-countdown px-4
        {{ section.settings.color_border }}
        {{ blocksettings.color_scheme }}
        {{ blocksettings.style_border }}
    "
    data-pdp-block
    style="
        padding-top:{{ blocksettings.spacing_top }}px;
        padding-bottom:{{ blocksettings.spacing_bottom }}px;
    "
    x-data="{
        expired: false,
        timer: (expiry) => {
        return {
            expiry: expiry,
            remaining:null,
            init() {
            this.setRemaining()
            setInterval(() => {
                this.setRemaining();
            }, 1000);
            },
            setRemaining() {
            const diff = this.expiry - new Date().getTime();
            this.remaining =  parseInt(diff / 1000);
            if (this.remaining < 0) {
                this.expired = true;
            }
            },
            days() {
            return {
                value:this.remaining / 86400,
                remaining:this.remaining % 86400
            };
            },
            hours() {
            return {
                value:this.days().remaining / 3600,
                remaining:this.days().remaining % 3600
            };
            },
            minutes() {
            return {
                value:this.hours().remaining / 60,
                remaining:this.hours().remaining % 60
            };
            },
            seconds() {
            return {
                value:this.minutes().remaining,
            };
            },
            format(value) {
            return (parseInt(value));
            },
            time(){
            return {
                days:this.format(this.days().value),
                hours:this.format(this.hours().value),
                minutes:this.format(this.minutes().value),
                seconds:this.format(this.seconds().value),
            }
            },
        }
        }
    }">  
        <div 
            class="m-0--clear block text-center"
            x-init="init();"
            x-data="timer(new Date('{{ blocksettings.countdown_date }}').getTime());">
        
            {% unless blocksettings.countdown_date == blank %}
            {% assign suffix_classes = "" %}
            {% if blocksettings.counter_suffix_bold %}
                {% assign suffix_classes = "font-bold" %}
            {% endif %}    
            
            {% capture suffix_classes %}
                {{ suffix_classes }} {{ blocksettings.counter_suffix_size }}
            {% endcapture %}
            
                
            <span class="type__nav">
                <span class="type__nav type--big text-center" x-text="time().days"></span
                ><span class="{{ suffix_classes }}">D</span
                >:<span class="type__nav type--big" x-text="time().hours"></span
                ><span class="{{ suffix_classes }}">H</span
                >:<span class="type__nav type--big" x-text="time().minutes"></span
                ><span class="{{ suffix_classes }}">M</span
                >:<span class="type__nav type--big" x-text="time().seconds"></span
                ><span class="{{ suffix_classes }}">S</span>
            </span>
            {% endunless %}
        
            {% unless blocksettings.content == blank %}
            <div class="text-center">
            {{ blocksettings.content }}
            </div>
            {% endunless %}
            
        </div>
    </div>
{%- endif -%}