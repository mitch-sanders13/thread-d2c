{% comment %}
  PDP entry for the Everyday Carry Set bundler.

  Shows a secondary CTA on Wallet / Lanyard / Chapstick Holder PDPs
  (matched by product.type). Links to the standalone bundler page with
  this product pre-selected (not locked) via ?slot_<key>=<handle>.
{% endcomment %}

{% doc %}
  Everyday Carry Set PDP CTA — navigates to the bundler page.
  @example
  {% render 'bundle__pdp-cta' %}
{% enddoc %}

{%- liquid
  assign wallet_types = "Elastic Wallet|Vertical Leather Wallet|Leather Zip Wallet" | split: "|"
  assign lanyard_types = "Keychain Clip|Mystery Lanyard|Neck Lanyard|Wide Wrist Lanyard|Wristlet Keychain" | split: "|"
  assign chapstick_types = "Chapstick Holder Keychain|Mystery Chapstick Holder Keychain" | split: "|"

  assign trifecta_slot = blank
  if wallet_types contains product.type
    assign trifecta_slot = "Wallet"
  elsif lanyard_types contains product.type
    assign trifecta_slot = "Lanyard"
  elsif chapstick_types contains product.type
    assign trifecta_slot = "Chapstick"
  endif

  assign cta_text = settings.trifecta_pdp_cta_text | default: 'Build an Everyday Carry Set — Save 10%'
  assign page_path = settings.trifecta_page_path | default: '/pages/build-your-trifecta'
  assign pdp_enable = settings.trifecta_pdp_preview_enable

  assign bundler_url = page_path
  if trifecta_slot != blank
    assign slot_key = trifecta_slot | downcase
    assign bundler_url = page_path | append: '?slot_' | append: slot_key | append: '=' | append: product.handle
  endif
-%}

{%- if pdp_enable and trifecta_slot != blank -%}
  <div class="trifecta-pdp-cta px-4 py-4">
    <a
      href="{{ bundler_url }}"
      class="btn btn--secondary w-full trifecta-pdp-cta__btn">
      {{ cta_text }}
    </a>
  </div>
{%- endif -%}
