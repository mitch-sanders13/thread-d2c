{% comment %}
  PDP entry for the Trifecta bundler — Market Tote pattern.

  Shows a secondary CTA on Wallet / Lanyard / Chapstick Holder PDPs
  (matched by product.type). Opens the full picker in a drawer with
  this product locked into its slot.
{% endcomment %}

{% doc %}
  Trifecta PDP CTA + drawer host.
  @example
  {% render 'bundle__pdp-cta' %}
{% enddoc %}

{%- liquid
  assign wallet_types = "Adventure Pouch Wallet|Elastic Wallet|Envelope Wallet|Leather Bifold Wallet|Leather Zip Wallet|Magnetic Wallet|Mystery Wallet|Phone Case Wallet|Stick On Wallet|Vegan Leather Bifold Wallet|Velcro Bifold Wallet|Vertical Leather Wallet|Wallet" | split: "|"
  assign lanyard_types = "Keychain Clip|Mystery Lanyard|Neck Lanyard|Wide Wrist Lanyard|Wristlet Keychain" | split: "|"
  assign chapstick_types = "Chapstick Holder Keychain|Mystery Chapstick Holder Keychain" | split: "|"

  assign trifecta_slot = blank
  if wallet_types contains product.type
    assign trifecta_slot = "Wallet"
  elsif lanyard_types contains product.type
    assign trifecta_slot = "Lanyard"
  elsif chapstick_types contains product.type
    assign trifecta_slot = "Chapstick"
  endif

  assign drawer_id = 'bundle-drawer-pdp-' | append: product.id
  assign cta_text = settings.trifecta_pdp_cta_text | default: 'Build a Trifecta — Save 10%'
  assign page_path = settings.trifecta_page_path | default: '/pages/build-your-trifecta'
  assign pdp_enable = settings.trifecta_pdp_preview_enable
-%}

{%- if pdp_enable and trifecta_slot != blank -%}
  {%- comment -%}
    Put ids on data-* attrs — do NOT use | json inside @click="...".
    | json emits double quotes and terminates the HTML attribute early.
  {%- endcomment -%}
  <div class="trifecta-pdp-cta px-4 py-4">
    <button
      type="button"
      class="btn btn--secondary w-full trifecta-pdp-cta__btn"
      data-drawer-id="{{ drawer_id | escape }}"
      data-slot-label="{{ trifecta_slot | escape }}"
      data-product-handle="{{ product.handle | escape }}"
      @click="
        window.dispatchEvent(new CustomEvent('bundle-drawer:open', {
          detail: {
            drawerId: $el.dataset.drawerId,
            mode: 'lock',
            payload: {
              slotLabel: $el.dataset.slotLabel,
              productHandle: $el.dataset.productHandle
            }
          }
        }));
      ">
      {{ cta_text }}
    </button>
  </div>

  {% render 'bundle__drawer',
      drawer_id: drawer_id,
      bundle_page_path: page_path,
      bundle_section_id: 'bundle_builder',
      title: settings.trifecta_drawer_title,
      preload: true %}
{%- endif -%}
