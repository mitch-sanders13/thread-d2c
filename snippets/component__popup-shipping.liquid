<!-- snippets/component__popup-shipping.liquid -->
{% comment %} 
  Updated popup overlay for Shipping Protection.

  Accepts:
    - popup_id: unique Id for the popup
    - content: liquid object for content (not used in this hardcoded example)
  
  Usage:
    {% render 'component__popup-shipping', popup_id: 'popup' %}
  
  Enhancements:
    - Responsive grid layout for desktop and mobile.
{% endcomment %}

<section 
  role="dialog" 
  aria-modal="true"
  class="fixed inset-0 z-50 overflow-hidden"
  @keyup.escape.window="{{ popup_id }} = false;"
  x-show="{{ popup_id }}"
  x-cloak>
  <div class="flex items-end justify-center min-h-screen px-4 pt-4 text-center">
    
    <div aria-hidden="true"
      class="fixed inset-0 transition-opacity bg-black bg-opacity-50" 
      @click="{{ popup_id }} = false;"
      x-show="{{ popup_id }}"
      {% if settings.enable_animations %}
        x-transition:enter="animation-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="animation-300"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
      {% endif %}
      x-cloak>
    </div>
    
    <div class="absolute left-0 right-0 inline-block m-auto text-left align-bottom transition-all transform -translate-y-1/2 top-1/2 md:max-w-4xl md:absolute"
      x-show="{{ popup_id }}"
      x-trap="{{ popup_id }}"
      {% if settings.enable_animations %}
        x-transition:enter="animation-300"
        x-transition:enter-start="opacity-0 translate-y-8"
        x-transition:enter-end="opacity-100"
        x-transition:leave="animation-300"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0 translate-y-8"
      {% endif %}
      x-cloak>
      
      <!-- snippets/component__popup.liquid -->
      <div class="color__bg-body border--radius overflow-hidden shadow-lg max-h-[80svh] md:max-h-auto p-4 md:p-8 overflow-y-auto">
        <div class="text-right">
          <button class="btn btn--smaller btn--plain" 
            type="button"
            title="{{ 'general.navigation.close' | t }}"
            @click="{{ popup_id }} = false;">
            {% render 'component__icon', icon: 'x', size: '24', class: '' %}
          </button>
        </div>
        <h1 class="mb-1 text-center type__heading type__heading--bold-0">Free Returns + Shipping Protection</h1>
        <h2 class="mb-4 text-center type--bigger">Easily secure your shipment with the click of a button.</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-8">
          <div class="flex flex-col items-center text-center text-wrap">
            {% assign hand_select = images['hand_select.png'] %}
            {{ hand_select | image_url: width: 64, height: 64 | image_tag: loading: 'lazy' }}
            <p class="mb-0 italic md:type--big">Select & Purchase Returns + Shipping Protection During Checkout</p>
          </div>
          <div class="flex flex-col items-center text-center text-wrap">
            {% assign black_blue_shipping = images['black_blue_shipping.png'] %}
            {{ black_blue_shipping | image_url: width: 64, height: 64 | image_tag: loading: 'lazy' }}
            <p class="mb-0 italic md:type--big">Get Instant Protection for Free Returns and Damaged, Lost or Stolen Packages</p>
          </div>
          <div class="flex flex-col items-center text-center text-wrap">
            {% assign file = images['file.png'] %}
            {{ file | image_url: width: 64, height: 64 | image_tag: loading: 'lazy' }}
            <p class="mb-0 italic md:type--big">Easily Make a Return or File a Claim if Anything Happens to Your Order</p>
          </div>
        </div>
      </div>
      
    </div>
    
  </div>
</section>