{% comment %}
  PDP "Frequently Bought Together" — inline Everyday Carry Set preview.

  Shown under the Bundle CTA on eligible PDPs (see bundle__pdp-cta).
  Keeps the Amazon-style 3-card picker so shoppers can add a full set
  without leaving the product page, while the CTA above still links to
  the full bundler for more browsing.

  Per-product dropdown UX:
    - Three product cards: current locked product + two companions.
    - Tap an unlocked card → dropdown with type tabs + swatch grid.
      Tap a swatch to preview it on the card; an Add/Swap button
      appears under that swatch image (same pattern as the Everyday
      Carry bundler). Swap commits and closes; ✕ / Close / Escape
      discard an unconfirmed preview.
    - Locked card has no dropdown (already on that PDP).

  Server-side ranking (per non-locked slot):
    1. Default-type + color-match + available
    2. Color-match + available
    3. Default-type + solids color share + available
    4. Solids color share + available
    5. Default-type + available
    6. Available
    7. Sold-out
    Defaults: trifecta_default_wallet_type / lanyard / chapstick

  Slot type lists must stay in sync with bundle__pdp-cta.liquid and
  product__stickyadd.liquid (Elastic / Vertical / Zip wallets only).
{% endcomment %}

{% doc %}
  Everyday Carry Set FBT widget — restores the inline preview under the PDP Bundle button.
  @example
  {% render 'bundle__pdp-fbt' %}
{% enddoc %}

{%- liquid
  comment
    Eligibility matches the Bundle CTA: product.type for Elastic /
    Vertical Leather / Leather Zip wallets, plus lanyard and chapstick
    holder types. bundle_slot is titlecase for the rest of this file.
  endcomment
  assign wallet_types = "Elastic Wallet|Vertical Leather Wallet|Leather Zip Wallet" | split: "|"
  assign lanyard_types = "Keychain Clip|Mystery Lanyard|Neck Lanyard|Wide Wrist Lanyard|Wristlet Keychain" | split: "|"
  assign chapstick_types = "Chapstick Holder Keychain|Mystery Chapstick Holder Keychain" | split: "|"

  assign trifecta_slot = blank
  if wallet_types contains product.type
    assign trifecta_slot = "wallet"
  elsif lanyard_types contains product.type
    assign trifecta_slot = "lanyard"
  elsif chapstick_types contains product.type
    assign trifecta_slot = "chapstick"
  endif

  assign bundle_slot = ''
  if trifecta_slot == 'wallet'
    assign bundle_slot = 'Wallet'
  elsif trifecta_slot == 'lanyard'
    assign bundle_slot = 'Lanyard'
  elsif trifecta_slot == 'chapstick'
    assign bundle_slot = 'Chapstick'
  endif

  comment
    Color-tag capture (unchanged from before): the bundle widget
    color-matches the current product to siblings by walking the
    color_* tags. Independent of slot detection, so it stays.
  endcomment
  assign current_color_tag = ''
  assign current_color_tags = ''
  for tag in product.tags
    assign tag_lc = tag | downcase | strip
    if tag_lc contains 'color_'
      assign _c = tag_lc | remove_first: 'color_'
      if current_color_tag == blank
        assign current_color_tag = _c
      endif
      assign current_color_tags = current_color_tags | append: ',' | append: _c
    endif
  endfor
  if current_color_tags != blank
    assign current_color_tags = current_color_tags | append: ','
  endif

  assign _show = false
  if settings.trifecta_pdp_preview_enable and trifecta_slot != blank
    if settings.trifecta_wallet_collection != blank and settings.trifecta_lanyard_collection != blank and settings.trifecta_chapstick_collection != blank
      assign _show = true
    endif
  endif
-%}

{%- if _show -%}

{%- liquid
  assign _wallet_coll = settings.trifecta_wallet_collection
  assign _lanyard_coll = settings.trifecta_lanyard_collection
  assign _chapstick_coll = settings.trifecta_chapstick_collection
  assign _default_wallet_type = settings.trifecta_default_wallet_type | strip
  assign _default_lanyard_type = settings.trifecta_default_lanyard_type | strip
  assign _default_chapstick_type = settings.trifecta_default_chapstick_type | strip
  assign PRODUCTS_PER_SLOT = 200
-%}

{%- comment -%}
  Per-slot product list builder. For the locked slot, just emit the
  current product. For the iterated slots, walk the eligibility
  collection (up to 80 products) and bucket each entry into one of
  five priority lists, then concat in order.
{%- endcomment -%}

{%- capture _slot_json_wallet -%}
{%- assign _bucket0 = '' -%}
{%- assign _bucket1 = '' -%}{%- assign _bucket2 = '' -%}{%- assign _bucket3 = '' -%}
{%- assign _bucket4 = '' -%}{%- assign _bucket5 = '' -%}{%- assign _bucket6 = '' -%}
{%- assign _bucket7 = '' -%}

{%- if bundle_slot == 'Wallet' -%}
  {%- assign _v = product.selected_or_first_available_variant -%}
  {%- capture _current_entry -%}{
    "handle": {{ product.handle | json }},
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "image": {{ product.featured_image | image_url: width: 240 | json }},
    "imageLarge": {{ product.featured_image | image_url: width: 480 | json }},
    "variantId": {{ _v.id | json }},
    "price": {{ _v.price | default: 0 | json }},
    "available": {{ _v.available | json }},
    "colorTag": {{ current_color_tag | json }},
    "type": {{ product.type | json }}
  }{%- endcapture -%}
  {%- assign _bucket0 = _current_entry | append: ',' -%}
{%- endif -%}

{%- for p in _wallet_coll.products limit: 200 -%}
  {%- if bundle_slot == 'Wallet' and p.handle == product.handle -%}{%- continue -%}{%- endif -%}
  {%- if p.type == 'Bundle' -%}{%- continue -%}{%- endif -%}
  {%- comment -%}Only Elastic / Vertical / Zip — same set as the bundler CTA.{%- endcomment -%}
  {%- unless wallet_types contains p.type -%}{%- continue -%}{%- endunless -%}
  {%- assign _v = p.selected_or_first_available_variant -%}
  {%- assign _p_color = '' -%}
  {%- for tag in p.tags -%}
    {%- assign _tlc = tag | downcase | strip -%}
    {%- if _tlc contains 'color_' -%}
      {%- assign _p_color = _tlc | remove_first: 'color_' -%}{%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign _is_type_match = false -%}
  {%- if _default_wallet_type != blank and p.type == _default_wallet_type -%}
    {%- assign _is_type_match = true -%}
  {%- endif -%}
  {%- assign _is_color_match = false -%}
  {%- if current_color_tag != blank and _p_color == current_color_tag -%}
    {%- assign _is_color_match = true -%}
  {%- endif -%}
  {%- comment -%}
    Solids fallback: candidate is tagged `solids` AND shares at least
    one color_* tag with the current product. Lets a Blossom wallet
    (multi-color pattern) default to a solid pink/green lanyard when
    no exact-pattern lanyard exists.
  {%- endcomment -%}
  {%- assign _is_solid = false -%}
  {%- assign _shares_color = false -%}
  {%- for tag in p.tags -%}
    {%- assign _tlc = tag | downcase | strip -%}
    {%- if _tlc == 'solids' -%}
      {%- assign _is_solid = true -%}
    {%- endif -%}
    {%- if _tlc contains 'color_' -%}
      {%- assign _c = _tlc | remove_first: 'color_' -%}
      {%- assign _needle = ',' | append: _c | append: ',' -%}
      {%- if current_color_tags contains _needle -%}
        {%- assign _shares_color = true -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign _is_solid_match = false -%}
  {%- if _is_solid and _shares_color -%}
    {%- assign _is_solid_match = true -%}
  {%- endif -%}
  {%- capture _entry -%}{
    "handle": {{ p.handle | json }},
    "title": {{ p.title | json }},
    "url": {{ p.url | json }},
    "image": {{ p.featured_image | image_url: width: 240 | json }},
    "imageLarge": {{ p.featured_image | image_url: width: 480 | json }},
    "variantId": {{ _v.id | default: 0 | json }},
    "price": {{ _v.price | default: 0 | json }},
    "available": {{ _v.available | default: false | json }},
    "colorTag": {{ _p_color | json }},
    "type": {{ p.type | json }}
  }{%- endcapture -%}
  {%- if _v.available and _is_type_match and _is_color_match -%}
    {%- assign _bucket1 = _bucket1 | append: _entry | append: ',' -%}
  {%- elsif _v.available and _is_color_match -%}
    {%- assign _bucket2 = _bucket2 | append: _entry | append: ',' -%}
  {%- elsif _v.available and _is_type_match and _is_solid_match -%}
    {%- assign _bucket3 = _bucket3 | append: _entry | append: ',' -%}
  {%- elsif _v.available and _is_solid_match -%}
    {%- assign _bucket4 = _bucket4 | append: _entry | append: ',' -%}
  {%- elsif _v.available and _is_type_match -%}
    {%- assign _bucket5 = _bucket5 | append: _entry | append: ',' -%}
  {%- elsif _v.available -%}
    {%- assign _bucket6 = _bucket6 | append: _entry | append: ',' -%}
  {%- else -%}
    {%- assign _bucket7 = _bucket7 | append: _entry | append: ',' -%}
  {%- endif -%}
{%- endfor -%}
{%- assign _combined = _bucket0 | append: _bucket1 | append: _bucket2 | append: _bucket3 | append: _bucket4 | append: _bucket5 | append: _bucket6 | append: _bucket7 -%}
[{{ _combined | remove_last: ',' }}]
{%- endcapture -%}

