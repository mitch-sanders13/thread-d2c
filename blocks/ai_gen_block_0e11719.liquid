{% doc %}
  @prompt
    Create a clean, modern pricing section for an event venue page called 241 Event Space. Match the existing style of the Thread website. Keep it minimal, polished, easy to scan, and mobile-friendly.
    
    Use a simple card-based layout with strong spacing and clear hierarchy.
    
    Section title:
    Pricing & Booking Options
    
    Intro text:
    Simple, flexible pricing for community gatherings, celebrations, workshops, meetings, and more.
    
    Create 4 pricing cards:
    
    1. Community & Creative Events
    Starting at $50/hr
    Ideal for workshops, clubs, nonprofits, networking events, and small gatherings.
    Discounts available for recurring bookings.
    
    2. Private Celebrations
    Monday - Thursday packages starting at $800
    Friday - Sunday packages starting at $1200
    Perfect for weddings, receptions, graduation parties, and formal events.
    
    3. Conference Room A
    $25/hr
    Includes 7 chairs and 1 large TV
    
    4. Conference Room B
    $30/hr
    Includes 10 chairs and 1 large TV
    
    At the bottom, add a small callout:
    Need a custom quote? Contact us or book a tour.
    
    Do not include long paragraphs. Keep it very clean and easy to digest.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pricing-section-{{ ai_gen_id }} {
    width: 100%;
    padding: 60px 60px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-pricing-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-pricing-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-pricing-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  .ai-pricing-intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-pricing-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: 50px;
  }

  .ai-pricing-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    padding: 32px 24px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-pricing-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .ai-pricing-card-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px 0;
    font-weight: 600;
    letter-spacing: 0.3px;
  }

  .ai-pricing-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin: 0 0 16px 0;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-pricing-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-pricing-callout-{{ ai_gen_id }} {
    text-align: left;
    padding: 0px;
   
  }

  .ai-pricing-callout-text-{{ ai_gen_id }} {
    font-size: 12px;
    color: #212121;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-pricing-section-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-pricing-header-{{ ai_gen_id }} {
      margin-bottom: 32px;
    }

    .ai-pricing-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-pricing-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 32px;
    }

    .ai-pricing-card-{{ ai_gen_id }} {
      padding: 24px 20px;
    }
  }
{% endstyle %}

<div class="ai-pricing-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pricing-container-{{ ai_gen_id }}">
    <div class="ai-pricing-header-{{ ai_gen_id }}">
      {% if block.settings.section_title != blank %}
        <h2 class="ai-pricing-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      {% endif %}
      {% if block.settings.intro_text != blank %}
        <p class="ai-pricing-intro-{{ ai_gen_id }}">{{ block.settings.intro_text }}</p>
      {% endif %}
    </div>

    <div class="ai-pricing-grid-{{ ai_gen_id }}">
      {% if block.settings.card_1_enabled %}
        <div class="ai-pricing-card-{{ ai_gen_id }}">
          {% if block.settings.card_1_name != blank %}
            <h3 class="ai-pricing-card-name-{{ ai_gen_id }}">{{ block.settings.card_1_name }}</h3>
          {% endif %}
          {% if block.settings.card_1_price != blank %}
            <div class="ai-pricing-card-price-{{ ai_gen_id }}">{{ block.settings.card_1_price }}</div>
          {% endif %}
          {% if block.settings.card_1_description != blank %}
            <p class="ai-pricing-card-description-{{ ai_gen_id }}">{{ block.settings.card_1_description }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_2_enabled %}
        <div class="ai-pricing-card-{{ ai_gen_id }}">
          {% if block.settings.card_2_name != blank %}
            <h3 class="ai-pricing-card-name-{{ ai_gen_id }}">{{ block.settings.card_2_name }}</h3>
          {% endif %}
          {% if block.settings.card_2_price != blank %}
            <div class="ai-pricing-card-price-{{ ai_gen_id }}">{{ block.settings.card_2_price }}</div>
          {% endif %}
          {% if block.settings.card_2_description != blank %}
            <p class="ai-pricing-card-description-{{ ai_gen_id }}">{{ block.settings.card_2_description }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_3_enabled %}
        <div class="ai-pricing-card-{{ ai_gen_id }}">
          {% if block.settings.card_3_name != blank %}
            <h3 class="ai-pricing-card-name-{{ ai_gen_id }}">{{ block.settings.card_3_name }}</h3>
          {% endif %}
          {% if block.settings.card_3_price != blank %}
            <div class="ai-pricing-card-price-{{ ai_gen_id }}">{{ block.settings.card_3_price }}</div>
          {% endif %}
          {% if block.settings.card_3_description != blank %}
            <p class="ai-pricing-card-description-{{ ai_gen_id }}">{{ block.settings.card_3_description }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_4_enabled %}
        <div class="ai-pricing-card-{{ ai_gen_id }}">
          {% if block.settings.card_4_name != blank %}
            <h3 class="ai-pricing-card-name-{{ ai_gen_id }}">{{ block.settings.card_4_name }}</h3>
          {% endif %}
          {% if block.settings.card_4_price != blank %}
            <div class="ai-pricing-card-price-{{ ai_gen_id }}">{{ block.settings.card_4_price }}</div>
          {% endif %}
          {% if block.settings.card_4_description != blank %}
            <p class="ai-pricing-card-description-{{ ai_gen_id }}">{{ block.settings.card_4_description }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if block.settings.callout_text != blank %}
      <div class="ai-pricing-callout-{{ ai_gen_id }}">
        <p class="ai-pricing-callout-text-{{ ai_gen_id }}">{{ block.settings.callout_text }}</p>
      </div>
    {% endif %}
  </div>
</div>

