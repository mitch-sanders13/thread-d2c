{% comment %}
  blocks/accordion_text.liquid

  A text block for an accordion row: three independent, optional text
  fields stacked top to bottom —

    1. Header      — plain text
    2. Sub-heading — plain text
    3. Body        — rich text

  Each of the three is fully and separately customizable (font,
  desktop/mobile size, weight, case, letter-spacing, line-height,
  color, and four-way padding) and each can be connected to a product
  metafield via the editor's dynamic-source picker.

  Renders nothing on the live storefront when all three resolve empty
  (e.g. bound to metafields a product hasn't set); the editor still
  shows a placeholder so the block stays selectable.

  Structural CSS lives in sections/product-details-accordion.liquid.
{% endcomment %}

{%- liquid
  assign bs = block.settings
  assign col = bs.column | default: 'left'
  assign head_clean = bs.heading | strip
  assign sub_clean = bs.subheading | strip
  assign body_clean = bs.body | strip_html | strip
  assign has_content = false
  if head_clean != blank or sub_clean != blank or body_clean != blank
    assign has_content = true
  endif
-%}

{%- if has_content or request.design_mode -%}
  <div
    id="pdp-acc-text-{{ block.id }}"
    class="pdp-acc__text pdp-acc__col--{{ col }}"
    {{ block.shopify_attributes }}>
    {%- if bs.heading != blank -%}
      <p class="pdp-acc__heading">{{ bs.heading }}</p>
    {%- endif -%}
    {%- if bs.subheading != blank -%}
      <p class="pdp-acc__subheading">{{ bs.subheading }}</p>
    {%- endif -%}
    {%- if bs.body != blank -%}
      <div class="pdp-acc__body rte">{{ bs.body }}</div>
    {%- endif -%}
    {%- unless has_content -%}
      <p class="pdp-acc__subheading">Text block — add a header, sub-heading or body</p>
    {%- endunless -%}
  </div>

  {% style %}
    /* ---- header ---- */
    #pdp-acc-text-{{ block.id }} .pdp-acc__heading {
      {%- case bs.hd_font -%}
        {%- when 'body' -%}font-family: var(--type-font-body-family);
        {%- when 'heading' -%}font-family: var(--type-font-header-family);
        {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
      {%- endcase -%}
      {%- if bs.hd_size_d > 0 %} font-size: {{ bs.hd_size_d }}px;{% endif -%}
      {%- if bs.hd_weight != blank %} font-weight: {{ bs.hd_weight }};{% endif -%}
      {%- if bs.hd_case != blank %} text-transform: {{ bs.hd_case }};{% endif -%}
      {%- if bs.hd_ls > 0 %} letter-spacing: {{ bs.hd_ls | divided_by: 100.0 }}em;{% endif -%}
      {%- if bs.hd_lh > 0 %} line-height: {{ bs.hd_lh }};{% endif -%}
      {%- if bs.hd_color != blank %} color: {{ bs.hd_color }};{% endif -%}
      padding: {{ bs.hd_pad_top }}px {{ bs.hd_pad_right }}px {{ bs.hd_pad_bottom }}px {{ bs.hd_pad_left }}px;
    }
    /* ---- sub-heading ---- */
    #pdp-acc-text-{{ block.id }} .pdp-acc__subheading {
      {%- case bs.sh_font -%}
        {%- when 'body' -%}font-family: var(--type-font-body-family);
        {%- when 'heading' -%}font-family: var(--type-font-header-family);
        {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family);
      {%- endcase -%}
      {%- if bs.sh_size_d > 0 %} font-size: {{ bs.sh_size_d }}px;{% endif -%}
      {%- if bs.sh_weight != blank %} font-weight: {{ bs.sh_weight }};{% endif -%}
      {%- if bs.sh_case != blank %} text-transform: {{ bs.sh_case }};{% endif -%}
      {%- if bs.sh_ls > 0 %} letter-spacing: {{ bs.sh_ls | divided_by: 100.0 }}em;{% endif -%}
      {%- if bs.sh_lh > 0 %} line-height: {{ bs.sh_lh }};{% endif -%}
      {%- if bs.sh_color != blank %} color: {{ bs.sh_color }};{% endif -%}
      padding: {{ bs.sh_pad_top }}px {{ bs.sh_pad_right }}px {{ bs.sh_pad_bottom }}px {{ bs.sh_pad_left }}px;
    }
    /* ---- body (rich text) ---- */
    #pdp-acc-text-{{ block.id }} .pdp-acc__body {
      {%- if bs.bd_color != blank %} color: {{ bs.bd_color }};{% endif -%}
      padding: {{ bs.bd_pad_top }}px {{ bs.bd_pad_right }}px {{ bs.bd_pad_bottom }}px {{ bs.bd_pad_left }}px;
    }
    /* the body is rich text — the dynamic-source content can land in
       spans, paragraphs or divs, so every typography property is forced
       onto the wrapper AND every descendant element with !important */
    #pdp-acc-text-{{ block.id }} .pdp-acc__body,
    #pdp-acc-text-{{ block.id }} .pdp-acc__body * {
      {%- case bs.bd_font -%}
        {%- when 'body' -%}font-family: var(--type-font-body-family) !important;
        {%- when 'heading' -%}font-family: var(--type-font-header-family) !important;
        {%- when 'handwritten' -%}font-family: var(--type-font-handwritten-family) !important;
      {%- endcase -%}
      {%- if bs.bd_size_d > 0 %} font-size: {{ bs.bd_size_d }}px !important;{% endif -%}
      {%- if bs.bd_weight != blank %} font-weight: {{ bs.bd_weight }} !important;{% endif -%}
      {%- if bs.bd_case != blank %} text-transform: {{ bs.bd_case }} !important;{% endif -%}
      {%- if bs.bd_ls > 0 %} letter-spacing: {{ bs.bd_ls | divided_by: 100.0 }}em !important;{% endif -%}
      {%- if bs.bd_lh > 0 %} line-height: {{ bs.bd_lh }} !important;{% endif -%}
    }
    {%- if bs.hd_size_m > 0 or bs.sh_size_m > 0 or bs.bd_size_m > 0 -%}
      @media (max-width: 749px) {
        {%- if bs.hd_size_m > 0 -%}
          #pdp-acc-text-{{ block.id }} .pdp-acc__heading { font-size: {{ bs.hd_size_m }}px; }
        {%- endif -%}
        {%- if bs.sh_size_m > 0 -%}
          #pdp-acc-text-{{ block.id }} .pdp-acc__subheading { font-size: {{ bs.sh_size_m }}px; }
        {%- endif -%}
        {%- if bs.bd_size_m > 0 -%}
          #pdp-acc-text-{{ block.id }} .pdp-acc__body,
          #pdp-acc-text-{{ block.id }} .pdp-acc__body * { font-size: {{ bs.bd_size_m }}px !important; }
        {%- endif -%}
      }
    {%- endif -%}
  {% endstyle %}
{%- endif -%}

{% schema %}
