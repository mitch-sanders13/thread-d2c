{% doc %}
  @prompt
    Contact form with a title, sub text below the tile, forms to fill out below that. I would like to be able to customize what forms I want and change it based on needs. Match the current theme styles (font family's) 'd like to be able to change the font colors. I'd like to specifiy what email address the form gets submitted to. , Can you have the fonts automaticall match my current webiste theme?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-contact-form__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-contact-form__heading-{{ ai_gen_id }} {
    margin: 0;
    font-family: {{ settings.type_font_heading.family }}, {{ settings.type_font_heading.fallback_families }};
    font-weight: {{ settings.type_font_heading.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-contact-form__subtext-{{ ai_gen_id }} {
    margin: 0;
    font-family: {{ settings.type_font_body.family }}, {{ settings.type_font_body.fallback_families }};
    font-weight: {{ settings.type_font_body.weight }};
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-contact-form__fields-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-contact-form__field-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form__label-{{ ai_gen_id }} {
    font-family: {{ settings.type_font_body.family }}, {{ settings.type_font_body.fallback_families }};
    font-weight: {{ settings.type_font_body.weight }};
    font-size: 14px;
    color: {{ block.settings.label_color }};
  }

  .ai-contact-form__input-{{ ai_gen_id }},
  .ai-contact-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    font-family: {{ settings.type_font_body.family }}, {{ settings.type_font_body.fallback_families }};
    font-weight: {{ settings.type_font_body.weight }};
    font-size: 16px;
    color: {{ block.settings.input_text_color }};
    background-color: {{ block.settings.input_background_color }};
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
  }

  .ai-contact-form__input-{{ ai_gen_id }}:focus,
  .ai-contact-form__textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
  }

  .ai-contact-form__textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-contact-form__button-{{ ai_gen_id }} {
    padding: 14px 32px;
    font-family: {{ settings.type_font_body.family }}, {{ settings.type_font_body.fallback_families }};
    font-weight: {{ settings.type_font_body.weight }};
    font-size: 16px;
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-contact-form__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-contact-form__success-{{ ai_gen_id }} {
    padding: 16px;
    font-family: {{ settings.type_font_body.family }}, {{ settings.type_font_body.fallback_families }};
    font-weight: {{ settings.type_font_body.weight }};
    color: {{ block.settings.success_text_color }};
    background-color: {{ block.settings.success_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
  }

  .ai-contact-form__error-{{ ai_gen_id }} {
    padding: 16px;
    font-family: {{ settings.type_font_body.family }}, {{ settings.type_font_body.fallback_families }};
    font-weight: {{ settings.type_font_body.weight }};
    color: {{ block.settings.error_text_color }};
    background-color: {{ block.settings.error_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-contact-form__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-contact-form__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<contact-form-{{ ai_gen_id }}
  class="ai-contact-form-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {%- form 'contact' -%}
    <input
      type="hidden"
      name="contact[recipient_email]"
      value="{{ block.settings.recipient_email }}"
    >

    <div class="ai-contact-form__content-{{ ai_gen_id }}">
      {% if form.posted_successfully? %}
        <div
          class="ai-contact-form__success-{{ ai_gen_id }}"
          role="status"
        >
          {{ block.settings.success_message }}
        </div>
      {% else %}
        {% if block.settings.heading != blank %}
          <h2 class="ai-contact-form__heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.subtext != blank %}
          <div class="ai-contact-form__subtext-{{ ai_gen_id }}">
            {{ block.settings.subtext }}
          </div>
        {% endif %}

        {% if form.errors %}
          <div
            class="ai-contact-form__error-{{ ai_gen_id }}"
            role="alert"
          >
            {{ form.errors.messages | first }}
          </div>
        {% endif %}

        <div class="ai-contact-form__fields-{{ ai_gen_id }}">
          {% if block.settings.show_name_field %}
            <div class="ai-contact-form__field-wrapper-{{ ai_gen_id }}">
              <label
                for="ai-contact-name-{{ ai_gen_id }}"
                class="ai-contact-form__label-{{ ai_gen_id }}"
              >
                {{ block.settings.name_label }}{% if block.settings.name_required %} *{% endif %}
              </label>
              <input
                type="text"
                id="ai-contact-name-{{ ai_gen_id }}"
                name="contact[name]"
                class="ai-contact-form__input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.name_placeholder }}"
                {% if block.settings.name_required %}required{% endif %}
              >
            </div>
          {% endif %}

          {% if block.settings.show_email_field %}
            <div class="ai-contact-form__field-wrapper-{{ ai_gen_id }}">
              <label
                for="ai-contact-email-{{ ai_gen_id }}"
                class="ai-contact-form__label-{{ ai_gen_id }}"
              >
                {{ block.settings.email_label }} *
              </label>
              <input
                type="email"
                id="ai-contact-email-{{ ai_gen_id }}"
                name="contact[email]"
                class="ai-contact-form__input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.email_placeholder }}"
                autocomplete="email"
                required
              >
            </div>
          {% endif %}

          {% if block.settings.show_phone_field %}
            <div class="ai-contact-form__field-wrapper-{{ ai_gen_id }}">
              <label
                for="ai-contact-phone-{{ ai_gen_id }}"
                class="ai-contact-form__label-{{ ai_gen_id }}"
              >
                {{ block.settings.phone_label }}{% if block.settings.phone_required %} *{% endif %}
              </label>
              <input
                type="tel"
                id="ai-contact-phone-{{ ai_gen_id }}"
                name="contact[phone]"
                class="ai-contact-form__input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.phone_placeholder }}"
                autocomplete="tel"
                {% if block.settings.phone_required %}required{% endif %}
              >
            </div>
          {% endif %}

          {% if block.settings.show_company_field %}
            <div class="ai-contact-form__field-wrapper-{{ ai_gen_id }}">
              <label
                for="ai-contact-company-{{ ai_gen_id }}"
                class="ai-contact-form__label-{{ ai_gen_id }}"
              >
                {{ block.settings.company_label }}{% if block.settings.company_required %} *{% endif %}
              </label>
              <input
                type="text"
                id="ai-contact-company-{{ ai_gen_id }}"
                name="contact[company]"
                class="ai-contact-form__input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.company_placeholder }}"
                {% if block.settings.company_required %}required{% endif %}
              >
            </div>
          {% endif %}

          {% if block.settings.show_subject_field %}
            <div class="ai-contact-form__field-wrapper-{{ ai_gen_id }}">
              <label
                for="ai-contact-subject-{{ ai_gen_id }}"
                class="ai-contact-form__label-{{ ai_gen_id }}"
              >
                {{ block.settings.subject_label }}{% if block.settings.subject_required %} *{% endif %}
              </label>
              <input
                type="text"
                id="ai-contact-subject-{{ ai_gen_id }}"
                name="contact[subject]"
                class="ai-contact-form__input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.subject_placeholder }}"
                {% if block.settings.subject_required %}required{% endif %}
              >
            </div>
          {% endif %}

          {% if block.settings.show_message_field %}
            <div class="ai-contact-form__field-wrapper-{{ ai_gen_id }}">
              <label
                for="ai-contact-message-{{ ai_gen_id }}"
                class="ai-contact-form__label-{{ ai_gen_id }}"
              >
                {{ block.settings.message_label }}{% if block.settings.message_required %} *{% endif %}
              </label>
              <textarea
                id="ai-contact-message-{{ ai_gen_id }}"
                name="contact[body]"
                class="ai-contact-form__textarea-{{ ai_gen_id }}"
                placeholder="{{ block.settings.message_placeholder }}"
                {% if block.settings.message_required %}required{% endif %}
              ></textarea>
            </div>
          {% endif %}

          <button
            type="submit"
            class="ai-contact-form__button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </button>
        </div>
      {% endif %}
    </div>
  {%- endform -%}
</contact-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        if (form) {
          form.addEventListener('submit', function() {
            const button = form.querySelector('button[type="submit"]');
            if (button) {
              button.disabled = true;
              button.textContent = 'Sending...';
            }
          });
        }
      }
    }

    customElements.define('contact-form-{{ ai_gen_id }}', ContactForm{{ ai_gen_id }});
  })();
</script>

