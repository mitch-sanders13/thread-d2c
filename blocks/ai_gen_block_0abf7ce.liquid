{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-addons-section-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-addons-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-addons-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 48px;
  }

  .ai-addons-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 400;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .ai-addons-intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.75;
    margin: 0;
    line-height: 1.6;
    max-width: 600px;
    {% if block.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .ai-addons-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-addon-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.2s ease;
  }

  .ai-addon-card-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.card_hover_border }};
  }

  .ai-addon-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.addon_name_size }}px;
    font-weight: 400;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px 0;
    line-height: 1.4;
  }

  .ai-addon-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.addon_price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-addons-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 16px;
    }

    .ai-addons-header-{{ ai_gen_id }} {
      margin-bottom: 32px;
    }

    .ai-addons-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: {{ block.settings.card_gap | times: 0.75 }}px;
    }

    .ai-addons-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-addon-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.85 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-addons-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-addons-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-addons-container-{{ ai_gen_id }}">
    <div class="ai-addons-header-{{ ai_gen_id }}">
      {% if block.settings.section_title != blank %}
        <h2 class="ai-addons-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      {% endif %}
      {% if block.settings.intro_text != blank %}
        <p class="ai-addons-intro-{{ ai_gen_id }}">{{ block.settings.intro_text }}</p>
      {% endif %}
    </div>

    <div class="ai-addons-grid-{{ ai_gen_id }}">
      {% if block.settings.addon_1_name != blank %}
        <div class="ai-addon-card-{{ ai_gen_id }}">
          <h3 class="ai-addon-name-{{ ai_gen_id }}">{{ block.settings.addon_1_name }}</h3>
          <p class="ai-addon-price-{{ ai_gen_id }}">{{ block.settings.addon_1_price }}</p>
        </div>
      {% endif %}

      {% if block.settings.addon_2_name != blank %}
        <div class="ai-addon-card-{{ ai_gen_id }}">
          <h3 class="ai-addon-name-{{ ai_gen_id }}">{{ block.settings.addon_2_name }}</h3>
          <p class="ai-addon-price-{{ ai_gen_id }}">{{ block.settings.addon_2_price }}</p>
        </div>
      {% endif %}

      {% if block.settings.addon_3_name != blank %}
        <div class="ai-addon-card-{{ ai_gen_id }}">
          <h3 class="ai-addon-name-{{ ai_gen_id }}">{{ block.settings.addon_3_name }}</h3>
          <p class="ai-addon-price-{{ ai_gen_id }}">{{ block.settings.addon_3_price }}</p>
        </div>
      {% endif %}

      {% if block.settings.addon_4_name != blank %}
        <div class="ai-addon-card-{{ ai_gen_id }}">
          <h3 class="ai-addon-name-{{ ai_gen_id }}">{{ block.settings.addon_4_name }}</h3>
          <p class="ai-addon-price-{{ ai_gen_id }}">{{ block.settings.addon_4_price }}</p>
        </div>
      {% endif %}

      {% if block.settings.addon_5_name != blank %}
        <div class="ai-addon-card-{{ ai_gen_id }}">
          <h3 class="ai-addon-name-{{ ai_gen_id }}">{{ block.settings.addon_5_name }}</h3>
          <p class="ai-addon-price-{{ ai_gen_id }}">{{ block.settings.addon_5_price }}</p>
        </div>
      {% endif %}

      {% if block.settings.addon_6_name != blank %}
        <div class="ai-addon-card-{{ ai_gen_id }}">
          <h3 class="ai-addon-name-{{ ai_gen_id }}">{{ block.settings.addon_6_name }}</h3>
          <p class="ai-addon-price-{{ ai_gen_id }}">{{ block.settings.addon_6_price }}</p>
        </div>
      {% endif %}

      {% if block.settings.addon_7_name != blank %}
        <div class="ai-addon-card-{{ ai_gen_id }}">
          <h3 class="ai-addon-name-{{ ai_gen_id }}">{{ block.settings.addon_7_name }}</h3>
          <p class="ai-addon-price-{{ ai_gen_id }}">{{ block.settings.addon_7_price }}</p>
        </div>
      {% endif %}

      {% if block.settings.addon_8_name != blank %}
        <div class="ai-addon-card-{{ ai_gen_id }}">
          <h3 class="ai-addon-name-{{ ai_gen_id }}">{{ block.settings.addon_8_name }}</h3>
          <p class="ai-addon-price-{{ ai_gen_id }}">{{ block.settings.addon_8_price }}</p>
        </div>
      {% endif %}

      {% if block.settings.addon_9_name != blank %}
        <div class="ai-addon-card-{{ ai_gen_id }}">
          <h3 class="ai-addon-name-{{ ai_gen_id }}">{{ block.settings.addon_9_name }}</h3>
          <p class="ai-addon-price-{{ ai_gen_id }}">{{ block.settings.addon_9_price }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

