{% doc %}
  @prompt
    Create a clean section for an event venue page called “What’s Included With Event Space Rental.” Match the existing Thread website style. Keep it minimal, modern, and easy to scan.
    
    Use a simple layout with small grouped cards.
    
    Include these items:
    - 2,220 sq ft industrial-style event space
    - Full kitchen access
    - Stage and large TV
    - Bluetooth sound system and cordless microphone
    - Tables, chairs, benches, and linens
    - Wheelchair accessibility
    - Private parking lot
    - Mothers’ room / bridal suite
    - Restroom access
    
    Add a short intro sentence:
    Everything you need for a seamless and stylish event is included.
    
    Keep it visually clean and not text-heavy.
    
    Give the ability to upload an image in each card. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-event-inclusions-{{ ai_gen_id }} {
    width: 100%;
    display: block;
  }

  .ai-event-inclusions-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  .ai-event-inclusions-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 16px;
  }

  .ai-event-inclusions-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px 0;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-event-inclusions-intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 auto;
    max-width: 600px;
    line-height: 1.6;
  }

  .ai-event-inclusions-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: {{ block.settings.card_gap }}px;
    margin-top: 40px;
  }

  .ai-event-inclusions-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.2s ease;
  }

  .ai-event-inclusions-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-event-inclusions-card-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-event-inclusions-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-event-inclusions-card-image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-event-inclusions-card-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-event-inclusions-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-event-inclusions-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
    opacity: 0.8;
  }

  @media screen and (max-width: 768px) {
    .ai-event-inclusions-container-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-event-inclusions-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.75 }}px;
    }

    .ai-event-inclusions-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<event-inclusions-{{ ai_gen_id }} class="ai-event-inclusions-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-event-inclusions-container-{{ ai_gen_id }}">
    <div class="ai-event-inclusions-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-event-inclusions-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.intro_text != blank %}
        <p class="ai-event-inclusions-intro-{{ ai_gen_id }}">{{ block.settings.intro_text }}</p>
      {% endif %}
    </div>

    <div class="ai-event-inclusions-grid-{{ ai_gen_id }}">
      {% for i in (1..9) %}
        {% liquid
          assign title_key = 'item_' | append: i | append: '_title'
          assign description_key = 'item_' | append: i | append: '_description'
          assign image_key = 'item_' | append: i | append: '_image'
          assign enabled_key = 'item_' | append: i | append: '_enabled'

          assign item_title = block.settings[title_key]
          assign item_description = block.settings[description_key]
          assign item_image = block.settings[image_key]
          assign item_enabled = block.settings[enabled_key]
        %}

        {% if item_enabled and item_title != blank %}
          <div class="ai-event-inclusions-card-{{ ai_gen_id }}">
            {% if item_image != blank or block.settings.show_image_placeholders %}
              <div class="ai-event-inclusions-card-image-wrapper-{{ ai_gen_id }}">
                {% if item_image != blank %}
                  <img
                    src="{{ item_image | image_url: width: 600 }}"
                    alt="{{ item_title | append: ' at 241 Event Space in downtown Provo' | escape }}"
                    class="ai-event-inclusions-card-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="338"
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              </div>
            {% endif %}
            <div class="ai-event-inclusions-card-content-{{ ai_gen_id }}">
              <h3 class="ai-event-inclusions-card-title-{{ ai_gen_id }}">{{ item_title }}</h3>
              {% if item_description != blank %}
                <p class="ai-event-inclusions-card-description-{{ ai_gen_id }}">{{ item_description }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</event-inclusions-{{ ai_gen_id }}>

<script>
  (function() {
    class EventInclusions{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('event-inclusions-{{ ai_gen_id }}', EventInclusions{{ ai_gen_id }});
  })();
</script>

